---
layout: layouts/base.njk
---

<div class="container">
  <article class="article-reading-container">
    <!-- 1. Clean Breadcrumbs -->
    <nav class="article-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span>/</span>
      <a href="{{ ('/' + (category | categorySlug) + '/') | url }}">{{ category }}</a>
    </nav>

    <!-- 2. Category Tag -->
    <div>
      <a href="{{ ('/' + (category | categorySlug) + '/') | url }}" class="category-label">
        {{ category }}
      </a>
    </div>

    <!-- 3. Featured Hero Image (Positioned near top) -->
    {% if image %}
      <figure class="article-hero-frame">
        <img 
          src="{{ image | url }}" 
          alt="{{ imageAlt or image_alt or title }}" 
          class="article-hero-img"
          fetchpriority="high"
          width="760" 
          height="428"
        >
        {% if imageCredit or image_credit %}
          <figcaption class="photo-caption-bar">
            Photo: {{ imageCredit or image_credit }}
          </figcaption>
        {% endif %}
      </figure>
    {% endif %}

    <!-- 4. Main H1 Headline -->
    <h1 class="article-headline-main">{{ title }}</h1>

    <!-- 5. Sub-headline / Dek -->
    {% if dek %}
      <p class="article-dek-main">{{ dek }}</p>
    {% endif %}

    <!-- 6. Byline Row -->
    <div class="article-byline-bar">
      <span>By <span class="byline-strong">{{ author or site.author.name }}</span></span>
      <span>•</span>
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      <span>•</span>
      <span>{{ content | readTime }}</span>
    </div>

    <!-- 7. Key Takeaways Box -->
    {% include "partials/key-takeaways.njk" %}

    <!-- 8. Core Article Content (with Inline "Also Read" after 2nd paragraph) -->
    {% set related = collections.articles | relatedArticles(page, 1) %}
    <div class="article-body-text">
      {% if related.length > 0 %}
        {{ content | injectAlsoRead(related[0]) | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

    <!-- 9. Embedded YouTube Video (Inline right after body content) -->
    {% if video_id and video_id != "" and video_id != "null" %}
      <div class="video-block-wrapper" aria-label="Related Video Coverage">
        <div class="video-caption-label">
          <div style="display: flex; align-items: center; gap: 8px; flex: 1; min-width: 0;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-brand, #C81E2C); flex-shrink: 0;">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
            <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Video Coverage: {{ video_caption or title }}</span>
          </div>
          <a href="https://www.youtube.com/watch?v={{ video_id }}" target="_blank" rel="noopener noreferrer" class="video-direct-link">
            Watch on YouTube ↗
          </a>
        </div>
        <div class="video-embed-container">
          <iframe 
            src="https://www.youtube.com/embed/{{ video_id }}" 
            title="{{ title | escape }}" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>
      </div>
    {% endif %}

    <!-- 10. Why It Matters Annotation -->
    {% include "partials/why-it-matters.njk" %}

    <!-- 11. Source Attribution -->
    {% set currentSourceName = sourceName or source_name %}
    {% set currentSourceUrl = sourceUrl or source_url %}
    <div class="source-citation">
      <span>Reporting based on verified dispatches from <strong>{{ currentSourceName or "Official Wire Services" }}</strong>.</span>
      {% if currentSourceUrl %}
        <span style="margin-left: 8px;">
          <a href="{{ currentSourceUrl }}" rel="nofollow noopener noreferrer" target="_blank">View primary release ↗</a>
        </span>
      {% endif %}
    </div>

    <!-- 12. Bottom "Also Read" Related Articles (Up to 3 stories) -->
    {% set relatedBottom = collections.articles | relatedArticles(page, 3) %}
    {% if relatedBottom.length > 0 %}
      <div class="also-read-bottom" aria-label="Also Read Related Articles">
        <div class="also-read-bottom-title">ALSO READ</div>
        <ul class="also-read-list">
          {% for rel in relatedBottom %}
            <li class="also-read-item">
              <a href="{{ rel.url | url }}">{{ rel.data.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    <!-- 12. In-Article Ad Slot -->
    {% set slotName = "article-bottom" %}
    {% include "partials/ad-slot.njk" %}

    <!-- 13. Related Stories ("More in [Category]") -->
    {% set related = collections.articles | relatedArticles(category, page.url, 3) %}
    {% if related.length > 0 %}
      <section class="more-from-category" aria-label="More in {{ category }}">
        <h2 class="more-title">More in {{ category }}</h2>
        <div class="more-grid">
          {% for article in related %}
            {% include "partials/card.njk" %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </article>
</div>
