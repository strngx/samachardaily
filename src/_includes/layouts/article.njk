---
layout: layouts/base.njk
---

<div class="container">
  <article class="article-reading-container">
    <!-- 1. Clean Breadcrumbs -->
    <nav class="article-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span class="crumb-separator" aria-hidden="true">/</span>
      <a href="{{ ('/' + (category | categorySlug) + '/') | url }}">{{ category }}</a>
    </nav>

    <!-- 2. Category Tag -->
    <div class="article-category-wrap">
      <a href="{{ ('/' + (category | categorySlug) + '/') | url }}" class="category-label category-tag-{{ category | categorySlug }}">
        {{ category }}
      </a>
    </div>

    <!-- 3. Featured Hero Image (Positioned near top) -->
    {% if image %}
      <figure class="article-hero-frame">
        <img 
          src="{{ image | url }}" 
          alt="{{ imageAlt or image_alt or title }}" 
          class="article-hero-img"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="760" 
          height="428"
        >
        {% if imageCredit or image_credit %}
          <figcaption class="photo-caption-bar">
            <svg class="caption-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
              <circle cx="12" cy="13" r="4"/>
            </svg>
            <span>Photo: {{ imageCredit or image_credit }}</span>
          </figcaption>
        {% endif %}
      </figure>
    {% endif %}

    <!-- 4. Main H1 Headline -->
    <h1 class="article-headline-main">{{ title }}</h1>

    <!-- 5. Sub-headline / Dek -->
    {% if dek %}
      <p class="article-dek-main">{{ dek }}</p>
    {% endif %}

    <!-- 6. Byline Row -->
    <div class="article-byline-bar">
      <div class="byline-author-group">
        {% set rawAuthor = (author or site.author.name or "") | trim %}
        {% if rawAuthor == "Arjun Khatri" %}
          {% set authorName = "Arjun Khatri" %}
          {% set authorUrl = "/authors/samachardaily-editorial-team/" %}
        {% else %}
          {% set authorName = "Samachar Daily" %}
          {% set authorUrl = "/authors/samachardaily-editorial-team/" %}
        {% endif %}
        <span class="byline-author">
          By <a href="{{ authorUrl | url }}" class="byline-strong">{{ authorName }}</a>
        </span>
      </div>
      <div class="byline-meta-group">
        <span class="byline-dot" aria-hidden="true">•</span>
        <span class="byline-date-wrap">
          <time datetime="{{ date | isoDate }}" class="byline-date">{{ date | readableDate }}</time>
        </span>
        {% set modDate = modifiedDate or dateModified or updated %}
        {% if modDate and (modDate | isoDate) != (date | isoDate) %}
          <span class="byline-dot" aria-hidden="true">•</span>
          <span class="byline-updated">
            <span class="byline-label">Updated:</span>
            <time datetime="{{ modDate | isoDate }}">{{ modDate | readableDate }}</time>
          </span>
        {% endif %}
        <span class="byline-dot" aria-hidden="true">•</span>
        <span class="byline-readtime">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{{ content | readTime }}</span>
        </span>
      </div>
    </div>

    <!-- 6b. Compact Editorial Disclosure -->
    <div class="article-disclosure-bar">
      <span class="disclosure-item disclosure-ai">AI-assisted wire synthesis</span>
      <span class="disclosure-dot" aria-hidden="true">·</span>
      <span class="disclosure-item disclosure-verified">
        {% if humanReviewed or human_reviewed %}Human reviewed{% elif corroboration_status == "corroborated" or corroborationStatus == "corroborated" %}Multi-source corroborated{% else %}Independently verified{% endif %}
      </span>
      <span class="disclosure-dot" aria-hidden="true">·</span>
      <a href="{{ '/editorial/' | url }}" class="disclosure-link">
        Editorial disclosure <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 6c. Factual Correction Notice (Renders ONLY if correction metadata exists) -->
    {% set articleCorrection = correction or correction_notice or corrections %}
    {% if articleCorrection %}
      <aside class="article-correction-box" aria-label="Editorial Correction Notice">
        <div class="correction-inner">
          <div class="correction-title">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>CORRECTION &amp; CLARIFICATION</span>
          </div>
          <div class="correction-body">
            <p>{{ articleCorrection }}</p>
          </div>
        </div>
      </aside>
    {% endif %}

    <!-- 7. Key Takeaways Box -->
    {% include "partials/key-takeaways.njk" %}

    <!-- 8. Core Article Content (with Inline "Also Read" after 2nd paragraph) -->
    {% set related = collections.articles | relatedArticles(page, 1) %}
    <div class="article-body-text">
      {% if related.length > 0 %}
        {{ content | injectAlsoRead(related[0]) | safe }}
      {% else %}
        {{ content | safe }}
      {% endif %}
    </div>

    <!-- 9. Embedded YouTube Video (Inline right after body content) -->
    {% include "partials/video-embed.njk" %}

    <!-- 10. Why It Matters Annotation -->
    {% include "partials/why-it-matters.njk" %}

    <!-- 10b. Health & Dietary Information Disclaimer -->
    {% include "partials/health-disclaimer.njk" %}

    <!-- 11. Source Attribution -->
    {% set currentSourceName = sourceName or source_name %}
    {% set currentSourceUrl = sourceUrl or source_url %}
    <aside class="source-citation" aria-label="Source and Reporting Disclosure">
      <div class="source-citation-inner">
        <svg class="source-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <div class="source-citation-text">
          {% if sources and sources.length > 0 %}
            <div class="multi-source-header">
              <span>Reporting synthesized from <strong>{{ sources.length }} attributed sources</strong>{% if corroboration_status == "corroborated" or corroborationStatus == "corroborated" %} with cross-source corroboration{% endif %}:</span>
            </div>
            <ul class="multi-source-list">
              {% for s in sources %}
                <li class="multi-source-item">
                  <span class="source-outlet-name"><strong>{{ s.name }}</strong></span>
                  {% if s.role == "primary_reporting" %}
                    <span class="source-role-tag primary">Primary Dispatch</span>
                  {% elif s.role == "independent_corroboration" %}
                    <span class="source-role-tag corroborating">Independent Corroboration</span>
                  {% elif s.role == "wire_dispatch" or s.role == "syndicated_copy" %}
                    <span class="source-role-tag wire">Wire Coverage</span>
                  {% endif %}
                  {% if s.url %}
                    <a href="{{ s.url }}" rel="nofollow noopener noreferrer" target="_blank" class="source-external-link">
                      View report <span aria-hidden="true">↗</span>
                    </a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <span>Reporting based on verified dispatches from <strong>{{ currentSourceName or "Official Wire Services" }}</strong>.</span>
            {% if currentSourceUrl %}
              <span class="source-link-wrap">
                <a href="{{ currentSourceUrl }}" rel="nofollow noopener noreferrer" target="_blank" class="source-external-link">
                  View primary release <span aria-hidden="true">↗</span>
                </a>
              </span>
            {% endif %}
          {% endif %}
        </div>
      </div>
    </aside>

    <!-- 12. Related Articles Block for Internal Linking (4 Most Recent in Same Category) -->
    {% set catKey = (category or "India") | categorySlug %}
    {% set catArticles = (collections.relatedArticlesByCategory and collections.relatedArticlesByCategory[catKey]) or [] %}
    {% if catArticles.length > 1 or (catArticles.length == 1 and catArticles[0].url != page.url) %}
      <aside class="also-read-bottom" aria-label="Related Articles">
        <div class="also-read-bottom-title">RELATED ARTICLES</div>
        <ul class="also-read-list">
          {% set count = 0 %}
          {% for rel in catArticles %}
            {% if rel.url != page.url and count < 4 %}
              {% set count = count + 1 %}
              <li class="also-read-item">
                <a href="{{ rel.url | url }}">{{ rel.data.title }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </aside>
    {% endif %}

    <!-- 12. In-Article Ad Slot -->
    {% set slotName = "article-bottom" %}
    {% include "partials/ad-slot.njk" %}

    <!-- 13. Related Stories ("More in [Category]") -->
    {% set related = collections.articles | relatedArticles(category, page.url, 3) %}
    {% if related.length > 0 %}
      <section class="more-from-category" aria-label="More in {{ category }}">
        <h2 class="more-title">More in {{ category }}</h2>
        <div class="more-grid">
          {% for article in related %}
            {% include "partials/card.njk" %}
          {% endfor %}
        </div>
      </section>
    {% endif %}
  </article>
</div>
