---
layout: layouts/base.njk
---

{% set category = pagedData.category if pagedData else category %}
{% set pageArticles = pagedData.articles if pagedData else collections[category.slug] %}
{% set currentPage = pagedData.pageNumber if pagedData else 1 %}
{% set totalPages = pagedData.totalPages if pagedData else 1 %}
{% set featuredList = pageArticles | featuredArticles %}
{% set archiveList = pageArticles | archiveArticles %}

<div class="container">
  <!-- Category Masthead (Monochrome, No "Desk" suffix) -->
  <header class="category-masthead">
    <h1 class="category-masthead-title">{{ category.name }}{% if currentPage > 1 %} <span style="font-size: 1.125rem; font-family: var(--font-sans); color: var(--color-muted); font-weight: 500;">(Page {{ currentPage }})</span>{% endif %}</h1>
    <div class="category-masthead-rule"></div>
    <p class="category-masthead-desc">{{ category.description }}</p>
  </header>

  <!-- Category Articles -->
  {% if pageArticles and pageArticles.length > 0 %}
    <!-- Lead Section (Featured Articles: Up to 3, prioritized by trendingMatch then recency) -->
    <div class="grid-comp-a" style="margin-bottom: var(--space-8);">
      {% for article in featuredList %}
        {% include "partials/card.njk" %}
      {% endfor %}
    </div>

    <!-- Ad Slot -->
    {% set slotName = "category-mid" %}
    {% include "partials/ad-slot.njk" %}

    <!-- Additional Stories Grid (Archive list: uncapped, shows all remaining articles on this page up to PAGE_SIZE) -->
    {% if archiveList.length > 0 %}
      <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.5rem; margin-bottom: var(--space-6);">Latest {{ category.name }} Archive</h2>
        <div class="grid-comp-a">
          {% for article in archiveList %}
            {% include "partials/card.njk" %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <!-- Numbered Pagination (Rendered when multiple pages exist) -->
    {% if totalPages > 1 %}
      <nav class="pagination-row" aria-label="{{ category.name }} Pagination">
        {% if pagedData and pagedData.prevPageUrl %}
          <a href="{{ pagedData.prevPageUrl | url }}" class="pagination-btn" aria-label="Previous Page">←</a>
        {% endif %}
        {% for p in range(1, totalPages + 1) %}
          {% if p == currentPage %}
            <span class="pagination-btn active" aria-current="page">{{ p }}</span>
          {% else %}
            {% set pageLink = ('/' + category.slug + '/') | url if p == 1 else ('/' + category.slug + '/' + p + '/') | url %}
            <a href="{{ pageLink }}" class="pagination-btn">{{ p }}</a>
          {% endif %}
        {% endfor %}
        {% if pagedData and pagedData.nextPageUrl %}
          <a href="{{ pagedData.nextPageUrl | url }}" class="pagination-btn" aria-label="Next Page">→</a>
        {% endif %}
      </nav>
    {% endif %}
  {% else %}
    <!-- Clean Empty Category State -->
    <div class="empty-newsroom-state" style="padding: 40px 0;">
      <div class="empty-newsroom-box">
        <h2 class="empty-title">No stories published in {{ category.name }} yet.</h2>
        <p class="empty-desc">
          Verified reporting in this category will appear as the newsroom files dispatches.
        </p>
      </div>
    </div>
  {% endif %}
</div>
