---
layout: layouts/base.njk
---

<div class="container">
  <h1 class="visually-hidden">SamacharDaily — News, Fast. Trends, Explained.</h1>
  {% set heroStories = collections.articles | heroCarouselFeed(5) %}
  {% set leadStory = heroStories[0] %}
  {% set wireStories = collections.articles | filterExcludedArticles(heroStories) | limit(5) %}
  
  {# Stories used in Hero Carousel + Wire Stream #}
  {% set heroUsedStories = [] %}
  {% for item in heroStories %}
    {% set heroUsedStories = (heroUsedStories.push(item), heroUsedStories) %}
  {% endfor %}
  {% for item in wireStories %}
    {% set heroUsedStories = (heroUsedStories.push(item), heroUsedStories) %}
  {% endfor %}

  {# 5 Trending Stories strictly excluding all Hero Carousel stories AND wireStories to prevent duplication #}
  {% set homepageArticles = collections.articles | homepageFeed %}
  {% set trendingCandidates = homepageArticles | filterExcludedArticles(heroUsedStories) %}
  {% if trendingCandidates.length < 5 %}
    {% set trendingCandidates = collections.articles | filterExcludedArticles(heroUsedStories) %}
  {% endif %}
  {% set trendingStories = trendingCandidates | limit(5) %}

  {# Master exclusion list for lower-page desk modules #}
  {% set masterUsedStories = [] %}
  {% for item in heroUsedStories %}
    {%- set masterUsedStories = (masterUsedStories.push(item), masterUsedStories) -%}
  {% endfor %}
  {% for item in trendingStories %}
    {%- set masterUsedStories = (masterUsedStories.push(item), masterUsedStories) -%}
  {% endfor %}

  {# Five-Desk Broadsheet Representation (India, World, Business, Tech, Sports) #}
  {% set indiaStories = [] %}
  {% for art in collections.india | filterExcludedArticles(masterUsedStories) %}
    {%- if indiaStories.length < 5 and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to -%}
      {%- set indiaStories = (indiaStories.push(art), indiaStories) -%}
      {%- set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) -%}
    {%- endif -%}
  {% endfor %}

  {% set worldStories = [] %}
  {% for art in collections.world | filterExcludedArticles(masterUsedStories) %}
    {%- if worldStories.length < 4 and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to -%}
      {%- set worldStories = (worldStories.push(art), worldStories) -%}
      {%- set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) -%}
    {%- endif -%}
  {% endfor %}

  {% set businessStories = [] %}
  {% for art in collections.business | filterExcludedArticles(masterUsedStories) %}
    {%- if businessStories.length < 5 and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to -%}
      {%- set businessStories = (businessStories.push(art), businessStories) -%}
      {%- set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) -%}
    {%- endif -%}
  {% endfor %}

  {% set techStories = [] %}
  {% for art in collections.tech | filterExcludedArticles(masterUsedStories) %}
    {%- if techStories.length < 5 and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to -%}
      {%- set techStories = (techStories.push(art), techStories) -%}
      {%- set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) -%}
    {%- endif -%}
  {% endfor %}

  {% set sportsStories = [] %}
  {% for art in collections.sports | filterExcludedArticles(masterUsedStories) %}
    {%- if sportsStories.length < 5 and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to -%}
      {%- set sportsStories = (sportsStories.push(art), sportsStories) -%}
      {%- set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) -%}
    {%- endif -%}
  {% endfor %}

  <!-- 1. Newsroom Lead + Latest News Continuous Wire -->
  {% include "partials/hero.njk" %}

  {% if collections.articles.length > 0 %}
    <!-- 2. Zero-CLS Top Ad Slot -->
    {% set slotName = "homepage-top" %}
    {% include "partials/ad-slot.njk" %}

    <!-- 3. Trending Stories with Visual Hierarchy (#1 Dominant + #2-4 Compact) -->
    {% if trendingStories.length > 0 %}
    <section class="trending-section" aria-label="Trending Stories">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">Trending Stories</h2>
          <span class="section-masthead-sub">Top reporting across categories</span>
        </div>
      </div>

      <div class="trending-hierarchy-grid">
        <!-- #1 Dominant Trending Story -->
        {% set topTrend = trendingStories[0] %}
        {% if topTrend %}
        <article class="trending-featured-card">
          <div class="trending-featured-media-wrap">
            {% if topTrend.data.image %}
              <a href="{{ topTrend.url | url }}" class="card-thumb" aria-label="{{ topTrend.data.title }}">
                <img src="{{ topTrend.data.image | url }}" alt="{{ topTrend.data.imageAlt or topTrend.data.title }}" loading="lazy" width="640" height="360">
                {% if (topTrend.date | isJustIn) %}
                  <span class="badge-just-in">JUST IN</span>
                {% endif %}
              </a>
            {% else %}
              <a href="{{ topTrend.url | url }}" class="card-thumb card-thumb-placeholder category-bg-{{ topTrend.data.category | lower }}" aria-label="{{ topTrend.data.title }}">
                <div class="placeholder-inner">
                  <span class="placeholder-brand">Samachar<span class="brand-red">Daily</span></span>
                  <span class="placeholder-category">{{ topTrend.data.category }}</span>
                </div>
                {% if (topTrend.date | isJustIn) %}
                  <span class="badge-just-in">JUST IN</span>
                {% endif %}
              </a>
            {% endif %}
            <span class="trending-rank-badge">#01 TRENDING</span>
          </div>
          <div class="trending-featured-body">
            <a href="{{ ('/' + (topTrend.data.category | categorySlug) + '/') | url }}" class="category-label">
              {{ topTrend.data.category }}
            </a>
            <h3 class="trending-featured-headline">
              <a href="{{ topTrend.url | url }}">{{ topTrend.data.title }}</a>
            </h3>
            {% if topTrend.data.dek %}
              <p class="trending-featured-dek">{{ topTrend.data.dek }}</p>
            {% endif %}
            <div class="meta-row" style="font-size: 0.8125rem; margin-top: auto;">
              <time datetime="{{ topTrend.date | isoDate }}">{{ topTrend.date | timeAgo }}</time>
              <span>•</span>
              <span>{{ topTrend.templateContent | readTime }}</span>
            </div>
          </div>
        </article>
        {% endif %}

        <!-- #02-05 Compact List Items -->
        <div class="trending-compact-list">
          {% for article in trendingStories | skip(1) | limit(4) %}
            <article class="trending-item">
              <span class="trending-rank" aria-hidden="true">0{{ loop.index + 1 }}</span>
              <div class="trending-content">
                {% if article.data.image %}
                  <a href="{{ article.url | url }}" class="trending-thumb-wrap" aria-label="{{ article.data.title }}">
                    <img src="{{ article.data.image | url }}" alt="{{ article.data.imageAlt or article.data.title }}" class="trending-thumb" loading="lazy" width="120" height="80">
                    {% if (article.date | isJustIn) %}
                      <span class="badge-just-in badge-just-in-sm">JUST IN</span>
                    {% endif %}
                  </a>
                {% else %}
                  <a href="{{ article.url | url }}" class="trending-thumb-wrap card-thumb-placeholder category-bg-{{ article.data.category | lower }}" aria-label="{{ article.data.title }}">
                    <div class="placeholder-inner-sm">
                      <span>{{ article.data.category }}</span>
                    </div>
                    {% if (article.date | isJustIn) %}
                      <span class="badge-just-in badge-just-in-sm">JUST IN</span>
                    {% endif %}
                  </a>
                {% endif %}
                <div style="flex: 1; min-width: 0;">
                  <a href="{{ ('/' + (article.data.category | categorySlug) + '/') | url }}" class="category-label">
                    {{ article.data.category }}
                  </a>
                  <h3 class="trending-headline">
                    <a href="{{ article.url | url }}">{{ article.data.title }}</a>
                  </h3>
                  <div class="meta-row" style="font-size: 0.75rem;">
                    <time datetime="{{ article.date | isoDate }}">{{ article.date | timeAgo }}</time>
                    <span>•</span>
                    <span>{{ article.templateContent | readTime }}</span>
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <!-- 4. Five-Desk Newsroom Representation -->
    {% if indiaStories.length > 0 %}
    <section class="editorial-category-section" aria-label="India Desk">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">India Desk</h2>
          <span class="section-masthead-sub">National coverage, policy developments, and domestic affairs</span>
        </div>
        <a href="{{ '/india/' | url }}" class="section-view-all">View All India →</a>
      </div>
      <div class="desk-india-layout">
        {% if indiaStories[0] %}
          <div class="desk-india-lead">
            {% set article = indiaStories[0] %}
            {% set cardVariant = "desk-lead" %}
            {% set isLeadCard = false %}
            {% include "partials/card.njk" %}
          </div>
        {% endif %}
        {% if indiaStories.length > 1 %}
          <div class="desk-supporting-rail">
            {% for article in indiaStories | skip(1) | limit(4) %}
              {% set cardVariant = "desk-compact" %}
              {% set isLeadCard = false %}
              {% include "partials/card.njk" %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if worldStories.length > 0 %}
    <section class="editorial-category-section" aria-label="World Desk">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">World Desk</h2>
          <span class="section-masthead-sub">Global geopolitics, international relations, and overseas reports</span>
        </div>
        <a href="{{ '/world/' | url }}" class="section-view-all">View All World →</a>
      </div>
      <div class="desk-world-layout">
        {% if worldStories[0] %}
          <div class="desk-world-lead">
            {% set article = worldStories[0] %}
            {% set cardVariant = "desk-horizontal" %}
            {% set isLeadCard = false %}
            {% include "partials/card.njk" %}
          </div>
        {% endif %}
        {% if worldStories.length > 1 %}
          <div class="desk-world-subgrid">
            {% for article in worldStories | skip(1) | limit(3) %}
              {% set cardVariant = "desk-compact" %}
              {% set isLeadCard = false %}
              {% include "partials/card.njk" %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if businessStories.length > 0 %}
    <section class="editorial-category-section" aria-label="Business Desk">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">Business Desk</h2>
          <span class="section-masthead-sub">Markets, economic policy, corporate developments, and finance</span>
        </div>
        <a href="{{ '/business/' | url }}" class="section-view-all">View All Business →</a>
      </div>
      <div class="desk-business-layout">
        {% if businessStories[0] %}
          <div class="desk-business-lead">
            {% set article = businessStories[0] %}
            {% set cardVariant = "desk-business-lead" %}
            {% set isLeadCard = false %}
            {% include "partials/card.njk" %}
          </div>
        {% endif %}
        {% if businessStories.length > 1 %}
          <div class="desk-business-rail">
            {% for article in businessStories | skip(1) | limit(4) %}
              {% set cardVariant = "desk-compact" %}
              {% set isLeadCard = false %}
              {% include "partials/card.njk" %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- Mid-Page Editorial Accent -->
    <div class="newsroom-editorial-break" aria-hidden="true">
      <span class="break-line"></span>
      <span class="break-pill"><span class="break-bullet">◆</span> Specialist Desks & In-Depth Reporting <span class="break-bullet">◆</span></span>
      <span class="break-line"></span>
    </div>

    <!-- 5. Mid-Page Ad Slot -->
    {% set slotName = "homepage-mid" %}
    {% include "partials/ad-slot.njk" %}

    {% if techStories.length > 0 %}
    <section class="editorial-category-section" aria-label="Tech Desk">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">Tech Desk</h2>
          <span class="section-masthead-sub">Artificial intelligence, cybersecurity, consumer tech, and digital frontiers</span>
        </div>
        <a href="{{ '/tech/' | url }}" class="section-view-all">View All Tech →</a>
      </div>
      <div class="desk-tech-layout">
        {% if techStories[0] %}
          <div class="desk-tech-lead">
            {% set article = techStories[0] %}
            {% set cardVariant = "desk-lead" %}
            {% set isLeadCard = false %}
            {% include "partials/card.njk" %}
          </div>
        {% endif %}
        {% if techStories.length > 1 %}
          <div class="desk-tech-stream">
            {% for article in techStories | skip(1) | limit(4) %}
              {% set cardVariant = "desk-compact" %}
              {% set isLeadCard = false %}
              {% include "partials/card.njk" %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    {% if sportsStories.length > 0 %}
    <section class="editorial-category-section" aria-label="Sports Desk">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">Sports Desk</h2>
          <span class="section-masthead-sub">Tournament action, athletic dispatches, squad updates, and match analysis</span>
        </div>
        <a href="{{ '/sports/' | url }}" class="section-view-all">View All Sports →</a>
      </div>
      <div class="desk-sports-layout">
        {% if sportsStories[0] %}
          <div class="desk-sports-lead">
            {% set article = sportsStories[0] %}
            {% set cardVariant = "desk-sports-lead" %}
            {% set isLeadCard = false %}
            {% include "partials/card.njk" %}
          </div>
        {% endif %}
        {% if sportsStories.length > 1 %}
          <div class="desk-sports-duo">
            {% for article in sportsStories | skip(1) | limit(4) %}
              {% set cardVariant = "desk-compact" %}
              {% set isLeadCard = false %}
              {% include "partials/card.njk" %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </section>
    {% endif %}

    <!-- 6. Video Journalism Section -->
    {% set videoStories = [] %}
    {% for art in collections.articles -%}
      {% set currentVid = art.data.videoId or art.data.video_id %}
      {%- if currentVid and currentVid != "" and currentVid != "null" and not art.data.noindex and not art.data.draft and not art.data.redirect and not art.data.redirect_to and videoStories.length < 4 -%}
        {% set isAlreadyUsed = false %}
        {% for used in masterUsedStories %}
          {% if used.url == art.url or (used.data.slug and art.data.slug and used.data.slug == art.data.slug) %}
            {% set isAlreadyUsed = true %}
          {% endif %}
        {% endfor %}
        {% if not isAlreadyUsed %}
          {% set videoStories = (videoStories.push(art), videoStories) %}
          {% set masterUsedStories = (masterUsedStories.push(art), masterUsedStories) %}
        {% endif %}
      {%- endif -%}
    {%- endfor %}

    {% if videoStories.length > 0 %}
    {% set primaryVideo = videoStories[0] %}
    {% set activeVideoId = primaryVideo.data.videoId or primaryVideo.data.video_id %}
    <section class="video-journalism-section" aria-label="Watch The Story - Video Journalism">
      <div class="video-section-header">
        <h2 class="video-section-title">
          <span style="color: var(--color-brand);">Watch</span> The Story
        </h2>
        <span style="font-size: 0.8125rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Broadcast Coverage</span>
      </div>

      {% if videoStories.length == 1 %}
      <div class="video-grid">
        <div class="video-player-wrap">
          <iframe 
            src="https://www.youtube.com/embed/{{ activeVideoId }}" 
            title="{{ primaryVideo.data.videoCaption or primaryVideo.data.video_caption or primaryVideo.data.title }}" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen
          ></iframe>
        </div>
        
        <div class="video-meta-box">
          <div>
            <a href="{{ ('/' + (primaryVideo.data.category | categorySlug) + '/') | url }}" class="category-label">
              {{ primaryVideo.data.category }}
            </a>
          </div>
          <h3 class="video-caption-text">
            <a href="{{ primaryVideo.url | url }}" class="video-caption-link">{{ primaryVideo.data.title or primaryVideo.data.seoTitle or "Featured Story" }}</a>
          </h3>
          {% if primaryVideo.data.dek %}
            <p class="video-dek">
              {{ primaryVideo.data.dek }}
            </p>
          {% endif %}
          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: auto;">
            <a href="{{ primaryVideo.url | url }}" class="video-cta-link">
              Read full accompanying article →
            </a>
            <a href="https://www.youtube.com/watch?v={{ activeVideoId }}" target="_blank" rel="noopener noreferrer" class="video-direct-link">
              Watch on YouTube ↗
            </a>
          </div>
        </div>
      </div>
      {% else %}
      <div class="video-enhanced-grid">
        <div class="video-primary-column">
          <div class="video-player-wrap">
            <iframe 
              src="https://www.youtube.com/embed/{{ activeVideoId }}" 
              title="{{ primaryVideo.data.videoCaption or primaryVideo.data.video_caption or primaryVideo.data.title }}" 
              loading="lazy" 
              referrerpolicy="strict-origin-when-cross-origin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              allowfullscreen
            ></iframe>
          </div>
          <div class="video-primary-meta">
            <div>
              <a href="{{ ('/' + (primaryVideo.data.category | categorySlug) + '/') | url }}" class="category-label">
                {{ primaryVideo.data.category }}
              </a>
            </div>
            <h3 class="video-caption-text">
              <a href="{{ primaryVideo.url | url }}" class="video-caption-link">{{ primaryVideo.data.title or primaryVideo.data.seoTitle or "Featured Story" }}</a>
            </h3>
            {% if primaryVideo.data.dek %}
              <p class="video-dek">{{ primaryVideo.data.dek }}</p>
            {% endif %}
            <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: auto;">
              <a href="{{ primaryVideo.url | url }}" class="video-cta-link">
                Read full accompanying article →
              </a>
              <a href="https://www.youtube.com/watch?v={{ activeVideoId }}" target="_blank" rel="noopener noreferrer" class="video-direct-link">
                Watch on YouTube ↗
              </a>
            </div>
          </div>
        </div>

        <div class="video-supporting-column">
          <h4 class="video-supporting-heading">More Broadcast Coverage</h4>
          <div class="video-supporting-list">
            {% for sup in videoStories | skip(1) | limit(3) %}
              {% set supVid = sup.data.videoId or sup.data.video_id %}
              <article class="video-supporting-item">
                <a href="{{ sup.url | url }}" class="video-supporting-thumb-wrap" aria-label="{{ sup.data.title }}">
                  {% if sup.data.image %}
                    <img src="{{ sup.data.image | url }}" alt="{{ sup.data.imageAlt or sup.data.title }}" class="video-supporting-thumb" loading="lazy" width="120" height="75">
                  {% else %}
                    <div class="video-supporting-placeholder category-bg-{{ sup.data.category | lower }}">
                      <span>{{ sup.data.category }}</span>
                    </div>
                  {% endif %}
                  <span class="video-play-badge" aria-hidden="true">▶</span>
                </a>
                <div class="video-supporting-info">
                  <a href="{{ ('/' + (sup.data.category | categorySlug) + '/') | url }}" class="category-label">
                    {{ sup.data.category }}
                  </a>
                  <h5 class="video-supporting-title">
                    <a href="{{ sup.url | url }}">{{ sup.data.title }}</a>
                  </h5>
                  <div class="meta-row" style="font-size: 0.75rem; margin-top: auto;">
                    <time datetime="{{ sup.date | isoDate }}">{{ sup.date | timeAgo }}</time>
                    <span>•</span>
                    <a href="https://www.youtube.com/watch?v={{ supVid }}" target="_blank" rel="noopener noreferrer" class="video-yt-link">
                      Watch ↗
                    </a>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}
  {% endif %}
</div>
