---
layout: layouts/base.njk
---

<div class="container">
  {% set homepageArticles = collections.articles | homepageFeed %}
  {% set leadStory = homepageArticles[0] %}
  {% set wireStories = collections.articles | filterExcludedArticles([leadStory]) | limit(5) %}
  
  {# Build exclusion list for hero and wire stories to guarantee zero duplicate slugs #}
  {% set excludedStories = [leadStory] %}
  {% for item in wireStories %}
    {% set excludedStories = (excludedStories.push(item), excludedStories) %}
  {% endfor %}

  {# Primary 24h/48h prioritized feed #}
  {% set feedArticles = homepageArticles | filterExcludedArticles(excludedStories) %}

  {# If fewer than 6 items remain in prioritized window, supplement with next chronological articles #}
  {% if feedArticles.length < 6 %}
    {% set extraArticles = collections.articles | filterExcludedArticles(excludedStories) %}
    {% for extra in extraArticles %}
      {% if feedArticles.length < 24 %}
        {% set isAlreadyInFeed = false %}
        {% for existing in feedArticles %}
          {% if existing.url == extra.url or (existing.data.slug and existing.data.slug == extra.data.slug) %}
            {% set isAlreadyInFeed = true %}
          {% endif %}
        {% endfor %}
        {% if not isAlreadyInFeed %}
          {% set feedArticles = (feedArticles.push(extra), feedArticles) %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  <!-- 1. Newsroom Lead + Latest News Continuous Wire -->
  {% include "partials/hero.njk" %}

  {% if collections.articles.length > 0 %}
    <!-- 2. Zero-CLS Top Ad Slot -->
    {% set slotName = "homepage-top" %}
    {% include "partials/ad-slot.njk" %}

    <!-- 3. Unified Live News Feed (Continuous stream across all desks) -->
    {% if feedArticles.length > 0 %}
    <section class="editorial-category-section" aria-label="Unified Live News Feed">
      <div class="section-masthead">
        <div class="section-title-group">
          <h2 class="section-masthead-title">Live News Feed</h2>
          <span class="section-masthead-sub">Continuous dispatches across India, World, Business, Tech, and Sports</span>
        </div>
      </div>

      <div class="category-grid">
        {% for article in feedArticles %}
          {% include "partials/card.njk" %}
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 4. Mid-Page Ad Slot -->
    {% set slotName = "homepage-mid" %}
    {% include "partials/ad-slot.njk" %}

    <!-- 5. Video Journalism Section -->
    {% include "partials/video-journalism.njk" %}
  {% endif %}
</div>
