<section class="newsletter-strip" aria-label="Daily Briefing">
  <div class="container">
    <div class="newsletter-box">
      <div class="newsletter-text">
        <h3>The Daily Briefing</h3>
        <p>Verified reporting and explanatory briefings delivered every morning. Zero fluff.</p>
      </div>
      <form class="newsletter-form-inline" id="newsletter-form" action="#" method="post">
        <input 
          type="email" 
          class="newsletter-input-field" 
          placeholder="Enter your email address" 
          required 
          aria-label="Email address"
        >
        <button type="submit" class="newsletter-submit-btn">Subscribe</button>
      </form>
    </div>
  </div>
</section>
