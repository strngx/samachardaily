{% set vid = videoId or video_id %}
{% if vid and vid != "" and vid != "null" %}
<div class="video-block-wrapper" aria-label="Related Video Coverage">
  <div class="video-caption-label">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-brand, #C81E2C);">
      <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
    </svg>
    <span>Video: {{ videoCaption or video_caption or title }}</span>
  </div>
  <div class="video-embed-container">
    <iframe 
      src="https://www.youtube.com/embed/{{ vid }}" 
      title="{{ title | escape }}" 
      loading="lazy" 
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
      allowfullscreen
    ></iframe>
  </div>
</div>
{% endif %}
