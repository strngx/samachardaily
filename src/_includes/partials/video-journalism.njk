{% set videoStory = null %}
{% for art in collections.articles %}
  {% set currentVid = art.data.videoId or art.data.video_id %}
  {% if currentVid and currentVid != "" and currentVid != "null" and not videoStory %}
    {% set videoStory = art %}
  {% endif %}
{% endfor %}

{% if videoStory %}
{% set activeVideoId = videoStory.data.videoId or videoStory.data.video_id %}
<section class="video-journalism-section" aria-label="Watch The Story - Video Journalism">
  <div class="container">
    <div class="video-section-header">
      <h3 class="video-section-title">
        <span style="color: var(--color-brand);">Watch</span> The Story
      </h3>
      <span style="font-size: 0.8125rem; color: #9DA3AF; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Broadcast Coverage</span>
    </div>

    <div class="video-grid">
      <div class="video-player-wrap">
        <iframe 
          src="https://www.youtube.com/embed/{{ activeVideoId }}" 
          title="{{ videoStory.data.videoCaption or videoStory.data.video_caption or videoStory.data.title }}" 
          loading="lazy" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
        ></iframe>
      </div>
      
      <div class="video-meta-box">
        <div>
          <a href="{{ ('/' + (videoStory.data.category | categorySlug) + '/') | url }}" class="category-label">
            {{ videoStory.data.category }}
          </a>
        </div>
        <h4 class="video-caption-text">
          <a href="{{ videoStory.url | url }}" class="video-caption-link">{{ videoStory.data.videoCaption or videoStory.data.video_caption or videoStory.data.title }}</a>
        </h4>
        {% if videoStory.data.dek %}
          <p class="video-dek">
            {{ videoStory.data.dek }}
          </p>
        {% endif %}
        <a href="{{ videoStory.url | url }}" class="video-cta-link">
          Read full accompanying article →
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}
