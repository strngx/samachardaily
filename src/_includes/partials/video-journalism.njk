{# Select first qualifying video article not already used on the homepage #}
{% set videoStory = null %}
{% if collections.articles %}
  {% for art in collections.articles %}
    {% set currentVid = art.data.videoId or art.data.video_id %}
    {% if currentVid and currentVid != "" and currentVid != "null" and not art.data.noindex and not art.data.draft and not videoStory %}
      {% set isAlreadyUsed = false %}
      {% if usedHomepageStories %}
        {% for used in usedHomepageStories %}
          {% if used.url == art.url or (used.data.slug and art.data.slug and used.data.slug == art.data.slug) %}
            {% set isAlreadyUsed = true %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {% if not isAlreadyUsed %}
        {% set videoStory = art %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {# Fallback if all qualifying video stories were already used #}
  {% if not videoStory %}
    {% for art in collections.articles %}
      {% set currentVid = art.data.videoId or art.data.video_id %}
      {% if currentVid and currentVid != "" and currentVid != "null" and not videoStory %}
        {% set videoStory = art %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% if videoStory %}
{% set activeVideoId = videoStory.data.videoId or videoStory.data.video_id %}
<section class="video-journalism-section" aria-label="Watch The Story - Video Journalism">
  <div class="container">
    <div class="video-section-header">
      <h2 class="video-section-title">
        <span style="color: var(--color-brand);">Watch</span> The Story
      </h2>
      <span style="font-size: 0.8125rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Broadcast Coverage</span>
    </div>

    <div class="video-grid">
      <div class="video-player-wrap">
        <iframe 
          src="https://www.youtube.com/embed/{{ activeVideoId }}" 
          title="{{ videoStory.data.videoCaption or videoStory.data.video_caption or videoStory.data.title }}" 
          loading="lazy" 
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          allowfullscreen
        ></iframe>
      </div>
      
      <div class="video-meta-box">
        <div>
          <a href="{{ ('/' + (videoStory.data.category | categorySlug) + '/') | url }}" class="category-label">
            {{ videoStory.data.category }}
          </a>
        </div>
        <h3 class="video-caption-text">
          <a href="{{ videoStory.url | url }}" class="video-caption-link">{{ videoStory.data.title or videoStory.data.seoTitle or "Featured Story" }}</a>
        </h3>
        {% if videoStory.data.dek %}
          <p class="video-dek">
            {{ videoStory.data.dek }}
          </p>
        {% endif %}
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: auto;">
          <a href="{{ videoStory.url | url }}" class="video-cta-link">
            Read full accompanying article →
          </a>
          <a href="https://www.youtube.com/watch?v={{ activeVideoId }}" target="_blank" rel="noopener noreferrer" class="video-direct-link">
            Watch on YouTube ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}
