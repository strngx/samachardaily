{% if why_it_matters %}
<div class="why-matters-annotation" style="border-left-color: var(--cat-{{ category | categorySlug }}, var(--color-brand));">
  <div class="annotation-label" style="color: var(--cat-{{ category | categorySlug }}, var(--color-brand));">
    Why This Matters
  </div>
  {% set paragraphs = why_it_matters.split('\n\n') %}
  {% for para in paragraphs %}
    {% if para | trim %}
      <p class="annotation-text" {% if not loop.last %}style="margin-bottom: 0.85rem;"{% endif %}>
        {{ para | trim }}
      </p>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
