<!-- Top Utility Strip -->
<div class="top-utility-strip">
  <div class="utility-inner">
    <div class="utility-left">
      <span class="live-pulse" aria-hidden="true"></span>
      <span class="utility-badge">LIVE NEWSROOM</span>
    </div>
    <div class="utility-right">
      <span class="utility-edition">EDITION: <strong>INDIA & GLOBAL</strong></span>
      <span class="utility-divider">·</span>
      <span class="utility-date">{{ "now" | dateOnly }}</span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header" id="site-header">
  <div class="container header-main">
    <!-- Brand Logo -->
    <a href="{{ '/' | url }}" class="site-brand" aria-label="SamacharDaily Home">
      Samachar<span class="brand-red">Daily</span>
    </a>

    <!-- Desktop 5-Category Navigation (Monochrome, No "Desk" suffix) -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <a 
        href="{{ '/' | url }}" 
        class="nav-category-link {% if page.url == '/' | url or page.url == '/' %}is-active{% endif %}"
      >
        Home
      </a>
      {% for cat in site.categories %}
        <a 
          href="{{ ('/' + cat.slug + '/') | url }}" 
          class="nav-category-link {% if page.url == ('/' + cat.slug + '/') | url or page.url == '/' + cat.slug + '/' %}is-active{% endif %}"
        >
          {{ cat.name }}
        </a>
      {% endfor %}
    </nav>

    <!-- Header Controls -->
    <div class="header-controls">
      <button type="button" class="search-btn" id="search-toggle" aria-label="Search articles" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <button type="button" class="menu-toggle-btn" id="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Compact Search Drawer -->
  <div class="search-drawer" id="search-drawer">
    <div class="container">
      <form class="search-form-drawer" action="{{ '/search/' | url }}" method="get" role="search">
        <input 
          type="search" 
          name="q" 
          id="search-input" 
          class="search-drawer-input" 
          placeholder="Search published stories, topics, policies..." 
          required
        >
        <button type="submit" class="search-drawer-submit">Search</button>
      </form>
    </div>
  </div>
</header>

<!-- Simplified Mobile Navigation Sheet (5 Public Categories Only) -->
<div class="mobile-nav-sheet" id="mobile-nav-sheet" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  <div class="mobile-nav-panel">
    <div class="mobile-nav-top">
      <a href="{{ '/' | url }}" class="site-brand">
        Samachar<span class="brand-red">Daily</span>
      </a>
      <button type="button" class="menu-toggle-btn close-btn" id="close-mobile-nav" aria-label="Close navigation">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="mobile-nav-divider"></div>

    <!-- Five Locked Categories Only (Monochrome, No "Desk" suffix) -->
    <nav class="mobile-nav-links" aria-label="Mobile Sections">
      <a href="{{ '/' | url }}" class="mobile-nav-item">
        Home
      </a>
      {% for cat in site.categories %}
        <a href="{{ ('/' + cat.slug + '/') | url }}" class="mobile-nav-item">
          {{ cat.name }}
        </a>
      {% endfor %}
    </nav>
  </div>
</div>
