{% if what_happens_next and what_happens_next != "No confirmed next steps reported yet." %}
<aside class="key-takeaways-box" aria-label="Key Takeaways Summary">
  <div class="takeaways-header">
    <svg class="takeaways-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 11 12 14 22 4"/>
      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
    </svg>
    <span class="takeaways-title">Key Takeaways &amp; Next Steps</span>
  </div>
  <ul class="takeaways-list">
    <li class="takeaways-item">
      <strong class="takeaways-lead">Next Phase:</strong> {{ what_happens_next }}
    </li>
  </ul>
</aside>
{% endif %}
