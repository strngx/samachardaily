<aside class="article-corrections-info" aria-label="Corrections and Reader Accountability">
  <div class="corrections-info-inner">
    <div class="corrections-info-header">
      <svg class="corrections-info-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="10" r="8"/>
        <line x1="12" y1="6" x2="12" y2="10"/>
        <line x1="12" y1="14" x2="12.01" y2="14"/>
      </svg>
      <span>Corrections &amp; Editorial Accountability</span>
    </div>
    <p class="corrections-info-text">
      SamacharDaily is committed to journalistic accuracy. If you identify a factual error, unverified figure, or outdated statement in this dispatch, please review our <a href="{{ '/editorial/#corrections-policy' | url }}">Corrections Policy</a> and follow the <a href="{{ '/contact/#how-to-submit-a-factual-correction' | url }}">submission guide</a>{% if site.author.email %} to contact our desk directly at <a href="mailto:{{ site.author.email }}">{{ site.author.email }}</a>{% endif %}.
    </p>
  </div>
</aside>
