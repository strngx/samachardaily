{% set articleImg = image or (site.url + '/assets/images/default-hero.jpg') %}
{% if image and not ('http://' in image or 'https://' in image) %}
  {% set articleImg = site.url + image %}
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "headline": {{ (seoTitle or title or "SamacharDaily News") | json | safe }},
  "description": {{ (dek or description or title or site.description or "") | json | safe }},
  "image": [
    "{{ articleImg }}"
  ],
  "datePublished": "{{ (date or page.date) | isoDate }}",
  "dateModified": "{{ (modifiedDate or dateModified or date or page.date) | isoDate }}",
  "author": {
    "@type": "Organization",
    "name": "{{ author or site.author.name or 'SamacharDaily Editorial Team' }}",
    "url": "{{ site.author.url or (site.url + '/about/') }}"
  },
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "{{ site.publisher.name or site.name or 'SamacharDaily' }}",
    "url": "{{ site.url }}/",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.publisher.logo or (site.url + '/assets/images/logo.svg') }}"
    }
  },
  "articleSection": "{{ category or 'News' }}",
  "inLanguage": "{{ site.language or 'en-IN' }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ (category or "News") | json | safe }},
      "item": "{{ site.url }}/{{ (category or 'india') | categorySlug }}/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ (title or "Article") | json | safe }},
      "item": "{{ site.url }}{{ page.url }}"
    }
  ]
}
</script>
{% set vid = videoId or video_id %}
{% if enable_video_object and vid and vid != "" and vid != "null" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ (video_title or videoCaption or video_caption or title) | json | safe }},
  "description": {{ (video_description or videoCaption or video_caption or dek or title) | json | safe }},
  "thumbnailUrl": [
    "https://i.ytimg.com/vi/{{ vid }}/hqdefault.jpg"
  ],
  "uploadDate": "{{ (date or page.date) | isoDate }}",
  "embedUrl": "https://www.youtube.com/embed/{{ vid }}"
}
</script>
{% endif %}
