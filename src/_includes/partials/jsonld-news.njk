{% set articleImg = image or (site.url + '/assets/images/default-hero.jpg') %}
{% if image and not ('http://' in image or 'https://' in image) %}
  {% set articleImg = site.url + image %}
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  },
  "headline": {{ (seoTitle or title or "SamacharDaily News") | json | safe }},
  "description": {{ (dek or description or title or site.description or "") | json | safe }},
  "image": [
    "{{ articleImg }}"
  ],
  "datePublished": "{{ (date or page.date) | isoDate }}",
  "dateModified": "{{ (modifiedDate or dateModified or date or page.date) | isoDate }}",
  {% set articleCorrection = correction or correction_notice or corrections %}
  {% if articleCorrection %}
  "correction": {{ articleCorrection | json | safe }},
  {% endif %}
  {% set rawAuthor = (author or site.author.name or "") | trim %}
  {% if rawAuthor == "Arjun Khatri" %}
  "author": {
    "@type": "Person",
    "@id": "{{ site.url }}/#arjun-khatri",
    "name": "Arjun Khatri",
    "url": "{{ site.url }}/authors/samachardaily-editorial-team/"
  },
  {% else %}
  "author": {
    "@type": "Organization",
    "@id": "{{ site.url }}/authors/samachardaily-editorial-team/#organization",
    "name": "Samachar Daily",
    "url": "{{ site.url }}/authors/samachardaily-editorial-team/"
  },
  {% endif %}
  "publisher": {
    "@type": "NewsMediaOrganization",
    "@id": "{{ site.url }}/#organization",
    "name": "{{ site.publisher.name or site.name or 'SamacharDaily' }}",
    "url": "{{ site.url }}/",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.publisher.logo or (site.url + '/assets/images/logo.svg') }}"
    },
    "founder": {
      "@type": "Person",
      "name": "Arjun Khatri"
    },
    "publishingPrinciples": "{{ site.url }}/editorial/",
    "correctionsPolicy": "{{ site.url }}/editorial/#corrections-policy"
  },
  "articleSection": "{{ category or 'News' }}",
  "inLanguage": "{{ site.language or 'en-IN' }}"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.url }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ (category or "News") | json | safe }},
      "item": "{{ site.url }}/{{ (category or 'india') | categorySlug }}/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ (title or "Article") | json | safe }},
      "item": "{{ site.url }}{{ page.url }}"
    }
  ]
}
</script>
{% set vid = "" %}
{% if video_id and video_id != "" and video_id != "null" and video_id != "undefined" %}
  {% set vid = video_id | trim %}
{% elif videos and videos.length and videos[0].video_id %}
  {% set vid = videos[0].video_id | trim %}
{% elif videoId and videoId != "" and videoId != "null" and videoId != "undefined" %}
  {% set vid = videoId | trim %}
{% endif %}
{% if vid and vid != "" and vid != "null" and vid != "undefined" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ (video_title or videoCaption or video_caption or title) | json | safe }},
  "description": {{ (video_description or videoCaption or video_caption or dek or title) | json | safe }},
  "thumbnailUrl": [
    "https://i.ytimg.com/vi/{{ vid }}/hqdefault.jpg"
  ],
  "uploadDate": "{{ (date or page.date) | isoDate }}",
  "embedUrl": "https://www.youtube.com/embed/{{ vid }}"
}
</script>
{% endif %}
