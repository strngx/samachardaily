{% set leadStory = collections.articles[0] %}
{% set wireStories = collections.articles | skip(1) | limit(5) %}

{% if leadStory %}
<!-- Breaking News Ticker (Rendered ONLY if genuine breaking content exists) -->
{% set breakingStory = null %}
{% for art in collections.articles %}
  {% if art.data.breaking and not breakingStory %}
    {% set breakingStory = art %}
  {% endif %}
{% endfor %}

{% if breakingStory %}
<div class="breaking-banner" role="alert" aria-label="Breaking News">
  <span class="breaking-badge">BREAKING</span>
  <a href="{{ breakingStory.url }}" class="breaking-title">{{ breakingStory.data.title }}</a>
  <span class="breaking-time">{{ breakingStory.date | timeAgo }}</span>
</div>
{% endif %}

<!-- Newsroom Hero: Dominant Lead + Chronological Latest Stream -->
<section class="newsroom-hero" aria-label="Top Story & Latest Dispatches">
  <!-- Primary Lead Story -->
  <article class="lead-story-card">
    {% if leadStory.data.image %}
      <a href="{{ leadStory.url }}" class="lead-media-wrap" aria-label="{{ leadStory.data.title }}">
        <img 
          src="{{ leadStory.data.image }}" 
          alt="{{ leadStory.data.title }}" 
          class="lead-img" 
          fetchpriority="high"
          width="740" 
          height="416"
        >
      </a>
    {% endif %}
    <div>
      <a href="/{{ leadStory.data.category | categorySlug }}/" class="category-label">
        {{ leadStory.data.category }}
      </a>
    </div>
    <h2 class="lead-headline">
      <a href="{{ leadStory.url }}">{{ leadStory.data.title }}</a>
    </h2>
    {% if leadStory.data.dek %}
      <p class="lead-dek">{{ leadStory.data.dek }}</p>
    {% endif %}
    <div class="meta-row">
      <span>By {{ leadStory.data.author or site.author.name }}</span>
      <span>•</span>
      <time datetime="{{ leadStory.date | isoDate }}">{{ leadStory.date | timeAgo }}</time>
      <span>•</span>
      <span>{{ leadStory.templateContent | readTime }}</span>
    </div>
  </article>

  <!-- Chronological Latest News Stream -->
  <aside class="latest-wire-module" aria-label="Latest News Stream">
    <div class="module-header">
      <h3 class="module-title">
        <span class="live-dot" aria-hidden="true"></span>
        Latest News
      </h3>
      <span class="module-status">Continuous Wire</span>
    </div>

    <div class="wire-stream-list">
      {% for item in wireStories %}
        <article class="wire-item">
          <div class="wire-meta">
            <time class="wire-time" datetime="{{ item.date | isoDate }}">{{ item.date | readableDate("hh:mm a") }}</time>
            <span class="wire-divider">|</span>
            <a href="/{{ item.data.category | categorySlug }}/" class="category-label">
              {{ item.data.category }}
            </a>
          </div>
          <h4 class="wire-headline">
            <a href="{{ item.url }}">{{ item.data.title }}</a>
          </h4>
        </article>
      {% endfor %}
    </div>
  </aside>
</section>
{% else %}
<!-- Subtle Compact Newsroom Empty State -->
<section class="empty-newsroom-state" aria-label="Newsroom Status">
  <div class="empty-newsroom-box">
    <div class="empty-badge">SAMACHARDAILY · TODAY'S EDITION</div>
    <h2 class="empty-title">Today's edition is being prepared.</h2>
    <p class="empty-desc">
      Verified reporting and explanatory journalism from India, World, Business, Tech, and Sports will appear here once published.
    </p>
  </div>
</section>
{% endif %}
