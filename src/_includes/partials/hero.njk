{% set heroStories = heroStories or (collections.articles | heroCarouselFeed(5)) %}
{% set leadStory = heroStories[0] or (collections.articles | homepageFeed | first) or collections.articles[0] %}
{% set wireStories = wireStories or (collections.articles | filterExcludedArticles(heroStories) | limit(5)) %}

{% if leadStory %}
<!-- Breaking News Ticker (Rendered ONLY if genuine breaking content exists) -->
{% set breakingStory = null %}
{% for art in collections.articles %}
  {% if art.data.breaking and not breakingStory %}
    {% set breakingStory = art %}
  {% endif %}
{% endfor %}

{% if breakingStory %}
<div class="breaking-banner" role="alert" aria-label="Breaking News">
  <span class="breaking-badge">BREAKING</span>
  <a href="{{ breakingStory.url | url }}" class="breaking-title">{{ breakingStory.data.title }}</a>
  <span class="breaking-time">{{ breakingStory.date | timeAgo }}</span>
</div>
{% endif %}

<!-- Newsroom Hero: Dynamic Featured Carousel + Chronological Latest Stream -->
<section class="newsroom-hero" aria-label="Top Stories & Latest Dispatches">
  <!-- Dynamic Featured News Carousel -->
  <div class="hero-carousel" id="hero-carousel" role="region" aria-roledescription="carousel" aria-label="Featured News Carousel" tabindex="0">
    <div class="hero-carousel-track-wrap">
      <div class="hero-carousel-track" id="hero-carousel-track">
        {% for slide in heroStories %}
          <article class="hero-slide {% if loop.first %}is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ heroStories.length }}" data-slide-index="{{ loop.index0 }}">
            <!-- Media -->
            {% if slide.data.image %}
              <a href="{{ slide.url | url }}" class="lead-media-wrap" aria-label="{{ slide.data.title }}">
                <img 
                  src="{{ slide.data.image | url }}" 
                  alt="{{ slide.data.imageAlt or slide.data.image_alt or slide.data.title }}" 
                  class="lead-img" 
                  loading="{% if loop.first %}eager{% else %}lazy{% endif %}"
                  {% if loop.first %}fetchpriority="high"{% endif %}
                  decoding="async"
                  width="740" 
                  height="416"
                >
                {% if (slide.date | isJustIn) %}
                  <span class="badge-just-in">JUST IN</span>
                {% endif %}
              </a>
            {% else %}
              <a href="{{ slide.url | url }}" class="lead-media-wrap card-thumb-placeholder category-bg-{{ slide.data.category | lower }}" aria-label="{{ slide.data.title }}">
                <div class="placeholder-inner">
                  <span class="placeholder-brand">Samachar<span class="brand-red">Daily</span></span>
                  <span class="placeholder-category">{{ slide.data.category }}</span>
                </div>
                {% if (slide.date | isJustIn) %}
                  <span class="badge-just-in">JUST IN</span>
                {% endif %}
              </a>
            {% endif %}

            <!-- Editorial Status & Category Hierarchy -->
            <div class="hero-status-row">
              {% if loop.first %}
                <span class="hero-editorial-badge badge-top-story">TOP STORY</span>
              {% endif %}
              {% if (slide.date | isJustIn) %}
                <span class="hero-editorial-badge badge-live"><span class="live-pulse" aria-hidden="true"></span>LIVE</span>
              {% elif slide.data.trending %}
                <span class="hero-editorial-badge badge-trending">TRENDING</span>
              {% endif %}
              <a href="{{ ('/' + (slide.data.category | categorySlug) + '/') | url }}" class="category-label hero-category-label">
                {{ slide.data.category }}
              </a>
            </div>

            <!-- Headline with Responsive Display Protection -->
            <h2 class="lead-headline hero-carousel-headline">
              <a href="{{ slide.url | url }}" title="{{ slide.data.title }}">{{ slide.data.title }}</a>
            </h2>

            <!-- Dek -->
            {% if slide.data.dek %}
              <p class="lead-dek hero-carousel-dek">{{ slide.data.dek }}</p>
            {% endif %}

            <!-- Meta Row -->
            <div class="meta-row hero-meta-row">
              {% set authorName = slide.data.author or site.author.name %}
              {% if authorName == "SamacharDaily Editorial Team" or authorName == "Samachar Daily" or not slide.data.author %}
                <span>By <a href="{{ '/authors/samachardaily-editorial-team/' | url }}">Samachar Daily</a></span>
              {% else %}
                <span>By {{ authorName }}</span>
              {% endif %}
              {% if slide.data.sourceName %}
                <span>•</span>
                <span class="hero-source">{{ slide.data.sourceName }}</span>
              {% endif %}
              <span>•</span>
              <time datetime="{{ slide.date | isoDate }}">{{ slide.date | timeAgo }}</time>
              <span>•</span>
              <span>{{ slide.templateContent | readTime }}</span>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>

    <!-- Carousel Navigation Arrows (Overlaying the image area) -->
    <button type="button" class="carousel-nav-btn prev-btn hero-carousel-prev" id="hero-prev-btn" aria-label="Previous story">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </button>
    <button type="button" class="carousel-nav-btn next-btn hero-carousel-next" id="hero-next-btn" aria-label="Next story">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>

    <!-- Slide Indicators / Dots below content -->
    <div class="carousel-indicators" role="tablist" aria-label="Choose story to display">
      {% for slide in heroStories %}
        <button 
          type="button" 
          role="tab" 
          class="carousel-dot {% if loop.first %}is-active{% endif %}" 
          aria-selected="{% if loop.first %}true{% else %}false{% endif %}" 
          aria-label="Story {{ loop.index }}: {{ slide.data.title | truncate(35) }}"
          data-index="{{ loop.index0 }}"
        >
          <span class="visually-hidden">Story {{ loop.index }}</span>
        </button>
      {% endfor %}
    </div>
  </div>

  <!-- Chronological Latest News Stream -->
  <aside class="latest-wire-module" aria-label="Latest News Stream">
    <div class="module-header">
      <h2 class="module-title">
        <span class="live-dot" aria-hidden="true"></span>
        Latest News
      </h2>
      <span class="module-status">Continuous Wire</span>
    </div>

    <div class="wire-stream-list">
      {% for item in wireStories %}
        <article class="wire-item">
          <div class="wire-content">
            <div class="wire-meta">
              <time class="wire-time" datetime="{{ item.date | isoDate }}">{{ item.date | readableDate("hh:mm a") }}</time>
              <span class="wire-divider">|</span>
              <a href="{{ ('/' + (item.data.category | categorySlug) + '/') | url }}" class="category-label">
                {{ item.data.category }}
              </a>
            </div>
            <h3 class="wire-headline">
              <a href="{{ item.url | url }}">{{ item.data.title }}</a>
            </h3>
          </div>
          {% if item.data.image %}
            <a href="{{ item.url | url }}" class="wire-thumb-wrap" aria-label="{{ item.data.title }}">
              <img 
                src="{{ item.data.image | url }}" 
                alt="{{ item.data.imageAlt or item.data.image_alt or item.data.title }}" 
                class="wire-thumb" 
                loading="lazy" 
                width="96" 
                height="64"
              >
              {% if (item.date | isJustIn) %}
                <span class="badge-just-in badge-just-in-sm">JUST IN</span>
              {% endif %}
            </a>
          {% else %}
            <a href="{{ item.url | url }}" class="wire-thumb-wrap card-thumb-placeholder category-bg-{{ item.data.category | lower }}" aria-label="{{ item.data.title }}">
              <div class="placeholder-inner-sm">
                <span>{{ item.data.category }}</span>
              </div>
              {% if (item.date | isJustIn) %}
                <span class="badge-just-in badge-just-in-sm">JUST IN</span>
              {% endif %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </aside>
</section>
{% else %}
<!-- Subtle Compact Empty State -->
<section class="empty-newsroom-state" aria-label="Publication Status">
  <div class="empty-newsroom-box">
    <div class="empty-badge">SAMACHARDAILY · TODAY'S EDITION</div>
    <h1 class="empty-title">{{ title or "Today's edition is being prepared." }}</h1>
    <p class="empty-desc">
      Verified reporting and explanatory journalism from India, World, Business, Tech, and Sports will appear here once published.
    </p>
  </div>
</section>
{% endif %}
