<article class="editorial-card cat-{{ article.data.category | lower }}" data-category="{{ article.data.category | lower }}">
  {% if article.data.image %}
    <a href="{{ article.url | url }}" class="card-thumb" aria-label="{{ article.data.title }}">
      <img 
        src="{{ article.data.image | url }}" 
        alt="{{ article.data.imageAlt or article.data.image_alt or article.data.title }}" 
        loading="lazy" 
        width="400" 
        height="225"
      >
      {% if (article.date | isJustIn(article.data.featured)) %}
        <span class="badge-just-in">JUST IN</span>
      {% endif %}
    </a>
  {% else %}
    <a href="{{ article.url | url }}" class="card-thumb card-thumb-placeholder category-bg-{{ article.data.category | lower }}" aria-label="{{ article.data.title }}">
      <div class="placeholder-inner">
        <span class="placeholder-brand">Samachar<span class="brand-red">Daily</span></span>
        <span class="placeholder-category">{{ article.data.category }}</span>
      </div>
      {% if (article.date | isJustIn(article.data.featured)) %}
        <span class="badge-just-in">JUST IN</span>
      {% endif %}
    </a>
  {% endif %}
  <div class="card-cat-wrap">
    <a href="{{ ('/' + (article.data.category | categorySlug) + '/') | url }}" class="category-label">
      {{ article.data.category }}
    </a>
  </div>
  <h3 class="card-title">
    <a href="{{ article.url | url }}">{{ article.data.title }}</a>
  </h3>
  {% if article.data.dek %}
    <p class="card-snippet">{{ article.data.dek }}</p>
  {% endif %}
  <div class="meta-row" style="margin-top: auto; font-size: 0.75rem;">
    <time datetime="{{ article.date | isoDate }}">{{ article.date | timeAgo }}</time>
    <span>•</span>
    <span>{{ article.templateContent | readTime }}</span>
  </div>
</article>
