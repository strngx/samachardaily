{% set heroStory = collections.articles[0] %}
{% set explainerStory = null %}

{% if heroStory %}
  {# Look for a distinct India article first #}
  {% for art in collections.articles %}
    {% if not explainerStory and art.url != heroStory.url and (art.data.category | lower) == "india" %}
      {% set explainerStory = art %}
    {% endif %}
  {% endfor %}

  {# Fallback to any distinct article from other categories #}
  {% if not explainerStory %}
    {% for art in collections.articles %}
      {% if not explainerStory and art.url != heroStory.url %}
        {% set explainerStory = art %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

{% if explainerStory %}
<section class="explainer-feature" aria-label="Why This Matters Feature">
  <div class="explainer-header">
    <span class="explainer-badge">WHY THIS MATTERS</span>
    <span class="explainer-subtitle">Key Editorial Breakdown</span>
  </div>
  <div class="explainer-grid">
    <div class="explainer-left">
      {% if explainerStory.data.image %}
        <a href="{{ explainerStory.url | url }}" class="explainer-img-wrap" aria-label="{{ explainerStory.data.title }}">
          <img src="{{ explainerStory.data.image | url }}" alt="{{ explainerStory.data.imageAlt or explainerStory.data.title }}" class="explainer-image" loading="lazy" width="400" height="225">
        </a>
      {% endif %}
      <h3 class="explainer-title">
        <a href="{{ explainerStory.url | url }}">{{ explainerStory.data.title }}</a>
      </h3>
      {% if explainerStory.data.dek %}
        <p class="explainer-dek">
          {{ explainerStory.data.dek }}
        </p>
      {% endif %}
      <a href="{{ explainerStory.url | url }}" class="explainer-cta">
        Read Full Story →
      </a>
    </div>

    <div class="explainer-points">
      <div class="explainer-point-item">
        <span class="point-number">01</span>
        <div>
          <span class="point-title">WHAT CHANGED</span>
          <p class="point-text">{{ explainerStory.data.dek or explainerStory.data.title }}</p>
        </div>
      </div>
      <div class="explainer-point-item">
        <span class="point-number">02</span>
        <div>
          <span class="point-title">WHY IT MATTERS</span>
          <p class="point-text">{{ (explainerStory.data.why_it_matters or "Strategic shifts impact policy, infrastructure, and institutional roadmaps across key sectors.") | truncateWords(30) }}</p>
        </div>
      </div>
      <div class="explainer-point-item">
        <span class="point-number">03</span>
        <div>
          <span class="point-title">WHAT HAPPENS NEXT</span>
          <p class="point-text">Implementation phases, stakeholder reviews, and regulatory milestones scheduled across upcoming operational cycles.</p>
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}
