permalink: /admin/index.html
eleventyExcludeFromCollections: true
noindex: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editorial Control Center Login — Samachar Daily</title>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-brand: #881337;
      --color-brand-hover: #9f1239;
      --color-brand-subtle: #fff1f2;
      --color-brand-border: #fecdd3;

      --color-bg: #f6f7f9;
      --color-surface: #ffffff;
      --color-surface-sub: #f8fafc;
      --color-border: #e4e7ec;
      --color-border-focus: #881337;

      --color-text-primary: #17202a;
      --color-text-secondary: #475467;
      --color-text-muted: #667085;
      --color-text-subtle: #98a2b3;

      --color-success-bg: #ecfdf5;
      --color-success-border: #a7f3d0;
      --color-success-text: #065f46;

      --color-danger-bg: #fef2f2;
      --color-danger-border: #fecaca;
      --color-danger-text: #991b1b;

      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

      --radius-sm: 6px;
      --radius-md: 8px;
      --radius-lg: 12px;

      --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.05);
      --shadow-md: 0 4px 12px -2px rgba(16, 24, 40, 0.08);
      --shadow-lg: 0 12px 32px -4px rgba(16, 24, 40, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      min-height: 100%;
      background-color: var(--color-bg);
      color: var(--color-text-primary);
      font-family: var(--font-sans);
      line-height: 1.5;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* Top Institutional Bar */
    .gov-topbar {
      width: 100%;
      background: #ffffff;
      border-bottom: 1px solid var(--color-border);
      padding: 12px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: var(--color-text-muted);
    }

    .gov-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-brand);
      text-decoration: none;
    }

    .gov-brand img {
      width: 24px;
      height: 24px;
      border-radius: 4px;
    }

    .gov-security-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 9999px;
      background: var(--color-surface-sub);
      border: 1px solid var(--color-border);
      font-size: 11px;
      font-weight: 500;
      color: var(--color-text-secondary);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: #10b981;
    }

    /* Main Workspace Split Layout */
    .workspace-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 48px 24px;
      max-width: 1180px;
      width: 100%;
      margin: 0 auto;
      gap: 64px;
    }

    /* Left Editorial Column */
    .editorial-col {
      flex: 1;
      max-width: 500px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .masthead-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-brand);
      background: var(--color-brand-subtle);
      border: 1px solid var(--color-brand-border);
      padding: 4px 10px;
      border-radius: 4px;
      width: fit-content;
    }

    .masthead-headline {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--color-text-primary);
      line-height: 1.25;
    }

    .masthead-sub {
      font-size: 15px;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .pillars-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 8px;
    }

    .pillar-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 12px 14px;
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
    }

    .pillar-icon {
      color: var(--color-brand);
      font-size: 16px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .pillar-text h3 {
      font-size: 13px;
      font-weight: 600;
      color: var(--color-text-primary);
      margin-bottom: 2px;
    }

    .pillar-text p {
      font-size: 12px;
      color: var(--color-text-muted);
      line-height: 1.4;
    }

    /* Right Login Card Column */
    .card-col {
      width: 100%;
      max-width: 440px;
      flex-shrink: 0;
    }

    .login-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 36px 32px;
    }

    .card-header-block {
      margin-bottom: 24px;
    }

    .card-header-block h2 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text-primary);
      margin-bottom: 6px;
    }

    .card-header-block p {
      font-size: 13px;
      color: var(--color-text-muted);
    }

    /* Alert / Error Box */
    .alert-box {
      display: none;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      margin-bottom: 20px;
      line-height: 1.45;
    }

    .alert-box.alert-error {
      display: block;
      background-color: var(--color-danger-bg);
      border: 1px solid var(--color-danger-border);
      color: var(--color-danger-text);
    }

    .alert-box.alert-success {
      display: block;
      background-color: var(--color-success-bg);
      border: 1px solid var(--color-success-border);
      color: var(--color-success-text);
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--color-text-secondary);
      margin-bottom: 6px;
    }

    .input-shell {
      position: relative;
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .input-shell:focus-within {
      border-color: var(--color-border-focus);
      box-shadow: 0 0 0 3px rgba(136, 19, 55, 0.12);
    }

    .form-input {
      width: 100%;
      height: 42px;
      padding: 0 12px;
      background: transparent;
      border: none;
      outline: none;
      font-family: var(--font-sans);
      font-size: 14px;
      color: var(--color-text-primary);
    }

    .form-input::placeholder {
      color: var(--color-text-subtle);
    }

    .password-toggle-btn {
      background: transparent;
      border: none;
      color: var(--color-text-muted);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      padding: 0 12px;
      height: 100%;
      user-select: none;
    }

    .password-toggle-btn:hover {
      color: var(--color-text-primary);
    }

    .btn-submit {
      width: 100%;
      height: 44px;
      background: var(--color-brand);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-sm);
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.01em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background-color 0.15s ease, box-shadow 0.15s ease;
      margin-top: 24px;
      box-shadow: var(--shadow-sm);
    }

    .btn-submit:hover:not(:disabled) {
      background: var(--color-brand-hover);
      box-shadow: var(--shadow-md);
    }

    .btn-submit:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .card-footer-meta {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: var(--color-text-subtle);
    }

    /* Page Footer */
    .site-footer {
      border-top: 1px solid var(--color-border);
      background: #ffffff;
      padding: 16px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: var(--color-text-subtle);
    }

    @media (max-width: 900px) {
      .workspace-wrapper {
        flex-direction: column;
        padding: 32px 16px;
        gap: 36px;
      }

      .editorial-col {
        max-width: 100%;
        text-align: center;
        align-items: center;
      }

      .masthead-headline {
        font-size: 24px;
      }

      .card-col {
        max-width: 100%;
      }

      .gov-topbar {
        padding: 12px 16px;
      }

      .site-footer {
        padding: 16px;
        flex-direction: column;
        gap: 8px;
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <!-- Header Bar -->
  <header class="gov-topbar" role="banner">
    <a href="/" class="gov-brand" title="SamacharDaily Home">
      <img src="/apple-touch-icon.png" alt="SamacharDaily Logo" width="24" height="24">
      <span>SAMACHARDAILY</span>
    </a>
    <div class="gov-security-pill">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Enterprise Editorial Gate &bull; TLS 1.3</span>
    </div>
  </header>

  <!-- Workspace Container -->
  <main class="workspace-wrapper" role="main">
    <!-- Left Column: Editorial Statement & Principles -->
    <section class="editorial-col" aria-label="Editorial Platform Overview">
      <div class="masthead-tag">Precision Journalism Desk</div>
      <h1 class="masthead-headline">Professional Editorial Operations &amp; Governance Center</h1>
      <p class="masthead-sub">
        Centralized newsroom command platform for live coverage, statutory editorial safety verification, content rehabilitation, and Google Search Console performance diagnostics.
      </p>

      <div class="pillars-grid">
        <div class="pillar-item">
          <div class="pillar-icon">&#10003;</div>
          <div class="pillar-text">
            <h3>Verified Wire Attribution</h3>
            <p>100% source corroboration requirement across PTI, ANI, and primary official reports.</p>
          </div>
        </div>

        <div class="pillar-item">
          <div class="pillar-icon">&#9881;</div>
          <div class="pillar-text">
            <h3>Statutory Safety Governance</h3>
            <p>Multi-tier review gates for sensitive dispatches covering legal, defense, and civic developments.</p>
          </div>
        </div>

        <div class="pillar-item">
          <div class="pillar-icon">&#9776;</div>
          <div class="pillar-text">
            <h3>Real-Time GSC Indexing Diagnostics</h3>
            <p>Direct read-only integration with official Search Console and Sitemaps APIs.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Right Column: Login Card -->
    <section class="card-col" aria-label="Sign In Area">
      <div class="login-card">
        <div class="card-header-block">
          <h2>Editorial Sign In</h2>
          <p>Enter your credentials to access the editorial control center.</p>
        </div>

        <div id="login-alert" class="alert-box" role="alert" aria-live="polite"></div>

        <form id="admin-login-form" onsubmit="handleLoginSubmit(event)">
          <div class="form-group">
            <label class="form-label" for="username">Username or Email</label>
            <div class="input-shell">
              <input
                type="text"
                id="username"
                name="username"
                class="form-input"
                value="admin"
                required
                autocomplete="username"
                autofocus
                placeholder="e.g. admin"
                spellcheck="false"
              >
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="password">Password</label>
            <div class="input-shell">
              <input
                type="password"
                id="password"
                name="password"
                class="form-input password-input"
                required
                autocomplete="current-password"
                placeholder="Enter password"
              >
              <button
                type="button"
                id="password-toggle-btn"
                class="password-toggle-btn"
                onclick="togglePasswordVisibility()"
                aria-label="Toggle password visibility"
              >Show</button>
            </div>
          </div>

          <button type="submit" id="submit-btn" class="btn-submit">
            <span id="submit-text">Sign In to Control Center</span>
          </button>
        </form>

        <div class="card-footer-meta">
          <span>Protected by Cloudflare Edge Guard</span>
          <span>Single-Sign-On Verified</span>
        </div>
      </div>
    </section>
  </main>

  <!-- Technical Footer -->
  <footer class="site-footer" role="contentinfo">
    <span>© SamacharDaily. All rights reserved.</span>
    <span>Private Editorial Operations Infrastructure</span>
  </footer>

  <script>
    // 1. Check if user already has an active authenticated session
    async function checkExistingSession() {
      try {
        const res = await fetch('/api/admin/session');
        if (res.ok) {
          const data = await res.json();
          if (data && data.authenticated) {
            window.location.replace('/admin/editorial/');
          }
        }
      } catch (e) {
        // Dev server or network offline; stay on login page
      }
    }
    checkExistingSession();

    function togglePasswordVisibility() {
      const input = document.getElementById('password');
      const btn = document.getElementById('password-toggle-btn');
      if (input.type === 'password') {
        input.type = 'text';
        btn.innerText = 'Hide';
        btn.setAttribute('aria-label', 'Hide password');
      } else {
        input.type = 'password';
        btn.innerText = 'Show';
        btn.setAttribute('aria-label', 'Show password');
      }
    }

    function showAlert(msg, isError = true) {
      const alert = document.getElementById('login-alert');
      alert.className = isError ? 'alert-box alert-error' : 'alert-box alert-success';
      alert.innerText = msg;
    }

    function clearAlert() {
      const alert = document.getElementById('login-alert');
      alert.className = 'alert-box';
      alert.innerText = '';
    }

    async function handleLoginSubmit(event) {
      event.preventDefault();
      clearAlert();

      const usernameInput = document.getElementById('username');
      const passwordInput = document.getElementById('password');
      const submitBtn = document.getElementById('submit-btn');
      const submitText = document.getElementById('submit-text');

      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      if (!username || !password) {
        showAlert('Please enter both username and password.');
        return;
      }

      submitBtn.disabled = true;
      submitText.innerText = 'Authenticating...';

      try {
        const response = await fetch('/api/admin/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({ username, password })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          showAlert('Authentication successful. Redirecting...', false);
          setTimeout(() => {
            window.location.replace('/admin/editorial/');
          }, 300);
        } else {
          submitBtn.disabled = false;
          submitText.innerText = 'Sign In to Control Center';
          showAlert(result.error || 'Invalid administrator credentials.');
          passwordInput.value = '';
          passwordInput.focus();
        }
      } catch (err) {
        submitBtn.disabled = false;
        submitText.innerText = 'Sign In to Control Center';
        showAlert('Network or server error. Please ensure the local admin server is running.');
      }
    }
  </script>
</body>
</html>
