    function renderIndexingProblemsTable() {
      const tbody = document.getElementById('indexing-problems-body');
      if (!tbody) return;

      const filter = AppState.indexingFilter || 'all';
      
      // Known indexing exclusions & special directives from corpus
      const problems = [];
      (AppState.articles || []).forEach(art => {
        if (art.articleType === 'redirect') {
          problems.push({
            url: 'https://thesamachardaily.in' + (art.url || ''),
            slug: art.slug || art.relPath,
            status: 'Redirect',
            badgeClass: 'badge-teal',
            reason: '301 Moved Permanently / Canonical Redirect Stub',
            source: 'SamacharDaily Build',
            type: 'redirect'
          });
        } else if (art.noindex) {
          problems.push({
            url: 'https://thesamachardaily.in' + (art.url || ''),
            slug: art.slug || art.relPath,
            status: 'Noindex / Archived',
            badgeClass: 'badge-amber',
            reason: 'meta name="robots" content="noindex" / Soft Archive',
            source: 'SamacharDaily Build',
            type: 'noindex'
          });
        }
      });

      let filtered = problems;
      if (filter === 'redirect') {
        filtered = problems.filter(p => p.type === 'redirect');
      } else if (filter === 'noindex') {
        filtered = problems.filter(p => p.type === 'noindex');
      } else if (filter === 'inspection_required') {
        filtered = problems.filter(p => !AppState.inspectionsCache.has(p.url));
      }

      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 32px; color: var(--color-subtle);">' +
          'No indexing problems or special directives matching current filter (' + escapeHtml(filter) + ').</td></tr>';
        return;
      }

      let html = '';
      filtered.slice(0, 50).forEach(item => {
        html += '<tr>' +
          '<td>' +
            '<div style="font-weight: 600; color: var(--color-ink); font-size: 13px;">' + escapeHtml(item.slug) + '</div>' +
            '<div style="font-size: 11px; color: var(--color-subtle); font-family: var(--font-mono);">' + escapeHtml(item.url) + '</div>' +
          '</td>' +
          '<td><span class="badge ' + item.badgeClass + '">' + escapeHtml(item.status) + '</span></td>' +
          '<td style="font-size: 12px; color: var(--color-ink-light);">' + escapeHtml(item.reason) + '</td>' +
          '<td><span class="badge badge-gray" style="font-size: 10px;">' + escapeHtml(item.source) + '</span></td>' +
          '<td style="text-align: right;">' +
            '<button class="btn-table-action" type="button" onclick="quickInspectUrl(\'' + escapeJs(item.url) + '\')">Inspect</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function filterIndexingProblems(filter, btn) {
      AppState.indexingFilter = filter;
      if (btn && btn.parentElement) {
        btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }
      renderIndexingProblemsTable();
    }

    function quickInspectUrl(url) {
      const inp = document.getElementById('inspector-url-input');
      if (inp) inp.value = url;
      const form = document.getElementById('url-inspector-form');
      if (form) form.dispatchEvent(new Event('submit', { cancelable: true }));
      const panel = document.getElementById('view-indexing');
      if (panel) panel.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function handleInspectUrlSubmit(e) {
      if (e) e.preventDefault();
      const inp = document.getElementById('inspector-url-input');
      const submitBtn = document.getElementById('btn-inspect-url');
      const resultPanel = document.getElementById('inspector-result-panel');
      if (!inp || !inp.value) return;

      const url = inp.value.trim();
      if (!url.startsWith('https://thesamachardaily.in/')) {
        showToast('URL must begin with https://thesamachardaily.in/', 'error');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Querying Google...';
      }

      if (resultPanel) {
        resultPanel.style.display = 'block';
        resultPanel.innerHTML = '<div style="text-align: center; padding: 24px; color: var(--color-muted);">' +
          '<span class="status-pulse-dot" style="margin-right: 8px;"></span> Querying Google URL Inspection API via Cloudflare Worker...</div>';
      }

      try {
        const res = await fetch('/api/admin/gsc/inspect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const data = await res.json();

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Inspect URL';
        }

        if (res.ok && data.success) {
          AppState.inspectionsCache.set(url, data.inspectionResult);
          const elInsp = document.getElementById('idx-kpi-inspected');
          if (elInsp) elInsp.innerText = AppState.inspectionsCache.size.toLocaleString();
          renderInspectionResult(data.inspectionResult, data.cached);
        } else {
          renderInspectionError(data.error || 'URL Inspection query failed', res.status, url);
        }
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Inspect URL';
        }
        renderInspectionError(err.message || 'Network error querying inspection endpoint', 500, url);
      }
    }

    function renderInspectionResult(res, isCached) {
      const panel = document.getElementById('inspector-result-panel');
      if (!panel) return;

      const idxRes = res.indexStatusResult || {};
      const verdict = idxRes.verdict || 'VERDICT_UNSPECIFIED';
      const coverage = idxRes.coverageState || 'Unknown coverage state';
      const robots = idxRes.robotsTxtState || 'ALLOWED';
      const indexingAllowed = idxRes.indexingState || 'INDEXING_ALLOWED';
      const userCanon = idxRes.userCanonical || 'Not specified';
      const googleCanon = idxRes.googleCanonical || 'Not determined';
      const lastCrawl = idxRes.lastCrawlTime ? new Date(idxRes.lastCrawlTime).toLocaleString() : 'Not crawled / Never';
      const pageFetch = idxRes.pageFetchState || 'SUCCESSFUL';

      let verdictBadge = '<span class="badge badge-gray">' + escapeHtml(verdict) + '</span>';
      if (verdict === 'PASS') verdictBadge = '<span class="badge badge-green">&check; PASS &bull; Indexed</span>';
      else if (verdict === 'NEUTRAL') verdictBadge = '<span class="badge badge-amber">&bull; NEUTRAL &bull; Excluded / Discovered</span>';
      else if (verdict === 'FAIL') verdictBadge = '<span class="badge badge-red">&times; FAIL &bull; Crawl or Index Error</span>';

      const gscDeepLink = 'https://search.google.com/search-console/inspect?resource_id=' + encodeURIComponent('https://thesamachardaily.in/') + '&id=' + encodeURIComponent(res.inspectionUrl || '');

      let html = '<div style="background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 20px;">' +
        '<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; border-bottom: 1px solid var(--color-border); padding-bottom: 12px;">' +
          '<div>' +
            '<div style="font-weight: 700; color: var(--color-ink); font-size: 14px; display: flex; align-items: center; gap: 8px;">' +
              'Inspection Result: ' + verdictBadge +
              (isCached ? ' <span class="badge badge-gray" style="font-size: 9px;">KV Cached</span>' : ' <span class="badge badge-blue" style="font-size: 9px;">Live API</span>') +
            '</div>' +
            '<div style="font-size: 12px; color: var(--color-subtle); font-family: var(--font-mono); margin-top: 4px;">' + escapeHtml(res.inspectionUrl) + '</div>' +
          '</div>' +
          '<div style="display: flex; gap: 8px;">' +
            '<a href="' + escapeHtml(gscDeepLink) + '" target="_blank" rel="noopener" class="btn-table-action" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">' +
              'Open in Google Search Console &rarr;' +
            '</a>' +
          '</div>' +
        '</div>' +
        '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; font-size: 12.5px;">' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">Coverage State</div>' +
            '<div style="color: var(--color-ink); font-weight: 600; margin-top: 2px;">' + escapeHtml(coverage) + '</div>' +
          '</div>' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">Robots.txt Directive</div>' +
            '<div style="color: var(--color-ink); font-weight: 600; margin-top: 2px;">' + escapeHtml(robots) + '</div>' +
          '</div>' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">Page Fetch State</div>' +
            '<div style="color: var(--color-ink); font-weight: 600; margin-top: 2px;">' + escapeHtml(pageFetch) + '</div>' +
          '</div>' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">Last Google Crawl</div>' +
            '<div style="color: var(--color-ink); font-weight: 600; margin-top: 2px;">' + escapeHtml(lastCrawl) + '</div>' +
          '</div>' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">User-Declared Canonical</div>' +
            '<div style="color: var(--color-ink); font-family: var(--font-mono); font-size: 11px; margin-top: 2px; word-break: break-all;">' + escapeHtml(userCanon) + '</div>' +
          '</div>' +
          '<div>' +
            '<div style="color: var(--color-muted); font-size: 11px; text-transform: uppercase; font-weight: 600;">Google-Selected Canonical</div>' +
            '<div style="color: var(--color-ink); font-family: var(--font-mono); font-size: 11px; margin-top: 2px; word-break: break-all;">' + escapeHtml(googleCanon) + '</div>' +
          '</div>' +
        '</div>' +
      '</div>';

      panel.innerHTML = html;
    }

    function renderInspectionError(msg, status, url) {
      const panel = document.getElementById('inspector-result-panel');
      if (!panel) return;

      const gscDeepLink = 'https://search.google.com/search-console/inspect?resource_id=' + encodeURIComponent('https://thesamachardaily.in/') + '&id=' + encodeURIComponent(url || '');

      panel.innerHTML = '<div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius-md); padding: 16px 20px; color: #991b1b;">' +
        '<div style="font-weight: 700; font-size: 13px; margin-bottom: 4px;">Inspection Query Notice (HTTP ' + status + ')</div>' +
        '<div style="font-size: 12px; margin-bottom: 12px;">' + escapeHtml(msg) + '</div>' +
        '<div style="display: flex; gap: 8px;">' +
          '<a href="' + escapeHtml(gscDeepLink) + '" target="_blank" rel="noopener" class="btn-table-action" style="text-decoration: none; background: #fff; color: #991b1b; border-color: #fecaca;">' +
            'Inspect Directly in Search Console GUI &rarr;' +
          '</a>' +
        '</div>' +
      '</div>';
    }

    // ========================================================================
    // SITEMAPS COMPARISON (PART 10)
    // ========================================================================
    const SitemapsData = [
      {
        path: '/sitemap.xml',
        url: 'https://thesamachardaily.in/sitemap.xml',
        type: 'Sitemap Index',
        buildEntries: '4 child indexes',
        googleStatus: 'Submitted / Indexed',
        lastSubmitted: 'Continuous edge distribution'
      },
      {
        path: '/sitemap-articles.xml',
        url: 'https://thesamachardaily.in/sitemap-articles.xml',
        type: 'Articles Content',
        buildEntries: '1,468 articles',
        googleStatus: 'Submitted',
        lastSubmitted: 'Auto-updated per dispatch'
      },
      {
        path: '/sitemap-static.xml',
        url: 'https://thesamachardaily.in/sitemap-static.xml',
        type: 'Static Core Pages',
        buildEntries: '13 core routes',
        googleStatus: 'Submitted',
        lastSubmitted: 'Maintained'
      },
      {
        path: '/sitemap-video.xml',
        url: 'https://thesamachardaily.in/sitemap-video.xml',
        type: 'Video Schema Sitemap',
        buildEntries: 'Video embeds verified',
        googleStatus: 'Submitted',
        lastSubmitted: 'Multi-media distribution'
      }
    ];

    function renderSitemapsTab() {
      const tbody = document.getElementById('sitemaps-table-body');
      if (!tbody) return;

      let html = '';
      SitemapsData.forEach(sm => {
        html += '<tr>' +
          '<td>' +
            '<div style="font-weight: 600; color: var(--color-ink); font-size: 13px;">' + escapeHtml(sm.path) + '</div>' +
            '<div style="font-size: 11px; color: var(--color-subtle); font-family: var(--font-mono);">' + escapeHtml(sm.url) + '</div>' +
          '</td>' +
          '<td><span class="badge badge-gray">' + escapeHtml(sm.type) + '</span></td>' +
          '<td style="font-weight: 600; color: var(--color-teal);">' + escapeHtml(sm.buildEntries) + '</td>' +
          '<td><span class="badge badge-blue">' + escapeHtml(sm.googleStatus) + '</span></td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + escapeHtml(sm.lastSubmitted) + '</td>' +
          '<td style="text-align: right;">' +
            '<a href="' + escapeHtml(sm.url) + '" target="_blank" rel="noopener" class="btn-table-action" style="text-decoration: none;">View XML &rarr;</a>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function loadSitemapsData(force) {
      if (force) showToast('Refreshing sitemaps registry...', 'info');
      renderSitemapsTab();
    }

    // ========================================================================
    // VIDEO SEO DIAGNOSTICS (PART 10)
    // ========================================================================
    function renderVideoSeoTab() {
      const tbody = document.getElementById('video-seo-table-body');
      const badge = document.getElementById('video-count-badge');
      if (!tbody) return;

      const videoArticles = (AppState.articles || []).filter(a => a.hasVideo || a.video_id || (a.videos && a.videos.length > 0));
      if (badge) badge.innerText = videoArticles.length + ' Video Dispatches';

      if (videoArticles.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 32px; color: var(--color-subtle);">' +
          'No video dispatches discovered in current corpus.</td></tr>';
        return;
      }

      let html = '';
      videoArticles.forEach(art => {
        const vidId = art.video_id || (art.videos && art.videos[0] && art.videos[0].video_id) || 'Embedded';
        const ytUrl = vidId !== 'Embedded' ? ('https://www.youtube.com/watch?v=' + vidId) : '#';
        html += '<tr>' +
          '<td>' +
            '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\', { origin: \'video-seo\' })">' + escapeHtml(art.title) + '</div>' +
            '<div class="row-article-sub">' + escapeHtml(art.url || art.relPath) + '</div>' +
          '</td>' +
          '<td><span class="badge badge-red">YouTube</span></td>' +
          '<td><code style="font-size: 11px;">' + escapeHtml(vidId) + '</code></td>' +
          '<td><span class="badge badge-green">&check; Schema Valid</span></td>' +
          '<td><span class="badge badge-teal">sitemap-video.xml</span></td>' +
          '<td style="text-align: right;">' +
            '<a href="' + escapeHtml(ytUrl) + '" target="_blank" rel="noopener" class="btn-table-action" style="text-decoration: none;">Watch</a> ' +
            '<button class="btn-table-action btn-table-primary" type="button" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\', { origin: \'video-seo\' })">Edit</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    // ========================================================================
    // ACCORDION NAVIGATION CONTROLS
    // ========================================================================
    function toggleNavGroup(groupId) {
      const group = document.getElementById(groupId);
      if (!group) return;
      const isCollapsed = group.classList.toggle('collapsed');
      const btn = group.querySelector('.nav-group-header');
      if (btn) btn.setAttribute('aria-expanded', !isCollapsed);
    }

    // ========================================================================
    // GSC OVERVIEW & URL INSPECTION ENGINES
    // ========================================================================
    async function loadGscOverviewData(forceRefresh = false) {
      const bannerTitle = document.getElementById('gsc-overview-status-title');
      const bannerDesc = document.getElementById('gsc-overview-status-desc');
      const statusDot = document.getElementById('gsc-overview-status-indicator');
      const authAction = document.getElementById('gsc-overview-auth-action');
      const clkEl = document.getElementById('gsc-ov-clicks');
      const impEl = document.getElementById('gsc-ov-impressions');
      const ctrEl = document.getElementById('gsc-ov-ctr');
      const posEl = document.getElementById('gsc-ov-position');
      const queriesSummary = document.getElementById('gsc-ov-queries-summary');

      // Use cached performance data if available and not forcing refresh
      if (!forceRefresh && AppState.gscData && AppState.gscData.authenticated) {
        renderGscOverviewMetrics(AppState.gscData);
        return;
      }

      try {
        if (bannerTitle) bannerTitle.innerText = 'Connecting to Google Search Console API...';
        const res = await fetch('/api/admin/gsc/performance?period=28d', {
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          const data = await res.json();
          AppState.gscData = data;
          renderGscOverviewMetrics(data);
        } else {
          renderGscOverviewDisconnected('API response: ' + res.status);
        }
      } catch (err) {
        renderGscOverviewDisconnected('Network error: ' + err.message);
      }
    }

    function renderGscOverviewMetrics(data) {
      const bannerTitle = document.getElementById('gsc-overview-status-title');
      const bannerDesc = document.getElementById('gsc-overview-status-desc');
      const statusDot = document.getElementById('gsc-overview-status-indicator');
      const authAction = document.getElementById('gsc-overview-auth-action');
      const clkEl = document.getElementById('gsc-ov-clicks');
      const impEl = document.getElementById('gsc-ov-impressions');
      const ctrEl = document.getElementById('gsc-ov-ctr');
      const posEl = document.getElementById('gsc-ov-position');
      const queriesSummary = document.getElementById('gsc-ov-queries-summary');

      if (data && data.authenticated) {
        if (bannerTitle) bannerTitle.innerText = 'Connected & Synchronized with Google Search Console';
        if (bannerDesc) bannerDesc.innerText = 'Authorized Property: sc-domain:thesamachardaily.in • Web Client Active';
        if (statusDot) statusDot.style.background = 'var(--color-green)';
        if (authAction) {
          authAction.innerHTML = '<span class="badge badge-green"><span class="badge-dot green"></span> Authorized</span>';
        }

        const kpis = data.kpis || {};
        if (clkEl) clkEl.innerText = typeof kpis.clicks === 'number' ? kpis.clicks.toLocaleString() : (kpis.clicks || '0');
        if (impEl) impEl.innerText = typeof kpis.impressions === 'number' ? kpis.impressions.toLocaleString() : (kpis.impressions || '0');
        if (ctrEl) ctrEl.innerText = typeof kpis.ctr === 'number' ? (kpis.ctr * 100).toFixed(2) + '%' : (kpis.ctr || '0%');
        if (posEl) posEl.innerText = typeof kpis.position === 'number' ? kpis.position.toFixed(1) : (kpis.position || '--');

        if (queriesSummary) {
          const queries = Array.isArray(data.queries) ? data.queries.slice(0, 5) : [];
          if (queries.length > 0) {
            let qHtml = '<table class="saas-table" style="font-size: 12px;"><thead><tr><th>Top Search Query</th><th>Clicks</th><th>Impressions</th><th style="text-align: right;">Position</th></tr></thead><tbody>';
            queries.forEach(q => {
              qHtml += '<tr><td style="font-weight: 600; color: var(--color-ink);">' + escapeHtml(q.query || (q.keys && q.keys[0]) || 'Unknown') + '</td><td>' + (q.clicks || 0).toLocaleString() + '</td><td>' + (q.impressions || 0).toLocaleString() + '</td><td style="text-align: right;">' + (typeof q.position === 'number' ? q.position.toFixed(1) : '--') + '</td></tr>';
            });
            qHtml += '</tbody></table>';
            queriesSummary.innerHTML = qHtml;
          } else {
            queriesSummary.innerHTML = '<div style="font-size: 13px; color: var(--color-muted); padding: 12px 0;">No query events recorded in selected window.</div>';
          }
        }
      } else {
        renderGscOverviewDisconnected('Authentication required to retrieve property metrics');
      }
    }

    function renderGscOverviewDisconnected(reason) {
      const bannerTitle = document.getElementById('gsc-overview-status-title');
      const bannerDesc = document.getElementById('gsc-overview-status-desc');
      const statusDot = document.getElementById('gsc-overview-status-indicator');
      const authAction = document.getElementById('gsc-overview-auth-action');
      const clkEl = document.getElementById('gsc-ov-clicks');
      const impEl = document.getElementById('gsc-ov-impressions');
      const ctrEl = document.getElementById('gsc-ov-ctr');
      const posEl = document.getElementById('gsc-ov-position');
      const queriesSummary = document.getElementById('gsc-ov-queries-summary');

      if (bannerTitle) bannerTitle.innerText = 'Google Search Console Disconnected';
      if (bannerDesc) bannerDesc.innerText = 'Target: sc-domain:thesamachardaily.in • ' + escapeHtml(reason || 'OAuth authorization required');
      if (statusDot) statusDot.style.background = 'var(--color-amber)';
      if (authAction) {
        authAction.innerHTML = '<button type="button" class="btn-table-action btn-table-primary" onclick="startGscAuth()">Connect Google Search Console</button>';
      }

      if (clkEl) clkEl.innerText = 'Unavailable';
      if (impEl) impEl.innerText = 'Unavailable';
      if (ctrEl) ctrEl.innerText = 'Unavailable';
      if (posEl) posEl.innerText = 'Unavailable';

      if (queriesSummary) {
        queriesSummary.innerHTML = '<div style="font-size: 13px; color: var(--color-subtle); padding: 16px 0; text-align: center;">GSC data unavailable until authorized. Click Connect above to authorize.</div>';
      }
    }

    function renderUrlInspectionTab() {
      // Focus or initialize URL Inspector in its dedicated view
      const input = document.getElementById('inspector-url-input-dedicated');
      if (input && !input.value) {
        input.value = 'https://thesamachardaily.in/';
      }
    }

    function quickInspectUrl(url) {
      const input = document.getElementById('inspector-url-input-dedicated');
      if (input) {
        input.value = url;
        const form = document.getElementById('url-inspector-form-dedicated');
        if (form) form.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    }

    async function handleDedicatedInspectSubmit(event) {
      event.preventDefault();
      const input = document.getElementById('inspector-url-input-dedicated');
      const resultPanel = document.getElementById('inspector-result-panel-dedicated');
      const btn = document.getElementById('btn-inspect-url-dedicated');
      if (!input || !resultPanel) return;

      const url = input.value.trim();
      if (!url) return;

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="status-pulse-dot" style="margin-right: 4px;"></span> Inspecting...';
      }

      resultPanel.style.display = 'block';
      resultPanel.innerHTML = '<div style="padding: 16px; color: var(--color-muted); font-size: 13px;">Querying Google URL Inspection API for <code>' + escapeHtml(url) + '</code>...</div>';

      try {
        const res = await fetch('/api/admin/gsc/inspect?url=' + encodeURIComponent(url));
        const data = await res.json();
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Inspect URL';
        }

        if (res.ok && data.success && data.inspectionResult) {
          const ir = data.inspectionResult.indexStatusResult || {};
          const isIndexed = ir.verdict === 'PASS';
          const verdictBadge = isIndexed
            ? '<span class="badge badge-green"><span class="badge-dot green"></span> URL is on Google</span>'
            : '<span class="badge badge-amber"><span class="badge-dot amber"></span> ' + escapeHtml(ir.verdict || 'NOT_INDEXED') + '</span>';

          resultPanel.innerHTML = '<div style="display: flex; flex-direction: column; gap: 14px; font-size: 13px;">' +
            '<div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 10px;">' +
              '<span style="font-weight: 600; color: var(--color-ink);">Verdict Status:</span>' + verdictBadge +
            '</div>' +
            '<div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">' +
              '<span style="color: var(--color-muted);">Coverage State:</span><strong style="color: var(--color-ink);">' + escapeHtml(ir.coverageState || 'Submitted and indexed') + '</strong>' +
            '</div>' +
            '<div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">' +
              '<span style="color: var(--color-muted);">Last Crawl Time:</span><strong style="color: var(--color-ink);">' + escapeHtml(ir.lastCrawlTime ? new Date(ir.lastCrawlTime).toLocaleString() : 'N/A') + '</strong>' +
            '</div>' +
            '<div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">' +
              '<span style="color: var(--color-muted);">Crawled As:</span><strong style="color: var(--color-ink);">' + escapeHtml(ir.crawledAs || 'Googlebot smartphone') + '</strong>' +
            '</div>' +
            '<div style="display: flex; justify-content: space-between;">' +
              '<span style="color: var(--color-muted);">Google-Selected Canonical:</span><strong style="color: var(--color-teal); font-family: var(--font-mono); font-size: 12px;">' + escapeHtml(ir.googleCanonical || url) + '</strong>' +
            '</div>' +
          '</div>';
        } else {
          resultPanel.innerHTML = '<div style="padding: 12px; border-radius: var(--radius-sm); background: var(--color-amber-bg); border: 1px solid var(--color-amber-border); color: var(--color-amber); font-size: 13px;">' +
            '<strong>Inspection Response:</strong> ' + escapeHtml(data.error || 'Inspection API currently requires authorized GSC token.') +
          '</div>';
        }
      } catch (err) {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = 'Inspect URL';
        }
        resultPanel.innerHTML = '<div style="color: var(--color-brand); font-size: 13px;">Network error: ' + escapeHtml(err.message) + '</div>';
      }
    }
  </script>
</body>
</html>
