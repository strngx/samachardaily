      if (art.articleType === 'redirect') {
        return '<span class="badge badge-teal">Redirect</span>';
      } else if (art.noindex) {
        return '<span class="badge badge-amber">Archived</span>';
      }
      return '<span class="badge badge-green">Active</span>';
    }

    function formatDate(d) {
      if (!d) return 'N/A';
      try {
        return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch (e) {
        return String(d);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeJs(str) {
      if (!str) return '';
      return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'toast-pill ' + type;
      toast.innerHTML = '<span>' + (type === 'success' ? '&#10003;' : (type === 'error' ? '&#9888;' : '&#8505;')) + '</span> <span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
