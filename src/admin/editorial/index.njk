        </button>
      </div>

      <div class="nav-tabs-group">
        <button class="nav-tab-btn nav-tab-secondary" onclick="switchTab('website-health', this)">
          <span>Website Health</span>
          <span class="badge badge-green" style="font-size: 9px; padding: 2px 5px;">PASS</span>
        </button>
        <button class="nav-tab-btn nav-tab-secondary" onclick="switchTab('search-perf', this)">
          <span>Search Performance</span>
          <span class="badge badge-gray" style="font-size: 9px; padding: 2px 5px;">Roadmap</span>
        </button>
        <button class="nav-tab-btn nav-tab-secondary" onclick="switchTab('broken-links', this)">
          <span>Broken Links</span>
          <span class="badge badge-gray" style="font-size: 9px; padding: 2px 5px;">Roadmap</span>
        </button>
        <button class="nav-tab-btn nav-tab-secondary" onclick="switchTab('google-news', this)">
          <span>Google News</span>
          <span class="badge badge-green" style="font-size: 9px; padding: 2px 5px;">PASS</span>
        </button>
      </div>
    </div>

    <!-- ============================================================= -->
    <!-- TAB 1: OVERVIEW -->
    <!-- ============================================================= -->
    <div id="tab-overview" class="tab-pane active">

      <!-- Compact Top KPI Cards -->
      <div class="kpi-grid">
        <div class="kpi-card kpi-green">
          <div class="kpi-header">
            <span class="kpi-label">Published</span>
