      </nav>

      <!-- Sidebar Footer User Profile (Single Sign Out Action) -->
      <div class="sidebar-footer">
        <div class="admin-profile-pill">
          <div class="admin-avatar" id="sidebar-user-avatar">AD</div>
          <div class="admin-info-text">
            <div class="admin-name" id="sidebar-user-name">Newsroom Admin</div>
            <div class="admin-email" id="sidebar-user-email">admin@thesamachardaily.in</div>
            <div class="admin-status-indicator">
              <span class="status-pulse-dot"></span> <span id="sidebar-user-role">Session active</span>
            </div>
          </div>
        </div>
        <button class="btn-signout-sidebar" onclick="handleLogout()" title="Sign Out from Newsroom">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          <span>Sign Out</span>
        </button>
      </div>

    </aside>

    <!-- ======================================================================
         2. MAIN WORKSPACE WITH TOP GLOBAL BAR
         ====================================================================== -->
    <div class="saas-content-area">
      
      <!-- Top Bar: Single Sign Out rule enforced (no duplicate sign out here) -->
      <header class="saas-top-bar">
        <div class="top-left-cluster">
          <button class="mobile-nav-toggle" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
          <div class="breadcrumb-trail">
            <span class="breadcrumb-root">Newsroom</span>
            <span class="breadcrumb-divider">/</span>
            <span class="breadcrumb-active" id="top-breadcrumb">Overview</span>
          </div>
        </div>

        <div class="top-center-search">
          <div class="quick-search-wrapper">
            <span class="quick-search-icon">&#128269;</span>
            <input type="text" id="global-search-input" class="quick-search-input" placeholder="Quick find article across corpus..." oninput="handleGlobalSearch(this.value)">
            <kbd class="search-key-badge">/</kbd>
          </div>
        </div>

        <div class="top-right-cluster">
          <div class="prod-status-chip">
            <span class="prod-dot"></span>
            <span>Production Edge Live</span>
          </div>
          <div class="topbar-user-pill" id="topbar-user-pill" title="Active User Session">
            <div class="topbar-avatar" id="topbar-user-avatar">AD</div>
            <div class="topbar-user-meta">
              <span class="topbar-user-name" id="topbar-user-name">Newsroom Admin</span>
              <span class="topbar-user-role" id="topbar-user-role">Session active</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Scrollable Main Content -->
      <main class="saas-workspace-scroll" id="main-workspace-scroll">

        <section id="view-overview" class="view-pane active">
          
          <div class="view-header">
            <div class="view-title-group">
              <h1>Editorial Operations &amp; Intelligence</h1>
              <p>Executive newsroom overview, content governance, and edge distribution health.</p>
            </div>
            <div class="view-actions-group">
              <button class="btn btn-primary" onclick="navigate('articles')">Browse All Articles &rarr;</button>
            </div>
          </div>

          <!-- Top-Level 7 KPI Cards Strip -->
          <div class="ov-kpi-grid-7">
            <div class="kpi-card" onclick="navigate('articles')">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Articles</span>
                <span class="badge badge-gray">Corpus</span>
              </div>
              <div class="kpi-card-val" id="ov-kpi-total">...</div>
              <div class="kpi-card-sub">Markdown story files</div>
            </div>

            <div class="kpi-card" onclick="navigate('articles', { status: 'published' })">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Published</span>
                <span class="badge badge-green">Live</span>
              </div>
              <div class="kpi-card-val" id="ov-kpi-active" style="color: var(--color-green);">...</div>
              <div class="kpi-card-sub">Indexable in sitemap.xml</div>
            </div>

            <div class="kpi-card" onclick="navigate('attention')">
              <div class="kpi-card-header">
                <span class="kpi-card-label">Needs Attention</span>
                <span class="badge badge-amber">Action</span>
              </div>
              <div class="kpi-card-val" id="ov-kpi-attention" style="color: var(--color-amber);">...</div>
              <div class="kpi-card-sub">Missing hero or attribution</div>
            </div>

            <div class="kpi-card" onclick="navigate('thin-queue')">
              <div class="kpi-card-header">
