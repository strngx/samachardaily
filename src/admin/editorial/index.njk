    function syncEditorStatusIfCurrent(art) {
      if (AppState.currentlyEditingArticle && AppState.currentlyEditingArticle.relPath === art.relPath) {
        const statusBadge = document.getElementById('editor-status-badge');
        if (statusBadge) {
