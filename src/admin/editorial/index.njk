    // ========================================================================
    // PHASE 8: THIN CONTENT QUEUE CLIENT ENGINE
    // ========================================================================
    const ThinQueueState = {
      items: Array.isArray(window.__THIN_QUEUE__) ? window.__THIN_QUEUE__ : [],
      stats: window.__THIN_STATS__ || {},
      filteredItems: [],
      selectedItem: null,
      reviewStates: {}, // slug -> { status: 'reviewed' | 'dismissed', reviewer, timestamp, notes }
      filters: {
        classification: 'ALL',
        desk: 'ALL',
        words: 'ALL',
        reviewStatus: 'ALL',
        search: '',
        sort: 'confidence'
      },
      pagination: {
        page: 1,
        pageSize: 25
      }
    };

    // Load persisted review states from localStorage as local fallback
    try {
      const cachedReviews = localStorage.getItem('samachar_thin_queue_reviews');
      if (cachedReviews) {
        ThinQueueState.reviewStates = JSON.parse(cachedReviews) || {};
      }
    } catch (_) {}

    function initThinQueueView(forceRefresh = false) {
      if (forceRefresh) {
        showToast('Refreshing Thin Content Queue data...', 'info');
      }

      // Sync items from global
      ThinQueueState.items = Array.isArray(window.__THIN_QUEUE__) ? window.__THIN_QUEUE__ : [];
      ThinQueueState.stats = window.__THIN_STATS__ || {};

      // Preserve existing search input value
      const searchInput = document.getElementById('tq-search-input');
      if (searchInput && ThinQueueState.filters.search) {
        searchInput.value = ThinQueueState.filters.search;
      }

      // Batch fetch latest review states from Worker API if authenticated
      fetchThinQueueReviewStates();

      // Apply filters and render
      applyThinQueueFilters();
    }

    async function fetchThinQueueReviewStates() {
      if (!ThinQueueState.items || ThinQueueState.items.length === 0) return;
      // Get first 100 slugs for active inspection
      const slugs = ThinQueueState.items.slice(0, 100).map(i => i.slug).filter(Boolean);
      if (slugs.length === 0) return;

      try {
        const resp = await fetch('/api/admin/thin-queue/reviews?slugs=' + encodeURIComponent(slugs.join(',')), {
          headers: { 'Accept': 'application/json' }
        });
        if (resp.ok) {
          const data = await resp.json();
          if (data && data.reviews) {
            ThinQueueState.reviewStates = { ...ThinQueueState.reviewStates, ...data.reviews };
            try {
              localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
            } catch (_) {}
            renderThinQueueTable();
          }
        }
      } catch (_) {
        // Fallback gracefully to local state
      }
    }

    function applyThinQueueFilters() {
      let filtered = [...ThinQueueState.items];
      const f = ThinQueueState.filters;

      // 1. Classification Filter
      if (f.classification !== 'ALL') {
        if (f.classification === 'LOW_VALUE') {
          filtered = filtered.filter(item => item.classification === 'Noindex' || item.classification === 'Prune');
        } else {
          filtered = filtered.filter(item => item.classification === f.classification);
        }
      }

      // 2. Desk Filter
      if (f.desk !== 'ALL') {
        filtered = filtered.filter(item => (item.category || '').toLowerCase() === f.desk.toLowerCase());
      }

      // 3. Word Count Filter
      if (f.words !== 'ALL') {
        if (f.words === 'under100') filtered = filtered.filter(item => item.wordCount < 100);
        else if (f.words === '100-199') filtered = filtered.filter(item => item.wordCount >= 100 && item.wordCount < 200);
        else if (f.words === '200-299') filtered = filtered.filter(item => item.wordCount >= 200 && item.wordCount < 300);
        else if (f.words === '300plus') filtered = filtered.filter(item => item.wordCount >= 300);
      }

      // 4. Review Status Filter
      if (f.reviewStatus !== 'ALL') {
        filtered = filtered.filter(item => {
          const rev = ThinQueueState.reviewStates[item.slug];
          const status = rev ? rev.status : 'unreviewed';
          return status === f.reviewStatus;
        });
      }

      // 5. Search Filter
      if (f.search) {
        const q = f.search.toLowerCase();
        filtered = filtered.filter(item => {
          return (item.title && item.title.toLowerCase().includes(q)) ||
                 (item.slug && item.slug.toLowerCase().includes(q)) ||
                 (item.reason && item.reason.toLowerCase().includes(q));
        });
      }

      // 6. Sorting
      const confOrder = { 'High': 3, 'Medium': 2, 'Low': 1 };
      filtered.sort((a, b) => {
        if (f.sort === 'confidence') {
          const cA = confOrder[a.confidence] || 0;
          const cB = confOrder[b.confidence] || 0;
          if (cA !== cB) return cB - cA;
          return a.wordCount - b.wordCount;
        } else if (f.sort === 'newest') {
          return (b.date || '').localeCompare(a.date || '');
        } else if (f.sort === 'oldest') {
          return (a.date || '').localeCompare(b.date || '');
        } else if (f.sort === 'shortest') {
          return a.wordCount - b.wordCount;
        } else if (f.sort === 'longest') {
          return b.wordCount - a.wordCount;
        }
        return 0;
      });

      ThinQueueState.filteredItems = filtered;
      ThinQueueState.pagination.page = 1;
      // Sync search input element if not currently focused
      const searchInput = document.getElementById('tq-search-input');
      if (searchInput && document.activeElement !== searchInput) {
        if (searchInput.value !== (ThinQueueState.filters.search || '')) {
          searchInput.value = ThinQueueState.filters.search || '';
        }
      }
      renderThinQueueTable();
      updateThinQueueCounts();
    }

