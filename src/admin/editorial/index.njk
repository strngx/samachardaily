---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editorial Control Center — Samachar Daily</title>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --color-brand: #C81E2C;
      --color-brand-dark: #9e1420;
      --color-brand-light: #fef2f2;
      --color-ink: #0f172a;
      --color-ink-light: #1e293b;
      --color-muted: #475569;
      --color-subtle: #64748b;
      --color-canvas: #f8fafc;
      --color-surface: #ffffff;
      --color-surface-alt: #f1f5f9;
      --color-surface-hover: #f8fafc;
      --color-border: #e2e8f0;
      --color-border-dark: #cbd5e1;
      
      --color-blue: #1d4ed8;
      --color-blue-bg: #eff6ff;
      --color-blue-border: #bfdbfe;
      
      --color-green: #15803d;
      --color-green-bg: #f0fdf4;
      --color-green-border: #bbf7d0;
      
      --color-amber: #b45309;
      --color-amber-bg: #fffbeb;
      --color-amber-border: #fde68a;
      
      --color-red: #dc2626;
      --color-red-bg: #fef2f2;
      --color-red-border: #fecaca;
      
      --color-teal: #0f766e;
      --color-teal-bg: #f0fdfa;
      --color-teal-border: #99f6e4;
      
      --color-purple: #7e22ce;
      --color-purple-bg: #faf5ff;
      --color-purple-border: #e9d5ff;

      --font-stack: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --font-serif: 'Merriweather', Georgia, "Times New Roman", serif;
      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
      
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background-color: var(--color-canvas);
      color: var(--color-ink);
      font-family: var(--font-stack);
      line-height: 1.5;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Operational Bar */
    .top-bar {
      background-color: #042f2e;
      color: #ccfbf1;
      padding: 7px 24px;
      font-size: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid #115e59;
    }
    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .top-bar-badge {
      background-color: #f59e0b;
      color: #78350f;
      font-weight: 700;
      font-size: 10px;
      padding: 2px 7px;
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .top-bar-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .btn-logout {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      padding: 3px 10px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      transition: all 0.15s ease;
    }
    .btn-logout:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    /* Main Container */
    .dashboard-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 20px 24px 60px;
    }

    /* Header */
    .dashboard-header {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 20px 24px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .brand-mark {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--color-brand);
      margin-bottom: 2px;
    }
    .header-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--color-ink);
      letter-spacing: -0.5px;
    }
    .header-subtitle {
      font-size: 13px;
      color: var(--color-muted);
      margin-top: 2px;
    }
    .header-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .meta-chip {
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      color: var(--color-muted);
      display: flex;
      gap: 6px;
      align-items: center;
    }
    .meta-chip strong {
      color: var(--color-ink);
      font-weight: 600;
    }

    /* Primary & Secondary Nav Tabs */
    .nav-tabs-wrapper {
      margin-bottom: 24px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
    }
    .nav-tabs-group {
      display: flex;
      gap: 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-tabs-group::-webkit-scrollbar { display: none; }
    
    .nav-tab-btn {
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-muted);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .nav-tab-btn:hover {
      color: var(--color-ink);
      background-color: rgba(0, 0, 0, 0.02);
    }
    .nav-tab-btn.active {
      color: var(--color-brand);
      border-bottom-color: var(--color-brand);
      background: none;
    }
    .nav-tab-secondary {
      font-size: 12px;
      padding: 10px 12px;
      color: var(--color-subtle);
    }
    .nav-tab-secondary.active {
      color: var(--color-ink);
      border-bottom-color: var(--color-ink);
    }

    .tab-badge {
      background-color: var(--color-surface-alt);
      color: var(--color-muted);
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 10px;
    }
    .nav-tab-btn.active .tab-badge {
      background-color: var(--color-brand-light);
      color: var(--color-brand);
    }

    /* Tab Panes */
    .tab-pane {
      display: none;
    }
    .tab-pane.active {
      display: block;
    }

    /* KPI Grid */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .kpi-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }
    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--color-border);
    }
    .kpi-card.kpi-brand::before { background: var(--color-brand); }
    .kpi-card.kpi-green::before { background: var(--color-green); }
    .kpi-card.kpi-amber::before { background: var(--color-amber); }
    .kpi-card.kpi-blue::before { background: var(--color-blue); }
    .kpi-card.kpi-teal::before { background: var(--color-teal); }

    .kpi-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }
    .kpi-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-subtle);
    }
    .kpi-value {
      font-size: 28px;
      font-weight: 800;
      color: var(--color-ink);
      line-height: 1.1;
      margin-bottom: 4px;
    }
    .kpi-sub {
      font-size: 12px;
      color: var(--color-muted);
    }

    /* Standard Cards & Layouts */
    .card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      margin-bottom: 24px;
    }
    .card-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .card-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .card-desc {
      font-size: 13px;
      color: var(--color-muted);
      margin-top: 2px;
    }
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 20px;
    }
    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    /* Badges & Tags */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      line-height: 1;
      white-space: nowrap;
    }
    .badge-red { background: #fee2e2; color: #991b1b; }
    .badge-blue { background: #dbeafe; color: #1e40af; }
    .badge-green { background: #dcfce7; color: #166534; }
    .badge-purple { background: #f3e8ff; color: #6b21a8; }
    .badge-amber { background: #fef3c7; color: #92400e; }
    .badge-teal { background: #ccfbf1; color: #115e59; }
    .badge-gray { background: #f1f5f9; color: #475569; }

    /* Health Dot */
    .health-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
    }
    .health-dot.healthy { background: var(--color-green); box-shadow: 0 0 0 2px #dcfce7; }
    .health-dot.warning { background: var(--color-amber); box-shadow: 0 0 0 2px #fef3c7; }
    .health-dot.critical { background: var(--color-red); box-shadow: 0 0 0 2px #fee2e2; }

    /* Primary Article Management Workspace */
    .articles-toolbar {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 16px 20px;
      margin-bottom: 16px;
      box-shadow: var(--shadow-sm);
    }
    .search-row {
      display: flex;
      gap: 12px;
      margin-bottom: 14px;
      align-items: center;
    }
    .search-input-wrap {
      flex: 1;
      position: relative;
    }
    .search-input {
      width: 100%;
      padding: 9px 12px 9px 36px;
      font-size: 13px;
      border: 1px solid var(--color-border-dark);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-ink);
      outline: none;
      transition: border-color 0.15s ease;
    }
    .search-input:focus {
      border-color: var(--color-brand);
      box-shadow: 0 0 0 2px rgba(200, 30, 44, 0.1);
    }
    .search-icon {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-subtle);
      font-size: 14px;
      pointer-events: none;
    }
    .filter-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }
    .filter-select {
      padding: 7px 10px;
      font-size: 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      color: var(--color-ink);
      outline: none;
      cursor: pointer;
      font-weight: 500;
    }
    .filter-select:focus {
      border-color: var(--color-brand);
    }
    .btn-reset {
      background: none;
      border: 1px solid var(--color-border);
      padding: 7px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      color: var(--color-muted);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-reset:hover {
      background: var(--color-surface-alt);
      color: var(--color-ink);
    }

    /* Bulk Actions Toolbar */
    .bulk-toolbar {
      background: #0f172a;
      color: #ffffff;
      padding: 10px 18px;
      border-radius: var(--radius-md);
      margin-bottom: 16px;
      display: none;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-md);
      animation: fadeIn 0.15s ease;
    }
    .bulk-toolbar.visible {
      display: flex;
    }
    .bulk-actions-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .btn-bulk {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #ffffff;
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-bulk:hover {
      background: rgba(255, 255, 255, 0.3);
    }
    .btn-bulk-danger {
      background: #dc2626;
      border-color: #ef4444;
    }
    .btn-bulk-danger:hover {
      background: #b91c1c;
    }

    /* Article Table (Desktop) */
    .table-container {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 16px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }
    .data-table th {
      background-color: var(--color-surface-alt);
      color: var(--color-subtle);
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--color-border);
    }
    .data-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-ink);
      vertical-align: middle;
    }
    .data-table tr:hover td {
      background-color: var(--color-surface-hover);
    }
    .data-table tr.selected td {
      background-color: #f0fdf4;
    }
    
    .td-article-title {
      font-weight: 600;
      color: var(--color-ink);
      font-size: 14px;
      margin-bottom: 3px;
      line-height: 1.35;
      cursor: pointer;
    }
    .td-article-title:hover {
      color: var(--color-brand);
    }
    .td-article-url {
      font-size: 11px;
      color: var(--color-subtle);
      font-family: var(--font-mono);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 440px;
    }

    /* Action Buttons */
    .btn-action-primary {
      background: var(--color-brand);
      color: #ffffff;
      border: none;
      padding: 5px 11px;
      font-size: 12px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .btn-action-primary:hover {
      background: var(--color-brand-dark);
    }
    .btn-action-secondary {
      background: var(--color-surface);
      border: 1px solid var(--color-border-dark);
      color: var(--color-ink);
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.15s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }
    .btn-action-secondary:hover {
      background: var(--color-surface-alt);
    }
    .btn-action-more {
      background: none;
      border: 1px solid var(--color-border);
      color: var(--color-muted);
      padding: 5px 8px;
      font-size: 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
    }
    .btn-action-more:hover {
      background: var(--color-surface-alt);
      color: var(--color-ink);
    }

    /* Dropdown Menu */
    .dropdown {
      position: relative;
      display: inline-block;
    }
    .dropdown-content {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 4px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-lg);
      min-width: 160px;
      z-index: 100;
      overflow: hidden;
    }
    .dropdown-content.show {
      display: block;
    }
    .dropdown-item {
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 500;
      color: var(--color-ink);
      display: block;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.1s ease;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }
    .dropdown-item:hover {
      background: var(--color-surface-alt);
    }
    .dropdown-item.danger {
      color: var(--color-red);
    }
    .dropdown-item.danger:hover {
      background: var(--color-red-bg);
    }

    /* Mobile Article Card View (hidden on desktop) */
    .mobile-cards-view {
      display: none;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 16px;
    }
    .mobile-article-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 16px;
      box-shadow: var(--shadow-sm);
    }
    .mobile-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 8px;
    }
    .mobile-card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--color-ink);
      line-height: 1.3;
    }
    .mobile-card-url {
      font-size: 11px;
      color: var(--color-subtle);
      font-family: var(--font-mono);
      margin-bottom: 12px;
      word-break: break-all;
    }
    .mobile-card-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
      margin-bottom: 14px;
    }
    .mobile-card-actions {
      display: flex;
      gap: 8px;
      padding-top: 12px;
      border-top: 1px solid var(--color-border);
      align-items: center;
      justify-content: space-between;
    }

    /* Pagination */
    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 13px;
      color: var(--color-muted);
      flex-wrap: wrap;
      gap: 12px;
      box-shadow: var(--shadow-sm);
    }
    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pagination-btn {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-ink);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .pagination-btn:hover:not(:disabled) {
      background: var(--color-surface-alt);
    }
    .pagination-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* Right-Side Slide-Over Detail Drawer */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.4);
      backdrop-filter: blur(2px);
      z-index: 500;
      display: none;
      justify-content: flex-end;
      animation: fadeIn 0.2s ease;
    }
    .drawer-panel {
      width: 100%;
      max-width: 560px;
      background: var(--color-surface);
      height: 100vh;
      overflow-y: auto;
      box-shadow: var(--shadow-xl);
      display: flex;
      flex-direction: column;
      animation: slideInRight 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .drawer-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      background: var(--color-surface);
      z-index: 10;
    }
    .drawer-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-ink);
    }
    .drawer-close {
      background: none;
      border: none;
      font-size: 20px;
      color: var(--color-muted);
      cursor: pointer;
      line-height: 1;
      padding: 4px;
    }
    .drawer-close:hover {
      color: var(--color-ink);
    }
    .drawer-body {
      padding: 24px;
      flex: 1;
    }
    .drawer-section {
      margin-bottom: 24px;
    }
    .drawer-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--color-subtle);
      margin-bottom: 8px;
    }
    .meta-pair {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--color-surface-alt);
      font-size: 13px;
    }
    .meta-pair-label {
      color: var(--color-muted);
    }
    .meta-pair-value {
      font-weight: 600;
      color: var(--color-ink);
      text-align: right;
      max-width: 60%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .drawer-footer {
      padding: 16px 24px;
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-alt);
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      flex-wrap: wrap;
      position: sticky;
      bottom: 0;
    }

    /* Article Writing Studio (Editor View) */
    .editor-view {
      display: none;
      animation: fadeIn 0.15s ease;
    }
    .editor-view.active {
      display: block;
    }
    .editor-top-bar {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 14px 20px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 12px;
      z-index: 40;
    }
    .editor-top-left {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .btn-back {
      background: var(--color-surface);
      border: 1px solid var(--color-border-dark);
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--color-ink);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .btn-back:hover {
      background: var(--color-surface-alt);
    }
    .save-status-text {
      font-size: 12px;
      color: var(--color-subtle);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .save-status-text.saved {
      color: var(--color-green);
      font-weight: 600;
    }
    .save-status-text.error {
      color: var(--color-red);
      font-weight: 600;
    }

    .editor-layout {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
      align-items: start;
    }
    .writing-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 28px 32px;
      box-shadow: var(--shadow-sm);
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: var(--color-ink);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .form-hint {
      font-size: 12px;
      color: var(--color-subtle);
      margin-top: 4px;
    }
    .headline-input {
      width: 100%;
      font-size: 24px;
      font-weight: 800;
      line-height: 1.25;
      padding: 12px 14px;
      border: 1px solid var(--color-border-dark);
      border-radius: var(--radius-sm);
      color: var(--color-ink);
      outline: none;
      font-family: var(--font-stack);
      margin-bottom: 16px;
    }
    .headline-input:focus {
      border-color: var(--color-brand);
      box-shadow: 0 0 0 3px rgba(200, 30, 44, 0.1);
    }
    .dek-textarea {
      width: 100%;
      font-size: 14px;
      font-style: italic;
      color: var(--color-muted);
      padding: 10px 14px;
      border: 1px solid var(--color-border-dark);
      border-radius: var(--radius-sm);
      outline: none;
      resize: vertical;
      min-height: 72px;
      line-height: 1.5;
      font-family: var(--font-stack);
      margin-bottom: 20px;
    }
    .dek-textarea:focus {
      border-color: var(--color-brand);
      box-shadow: 0 0 0 3px rgba(200, 30, 44, 0.1);
    }

    /* Editor Toolbar */
    .editor-toolbar {
      display: flex;
      gap: 4px;
      padding: 8px 12px;
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      border-bottom: none;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
      flex-wrap: wrap;
    }
    .tool-btn {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 4px 8px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      color: var(--color-ink);
      cursor: pointer;
    }
    .tool-btn:hover {
      background: var(--color-brand-light);
      color: var(--color-brand);
    }

    .body-textarea {
      width: 100%;
      min-height: 480px;
      padding: 16px;
      font-family: var(--font-serif);
      font-size: 15px;
      line-height: 1.7;
      color: var(--color-ink);
      border: 1px solid var(--color-border-dark);
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      outline: none;
      resize: vertical;
      background: #fafafa;
    }
    .body-textarea:focus {
      border-color: var(--color-brand);
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(200, 30, 44, 0.1);
    }

    /* Editor Sidebar */
    .editor-sidebar {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .sidebar-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 18px;
      box-shadow: var(--shadow-sm);
    }
    .sidebar-card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--color-ink);
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .input-sm {
      width: 100%;
      padding: 7px 10px;
      font-size: 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      outline: none;
      color: var(--color-ink);
      background: var(--color-surface);
      margin-bottom: 10px;
    }
    .input-sm:focus {
      border-color: var(--color-brand);
    }
    .input-sm[readonly] {
      background: var(--color-surface-alt);
      color: var(--color-muted);
      cursor: not-allowed;
    }

    /* Modal Styles */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.5);
      backdrop-filter: blur(2px);
      z-index: 600;
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      animation: fadeIn 0.15s ease;
    }
    .modal-card {
      background: var(--color-surface);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 600px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-xl);
      animation: zoomIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .modal-card.preview-card {
      max-width: 820px;
    }
    .modal-header {
      padding: 18px 22px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      background: var(--color-surface);
      z-index: 10;
    }
    .modal-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-ink);
    }
    .modal-body {
      padding: 22px;
    }
    .modal-footer {
      padding: 14px 22px;
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-alt);
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      position: sticky;
      bottom: 0;
    }

    /* Public Presentation Preview */
    .preview-article-body {
      font-family: var(--font-serif);
      font-size: 16px;
      line-height: 1.8;
      color: #1e293b;
    }
    .preview-article-body p {
      margin-bottom: 16px;
    }
    .preview-hero-img {
      width: 100%;
      height: 320px;
      object-fit: cover;
      border-radius: var(--radius-md);
      margin-bottom: 10px;
    }
    .preview-img-credit {
      font-size: 11px;
      color: var(--color-subtle);
      margin-bottom: 20px;
      font-family: var(--font-stack);
    }
    .preview-callout {
      background: var(--color-brand-light);
      border-left: 4px solid var(--color-brand);
      padding: 16px 20px;
      border-radius: var(--radius-sm);
      margin: 24px 0;
    }

    /* Toast Notification */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }
    .toast {
      background: #0f172a;
      color: #ffffff;
      padding: 12px 18px;
      border-radius: var(--radius-md);
      font-size: 13px;
      font-weight: 500;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
      animation: slideUp 0.2s ease;
      min-width: 280px;
    }
    .toast.success { border-left: 4px solid #22c55e; }
    .toast.error { border-left: 4px solid #ef4444; }
    .toast.warning { border-left: 4px solid #f59e0b; }

    /* Keyframes */
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideInRight { from { transform: translateX(100%); } to { transform: translateX(0); } }
    @keyframes zoomIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    /* Responsive Viewports */
    @media (max-width: 1024px) {
      .editor-layout {
        grid-template-columns: 1fr;
      }
      .editor-sidebar {
        order: 2;
      }
    }
    @media (max-width: 768px) {
      .dashboard-container {
        padding: 12px 14px 40px;
      }
      .header-content {
        flex-direction: column;
        align-items: flex-start;
      }
      .top-bar {
        flex-direction: column;
        align-items: flex-start;
      }
      .top-bar-right {
        width: 100%;
        justify-content: space-between;
      }
      .nav-tabs-wrapper {
        flex-direction: column;
        align-items: flex-start;
      }
      .table-container {
        display: none;
      }
      .mobile-cards-view {
        display: flex;
      }
      .writing-surface {
        padding: 16px;
      }
      .headline-input {
        font-size: 18px;
      }
    }
  </style>
</head>
<body>

  <!-- Top Operational Bar -->
  <div class="top-bar">
    <div class="top-bar-left">
      <span class="top-bar-badge">Newsroom CMS</span>
      <span>Samachar Daily Editorial Operations</span>
      <span style="opacity: 0.4;">|</span>
      <span>Environment: <strong>Local &amp; Edge Sync</strong></span>
    </div>
    <div class="top-bar-right">
      <span>User: <strong>admin</strong></span>
      <span>Session: <strong style="color: #6ee7b7;">Active (2h TTL)</strong></span>
      <button class="btn-logout" onclick="handleLogout()">Sign Out</button>
    </div>
  </div>

  <div class="dashboard-container">

    <!-- Top Header -->
    <header class="dashboard-header">
      <div class="header-content">
        <div>
          <div class="brand-mark">Samachar Daily</div>
