    // -------------------------------------------------------------
    // Article Writing Studio (The Editor)
    // -------------------------------------------------------------
    async function openArticleEditor(relPath) {
      closeArticleDrawer();
      const art = articles.find(a => a.relPath === relPath);
      if (!art) return;

      currentlyEditingArticle = art;

      // Hide tabs and show editor
      document.getElementById('main-nav-wrapper').style.display = 'none';
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      const editorView = document.getElementById('editor-view');
      editorView.classList.add('active');

      // Populate Form Fields
      document.getElementById('edit-headline').value = art.title || '';
      document.getElementById('edit-dek').value = art.dek || '';
      document.getElementById('edit-why-it-matters').value = art.why_it_matters || '';
      document.getElementById('edit-what-happens-next').value = art.what_happens_next || '';
      document.getElementById('edit-category').value = art.category || 'India';
      document.getElementById('edit-author').value = art.author || 'SamacharDaily Editorial Team';
      document.getElementById('edit-date-display').value = formatDate(art.date);
      document.getElementById('edit-slug').value = art.slug || '';
      document.getElementById('edit-url').value = 'https://thesamachardaily.in' + art.url;
      document.getElementById('edit-seo-title').value = art.seoTitle || '';
      document.getElementById('edit-source-name').value = art.sourceName || '';
      document.getElementById('edit-source-url').value = art.sourceUrl || '';
      document.getElementById('edit-image').value = art.image || '';
      document.getElementById('edit-image-credit').value = art.imageCredit || '';

      updateImagePreview(art.image);

      const statusBadge = document.getElementById('editor-status-badge');
      if (art.noindex) {
        statusBadge.className = 'badge badge-amber';
        statusBadge.innerText = 'Archived (noindex)';
      } else if (art.articleType === 'redirect') {
        statusBadge.className = 'badge badge-teal';
        statusBadge.innerText = 'Redirect Stub';
      } else {
        statusBadge.className = 'badge badge-green';
        statusBadge.innerText = 'Published (Active)';
      }

      const saveStatus = document.getElementById('editor-save-status');

      // Check if full article body is already cached in memory
      if (typeof art.body === 'string') {
        document.getElementById('edit-body').value = art.body;
        updateWordCountLive();
        saveStatus.className = 'save-status-text';
        saveStatus.innerText = art.sha ? ('Loaded (Git SHA: ' + art.sha.slice(0, 7) + ')') : 'Loaded dispatch';
      } else {
        document.getElementById('edit-body').value = 'Loading complete article body from repository...';
        saveStatus.className = 'save-status-text';
        saveStatus.innerText = 'Fetching article body...';
        try {
          const res = await fetch('/api/admin/articles/get?relPath=' + encodeURIComponent(relPath));
          if (res.ok) {
            const data = await res.json();
            if (data.success) {
              art.body = data.body || '';
              art.sha = data.sha || null;
              if (data.data) {
                if (data.data.why_it_matters && !art.why_it_matters) {
                  art.why_it_matters = data.data.why_it_matters;
                  document.getElementById('edit-why-it-matters').value = art.why_it_matters;
                }
                if (data.data.what_happens_next && !art.what_happens_next) {
                  art.what_happens_next = data.data.what_happens_next;
                  document.getElementById('edit-what-happens-next').value = art.what_happens_next;
                }
              }
              document.getElementById('edit-body').value = art.body;
              updateWordCountLive();
              saveStatus.className = 'save-status-text';
              saveStatus.innerText = art.sha ? ('Loaded (Git SHA: ' + art.sha.slice(0, 7) + ')') : 'Loaded dispatch';
            } else {
              saveStatus.className = 'save-status-text error';
              saveStatus.innerText = 'Failed to load body: ' + (data.error || 'Unknown error');
            }
          } else {
            saveStatus.className = 'save-status-text error';
            saveStatus.innerText = 'Failed to fetch article (' + res.status + ')';
          }
        } catch (fetchErr) {
          saveStatus.className = 'save-status-text error';
          saveStatus.innerText = 'Error loading article: ' + fetchErr.message;
        }
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function closeEditorView() {
      const editorView = document.getElementById('editor-view');
      editorView.classList.remove('active');
      document.getElementById('main-nav-wrapper').style.display = 'flex';
      switchTab('articles');
      currentlyEditingArticle = null;
    }

    function updateImagePreview(url) {
      const wrap = document.getElementById('edit-image-preview-wrap');
      const img = document.getElementById('edit-image-preview');
      if (url && url.trim()) {
        img.src = url.trim();
        wrap.style.display = 'block';
      } else {
        wrap.style.display = 'none';
      }
    }

    function updateWordCountLive() {
      const text = document.getElementById('edit-body').value || '';
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      document.getElementById('editor-word-count').innerText = words + ' words';
      const readMins = Math.max(1, Math.round(words / 200));
      document.getElementById('editor-reading-time').innerText = readMins + ' min read';

      const tierEl = document.getElementById('editor-health-tier');
      if (words < 100) {
        tierEl.innerHTML = '<span style="color: var(--color-red);">Severe Thin (&lt;100w)</span>';
      } else if (words < 150) {
        tierEl.innerHTML = '<span style="color: var(--color-amber);">Thin (&lt;150w)</span>';
      } else {
        tierEl.innerHTML = '<span style="color: var(--color-green);">Substantive (' + words + 'w)</span>';
      }
    }

    function formatMarkdown(prefix, suffix) {
      const textarea = document.getElementById('edit-body');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      const selected = text.substring(start, end);
      const replacement = prefix + selected + suffix;
      textarea.value = text.substring(0, start) + replacement + text.substring(end);
      textarea.focus();
      textarea.selectionStart = start + prefix.length;
      textarea.selectionEnd = start + prefix.length + selected.length;
      updateWordCountLive();
    }

    async function saveEditorArticle() {
      if (!currentlyEditingArticle) return;

      const saveStatus = document.getElementById('editor-save-status');
      const btn = document.getElementById('btn-save-editor');
      btn.disabled = true;
      saveStatus.className = 'save-status-text';
      saveStatus.innerText = 'Saving changes...';

      const payload = {
        relPath: currentlyEditingArticle.relPath,
        sha: currentlyEditingArticle.sha || null,
        title: document.getElementById('edit-headline').value,
        dek: document.getElementById('edit-dek').value,
        body: document.getElementById('edit-body').value,
        why_it_matters: document.getElementById('edit-why-it-matters').value,
        what_happens_next: document.getElementById('edit-what-happens-next').value,
        category: document.getElementById('edit-category').value,
        author: document.getElementById('edit-author').value,
        seoTitle: document.getElementById('edit-seo-title').value,
        sourceName: document.getElementById('edit-source-name').value,
        sourceUrl: document.getElementById('edit-source-url').value,
        image: document.getElementById('edit-image').value,
        imageCredit: document.getElementById('edit-image-credit').value
      };

      try {
        const res = await fetch('/api/admin/articles/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        btn.disabled = false;

        if (res.ok && data.success) {
          // Update in-memory article record
          Object.assign(currentlyEditingArticle, payload);
          if (data.sha) currentlyEditingArticle.sha = data.sha;
          currentlyEditingArticle.wordCount = data.wordCount || payload.body.trim().split(/\s+/).filter(Boolean).length;
          currentlyEditingArticle.modified = data.modified;

          const timeStr = new Date(data.modified).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          saveStatus.className = 'save-status-text saved';
          saveStatus.innerText = 'Saved successfully • Modified: ' + timeStr + (data.sha ? ' (Git SHA: ' + data.sha.slice(0, 7) + ')' : '');

          showToast('Saved successfully (' + timeStr + ')', 'success');
          renderArticleTable();
          renderOverviewRecent();
        } else if (res.status === 409 || data.conflict) {
          saveStatus.className = 'save-status-text error';
          saveStatus.innerText = 'Conflict: Article changed in GitHub';
          showToast('This article changed in GitHub since you opened it. Reload before saving.', 'error');
        } else {
          saveStatus.className = 'save-status-text error';
          saveStatus.innerText = 'Save error: ' + (data.error || 'Server rejected');
          showToast(data.error || 'Failed to save', 'error');
        }
      } catch (err) {
        btn.disabled = false;
        saveStatus.className = 'save-status-text error';
        saveStatus.innerText = 'Network error during save';
        showToast('Save failed: Network error', 'error');
      }
    }

    // -------------------------------------------------------------
    // Public Presentation Preview Modal
    // -------------------------------------------------------------
    async function openPreviewModal(relPath) {
      closeArticleDrawer();
      const art = articles.find(a => a.relPath === relPath);
      if (!art) return;
      if (typeof art.body !== 'string') {
        try {
          const res = await fetch('/api/admin/articles/get?relPath=' + encodeURIComponent(relPath));
          if (res.ok) {
            const data = await res.json();
            if (data.success) {
              art.body = data.body || '';
              art.sha = data.sha || null;
            }
          }
        } catch (_) {}
      }
      renderPreview(art);
    }

    function previewCurrentEditorArticle() {
      if (!currentlyEditingArticle) return;
      const previewData = {
        ...currentlyEditingArticle,
        title: document.getElementById('edit-headline').value,
        dek: document.getElementById('edit-dek').value,
        body: document.getElementById('edit-body').value,
        why_it_matters: document.getElementById('edit-why-it-matters').value,
        what_happens_next: document.getElementById('edit-what-happens-next').value,
        category: document.getElementById('edit-category').value,
        author: document.getElementById('edit-author').value,
        image: document.getElementById('edit-image').value,
        imageCredit: document.getElementById('edit-image-credit').value,
        sourceName: document.getElementById('edit-source-name').value
      };
      renderPreview(previewData);
    }

    function renderPreview(art) {
      const bodyEl = document.getElementById('preview-modal-body');
      const deskBadge = getDeskBadge(art.category);

      let html = '<div style="margin-bottom: 16px;">' +
        '<div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--color-subtle); margin-bottom: 6px;">Samachar Daily &bull; ' + escapeHtml(art.category) + '</div>' +
        '<h1 style="font-family: var(--font-serif); font-size: 26px; font-weight: 700; line-height: 1.3; color: #0f172a; margin-bottom: 12px;">' + escapeHtml(art.title) + '</h1>' +
        (art.dek ? '<p style="font-size: 16px; line-height: 1.5; color: #475569; font-style: italic; margin-bottom: 16px;">' + escapeHtml(art.dek) + '</p>' : '') +
        '<div style="display: flex; gap: 12px; font-size: 12px; color: var(--color-subtle); padding-bottom: 16px; border-bottom: 1px solid var(--color-border); margin-bottom: 20px;">' +
          '<span>By <strong>' + escapeHtml(art.author || 'SamacharDaily Editorial Team') + '</strong></span>' +
          '<span>&bull;</span>' +
          '<span>Published: ' + formatDate(art.date) + '</span>' +
        '</div>' +
      '</div>';

      if (art.image) {
        html += '<div>' +
          '<img src="' + art.image + '" alt="' + escapeHtml(art.title) + '" class="preview-hero-img">' +
          '<div class="preview-img-credit">Photo Credit: ' + escapeHtml(art.imageCredit || 'Wire Agency') + '</div>' +
        '</div>';
      }

      // Convert Markdown body paragraphs cleanly
      const paragraphs = (art.body || '').split(/\n\s*\n/).filter(Boolean);
      html += '<div class="preview-article-body">';
      paragraphs.forEach(p => {
        const trimmed = p.trim();
        if (trimmed.startsWith('## ')) {
          html += '<h2 style="font-size: 20px; font-weight: 700; margin: 24px 0 12px; font-family: var(--font-stack);">' + escapeHtml(trimmed.substring(3)) + '</h2>';
        } else if (trimmed.startsWith('### ')) {
          html += '<h3 style="font-size: 17px; font-weight: 700; margin: 20px 0 10px; font-family: var(--font-stack);">' + escapeHtml(trimmed.substring(4)) + '</h3>';
        } else if (trimmed.startsWith('> ')) {
          html += '<blockquote style="border-left: 3px solid var(--color-brand); padding-left: 16px; font-style: italic; color: #334155; margin: 16px 0;">' + escapeHtml(trimmed.substring(2)) + '</blockquote>';
        } else {
          html += '<p>' + escapeHtml(trimmed) + '</p>';
        }
      });
      html += '</div>';

      if (art.why_it_matters) {
        html += '<div class="preview-callout">' +
          '<strong style="color: var(--color-brand); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">Why It Matters</strong>' +
          '<div style="font-size: 14px; line-height: 1.6; color: #1e293b;">' + escapeHtml(art.why_it_matters) + '</div>' +
        '</div>';
      }

      if (art.what_happens_next) {
        html += '<div style="background: var(--color-surface-alt); padding: 16px 20px; border-radius: var(--radius-sm); margin: 20px 0; border: 1px solid var(--color-border);">' +
          '<strong style="color: var(--color-ink); font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 6px;">What Happens Next</strong>' +
          '<div style="font-size: 14px; line-height: 1.6; color: #475569;">' + escapeHtml(art.what_happens_next) + '</div>' +
        '</div>';
      }

      if (art.sourceName) {
        html += '<div style="font-size: 12px; color: var(--color-subtle); margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--color-border);">' +
          'Dispatched via verified wire attribution: <strong>' + escapeHtml(art.sourceName) + '</strong>' +
        '</div>';
      }

      bodyEl.innerHTML = html;
      document.getElementById('preview-modal').style.display = 'flex';
    }

    function closePreviewModal(e) {
      if (e && e.target && e.target.id !== 'preview-modal' && !e.target.classList.contains('drawer-close') && !e.target.classList.contains('btn-reset')) return;
      document.getElementById('preview-modal').style.display = 'none';
    }

    // -------------------------------------------------------------
    // Archive & Restore Flows
    // -------------------------------------------------------------
    function promptArchiveArticle(relPath) {
      closeArticleDrawer();
      const art = articles.find(a => a.relPath === relPath);
      if (!art) return;

      openConfirmModal({
        title: 'Archive Article?',
        body: 'Archiving <strong>' + escapeHtml(art.title) + '</strong> sets it to <code>noindex: true</code>.<br><br>It will be safely excluded from search sitemaps while preserving the original source for restoration at any time.',
        confirmLabel: 'Archive Article',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          try {
            const res = await fetch('/api/admin/articles/archive', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, sha: art.sha || null })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              art.noindex = true;
              art.articleType = 'noindexed';
              if (data.sha) art.sha = data.sha;
              renderArticleTable();
              renderOverviewRecent();
              showToast('Article archived (set to noindex)', 'warning');
            } else if (res.status === 409 || data.conflict) {
              showToast('This article changed in GitHub since you opened it. Reload before saving.', 'error');
            } else {
              showToast(data.error || 'Failed to archive', 'error');
            }
          } catch (e) {
            showToast('Network error during archive', 'error');
          }
        }
      });
    }

    function promptRestoreArticle(relPath) {
      closeArticleDrawer();
      const art = articles.find(a => a.relPath === relPath);
      if (!art) return;

      openConfirmModal({
        title: 'Restore Article to Active?',
        body: 'Restore <strong>' + escapeHtml(art.title) + '</strong> to active search indexation? This removes the <code>noindex</code> flag and includes it in sitemap feeds.',
        confirmLabel: 'Restore to Active',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          try {
            const res = await fetch('/api/admin/articles/restore', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, sha: art.sha || null })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              delete art.noindex;
              art.articleType = 'active';
              if (data.sha) art.sha = data.sha;
              renderArticleTable();
              renderOverviewRecent();
              showToast('Article restored to active status', 'success');
            } else if (res.status === 409 || data.conflict) {
              showToast('This article changed in GitHub since you opened it. Reload before saving.', 'error');
            } else {
              showToast(data.error || 'Failed to restore', 'error');
            }
          } catch (e) {
            showToast('Network error during restore', 'error');
          }
        }
      });
    }

    // -------------------------------------------------------------
    // Guarded Destructive Delete Flow
    // -------------------------------------------------------------
    function promptDeleteArticle(relPath) {
      closeArticleDrawer();
      const art = articles.find(a => a.relPath === relPath);
      if (!art) return;

      if (art.articleType === 'redirect') {
        alert('Cannot delete redirect stub. Redirect stubs protect canonical backlinks and prevent crawl penalties.');
        return;
      }

      openConfirmModal({
        title: 'Guarded Action: Delete Article?',
        body: '<strong>Warning:</strong> This article has been published and has an active public URL (<a href="' + art.url + '" target="_blank">' + art.url + '</a>).<br><br>' +
              'Permanent deletion will remove the Markdown source file from disk. It may cause search crawl penalties and broken external citations.<br><br>' +
              'To confirm deletion, please type <strong>DELETE</strong> below:',
        inputRequired: 'DELETE',
        confirmLabel: 'Permanently Delete',
        danger: true,
        onConfirm: async () => {
          closeConfirmModal();
          try {
            const res = await fetch('/api/admin/articles/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, confirmTitle: 'DELETE', sha: art.sha || null })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              const idx = articles.findIndex(a => a.relPath === relPath);
              if (idx !== -1) articles.splice(idx, 1);
              applyFiltersAndSorting();
              renderOverviewRecent();
              showToast('Article deleted permanently from corpus', 'error');
            } else if (res.status === 409 || data.conflict) {
              showToast('This article changed in GitHub since you opened it. Reload before saving.', 'error');
            } else {
              showToast(data.error || 'Failed to delete article', 'error');
            }
          } catch (e) {
            showToast('Network error during deletion', 'error');
          }
        }
      });
    }

    // -------------------------------------------------------------
    // Confirmation Modal Helper
    // -------------------------------------------------------------
    let currentConfirmCallback = null;

    function openConfirmModal(config) {
      const modal = document.getElementById('confirm-modal');
      document.getElementById('confirm-modal-title').innerText = config.title;

      let bodyHtml = '<div style="font-size: 13px; line-height: 1.6; color: var(--color-ink);">' + config.body + '</div>';
      if (config.inputRequired) {
        bodyHtml += '<div style="margin-top: 14px;">' +
          '<input type="text" id="confirm-input-phrase" class="input-sm" style="font-weight: 700; letter-spacing: 1px;" placeholder="Type ' + config.inputRequired + ' to confirm">' +
        '</div>';
      }
      document.getElementById('confirm-modal-body').innerHTML = bodyHtml;

      const btnClass = config.danger ? 'btn-action-primary' : 'btn-action-primary';
      const btnColor = config.danger ? 'background: #dc2626;' : '';

      let footerHtml = '<button class="btn-reset" onclick="closeConfirmModal()">Cancel</button>' +
        '<button class="' + btnClass + '" style="' + btnColor + '" id="btn-modal-confirm">' + config.confirmLabel + '</button>';
      document.getElementById('confirm-modal-footer').innerHTML = footerHtml;

      currentConfirmCallback = () => {
        if (config.inputRequired) {
          const input = document.getElementById('confirm-input-phrase');
          if (!input || input.value.trim().toUpperCase() !== config.inputRequired) {
            alert('Confirmation phrase does not match. Action aborted.');
            return;
          }
        }
        if (config.onConfirm) config.onConfirm();
      };

      document.getElementById('btn-modal-confirm').onclick = currentConfirmCallback;
      modal.style.display = 'flex';

      if (config.inputRequired) {
        setTimeout(() => {
          const inp = document.getElementById('confirm-input-phrase');
          if (inp) inp.focus();
        }, 100);
      }
    }

    function closeConfirmModal(e) {
      if (e && e.target && e.target.id !== 'confirm-modal' && !e.target.classList.contains('drawer-close') && !e.target.classList.contains('btn-reset')) return;
      document.getElementById('confirm-modal').style.display = 'none';
      currentConfirmCallback = null;
    }

    // -------------------------------------------------------------
    // Needs Attention & Safety Table Rendering
    // -------------------------------------------------------------
    function renderNeedsAttentionTab() {
      const tbody = document.getElementById('attn-table-body');
      if (!tbody) return;

      const list = Array.isArray(window.__NEEDS_ATTENTION__) ? window.__NEEDS_ATTENTION__ : [];
      let html = '';
      list.forEach((item, idx) => {
        let sevBadge = '<span class="badge badge-gray">' + item.severity + '</span>';
        if (item.severity === 'HIGH') sevBadge = '<span class="badge badge-red">HIGH</span>';
        else if (item.severity === 'MEDIUM') sevBadge = '<span class="badge badge-amber">MEDIUM</span>';
        else if (item.severity === 'INFO') sevBadge = '<span class="badge badge-teal">INFO</span>';

        html += '<tr>' +
          '<td style="color: var(--color-subtle);">' + (idx + 1) + '</td>' +
          '<td>' +
            '<div class="td-article-title" onclick="openArticleDrawer(\'' + escapeJs(item.relPath) + '\')">' + escapeHtml(item.title) + '</div>' +
            '<div class="td-article-url">' + escapeHtml(item.relPath) + '</div>' +
          '</td>' +
          '<td>' + sevBadge + '</td>' +
          '<td><strong>' + escapeHtml(item.problem) + '</strong><div style="font-size: 11px; color: var(--color-muted);">' + escapeHtml(item.reason) + '</div></td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + escapeHtml(item.recommendedAction) + '</td>' +
          '<td style="text-align: right;">' +
            '<button class="btn-action-primary" onclick="openArticleEditor(\'' + escapeJs(item.relPath) + '\')">Edit</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function renderSafetyTab() {
      const tbody = document.getElementById('safety-table-body');
      if (!tbody) return;

      const list = Array.isArray(window.__SENSITIVE__) ? window.__SENSITIVE__ : [];
      let html = '';
      list.forEach((item, idx) => {
        const flags = (item.flags || []).map(f => '<span class="badge badge-amber">' + f + '</span>').join(' ');
        html += '<tr>' +
          '<td style="color: var(--color-subtle);">' + (idx + 1) + '</td>' +
          '<td>' +
            '<div class="td-article-title" onclick="openArticleDrawer(\'' + escapeJs(item.relPath) + '\')">' + escapeHtml(item.title) + '</div>' +
            '<div class="td-article-url">Src: ' + escapeHtml(item.source) + ' &bull; ' + escapeHtml(item.relPath) + '</div>' +
          '</td>' +
          '<td>' + getDeskBadge(item.category) + '</td>' +
          '<td>' + flags + '</td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + formatDate(item.date) + '</td>' +
          '<td style="text-align: right;">' +
            '<button class="btn-action-primary" onclick="openArticleEditor(\'' + escapeJs(item.relPath) + '\')">Edit</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    // -------------------------------------------------------------
    // Helper Formatting & Utilities
    // -------------------------------------------------------------
    function getDeskBadge(cat) {
      const c = (cat || '').toLowerCase();
      let badgeClass = 'badge-gray';
      if (c === 'india') badgeClass = 'badge-red';
      else if (c === 'world') badgeClass = 'badge-blue';
      else if (c === 'business') badgeClass = 'badge-green';
      else if (c === 'tech') badgeClass = 'badge-purple';
      else if (c === 'sports') badgeClass = 'badge-amber';
      return '<span class="badge ' + badgeClass + '">' + escapeHtml(cat || 'General') + '</span>';
    }

    function getStatusBadge(art) {
      if (art.articleType === 'redirect') {
        return '<span class="badge badge-teal">Redirect</span>';
      } else if (art.noindex) {
        return '<span class="badge badge-amber">Archived</span>';
      }
      return '<span class="badge badge-green">Published</span>';
    }

    function getHealthIndicator(art) {
      if (attentionMap.has(art.relPath)) {
        const prob = attentionMap.get(art.relPath);
        if (prob.severity === 'HIGH') {
          return '<span style="display: flex; align-items: center;"><span class="health-dot critical"></span>Critical</span>';
        }
        return '<span style="display: flex; align-items: center;"><span class="health-dot warning"></span>Warning</span>';
      }
      return '<span style="display: flex; align-items: center;"><span class="health-dot healthy"></span>Healthy</span>';
    }

    function formatDate(d) {
      if (!d) return 'N/A';
      try {
        return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch (e) {
        return String(d);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeJs(str) {
      if (!str) return '';
      return String(str).replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

    function toggleDropdown(btn) {
      document.querySelectorAll('.dropdown-content').forEach(d => {
        if (d !== btn.nextElementSibling) d.classList.remove('show');
      });
      const menu = btn.nextElementSibling;
      if (menu) menu.classList.toggle('show');
    }

    window.onclick = function(e) {
      if (!e.target.matches('.btn-action-more')) {
        document.querySelectorAll('.dropdown-content').forEach(d => d.classList.remove('show'));
      }
    };

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'toast ' + type;
      toast.innerHTML = '<span>' + (type === 'success' ? '&#10003;' : (type === 'error' ? '&#9888;' : '&#8505;')) + '</span> <span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Initialize on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      renderOverviewRecent();
      applyFiltersAndSorting();
      renderNeedsAttentionTab();
      renderSafetyTab();
    });
  </script>
</body>
</html>
