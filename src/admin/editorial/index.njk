          btnRefresh.innerText = 'Refresh';
          btnRefresh.style.display = 'inline-block';
        }
        if (btnDisconnect) {
          btnDisconnect.innerText = 'Disconnect';
          btnDisconnect.style.display = 'inline-block';
        }
        if (promoCard) promoCard.style.display = 'none';

        if (lastSyncedChip && GSCState.lastSynced) {
          try {
            const syncDate = new Date(GSCState.lastSynced);
            lastSyncedChip.innerText = 'Last synced: ' + syncDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          } catch (e) {}
        }

        if (ovGscBadge) {
          ovGscBadge.className = 'badge badge-green';
          ovGscBadge.innerText = 'CONNECTED';
        }
      } else {
        if (statusBadge) {
          statusBadge.className = 'badge badge-amber';
          statusBadge.innerHTML = '<span class="badge-dot amber"></span> Not connected';
        }
        if (btnConnect) {
          btnConnect.innerText = 'Connect Google Search Console';
          btnConnect.style.display = 'inline-block';
