      <div id="tq-modal-meta-strip" style="padding: 12px 20px; font-size: 12px; color: var(--color-subtle); background: var(--color-surface-alt); border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
        <div><strong>Desk:</strong> <span id="tq-modal-desk">Tech</span></div>
        <div><strong>Date:</strong> <span id="tq-modal-date">2026-09-20</span></div>
        <div><strong>Words:</strong> <span id="tq-modal-words">120</span></div>
        <div><strong>Chars:</strong> <span id="tq-modal-chars">720</span></div>
        <div><strong>Paras:</strong> <span id="tq-modal-paras">2</span></div>
        <div><strong>Status:</strong> <span id="tq-modal-review-status" class="badge badge-gray">Unreviewed</span></div>
      </div>

      <div class="modal-body" id="tq-modal-body" style="max-height: 60vh; overflow-y: auto; padding: 20px;">
        <!-- Injected via JavaScript -->
      </div>

      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; gap: 8px;">
          <button class="btn-table-action" type="button" id="tq-modal-btn-mark-reviewed" onclick="markThinItemReviewed()">Mark Reviewed</button>
          <button class="btn-table-action" type="button" id="tq-modal-btn-dismiss" onclick="dismissThinItemFlag()">Dismiss Flag</button>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn-table-action btn-table-primary" type="button" id="tq-modal-btn-editor" onclick="openEditorFromThinQueue()">Open Article Editor</button>
          <a class="btn-table-action" id="tq-modal-btn-live" href="#" target="_blank" rel="noopener">View Live Article</a>
          <button class="btn-table-action" type="button" onclick="closeThinDetailModal()">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Editorial Safety Inspection Modal (Phase 9) -->
  <div id="safety-inspection-modal" class="modal-backdrop" onclick="closeSafetyModal(event)">
    <div class="modal-box preview-mode" onclick="event.stopPropagation()" style="max-width: 840px;">
      <div class="modal-header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span class="badge badge-gray" id="safety-modal-gate-badge">Unchecked</span>
          <div class="modal-title" id="safety-modal-title">Editorial Safety &amp; Integrity Analysis</div>
        </div>
        <button class="btn-close-modal" type="button" onclick="closeSafetyModal()">&times;</button>
      </div>

      <div id="safety-modal-meta-strip" style="padding: 10px 20px; font-size: 12px; color: var(--color-subtle); background: var(--color-surface-alt); border-bottom: 1px solid var(--color-border); display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between;">
        <div style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
          <div><strong>Revision SHA:</strong> <span id="safety-modal-sha" style="font-family: var(--font-mono); font-size: 11px;">Unsaved</span></div>
          <div><strong>Checked:</strong> <span id="safety-modal-checked-at">Not checked yet</span></div>
          <div><strong>Persistence:</strong> <span id="safety-modal-kv-status" class="badge badge-gray">Pending</span></div>
        </div>
        <div id="safety-modal-signoff-status" style="font-size: 11px; font-weight: 500;"></div>
      </div>

      <!-- Navigation tabs inside modal -->
      <div style="display: flex; gap: 4px; padding: 10px 20px 0; border-bottom: 1px solid var(--color-border); background: var(--color-surface); overflow-x: auto;">
        <button class="btn-table-action active" id="safety-tab-all" onclick="switchSafetyModalTab('all')" style="font-size: 12px; padding: 4px 10px;">Summary Overview</button>
        <button class="btn-table-action" id="safety-tab-pii" onclick="switchSafetyModalTab('pii')" style="font-size: 12px; padding: 4px 10px;">Privacy / PII</button>
        <button class="btn-table-action" id="safety-tab-claims" onclick="switchSafetyModalTab('claims')" style="font-size: 12px; padding: 4px 10px;">Claims &amp; Facts</button>
        <button class="btn-table-action" id="safety-tab-source" onclick="switchSafetyModalTab('source')" style="font-size: 12px; padding: 4px 10px;">Source Attribution</button>
        <button class="btn-table-action" id="safety-tab-sensitivity" onclick="switchSafetyModalTab('sensitivity')" style="font-size: 12px; padding: 4px 10px;">Sensitive Topics</button>
        <button class="btn-table-action" id="safety-tab-media" onclick="switchSafetyModalTab('media')" style="font-size: 12px; padding: 4px 10px;">Media Rights</button>
      </div>

      <div class="modal-body" id="safety-modal-body" style="max-height: 55vh; overflow-y: auto; padding: 20px;">
        <!-- Injected via JavaScript -->
      </div>

      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid var(--color-border); padding: 12px 20px;">
        <div id="safety-signoff-container" style="display: flex; align-items: center; gap: 8px;">
          <input type="text" id="safety-signoff-notes" class="form-input-sm" placeholder="Editorial rationale (optional)..." style="width: 220px; font-size: 12px; padding: 4px 8px;">
          <button class="btn-table-action" type="button" id="btn-safety-signoff" onclick="handleSafetySignoff()" style="font-size: 12px;">Editorial Sign-Off</button>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn-table-action" type="button" id="btn-re-safety-check" onclick="runSafetyCheckFromEditor(false)" style="font-size: 12px;">Re-run Check</button>
          <button class="btn-table-action" type="button" onclick="closeSafetyModal()" style="font-size: 12px;">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirm-modal" class="modal-backdrop" onclick="closeConfirmModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div class="modal-title" id="confirm-modal-title">Confirm Action</div>
        <button class="btn-close-modal" onclick="closeConfirmModal()">&times;</button>
      </div>
      <div class="modal-body" id="confirm-modal-body">
        <!-- Injected via JavaScript -->
      </div>
      <div class="modal-footer" id="confirm-modal-footer">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="toast-container"></div>

  <!-- ======================================================================
       CLIENT APPLICATION JAVASCRIPT STATE ENGINE
       ====================================================================== -->
  <script>
    // Master Injected Data from Eleventy Build
    window.__CORPUS__ = {{ editorial.masterArticlesJson | safe }};
    window.__NEEDS_ATTENTION__ = {{ editorial.needsAttentionJson | safe }};
    window.__SENSITIVE__ = {{ editorial.sensitiveArticlesJson | safe }};
    window.__THIN_QUEUE__ = {{ editorial.thinContentQueueJson | safe }};
    window.__THIN_STATS__ = {{ editorial.thinContentStatsJson | safe }};

    // Central Application State
    const AppState = {
      currentView: 'overview',
      articleSubView: 'list', // 'list' | 'editor'
      currentlyEditingArticle: null,
      articles: Array.isArray(window.__CORPUS__) ? window.__CORPUS__ : [],
      filteredArticles: [],
      selectedIds: new Set(),
      pagination: {
        page: 1,
        pageSize: 25
      },
      filters: {
        search: '',
        desk: 'ALL',
        status: 'ALL',
        health: 'ALL',
        date: 'ALL',
        sort: 'newest'
      }
    };

    AppState.filteredArticles = [...AppState.articles];

    // Fast lookup map for attention items
    const attentionMap = new Map();
    (Array.isArray(window.__NEEDS_ATTENTION__) ? window.__NEEDS_ATTENTION__ : []).forEach(item => {
      if (item.relPath) attentionMap.set(item.relPath, item);
    });

    // ========================================================================
    // SINGLE-SOURCE NAVIGATION ROUTER
    // ========================================================================
    function navigate(viewId, options = {}) {
      const validViews = ['overview', 'articles', 'thin-queue', 'attention', 'safety', 'search', 'website', 'broken-links', 'google-news', 'settings'];
      if (!validViews.includes(viewId)) viewId = 'overview';

      const prevView = AppState.currentView;
      AppState.currentView = viewId;

      // Handle subviews for articles
      if (viewId === 'articles') {
        if (options.subview === 'editor') {
          AppState.articleSubView = 'editor';
        } else {
          AppState.articleSubView = 'list';
          if (!options.fromEditor && !options.fromGlobalSearch) {
            // Fresh entry into articles list view: always reset search & filters to avoid sticky state
            resetArticleFilters(Boolean(options.status));
            if (options.status) {
              AppState.filters.status = options.status;
              const filterEl = document.getElementById('filter-status');
              if (filterEl) filterEl.value = options.status;
              applyFiltersAndSorting();
            }
          } else {
            // Returning from editor or global search: ensure table reflects all recent mutations immediately
            applyFiltersAndSorting();
          }
        }
      } else {
        AppState.articleSubView = 'list';
        // Clear global search and selection when leaving articles view
        if (prevView === 'articles') {
          const globalSearch = document.getElementById('global-search-input');
          if (globalSearch) globalSearch.value = '';
          AppState.selectedIds.clear();
          updateBulkToolbar();
        }
      }

      // Synchronize View Panes
      document.querySelectorAll('.view-pane').forEach(el => el.classList.remove('active'));
      const activePane = document.getElementById('view-' + viewId);
      if (activePane) {
        activePane.classList.add('active');
      } else {
        // Fallback: never leave page blank
        const fallback = document.getElementById('view-overview');
        if (fallback) fallback.classList.add('active');
      }

      // Synchronize View Content Deterministically
      if (viewId === 'overview') {
        populateOverviewStats();
      } else if (viewId === 'thin-queue') {
        applyThinQueueFilters();
      } else if (viewId === 'attention') {
        renderNeedsAttentionTab();
      } else if (viewId === 'safety') {
        renderSafetyTab();
      }

      // Synchronize Articles Subviews
      const listContainer = document.getElementById('articles-list-container');
      const editorContainer = document.getElementById('articles-editor-container');
      if (listContainer && editorContainer) {
        if (viewId === 'articles' && AppState.articleSubView === 'editor') {
          listContainer.style.display = 'none';
          editorContainer.classList.add('show');
        } else {
          listContainer.style.display = 'block';
          editorContainer.classList.remove('show');
        }
      }

      // Synchronize Sidebar Active State
      document.querySelectorAll('.saas-sidebar .nav-item').forEach(btn => {
        if (btn.getAttribute('data-view') === viewId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Synchronize Topbar Breadcrumb
      const breadcrumbEl = document.getElementById('top-breadcrumb');
      if (breadcrumbEl) {
        const labels = {
          'overview': 'Overview',
          'articles': AppState.articleSubView === 'editor' ? 'Articles / Writing Studio' : 'Articles',
          'thin-queue': 'Thin Content Queue',
          'attention': 'Needs Attention',
          'safety': 'Safety Governance',
          'search': 'Search Performance',
          'website': 'Website Health',
          'broken-links': 'Broken Links',
          'google-news': 'Google News',
          'settings': 'Settings'
        };
        breadcrumbEl.innerText = labels[viewId] || 'Overview';
      }

      // Update URL search parameters smoothly without flooding browser history
      if (!options.fromPopState) {
        const url = new URL(window.location);
        const currentParamView = url.searchParams.get('view') || 'overview';
        url.searchParams.set('view', viewId);
        if (viewId === 'articles' && AppState.articleSubView === 'editor' && AppState.currentlyEditingArticle) {
          url.searchParams.set('article', AppState.currentlyEditingArticle.slug || 'edit');
          url.searchParams.set('mode', 'edit');
        } else {
          url.searchParams.delete('article');
          url.searchParams.delete('mode');
        }
        if (currentParamView === viewId && (!options.subview || options.subview === 'list')) {
          window.history.replaceState({ view: viewId, subview: AppState.articleSubView }, '', url.toString());
        } else {
          window.history.pushState({ view: viewId, subview: AppState.articleSubView }, '', url.toString());
        }
      }

      // Close mobile drawer if open
      toggleMobileSidebar(false);

      // Scroll workspace to top
      const scrollWrap = document.getElementById('main-workspace-scroll');
      if (scrollWrap) scrollWrap.scrollTo({ top: 0, behavior: 'instant' });
    }

    // Handle Browser Back / Forward Buttons
    window.addEventListener('popstate', (e) => {
      const params = new URLSearchParams(window.location.search);
      const view = params.get('view') || 'overview';
      const artSlug = params.get('article');
      const mode = params.get('mode');

      if (view === 'articles' && mode === 'edit' && artSlug) {
        const art = AppState.articles.find(a => a.slug === artSlug || a.relPath.includes(artSlug));
        if (art) {
          openArticleEditor(art.relPath, { fromPopState: true });
          return;
        }
      }

      navigate(view, { fromPopState: true });
    });

    // Mobile Sidebar Drawer
    function toggleMobileSidebar(force) {
      const sidebar = document.getElementById('saas-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      if (!sidebar || !overlay) return;

      if (typeof force === 'boolean') {
        if (force) {
          sidebar.classList.add('mobile-open');
          overlay.classList.add('mobile-open');
        } else {
          sidebar.classList.remove('mobile-open');
          overlay.classList.remove('mobile-open');
        }
      } else {
        sidebar.classList.toggle('mobile-open');
        overlay.classList.toggle('mobile-open');
      }
    }

    // Global Quick Search (Keyboard '/')
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        e.preventDefault();
        const searchInput = document.getElementById('global-search-input');
        if (searchInput) searchInput.focus();
      }
    });

    // Debounce helper for silky performance
    function debounce(fn, delay = 180) {
      let timer = null;
      return function (...args) {
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          fn.apply(this, args);
        }, delay);
      };
    }

    const debouncedGlobalSearch = debounce((query) => {
      if (AppState.currentView !== 'articles' || AppState.articleSubView !== 'list') {
        navigate('articles', { fromGlobalSearch: true });
      }
      const tableInput = document.getElementById('table-search-input');
      if (tableInput) {
        tableInput.value = query;
      }
      AppState.filters.search = (query || '').toLowerCase().trim();
      AppState.pagination.page = 1;
      applyFiltersAndSorting();
    }, 200);

    function handleGlobalSearch(query) {
      debouncedGlobalSearch(query);
    }

    // Session Management & Logout
    async function verifyAuthSession() {
      try {
        const res = await fetch('/api/admin/session');
        if (res.ok) {
          const data = await res.json();
          if (!data || !data.authenticated) {
            window.location.replace('/admin/');
          }
        }
      } catch (e) {}
    }
    verifyAuthSession();

    async function handleLogout() {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch (e) {}
      window.location.replace('/admin/');
    }

    // ========================================================================
    // OVERVIEW POPULATION & STATS
    // ========================================================================
    function populateOverviewStats() {
      const total = AppState.articles.length;
      let active = 0;
      let archived = 0;
      let redirects = 0;
      let withAttribution = 0;
      const deskCounts = { india: 0, world: 0, business: 0, tech: 0, sports: 0 };

      AppState.articles.forEach(art => {
        if (art.articleType === 'redirect') redirects++;
        else if (art.noindex) archived++;
        else active++;

        if (art.hasSourceName || (art.sourceName && art.sourceName.trim())) withAttribution++;

        const d = (art.category || '').toLowerCase();
        if (deskCounts[d] !== undefined) deskCounts[d]++;
      });

      const attnCount = attentionMap.size;
      const safeCount = (Array.isArray(window.__SENSITIVE__) ? window.__SENSITIVE__.length : 0);

      // KPI Elements
      const elTotal = document.getElementById('ov-kpi-total');
      const elActive = document.getElementById('ov-kpi-active');
      const elArchived = document.getElementById('ov-kpi-archived');
      const elAttention = document.getElementById('ov-kpi-attention');

      if (elTotal) elTotal.innerText = total.toLocaleString();
      if (elActive) elActive.innerText = active.toLocaleString();
      if (elArchived) elArchived.innerText = archived.toLocaleString();
      if (elAttention) elAttention.innerText = attnCount.toLocaleString();

      // Sidebar badges
      const sideArt = document.getElementById('side-art-count');
      const sideAttn = document.getElementById('side-attn-count');
      const sideSafe = document.getElementById('side-safe-count');
      const sideThin = document.getElementById('side-thin-count');
      if (sideArt) sideArt.innerText = total.toLocaleString();
      if (sideAttn) sideAttn.innerText = attnCount.toLocaleString();
      if (sideSafe) sideSafe.innerText = safeCount.toLocaleString();
      if (sideThin) sideThin.innerText = (window.__THIN_STATS__ && typeof window.__THIN_STATS__.flaggedCount === 'number' ? window.__THIN_STATS__.flaggedCount : 0).toLocaleString();

      // Articles View Strip
      const artTot = document.getElementById('art-metric-total');
      const artAct = document.getElementById('art-metric-active');
      const artArc = document.getElementById('art-metric-archived');
      const artRed = document.getElementById('art-metric-redirects');
      if (artTot) artTot.innerText = total.toLocaleString();
      if (artAct) artAct.innerText = active.toLocaleString();
      if (artArc) artArc.innerText = archived.toLocaleString();
      if (artRed) artRed.innerText = redirects.toLocaleString();

      // Badges
      const bAttn = document.getElementById('attn-count-badge');
      const bSafe = document.getElementById('safety-count-badge');
      if (bAttn) bAttn.innerText = attnCount + ' Dispatches';
      if (bSafe) bSafe.innerText = safeCount + ' Dispatches';

      // Health ratios
      const indexablePct = total > 0 ? Math.round((active / total) * 100) : 0;
      const attribPct = total > 0 ? Math.round((withAttribution / total) * 100) : 0;

      const elIdxRatio = document.getElementById('ch-indexable-ratio');
      const elBarIdx = document.getElementById('ch-bar-indexable');
      if (elIdxRatio) elIdxRatio.innerText = active + ' (' + indexablePct + '%)';
      if (elBarIdx) elBarIdx.style.width = indexablePct + '%';

      const elAttRatio = document.getElementById('ch-attribution-ratio');
      const elBarAtt = document.getElementById('ch-bar-attribution');
      if (elAttRatio) elAttRatio.innerText = withAttribution + ' (' + attribPct + '%)';
      if (elBarAtt) elBarAtt.style.width = attribPct + '%';

      const elSafeCnt = document.getElementById('ch-sensitive-count');
      const elBarSafe = document.getElementById('ch-bar-sensitive');
      if (elSafeCnt) elSafeCnt.innerText = safeCount + ' flagged';
      if (elBarSafe) elBarSafe.style.width = Math.min(100, Math.round((safeCount / total) * 100 * 2.5)) + '%';

      const elRedCnt = document.getElementById('ch-redirects-count');
      const elBarRed = document.getElementById('ch-bar-redirects');
      if (elRedCnt) elRedCnt.innerText = redirects + ' active stubs';
      if (elBarRed) elBarRed.style.width = '12%';

      // Desk Distribution rendering
      const deskContainer = document.getElementById('desk-distribution-container');
      if (deskContainer) {
        const desks = [
          { key: 'india', label: 'India Desk', color: 'var(--color-brand)' },
          { key: 'world', label: 'World Desk', color: 'var(--color-blue)' },
          { key: 'business', label: 'Business Desk', color: 'var(--color-green)' },
          { key: 'tech', label: 'Tech Desk', color: 'var(--color-purple)' },
          { key: 'sports', label: 'Sports Desk', color: 'var(--color-amber)' }
        ];

        let html = '';
        desks.forEach(d => {
          const count = deskCounts[d.key] || 0;
          const pct = total > 0 ? Math.round((count / total) * 100) : 0;
          html += '<div class="stat-bar-item">' +
            '<div class="stat-bar-labels">' +
              '<span>' + d.label + '</span>' +
              '<span><strong>' + count.toLocaleString() + '</strong> (' + pct + '%)</span>' +
            '</div>' +
            '<div class="stat-bar-track">' +
              '<div class="stat-bar-fill" style="width: ' + pct + '%; background: ' + d.color + ';"></div>' +
            '</div>' +
          '</div>';
        });
        deskContainer.innerHTML = html;
      }

      // Small secondary recent feed
      const recentTbody = document.getElementById('overview-recent-body');
      if (recentTbody) {
        const recent = AppState.articles.slice(0, 5);
        let rHtml = '';
        recent.forEach(art => {
          rHtml += '<tr>' +
            '<td>' +
              '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">' + escapeHtml(art.title) + '</div>' +
              '<div class="row-article-sub">' + escapeHtml(art.url) + '</div>' +
            '</td>' +
            '<td>' + getDeskBadge(art.category) + '</td>' +
            '<td>' + getStatusBadge(art) + '</td>' +
            '<td style="font-size: 12px; color: var(--color-muted);">' + formatDate(art.date) + '</td>' +
            '<td style="text-align: right;">' +
              '<button class="btn-table-action btn-table-primary" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">Edit</button>' +
            '</td>' +
          '</tr>';
        });
        recentTbody.innerHTML = rHtml;
      }
    }

    // ========================================================================
    // ARTICLES SEARCH, FILTERING, SORTING & PAGINATION
    // ========================================================================
    const debouncedArticleSearch = debounce(() => {
      const input = document.getElementById('table-search-input');
      AppState.filters.search = input ? input.value.toLowerCase().trim() : '';
      AppState.pagination.page = 1;
      applyFiltersAndSorting();
    }, 180);

    function handleArticleSearch() {
      debouncedArticleSearch();
    }

    function handleArticleFilter() {
      const fDesk = document.getElementById('filter-desk');
      const fStatus = document.getElementById('filter-status');
      const fHealth = document.getElementById('filter-health');
      const fDate = document.getElementById('filter-date');
      const fSort = document.getElementById('filter-sort');

      if (fDesk) AppState.filters.desk = fDesk.value;
      if (fStatus) AppState.filters.status = fStatus.value;
      if (fHealth) AppState.filters.health = fHealth.value;
      if (fDate) AppState.filters.date = fDate.value;
      if (fSort) AppState.filters.sort = fSort.value;

      AppState.pagination.page = 1;
      applyFiltersAndSorting();
    }

    function resetArticleFilters(skipRender = false) {
      AppState.filters = {
        search: '',
        desk: 'ALL',
        status: 'ALL',
        health: 'ALL',
        date: 'ALL',
        sort: 'newest'
      };

      const tableInput = document.getElementById('table-search-input');
      const globalInput = document.getElementById('global-search-input');
      const fDesk = document.getElementById('filter-desk');
      const fStatus = document.getElementById('filter-status');
      const fHealth = document.getElementById('filter-health');
      const fDate = document.getElementById('filter-date');
      const fSort = document.getElementById('filter-sort');

      if (tableInput) tableInput.value = '';
      if (globalInput) globalInput.value = '';
      if (fDesk) fDesk.value = 'ALL';
      if (fStatus) fStatus.value = 'ALL';
      if (fHealth) fHealth.value = 'ALL';
      if (fDate) fDate.value = 'ALL';
      if (fSort) fSort.value = 'newest';

      AppState.pagination.page = 1;
      if (!skipRender) {
        applyFiltersAndSorting();
      }
    }

    function applyFiltersAndSorting() {
      const { search, desk, status, health, date, sort } = AppState.filters;

      AppState.filteredArticles = AppState.articles.filter(art => {
        // Search Filter
        if (search) {
          const matchTitle = (art.title || '').toLowerCase().includes(search);
          const matchSlug = (art.slug || '').toLowerCase().includes(search);
          const matchAuthor = (art.author || '').toLowerCase().includes(search);
          const matchSource = (art.sourceName || '').toLowerCase().includes(search);
          if (!matchTitle && !matchSlug && !matchAuthor && !matchSource) return false;
        }

        // Desk Filter
        if (desk !== 'ALL') {
          if ((art.category || '').toLowerCase() !== desk.toLowerCase()) return false;
        }

        // Status Filter
        if (status !== 'ALL') {
          if (status === 'published' && (art.noindex || art.articleType === 'redirect')) return false;
          if (status === 'archived' && !art.noindex) return false;
          if (status === 'redirect' && art.articleType !== 'redirect') return false;
        }

        // Health Filter
        if (health !== 'ALL') {
          if (health === 'healthy' && attentionMap.has(art.relPath)) return false;
          if (health === 'attention' && !attentionMap.has(art.relPath)) return false;
          if (health === 'sensitive' && !art.sensitiveTopic) return false;
          if (health === 'no_source' && (art.hasSourceName || (art.sourceName && art.sourceName.trim()))) return false;
        }

        // Date Filter
        if (date !== 'ALL' && art.date) {
          const artTime = new Date(art.date).getTime();
          const now = Date.now();
          if (date === 'today' && now - artTime > 86400000) return false;
          if (date === '7days' && now - artTime > 7 * 86400000) return false;
          if (date === '30days' && now - artTime > 30 * 86400000) return false;
        }

        return true;
      });

      // Sorting
      AppState.filteredArticles.sort((a, b) => {
        if (sort === 'newest') return new Date(b.date || 0) - new Date(a.date || 0);
        if (sort === 'oldest') return new Date(a.date || 0) - new Date(b.date || 0);
        if (sort === 'modified') return new Date(b.modified || b.date || 0) - new Date(a.modified || a.date || 0);
        if (sort === 'title_asc') return (a.title || '').localeCompare(b.title || '');
        if (sort === 'words_desc') return (b.wordCount || 0) - (a.wordCount || 0);
        if (sort === 'words_asc') return (a.wordCount || 0) - (b.wordCount || 0);
        return 0;
      });

      renderArticleTable();
    }

    function renderArticleTable() {
      const tbody = document.getElementById('article-table-body');
      const mobileContainer = document.getElementById('mobile-cards-container');
      const totalCount = AppState.filteredArticles.length;
      const pageSize = AppState.pagination.pageSize;
      const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));

      if (AppState.pagination.page > totalPages) AppState.pagination.page = totalPages;
      if (AppState.pagination.page < 1) AppState.pagination.page = 1;

      const page = AppState.pagination.page;
      const startIndex = (page - 1) * pageSize;
      const pageArticles = AppState.filteredArticles.slice(startIndex, startIndex + pageSize);

      // Update Pagination Indicators
      const elShown = document.getElementById('art-shown-count');
      const elTotal = document.getElementById('art-total-count');
      const elPageNum = document.getElementById('art-page-num');
      const elPageTotal = document.getElementById('art-page-total');
      const btnPrev = document.getElementById('art-prev-btn');
      const btnNext = document.getElementById('art-next-btn');

      if (elShown) elShown.innerText = pageArticles.length;
      if (elTotal) elTotal.innerText = totalCount.toLocaleString();
      if (elPageNum) elPageNum.innerText = page;
      if (elPageTotal) elPageTotal.innerText = totalPages;
      if (btnPrev) btnPrev.disabled = page <= 1;
      if (btnNext) btnNext.disabled = page >= totalPages;

      // Empty State Handling
      if (totalCount === 0) {
        const emptyHtml = '<tr><td colspan="8" style="text-align: center; padding: 48px 20px; color: var(--color-subtle);">' +
          '<div style="font-size: 16px; font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">No articles found</div>' +
          '<div style="font-size: 13px; margin-bottom: 16px;">Try adjusting your search terms or clearing active filters.</div>' +
          '<button class="btn-table-action" onclick="resetArticleFilters()">Reset All Filters</button>' +
          '</td></tr>';
        if (tbody) tbody.innerHTML = emptyHtml;
        if (mobileContainer) mobileContainer.innerHTML = '<div style="text-align: center; padding: 32px; color: var(--color-subtle);">No articles match current filters.</div>';
        return;
      }

      // Render Desktop Rows
      let tableHtml = '';
      let mobileHtml = '';

      pageArticles.forEach(art => {
        const isSelected = AppState.selectedIds.has(art.relPath);
        const isArchived = Boolean(art.noindex);
        const deskBadge = getDeskBadge(art.category);
        const statusBadge = getStatusBadge(art);
        const dateStr = formatDate(art.date);
        const wordsStr = (art.wordCount || 0).toLocaleString();
        const sourceStr = escapeHtml(art.sourceName || 'Unspecified');

        tableHtml += '<tr class="' + (isSelected ? 'selected' : '') + '">' +
          '<td style="text-align: center;">' +
            '<input type="checkbox" ' + (isSelected ? 'checked' : '') + ' onchange="toggleArticleSelection(\'' + escapeJs(art.relPath) + '\', this)">' +
          '</td>' +
          '<td>' +
            '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">' + escapeHtml(art.title) + '</div>' +
            '<div class="row-article-sub">' + escapeHtml(art.url) + '</div>' +
          '</td>' +
          '<td>' + deskBadge + '</td>' +
          '<td>' + statusBadge + '</td>' +
          '<td style="font-size: 12px; color: var(--color-muted); white-space: nowrap;">' + dateStr + '</td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + wordsStr + '</td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + sourceStr + '</td>' +
          '<td style="text-align: right; white-space: nowrap;">' +
            '<div style="display: flex; gap: 4px; justify-content: flex-end;">' +
              '<button class="btn-table-action btn-table-primary" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">Edit</button>' +
              '<button class="btn-table-action" onclick="openRevisionHistoryModal(\'' + escapeJs(art.relPath) + '\')">History</button>' +
              '<button class="btn-table-action" onclick="openPreviewModal(\'' + escapeJs(art.relPath) + '\')">Preview</button>' +
              (isArchived
                ? '<button class="btn-table-action" onclick="promptRestoreArticle(\'' + escapeJs(art.relPath) + '\')">Restore</button>'
                : '<button class="btn-table-action" onclick="promptArchiveArticle(\'' + escapeJs(art.relPath) + '\')">Archive</button>'
              ) +
              '<button class="btn-table-action btn-table-danger" onclick="promptDeleteArticle(\'' + escapeJs(art.relPath) + '\')">Delete</button>' +
            '</div>' +
          '</td>' +
        '</tr>';

        // Mobile Card Representation
        mobileHtml += '<div class="article-mobile-card">' +
          '<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">' +
            '<div style="display: flex; gap: 6px;">' + deskBadge + ' ' + statusBadge + '</div>' +
            '<span style="font-size: 11px; color: var(--color-subtle);">' + dateStr + '</span>' +
          '</div>' +
          '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">' + escapeHtml(art.title) + '</div>' +
          '<div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--color-muted); margin-top: 4px;">' +
            '<span>' + wordsStr + ' words</span>' +
            '<span>Source: ' + sourceStr + '</span>' +
          '</div>' +
          '<div style="display: flex; gap: 6px; margin-top: 8px; border-top: 1px solid var(--color-border); padding-top: 8px;">' +
            '<button class="btn-table-action btn-table-primary" style="flex: 1; justify-content: center;" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">Edit</button>' +
            '<button class="btn-table-action" style="flex: 1; justify-content: center;" onclick="openRevisionHistoryModal(\'' + escapeJs(art.relPath) + '\')">History</button>' +
            '<button class="btn-table-action" style="flex: 1; justify-content: center;" onclick="openPreviewModal(\'' + escapeJs(art.relPath) + '\')">Preview</button>' +
            (isArchived
              ? '<button class="btn-table-action" onclick="promptRestoreArticle(\'' + escapeJs(art.relPath) + '\')">Restore</button>'
              : '<button class="btn-table-action" onclick="promptArchiveArticle(\'' + escapeJs(art.relPath) + '\')">Archive</button>'
            ) +
            '<button class="btn-table-action btn-table-danger" onclick="promptDeleteArticle(\'' + escapeJs(art.relPath) + '\')">Delete</button>' +
          '</div>' +
        '</div>';
      });

      if (tbody) tbody.innerHTML = tableHtml;
      if (mobileContainer) mobileContainer.innerHTML = mobileHtml;

      // Synchronize master checkbox state with current page selection
      const master = document.getElementById('master-checkbox');
      if (master) {
        master.checked = pageArticles.length > 0 && pageArticles.every(art => AppState.selectedIds.has(art.relPath));
      }
    }

    function prevArticlePage() {
      if (AppState.pagination.page > 1) {
        AppState.pagination.page--;
        renderArticleTable();
        const scrollWrap = document.getElementById('main-workspace-scroll');
        if (scrollWrap) scrollWrap.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function nextArticlePage() {
      const totalPages = Math.ceil(AppState.filteredArticles.length / AppState.pagination.pageSize);
      if (AppState.pagination.page < totalPages) {
        AppState.pagination.page++;
        renderArticleTable();
        const scrollWrap = document.getElementById('main-workspace-scroll');
        if (scrollWrap) scrollWrap.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    // Bulk Checkbox Handling
    function handleMasterCheckbox(master) {
      const pageArticles = getCurrentlyPagedArticles();
      pageArticles.forEach(art => {
        if (master.checked) AppState.selectedIds.add(art.relPath);
        else AppState.selectedIds.delete(art.relPath);
      });
      updateBulkToolbar();
      renderArticleTable();
    }

    function toggleArticleSelection(relPath, checkbox) {
      if (checkbox.checked) AppState.selectedIds.add(relPath);
      else AppState.selectedIds.delete(relPath);

      const tr = checkbox.closest('tr');
      if (tr) tr.classList.toggle('selected', checkbox.checked);

      const pageArticles = getCurrentlyPagedArticles();
      const master = document.getElementById('master-checkbox');
      if (master) {
        master.checked = pageArticles.length > 0 && pageArticles.every(art => AppState.selectedIds.has(art.relPath));
      }

      updateBulkToolbar();
    }

    function updateBulkToolbar() {
      const bar = document.getElementById('bulk-toolbar');
      const countEl = document.getElementById('bulk-selected-count');
      const count = AppState.selectedIds.size;
      if (countEl) countEl.innerText = count;
      if (bar) {
        if (count > 0) bar.classList.add('show');
        else bar.classList.remove('show');
      }
    }

    function clearBulkSelection() {
      AppState.selectedIds.clear();
      updateBulkToolbar();
      const master = document.getElementById('master-checkbox');
      if (master) master.checked = false;
      renderArticleTable();
    }

    function getCurrentlyPagedArticles() {
      const page = AppState.pagination.page;
      const pageSize = AppState.pagination.pageSize;
      const startIndex = (page - 1) * pageSize;
      return AppState.filteredArticles.slice(startIndex, startIndex + pageSize);
    }

    // ========================================================================
    // ARTICLE WRITING STUDIO / EDITOR (CHILD WORKSPACE OF ARTICLES)
    // ========================================================================
    async function openArticleEditor(relPath, options = {}) {
      const art = AppState.articles.find(a => a.relPath === relPath);
      if (!art) return;

      AppState.currentlyEditingArticle = art;
      navigate('articles', { subview: 'editor', fromPopState: options.fromPopState });

      // Populate Form Fields
      document.getElementById('edit-headline').value = art.title || '';
      document.getElementById('edit-dek').value = art.dek || '';
      document.getElementById('edit-why-it-matters').value = art.why_it_matters || '';
      document.getElementById('edit-what-happens-next').value = art.what_happens_next || '';
      document.getElementById('edit-category').value = art.category || 'India';
      document.getElementById('edit-author').value = art.author || 'SamacharDaily Editorial Team';
      document.getElementById('edit-date-display').value = formatDate(art.date);
      document.getElementById('edit-slug').value = art.slug || '';
      document.getElementById('edit-url').value = 'https://thesamachardaily.in' + (art.url || '');
      document.getElementById('edit-seo-title').value = art.seoTitle || '';
      document.getElementById('edit-source-name').value = art.sourceName || '';
      document.getElementById('edit-source-url').value = art.sourceUrl || '';
      document.getElementById('edit-image').value = art.image || '';
      document.getElementById('edit-image-credit').value = art.imageCredit || '';

      updateImagePreview(art.image);
      initYouTubeWidgetState(art);

      const statusBadge = document.getElementById('editor-status-badge');
      if (art.noindex) {
        statusBadge.className = 'badge badge-amber';
        statusBadge.innerText = 'Archived (Noindex)';
      } else if (art.articleType === 'redirect') {
        statusBadge.className = 'badge badge-teal';
        statusBadge.innerText = 'Redirect Stub';
      } else {
        statusBadge.className = 'badge badge-green';
        statusBadge.innerText = 'Active (Published)';
      }

      updateEditorActionButtons(art);

      const saveStatus = document.getElementById('editor-save-status');

      // Check if full article body is already cached in memory
      if (typeof art.body === 'string') {
        document.getElementById('edit-body').value = art.body;
        updateWordCountLive();
        saveStatus.className = 'editor-save-indicator';
        saveStatus.innerText = art.sha ? ('Loaded (Git SHA: ' + art.sha.slice(0, 7) + ')') : 'Loaded dispatch';
      } else {
        document.getElementById('edit-body').value = 'Loading complete article body from repository...';
        saveStatus.className = 'editor-save-indicator';
        saveStatus.innerText = 'Fetching article body...';
        try {
          const res = await fetch('/api/admin/articles/get?relPath=' + encodeURIComponent(relPath));
          if (res.ok) {
            const data = await res.json();
            if (data.success) {
              art.body = data.body || '';
              art.sha = data.sha || null;
              if (data.data) {
                if (data.data.why_it_matters && !art.why_it_matters) {
                  art.why_it_matters = data.data.why_it_matters;
                  document.getElementById('edit-why-it-matters').value = art.why_it_matters;
                }
                if (data.data.what_happens_next && !art.what_happens_next) {
                  art.what_happens_next = data.data.what_happens_next;
                  document.getElementById('edit-what-happens-next').value = art.what_happens_next;
                }
                const loadedVid = (data.data.video_id !== undefined ? data.data.video_id : data.data.videoId) || (Array.isArray(data.data.videos) && data.data.videos[0] && data.data.videos[0].video_id) || '';
                const loadedCaption = (data.data.video_caption !== undefined ? data.data.video_caption : data.data.videoCaption) || (Array.isArray(data.data.videos) && data.data.videos[0] && data.data.videos[0].title) || '';
                art.video_id = loadedVid ? String(loadedVid).trim() : '';
                art.video_caption = loadedCaption ? String(loadedCaption).trim() : '';
                if (Array.isArray(data.data.videos) && data.data.videos.length > 0) {
                  art.videos = data.data.videos;
                } else if (art.video_id) {
                  art.videos = [{ video_id: art.video_id, title: art.video_caption || art.title || 'News Coverage', channel: 'YouTube' }];
                } else {
                  art.videos = [];
                }
                art.hasVideo = Boolean(art.video_id && art.video_id !== 'null');
                initYouTubeWidgetState(art);
              }
              document.getElementById('edit-body').value = art.body;
              updateWordCountLive();
              saveStatus.className = 'editor-save-indicator';
              saveStatus.innerText = art.sha ? ('Loaded (Git SHA: ' + art.sha.slice(0, 7) + ')') : 'Loaded dispatch';
            } else {
              saveStatus.className = 'editor-save-indicator error';
              saveStatus.innerText = 'Failed to load: ' + (data.error || 'Server error');
            }
          } else {
            saveStatus.className = 'editor-save-indicator error';
            saveStatus.innerText = 'Failed to fetch article (' + res.status + ')';
          }
        } catch (fetchErr) {
          saveStatus.className = 'editor-save-indicator error';
          saveStatus.innerText = 'Error loading article body';
        }
      }

      // Phase 9: Initialize and fetch cached safety status for this revision
      resetSafetyEditorState();
      fetchEditorialSafetyStatus(art);

      const scrollWrap = document.getElementById('main-workspace-scroll');
      if (scrollWrap) scrollWrap.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Crucial Bugfix: Cleanly closes editor and restores the Articles table
    // FIX: Pass fromEditor:true so navigate() preserves the prior article list
    // filter/search state (user was editing from a filtered list and should
    // return to the same list context), while immediately re-rendering the list.
