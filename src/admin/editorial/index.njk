    function closeThinDetailModal(event) {
      if (event && event.target && !event.target.classList.contains('modal-backdrop')) return;
      const modal = document.getElementById('thin-item-modal');
      if (modal) modal.classList.remove('show');
    }

    async function markThinItemReviewed() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;

      const slug = item.slug;
      try {
        const resp = await fetch('/api/admin/thin-queue/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, relPath: item.relPath, action: 'reviewed' })
        });
        if (resp.ok) {
          const resData = await resp.json().catch(() => ({}));
          if (resData.persisted === false) {
            showToast('Warning: Cloudflare KV is unavailable. State preserved in local session only, not permanently stored on server.', 'warning');
          } else {
            showToast('Article marked as reviewed. Audit event logged.', 'success');
          }
        } else {
          showToast('Warning: Server review failed. Review state updated in local session only.', 'warning');
        }
      } catch (_) {
        showToast('Warning: Connection failed. Review state updated in local session only.', 'warning');
      }

      ThinQueueState.reviewStates[slug] = {
        status: 'reviewed',
        reviewer: 'editor',
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
      } catch (_) {}

      renderThinQueueTable();
      openThinDetailModal(slug);
    }

    async function dismissThinItemFlag() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;

      const slug = item.slug;
      try {
        const resp = await fetch('/api/admin/thin-queue/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, relPath: item.relPath, action: 'dismissed' })
        });
        if (resp.ok) {
          const resData = await resp.json().catch(() => ({}));
          if (resData.persisted === false) {
            showToast('Warning: Cloudflare KV is unavailable. Flag dismissed in local session only, not permanently stored on server.', 'warning');
          } else {
            showToast('Flag dismissed for this article. Audit event logged.', 'info');
          }
        } else {
          showToast('Warning: Server update failed. Flag dismissed in local session only.', 'warning');
        }
      } catch (_) {
        showToast('Warning: Connection failed. Flag dismissed in local session only.', 'warning');
      }

      ThinQueueState.reviewStates[slug] = {
        status: 'dismissed',
        reviewer: 'editor',
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
      } catch (_) {}

      renderThinQueueTable();
      openThinDetailModal(slug);
    }

    function openEditorFromThinQueue() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;
      closeThinDetailModal();
      openArticleEditor(item.relPath);
    }

