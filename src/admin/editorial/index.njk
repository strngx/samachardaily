    function renderGSCChart() {
      const panel = document.getElementById('gsc-chart-panel');
      const container = document.getElementById('gsc-chart-container');
      const clicksEl = document.getElementById('gsc-chart-total-clicks');
      const imprEl = document.getElementById('gsc-chart-total-impr');
      const subtitleEl = document.getElementById('gsc-chart-subtitle');

      if (!panel || !container) return;

      const series = GSCState.dateSeries;
      if (!Array.isArray(series) || series.length < 2) {
        panel.style.display = 'none';
        return;
      }

      panel.style.display = 'block';

      let totalClicks = 0;
      let totalImpr = 0;
      let maxClicks = 1;
      let maxImpr = 1;

      series.forEach(pt => {
        totalClicks += (pt.clicks || 0);
        totalImpr += (pt.impressions || 0);
        if ((pt.clicks || 0) > maxClicks) maxClicks = pt.clicks;
        if ((pt.impressions || 0) > maxImpr) maxImpr = pt.impressions;
      });

      if (clicksEl) clicksEl.innerText = totalClicks.toLocaleString();
      if (imprEl) imprEl.innerText = totalImpr.toLocaleString();
      if (subtitleEl) {
        subtitleEl.innerText = series[0].date + ' to ' + series[series.length - 1].date + ' (' + series.length + ' data points) — 2-3 day GSC reporting latency applies';
      }

      const w = 1000;
      const h = 180;
      const padL = 40;
      const padR = 20;
      const padT = 20;
      const padB = 30;
      const plotW = w - padL - padR;
      const plotH = h - padT - padB;

      const clickPoints = series.map((pt, i) => {
        const x = padL + (i / (series.length - 1)) * plotW;
        const y = padT + plotH - ((pt.clicks || 0) / maxClicks) * plotH;
        return x.toFixed(1) + ',' + y.toFixed(1);
      });

      const imprPoints = series.map((pt, i) => {
        const x = padL + (i / (series.length - 1)) * plotW;
        const y = padT + plotH - ((pt.impressions || 0) / maxImpr) * plotH;
        return x.toFixed(1) + ',' + y.toFixed(1);
      });

      const clickPoly = padL + ',' + (padT + plotH) + ' ' + clickPoints.join(' ') + ' ' + (padL + plotW) + ',' + (padT + plotH);
      const imprPoly = padL + ',' + (padT + plotH) + ' ' + imprPoints.join(' ') + ' ' + (padL + plotW) + ',' + (padT + plotH);

