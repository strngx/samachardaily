    // ========================================================================
    // YOUTUBE VIDEO MANAGEMENT WIDGET (PHASE 13D)
    // ========================================================================
    function parseYouTubeVideoId(input) {
      if (!input || typeof input !== 'string') return null;
      const raw = input.trim();
      if (!raw) return null;

      // Direct 11-char ID check (e.g. dQw4w9WgXcQ)
      if (/^[a-zA-Z0-9_-]{11}$/.test(raw)) {
        return raw;
      }

      // Disallow dangerous schemes explicitly
      const lower = raw.toLowerCase();
      if (lower.startsWith('javascript:') || lower.startsWith('data:') || lower.startsWith('vbscript:')) {
        return null;
      }

      try {
        const urlStr = raw.startsWith('http://') || raw.startsWith('https://') ? raw : ('https://' + raw);
        const parsed = new URL(urlStr);
        const host = parsed.hostname.toLowerCase();

        // Allowed YouTube domains only
        const isStandardHost = host === 'youtube.com' || host === 'www.youtube.com' || host === 'm.youtube.com' || host === 'music.youtube.com';
        const isShortHost = host === 'youtu.be';

        if (!isStandardHost && !isShortHost) {
          return null;
        }

        if (isShortHost) {
          const pathId = parsed.pathname.replace(/^\/+/, '').split('/')[0];
          return /^[a-zA-Z0-9_-]{11}$/.test(pathId) ? pathId : null;
        }

        if (isStandardHost) {
          // Standard /watch?v=ID
          if (parsed.pathname === '/watch') {
            const v = parsed.searchParams.get('v');
            return (v && /^[a-zA-Z0-9_-]{11}$/.test(v)) ? v : null;
          }
          // Embed /embed/ID, /v/ID, /shorts/ID
          const segments = parsed.pathname.replace(/^\/+/, '').split('/');
          if (segments[0] === 'embed' || segments[0] === 'v' || segments[0] === 'shorts') {
            const id = segments[1];
            return (id && /^[a-zA-Z0-9_-]{11}$/.test(id)) ? id : null;
          }
        }
      } catch (_) {
        return null;
      }
      return null;
    }

    function initYouTubeWidgetState(art) {
      const vid = (art && art.video_id && String(art.video_id).trim() !== '' && String(art.video_id).trim() !== 'null')
        ? String(art.video_id).trim()
        : null;

      const viewExisting = document.getElementById('yt-view-existing');
      const viewNone = document.getElementById('yt-view-none');
      const viewEdit = document.getElementById('yt-view-edit');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const urlInput = document.getElementById('yt-url-input');

      if (viewEdit) viewEdit.style.display = 'none';
      if (previewWrap) previewWrap.style.display = 'none';
      if (previewIframe) previewIframe.src = '';
      if (validationFeedback) {
        validationFeedback.style.display = 'none';
        validationFeedback.innerText = '';
      }
      if (urlInput) urlInput.value = '';

      if (vid) {
        if (viewExisting) viewExisting.style.display = 'block';
        if (viewNone) viewNone.style.display = 'none';

        const thumbImg = document.getElementById('yt-thumb-img');
        const watchLink = document.getElementById('yt-watch-link');
        const titleEl = document.getElementById('yt-current-title');
        const idBadge = document.getElementById('yt-current-id-badge');

        const safeVid = encodeURIComponent(vid);
        if (thumbImg) thumbImg.src = 'https://img.youtube.com/vi/' + safeVid + '/hqdefault.jpg';
        if (watchLink) watchLink.href = 'https://www.youtube.com/watch?v=' + safeVid;
        if (titleEl) {
          titleEl.innerText = art.video_caption || art.title || 'Attached YouTube Video';
        }
        if (idBadge) {
          idBadge.innerText = 'ID: ' + vid;
        }
      } else {
        if (viewExisting) viewExisting.style.display = 'none';
        if (viewNone) viewNone.style.display = 'block';
      }
    }

    function enterYouTubeEditMode() {
      const art = AppState.currentlyEditingArticle;
      const viewExisting = document.getElementById('yt-view-existing');
      const viewNone = document.getElementById('yt-view-none');
      const viewEdit = document.getElementById('yt-view-edit');
      const urlInput = document.getElementById('yt-url-input');
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');

      if (viewExisting) viewExisting.style.display = 'none';
      if (viewNone) viewNone.style.display = 'none';
      if (viewEdit) viewEdit.style.display = 'block';

      if (previewWrap) previewWrap.style.display = 'none';
      if (previewIframe) previewIframe.src = '';
      if (validationFeedback) {
        validationFeedback.style.display = 'none';
        validationFeedback.innerText = '';
      }

      if (art && art.video_id) {
        urlInput.value = 'https://www.youtube.com/watch?v=' + art.video_id;
      } else {
        urlInput.value = '';
      }
      urlInput.focus();
    }

    function cancelYouTubeEditMode() {
      initYouTubeWidgetState(AppState.currentlyEditingArticle);
    }

    function handleYouTubeUrlInput(val) {
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');

      if (!val || !val.trim()) {
        validationFeedback.style.display = 'none';
        validationFeedback.innerText = '';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
        return;
      }

      const id = parseYouTubeVideoId(val);
      if (id) {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-green)';
        validationFeedback.innerText = 'Valid YouTube ID: ' + id;
      } else {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-red)';
        validationFeedback.innerText = 'Enter a valid YouTube URL or 11-character video ID.';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
      }
    }

    function previewEnteredYouTubeVideo() {
      const urlInput = document.getElementById('yt-url-input');
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');

      const val = urlInput.value || '';
      const id = parseYouTubeVideoId(val);
      if (!id) {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-red)';
        validationFeedback.innerText = 'Enter a valid YouTube URL or 11-character video ID.';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
        return;
      }

      validationFeedback.style.display = 'block';
      validationFeedback.style.color = 'var(--color-green)';
      validationFeedback.innerText = 'Valid YouTube ID: ' + id;

      const safeVid = encodeURIComponent(id);
      previewIframe.src = 'https://www.youtube.com/embed/' + safeVid;
      previewWrap.style.display = 'block';
    }

    function markEditorAsUnsaved() {
      const saveStatus = document.getElementById('editor-save-status');
      if (saveStatus) {
        saveStatus.className = 'editor-save-indicator';
        saveStatus.innerText = 'Unsaved changes';
      }
    }

    function applyYouTubeVideoChanges() {
      const art = AppState.currentlyEditingArticle;
      if (!art) return;

      const urlInput = document.getElementById('yt-url-input');
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const id = parseYouTubeVideoId(urlInput.value || '');

      if (!id) {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-red)';
        validationFeedback.innerText = 'Enter a valid YouTube URL or 11-character video ID.';
        return;
      }

      const headlineInput = document.getElementById('edit-headline');
      const articleHeadline = (headlineInput && headlineInput.value.trim()) ? headlineInput.value.trim() : (art.title || 'News Coverage');

      art.video_id = id;
      if (!art.video_caption || String(art.video_caption).trim() === '') {
        art.video_caption = articleHeadline;
      }
      art.hasVideo = true;

      // Keep videos[] array in sync
      if (!Array.isArray(art.videos) || art.videos.length === 0) {
        art.videos = [{
          video_id: id,
          title: art.video_caption,
          channel: 'YouTube'
        }];
      } else {
        art.videos[0].video_id = id;
        art.videos[0].title = art.video_caption;
      }

      initYouTubeWidgetState(art);
      markEditorAsUnsaved();
      saveEditorArticle();
    }

    function removeYouTubeVideo() {
      const art = AppState.currentlyEditingArticle;
      if (!art) return;

      if (!confirm('Remove YouTube video from this article?')) {
        return;
      }

      art.video_id = '';
      art.video_caption = '';
      art.videos = [];
      art.hasVideo = false;

      initYouTubeWidgetState(art);
      markEditorAsUnsaved();
      showToast('YouTube video removed from editor. Click "Save Changes" to publish.', 'info');
    }

    // Save Article Action
    async function saveEditorArticle() {
      if (!AppState.currentlyEditingArticle) return;

      const saveStatus = document.getElementById('editor-save-status');
      const btn = document.getElementById('btn-save-editor');
      btn.disabled = true;
      saveStatus.className = 'editor-save-indicator';
      saveStatus.innerText = 'Saving changes...';

      const urlInput = document.getElementById('yt-url-input');
      if (urlInput && urlInput.value && urlInput.value.trim()) {
        const parsedId = parseYouTubeVideoId(urlInput.value);
        if (parsedId) {
          AppState.currentlyEditingArticle.video_id = parsedId;
          if (!AppState.currentlyEditingArticle.video_caption) {
            const hl = document.getElementById('edit-headline');
            AppState.currentlyEditingArticle.video_caption = (hl && hl.value.trim()) || AppState.currentlyEditingArticle.title || 'News Coverage';
          }
          AppState.currentlyEditingArticle.hasVideo = true;
          AppState.currentlyEditingArticle.videos = [{
            video_id: parsedId,
            title: AppState.currentlyEditingArticle.video_caption,
            channel: 'YouTube'
          }];
        }
      }

      const payload = {
        relPath: AppState.currentlyEditingArticle.relPath,
        sha: AppState.currentlyEditingArticle.sha || null,
        title: document.getElementById('edit-headline').value,
        dek: document.getElementById('edit-dek').value,
        body: document.getElementById('edit-body').value,
        why_it_matters: document.getElementById('edit-why-it-matters').value,
        what_happens_next: document.getElementById('edit-what-happens-next').value,
        category: document.getElementById('edit-category').value,
        author: document.getElementById('edit-author').value,
        seoTitle: document.getElementById('edit-seo-title').value,
        sourceName: document.getElementById('edit-source-name').value,
        sourceUrl: document.getElementById('edit-source-url').value,
        image: document.getElementById('edit-image').value,
        imageCredit: document.getElementById('edit-image-credit').value,
        video_id: AppState.currentlyEditingArticle.video_id || '',
        video_caption: AppState.currentlyEditingArticle.video_caption || '',
        videos: Array.isArray(AppState.currentlyEditingArticle.videos) ? AppState.currentlyEditingArticle.videos : []
      };

      if (SafetyState.currentResult && SafetyState.currentResult.gate === 'BLOCKED') {
        const proceed = confirm('Editorial Safety Gate is currently BLOCKED for this article.\n\nBlocking issues should ideally be remediated before publishing.\n\nDo you still wish to save this revision?');
        if (!proceed) {
          btn.disabled = false;
          saveStatus.className = 'editor-save-indicator';
          saveStatus.innerText = 'Save paused (Safety Blocked)';
          return;
        }
      }

      try {
        const res = await fetch('/api/admin/articles/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        btn.disabled = false;

        if (res.ok && data.success) {
          Object.assign(AppState.currentlyEditingArticle, payload);
          if (data.sha) AppState.currentlyEditingArticle.sha = data.sha;
          AppState.currentlyEditingArticle.wordCount = data.wordCount || countArticleWords(payload.body);
          AppState.currentlyEditingArticle.modified = data.modified;
          AppState.currentlyEditingArticle.hasImage = Boolean(payload.image && payload.image.trim().length > 0);
          AppState.currentlyEditingArticle.hasSourceName = Boolean(payload.sourceName && payload.sourceName.trim().length > 0);
          AppState.currentlyEditingArticle.hasSourceUrl = Boolean(payload.sourceUrl && payload.sourceUrl.trim().length > 0);
          initYouTubeWidgetState(AppState.currentlyEditingArticle);
          updateEditorActionButtons(AppState.currentlyEditingArticle);

          // Keep main corpus article object in sync with editing article
          const targetInCorpus = AppState.articles.find(a => a.relPath === payload.relPath);
          if (targetInCorpus && targetInCorpus !== AppState.currentlyEditingArticle) {
            Object.assign(targetInCorpus, AppState.currentlyEditingArticle);
          }

          // Phase 14A-2: Run targeted deterministic live recalculation
          recalculateArticleDeterministicState(AppState.currentlyEditingArticle);

          // Phase 9: New Git SHA invalidates previous safety checks/sign-offs
          resetSafetyEditorState();
          updateSafetyPillAndBadge('UNCHECKED', 'Safety: Re-check required');

          const timeStr = new Date(data.modified).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          saveStatus.className = 'editor-save-indicator saved';
          saveStatus.innerText = 'Saved • Modified: ' + timeStr + (data.sha ? ' (Git SHA: ' + data.sha.slice(0, 7) + ')' : '');

          showToast('Article saved successfully (' + timeStr + ')', 'success');
        } else if (res.status === 409 || data.conflict) {
          saveStatus.className = 'editor-save-indicator error';
          saveStatus.innerText = 'Conflict: Article changed in GitHub';
          showToast('This article changed in GitHub since you opened it. Reload before saving.', 'error');
        } else {
          saveStatus.className = 'editor-save-indicator error';
          saveStatus.innerText = 'Save error: ' + (data.error || 'Server rejected');
          showToast(data.error || 'Failed to save', 'error');
        }
      } catch (err) {
        btn.disabled = false;
        saveStatus.className = 'editor-save-indicator error';
        saveStatus.innerText = 'Network error during save';
        showToast('Save failed: Network error', 'error');
      }
    }

