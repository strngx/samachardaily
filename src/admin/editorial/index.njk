---
layout: false
title: "Editorial Control Center — Samachar Daily"
permalink: /admin/editorial/index.html
eleventyExcludeFromCollections: true
noindex: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editorial Control Center — Samachar Daily</title>
  <meta name="robots" content="noindex, nofollow, noarchive">
  <style>
    :root {
      --color-brand: #C81E2C;
      --color-brand-dark: #9e1420;
      --color-brand-light: #fef2f2;
      --color-ink: #0f172a;
      --color-muted: #475569;
      --color-subtle: #64748b;
      --color-canvas: #f8fafc;
      --color-surface: #ffffff;
      --color-surface-alt: #f1f5f9;
      --color-border: #e2e8f0;
      --color-border-dark: #cbd5e1;
      
      --color-blue: #1d4ed8;
      --color-blue-bg: #eff6ff;
      --color-blue-border: #bfdbfe;
      
      --color-green: #15803d;
      --color-green-bg: #f0fdf4;
      --color-green-border: #bbf7d0;
      
      --color-amber: #b45309;
      --color-amber-bg: #fffbeb;
      --color-amber-border: #fde68a;
      
      --color-teal: #0f766e;
      --color-teal-bg: #f0fdfa;
      --color-teal-border: #99f6e4;
      
      --color-purple: #7e22ce;
      --color-purple-bg: #faf5ff;
      --color-purple-border: #e9d5ff;

      --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --font-serif: "Merriweather", Georgia, "Times New Roman", serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
      
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      background-color: var(--color-canvas);
      color: var(--color-ink);
      font-family: var(--font-stack);
      line-height: 1.5;
      font-size: 14px;
      overflow-x: hidden;
    }

    /* Top Operational Bar */
    .top-bar {
      background-color: #042f2e;
      color: #ccfbf1;
      padding: 8px 20px;
      font-size: 11px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      border-bottom: 1px solid #115e59;
    }
    .top-bar-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .top-bar-badge {
      background-color: #f59e0b;
      color: #78350f;
      font-weight: 800;
      font-size: 9px;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .top-bar-right {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: var(--font-mono);
      font-size: 11px;
    }
    .btn-logout {
      background-color: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #ffffff;
      padding: 3px 10px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      font-family: var(--font-stack);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn-logout:hover {
      background-color: #b91c1c;
      border-color: #b91c1c;
    }

    /* Container */
    .dashboard-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 20px 16px 80px 16px;
      width: 100%;
    }

    /* Dashboard Header */
    .dashboard-header {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-bottom: 20px;
      box-shadow: var(--shadow-sm);
    }
    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 16px;
    }
    .brand-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-brand);
      margin-bottom: 4px;
    }
    .brand-tag::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 14px;
      background-color: var(--color-brand);
      border-radius: 1px;
    }
    .header-title {
      font-family: var(--font-serif);
      font-size: 24px;
      font-weight: 700;
      color: var(--color-ink);
      line-height: 1.25;
    }
    .header-subtext {
      color: var(--color-muted);
      font-size: 13px;
      margin-top: 4px;
    }
    .header-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
    }
    .meta-chip {
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      padding: 6px 12px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      color: var(--color-muted);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .meta-chip strong { color: var(--color-ink); }

    /* Navigation Tabs */
    .nav-tabs-wrapper {
      position: relative;
      margin-bottom: 24px;
    }
    .nav-tabs {
      display: flex;
      gap: 4px;
      border-bottom: 2px solid var(--color-border-dark);
      overflow-x: auto;
      background: var(--color-surface);
      padding: 6px 8px 0 8px;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      box-shadow: var(--shadow-sm);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }
    .nav-tab-btn {
      padding: 10px 14px;
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      font-size: 13px;
      font-weight: 600;
      color: var(--color-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      transition: all 0.15s ease;
      font-family: var(--font-stack);
      border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    }
    .nav-tab-btn:hover {
      color: var(--color-brand);
      background: var(--color-brand-light);
    }
    .nav-tab-btn.active {
      color: var(--color-brand);
      border-bottom-color: var(--color-brand);
      font-weight: 700;
      background: var(--color-brand-light);
    }
    .tab-badge {
      background: var(--color-surface-alt);
      color: var(--color-subtle);
      padding: 2px 7px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 700;
    }
    .nav-tab-btn.active .tab-badge {
      background: #fecaca;
      color: #991b1b;
    }
    .tab-badge-roadmap {
      background: #f1f5f9;
      color: #64748b;
      font-size: 9px;
      padding: 2px 5px;
      border-radius: 3px;
      text-transform: uppercase;
      font-weight: 800;
      border: 1px solid #cbd5e1;
    }

    /* Tab Panes */
    .tab-pane { display: none; }
    .tab-pane.active { display: block; animation: fadeIn 0.15s ease-in; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(2px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Grids & Cards */
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; margin-bottom: 24px; }

    .card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 20px;
      box-shadow: var(--shadow-sm);
    }
    .card-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--color-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .card-stat {
      font-size: 28px;
      font-weight: 800;
      color: var(--color-ink);
      line-height: 1.1;
      font-variant-numeric: tabular-nums;
    }
    .card-stat-desc {
      font-size: 12px;
      color: var(--color-subtle);
      margin-top: 6px;
      line-height: 1.4;
    }

    /* KPI Cards */
    .kpi-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-top: 3px solid var(--color-border-dark);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .kpi-card.kpi-brand { border-top-color: var(--color-brand); }
    .kpi-card.kpi-green { border-top-color: var(--color-green); }
    .kpi-card.kpi-amber { border-top-color: var(--color-amber); }
    .kpi-card.kpi-blue { border-top-color: var(--color-blue); }
    .kpi-card.kpi-purple { border-top-color: var(--color-purple); }
    .kpi-card.kpi-teal { border-top-color: var(--color-teal); }

    .kpi-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .kpi-label { font-size: 11px; font-weight: 700; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-value { font-size: 26px; font-weight: 800; color: var(--color-ink); font-variant-numeric: tabular-nums; }
    .kpi-sub { font-size: 12px; color: var(--color-subtle); margin-top: 4px; line-height: 1.35; }
    .kpi-footer { font-size: 11px; color: var(--color-subtle); border-top: 1px dashed var(--color-border); padding-top: 8px; margin-top: 12px; display: flex; justify-content: space-between; }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 11px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: var(--radius-sm);
      line-height: 1.3;
      white-space: nowrap;
    }
    .badge-green { background: var(--color-green-bg); color: var(--color-green); border: 1px solid var(--color-green-border); }
    .badge-blue { background: var(--color-blue-bg); color: var(--color-blue); border: 1px solid var(--color-blue-border); }
    .badge-amber { background: var(--color-amber-bg); color: var(--color-amber); border: 1px solid var(--color-amber-border); }
    .badge-red { background: var(--color-brand-light); color: var(--color-brand); border: 1px solid #fecaca; }
    .badge-purple { background: var(--color-purple-bg); color: var(--color-purple); border: 1px solid var(--color-purple-border); }
    .badge-teal { background: var(--color-teal-bg); color: var(--color-teal); border: 1px solid var(--color-teal-border); }
    .badge-gray { background: var(--color-surface-alt); color: var(--color-muted); border: 1px solid var(--color-border); }

    /* Filter Controls Bar */
    .filter-bar {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      justify-content: space-between;
      box-shadow: var(--shadow-sm);
    }
    .filter-group-left {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      flex: 1;
      min-width: 260px;
    }
    .search-input {
      min-width: 220px;
      flex: 1;
      height: 38px;
      padding: 0 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-family: var(--font-stack);
      color: var(--color-ink);
      background-color: #ffffff;
    }
    .search-input:focus {
      outline: none;
      border-color: var(--color-brand);
      box-shadow: 0 0 0 2px rgba(200, 30, 44, 0.12);
    }
    .filter-select {
      height: 38px;
      padding: 0 10px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-family: var(--font-stack);
      color: var(--color-ink);
      background-color: #ffffff;
      cursor: pointer;
    }
    .filter-select:focus {
      outline: none;
      border-color: var(--color-brand);
    }
    .btn-reset {
      height: 38px;
      padding: 0 12px;
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      color: var(--color-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }
    .btn-reset:hover {
      background: #e2e8f0;
      color: var(--color-ink);
    }

    /* Table Component */
    .table-responsive {
      width: 100%;
      overflow-x: auto;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      margin-bottom: 16px;
      -webkit-overflow-scrolling: touch;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
      text-align: left;
      min-width: 900px;
    }
    table.data-table th {
      background-color: #f8fafc;
      color: var(--color-muted);
      font-weight: 700;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--color-border);
      white-space: nowrap;
    }
    table.data-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--color-border);
      vertical-align: middle;
      color: var(--color-ink);
    }
    table.data-table tr:hover {
      background-color: #f8fafc;
    }
    .td-title {
      font-family: var(--font-serif);
      font-size: 13.5px;
      font-weight: 700;
      line-height: 1.35;
      color: var(--color-ink);
      max-width: 380px;
      overflow-wrap: break-word;
    }
    .td-title a {
      color: var(--color-ink);
      text-decoration: none;
    }
    .td-title a:hover {
      color: var(--color-brand);
      text-decoration: underline;
    }
    .td-sub {
      font-size: 11px;
      color: var(--color-subtle);
      margin-top: 4px;
      font-family: var(--font-stack);
    }
    .td-mono {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--color-muted);
    }

    /* Action Buttons */
    .btn-action-view {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-blue);
      background: var(--color-blue-bg);
      border: 1px solid var(--color-blue-border);
      border-radius: var(--radius-sm);
      text-decoration: none;
      cursor: pointer;
    }
    .btn-action-view:hover { background: #dbeafe; }

    .btn-action-inspect {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 8px;
      font-size: 11px;
      font-weight: 600;
      color: var(--color-muted);
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
    }
    .btn-action-inspect:hover { background: #e2e8f0; color: var(--color-ink); }

    /* Pagination */
    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: 12px;
      color: var(--color-muted);
      flex-wrap: wrap;
      gap: 10px;
    }
    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pagination-btn {
      padding: 5px 12px;
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      color: var(--color-ink);
      cursor: pointer;
    }
    .pagination-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* Modal */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(2px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal-card {
      background: #ffffff;
      border-radius: var(--radius-md);
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--color-border);
    }
    .modal-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h3 {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-ink);
    }
    .modal-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--color-subtle);
    }
    .modal-close:hover { color: var(--color-ink); }
    .modal-body {
      padding: 24px;
      font-size: 13px;
      line-height: 1.6;
    }
    .modal-footer {
      padding: 14px 24px;
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-alt);
      display: flex;
      justify-content: flex-end;
      gap: 10px;
    }

    /* Roadmap Banner */
    .roadmap-banner {
      background: #f8fafc;
      border: 1px dashed var(--color-border-dark);
      border-radius: var(--radius-md);
      padding: 32px 24px;
      text-align: center;
      margin-bottom: 24px;
    }
    .roadmap-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--color-ink);
      margin-bottom: 8px;
    }
    .roadmap-desc {
      font-size: 13px;
      color: var(--color-muted);
      max-width: 560px;
      margin: 0 auto 16px auto;
      line-height: 1.5;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .dashboard-container { padding: 12px 10px 60px 10px; }
      .header-content { flex-direction: column; }
      .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
      .filter-bar { flex-direction: column; align-items: stretch; }
      .filter-group-left { flex-direction: column; align-items: stretch; }
      .search-input { min-width: 100%; }
      .top-bar { flex-direction: column; align-items: flex-start; }
      .top-bar-right { width: 100%; justify-content: space-between; }
    }
  </style>
</head>
<body>

  <!-- Top Operational Strip -->
  <div class="top-bar">
    <div class="top-bar-left">
      <span class="top-bar-badge">Internal Newsroom Surface</span>
      <span>Samachar Daily Editorial Operations</span>
      <span style="opacity: 0.5;">|</span>
      <span>Local-Only Environment</span>
    </div>
    <div class="top-bar-right">
      <span>User: <strong>admin</strong></span>
      <span>Session: <strong style="color: #6ee7b7;">Active (2h TTL)</strong></span>
      <button class="btn-logout" onclick="handleLogout()">Sign Out</button>
    </div>
  </div>

  <div class="dashboard-container">

    <!-- Dashboard Header -->
    <header class="dashboard-header">
      <div class="header-content">
        <div>
          <div class="brand-tag">SamacharDaily</div>
          <h1 class="header-title">Editorial Control Center</h1>
          <div class="header-subtext">Newsroom governance, published article diagnostics, and verified system health.</div>
        </div>
        <div class="header-meta">
          <div class="meta-chip">
            <span>Branch:</span>
            <strong>{{ editorial.project.gitBranch or 'main' }}</strong>
          </div>
          <div class="meta-chip">
            <span>Commit:</span>
            <strong>{{ editorial.project.gitHead or 'b9cca8c' }}</strong>
          </div>
          <div class="meta-chip">
            <span>Total Corpus:</span>
            <strong style="color: var(--color-brand);">1,303 Files</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation Tabs (11 Sections) -->
    <div class="nav-tabs-wrapper">
      <nav class="nav-tabs">
        <button class="nav-tab-btn active" onclick="switchTab('overview', this)">
          <span>1. Overview</span>
          <span class="tab-badge">1,303</span>
        </button>
        <button class="nav-tab-btn" onclick="switchTab('articles', this)">
          <span>2. Articles</span>
          <span class="tab-badge">1,303</span>
        </button>
        <button class="nav-tab-btn" onclick="switchTab('needs-attention', this)">
          <span>3. Needs Attention</span>
          <span class="tab-badge" style="background: #fde68a; color: #78350f;">{{ editorial.needsAttentionList.length or '121' }}</span>
        </button>
        <button class="nav-tab-btn" onclick="switchTab('safety', this)">
          <span>4. Safety</span>
          <span class="tab-badge" style="background: #fed7aa; color: #9a3412;">{{ editorial.sensitiveArticlesList.length or '352' }}</span>
        </button>
