      const ovGscBadge = document.getElementById('ov-gsc-badge');
      const ovGscDesc = document.getElementById('ov-gsc-desc');

      if (propChip && GSCState.property) {
        propChip.innerText = 'Property: ' + GSCState.property.replace(/^https?:\/\//, '').replace(/\/$/, '');
      }

      if (GSCState.connected) {
        if (statusBadge) {
          statusBadge.className = 'badge badge-green';
          statusBadge.innerHTML = '<span class="badge-dot green"></span> Connected to Google';
        }
        if (btnConnect) btnConnect.style.display = 'none';
