          '<td style="font-weight: 500; color: var(--color-ink); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="' + querySafe + '">' + querySafe + '</td>' +
          '<td style="text-align: right; font-weight: 600; color: #38bdf8;">' + clicks + '</td>' +
          '<td style="text-align: right; color: var(--color-muted);">' + impr + '</td>' +
          '<td style="text-align: right; color: var(--color-teal);">' + ctr + '</td>' +
          '<td style="text-align: right; color: var(--color-amber);">' + pos + '</td>' +
        '</tr>';
      });

      tbody.innerHTML = html;
    }

