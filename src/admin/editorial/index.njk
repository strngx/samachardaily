                '<div style="display: flex; align-items: center; gap: 12px;">' +
                  '<div style="width: 34px; height: 34px; border-radius: 50%; background: ' + (isOwner ? 'var(--color-purple)' : 'var(--color-brand)') + '; color: #fff; font-weight: 700; font-size: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">' +
                    escapeHtml(initials) +
                  '</div>' +
                  '<div>' +
                    '<div style="font-weight: 600; color: var(--color-ink); font-size: 13px; display: flex; align-items: center; gap: 6px;">' +
                      escapeHtml(displayName) +
                      (isOwner ? ' <span style="font-size: 10px; color: var(--color-purple); font-weight: 700;">(Root Owner)</span>' : '') +
                    '</div>' +
                    '<div style="font-size: 11px; color: var(--color-subtle); font-family: var(--font-mono);">' +
                      escapeHtml(email) +
                    '</div>' +
                  '</div>' +
                '</div>' +
              '</td>' +
              '<td>' + roleBadge + '</td>' +
              '<td>' + statusBadge + '</td>' +
              '<td>' + lastActiveDisplay + '</td>' +
              '<td style="text-align: right;">' + actionsCol + '</td>' +
            '</tr>';
          });
          tbody.innerHTML = html;
        }
      }

      // Render Invitations Lifecycle Table
      const invTbody = document.getElementById('invitations-table-body');
      if (invTbody) {
        const filter = AppState.invitationFilter || 'all';
        let filteredInv = AppState.invitations || [];
        if (filter === 'pending') {
          filteredInv = filteredInv.filter(i => (i.status === 'pending') && !i.revoked && i.status !== 'cancelled' && i.status !== 'revoked');
        } else if (filter === 'accepted') {
          filteredInv = filteredInv.filter(i => i.status === 'accepted');
        } else if (filter === 'revoked') {
          filteredInv = filteredInv.filter(i => i.status === 'revoked' || i.status === 'cancelled' || i.revoked);
        } else if (filter === 'expired') {
          filteredInv = filteredInv.filter(i => i.status === 'expired');
        }

        if (filteredInv.length === 0) {
          invTbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 24px; color: var(--color-subtle); font-size: 13px;">' +
            'No invitations found matching filter (' + escapeHtml(filter) + ').</td></tr>';
        } else {
          let html = '';
          filteredInv.forEach(inv => {
            const roleBadge = inv.role === 'admin'
              ? '<span class="badge badge-blue">Admin</span>'
              : '<span class="badge badge-gray">Editor</span>';
            const expiresDate = inv.expiresAt ? new Date(inv.expiresAt).toLocaleString() : '48 Hours';

            const isRevoked = inv.status === 'revoked' || inv.status === 'cancelled' || inv.revoked;
            let statusBadge = '<span class="badge badge-amber">Pending Acceptance</span>';
            if (isRevoked) {
              statusBadge = '<span class="badge badge-red">Revoked</span>';
            } else if (inv.status === 'accepted') {
              statusBadge = '<span class="badge badge-green">Accepted</span>';
            } else if (inv.status === 'expired') {
              statusBadge = '<span class="badge badge-gray">Expired</span>';
            }

            const canCancel = !isRevoked && inv.status === 'pending' && AppState.currentUser && (AppState.currentUser.role === 'owner' || AppState.currentUser.role === 'admin');

            html += '<tr>' +
              '<td>' +
                '<strong style="color: var(--color-ink); font-size: 13px; font-family: var(--font-mono);">' + escapeHtml(inv.email) + '</strong>' +
              '</td>' +
              '<td>' + roleBadge + '</td>' +
              '<td>' + statusBadge + '</td>' +
              '<td style="font-size: 12px; color: var(--color-subtle);">' +
                (isRevoked && inv.revokedAt ? ('Revoked: ' + new Date(inv.revokedAt).toLocaleDateString()) : escapeHtml(expiresDate)) +
              '</td>' +
              '<td style="text-align: right;">' +
                (canCancel
                  ? '<button class="btn-table-action btn-table-danger" type="button" onclick="confirmCancelInvitation(\'' + escapeHtml(inv.id) + '\', \'' + escapeHtml(inv.email) + '\')">Revoke</button>'
                  : (isRevoked ? '<span style="font-size: 11px; color: var(--color-subtle);">Revoked</span>' : '<span style="font-size: 11px; color: var(--color-subtle);">' + escapeHtml(inv.status) + '</span>')) +
              '</td>' +
            '</tr>';
          });
          invTbody.innerHTML = html;
        }
      }
