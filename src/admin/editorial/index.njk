    async function handleSafetySignoff() {
      if (!AppState.currentlyEditingArticle) return;
      const art = AppState.currentlyEditingArticle;
      const notes = (document.getElementById('safety-signoff-notes').value || '').trim();
      const btn = document.getElementById('btn-safety-signoff');
      btn.disabled = true;
      btn.innerText = 'Signing off...';

      try {
        const res = await fetch('/api/admin/safety/sign-off', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: art.slug,
            relPath: art.relPath,
            sha: art.sha || (SafetyState.currentResult && SafetyState.currentResult.sha) || 'working-draft',
            action: 'SIGNOFF',
            notes: notes || 'Editorial review confirmed by editor'
          })
        });

        const data = await res.json();
        btn.disabled = false;
        btn.innerText = 'Editorial Sign-Off';

        if (res.ok && data.success && data.signoff) {
          SafetyState.currentSignoff = data.signoff;
          updateSafetyPillAndBadge('SIGNED_OFF', 'Safety: Signed Off (' + (data.signoff.user || 'Admin') + ')');
          renderSafetyModalContent();
          showToast('Editorial sign-off recorded for this article revision', 'success');
        } else {
          showToast(data.error || 'Failed to record sign-off', 'error');
        }
      } catch (err) {
        btn.disabled = false;
        btn.innerText = 'Editorial Sign-Off';
        showToast('Error sending sign-off: ' + err.message, 'error');
      }
    }

    function previewRedactionInEditor(detectedText, category) {
      if (!detectedText) return;
      const textarea = document.getElementById('edit-body');
      if (!textarea) return;

      const currentVal = textarea.value;
      if (!currentVal.includes(detectedText)) {
        showToast('Detected text not found in current editor body', 'warning');
        return;
      }

      const placeholder = '[REDACTED: ' + category + ']';
      textarea.value = currentVal.replace(detectedText, placeholder);
      updateWordCountLive();
      showToast('Redaction previewed in editor body. Review and click "Save Changes" to apply.', 'info');
      closeSafetyModal();
      textarea.focus();
    }

