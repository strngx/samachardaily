    function getFilteredSortedQueries() {
      let list = GSCState.queries.slice();
      if (GSCState.queryFilter) {
        const qf = GSCState.queryFilter.toLowerCase();
        list = list.filter(item => (item.query || '').toLowerCase().includes(qf));
      }
      const col = GSCState.querySortCol;
      const dir = GSCState.querySortDir === 'asc' ? 1 : -1;
      list.sort((a, b) => {
        let vA = a[col];
        let vB = b[col];
        if (typeof vA === 'string') return vA.localeCompare(vB) * dir;
        return ((vA || 0) - (vB || 0)) * dir;
      });
      return list;
    }

    function renderGSCQueriesTable() {
      const tbody = document.getElementById('gsc-queries-tbody');
      if (!tbody) return;

      const filtered = getFilteredSortedQueries();
      const total = filtered.length;
      const paginationEl = document.getElementById('gsc-queries-pagination');

      if (total === 0) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 24px; color: var(--color-muted);">' +
          'No queries matching current criteria.' +
        '</td></tr>';
        if (paginationEl) paginationEl.style.display = 'none';
        return;
      }

      if (paginationEl) paginationEl.style.display = 'flex';
      const totalPages = Math.ceil(total / GSCState.queryPageSize) || 1;
      if (GSCState.queryPage > totalPages) GSCState.queryPage = totalPages;
      if (GSCState.queryPage < 1) GSCState.queryPage = 1;

      const startIdx = (GSCState.queryPage - 1) * GSCState.queryPageSize;
      const endIdx = Math.min(startIdx + GSCState.queryPageSize, total);
      const pageSlice = filtered.slice(startIdx, endIdx);

      const pageInfo = document.getElementById('gsc-queries-page-info');
      const pageNum = document.getElementById('gsc-queries-page-num');
      const btnPrev = document.getElementById('gsc-queries-btn-prev');
      const btnNext = document.getElementById('gsc-queries-btn-next');

      if (pageInfo) pageInfo.innerText = 'Showing ' + (startIdx + 1) + ' to ' + endIdx + ' of ' + total;
      if (pageNum) pageNum.innerText = GSCState.queryPage + ' / ' + totalPages;
      if (btnPrev) btnPrev.disabled = (GSCState.queryPage === 1);
      if (btnNext) btnNext.disabled = (GSCState.queryPage === totalPages);

      let html = '';
      pageSlice.forEach(row => {
        const querySafe = escapeHtml(row.query || '');
        const clicks = Number(row.clicks || 0).toLocaleString();
        const impr = Number(row.impressions || 0).toLocaleString();
        const ctr = (Number(row.ctr || 0) * 100).toFixed(1) + '%';
