            <div class="card-desc">Secondary technical audit telemetry for search indexing and crawl safety.</div>
          </div>
        </div>

        <div class="grid-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
