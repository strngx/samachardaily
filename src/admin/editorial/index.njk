    // -------------------------------------------------------------
    // Search, Filter & Sort Handlers
    // -------------------------------------------------------------
    function handleArticleSearch() {
      applyFiltersAndSorting();
    }

    function handleArticleFilter() {
      applyFiltersAndSorting();
    }

    function applyFiltersAndSorting() {
      const q = (document.getElementById('article-search').value || '').toLowerCase().trim();
      const desk = document.getElementById('filter-desk').value.toLowerCase();
      const status = document.getElementById('filter-status').value;
      const health = document.getElementById('filter-health').value;
      const dateFilter = document.getElementById('filter-date').value;
      const sort = document.getElementById('filter-sort').value;

      const now = Date.now();
      const oneDayMs = 24 * 60 * 60 * 1000;

      filteredArticles = articles.filter(art => {
        // Text Search
        if (q) {
          const matchTitle = (art.title || '').toLowerCase().includes(q);
          const matchSlug = (art.slug || '').toLowerCase().includes(q);
          const matchAuthor = (art.author || '').toLowerCase().includes(q);
          const matchSource = (art.sourceName || '').toLowerCase().includes(q);
          const matchDek = (art.dek || '').toLowerCase().includes(q);
          if (!matchTitle && !matchSlug && !matchAuthor && !matchSource && !matchDek) return false;
        }

        // Desk Filter
        if (desk !== 'all' && (art.category || '').toLowerCase() !== desk) return false;

        // Status Filter
        if (status === 'published' && (art.noindex || art.articleType === 'redirect')) return false;
        if (status === 'archived' && (!art.noindex || art.articleType === 'redirect')) return false;
        if (status === 'redirect' && art.articleType !== 'redirect') return false;

        // Health Filter
        const hasIssue = attentionMap.has(art.relPath);
        if (health === 'healthy' && hasIssue) return false;
        if (health === 'attention' && !hasIssue) return false;

        // Date Filter
        if (dateFilter !== 'ALL' && art.date) {
          const artTime = new Date(art.date).getTime();
          const diffDays = (now - artTime) / oneDayMs;
          if (dateFilter === 'today' && diffDays > 1) return false;
          if (dateFilter === '7days' && diffDays > 7) return false;
          if (dateFilter === '30days' && diffDays > 30) return false;
        }

        return true;
      });

      // Sorting
      if (sort === 'newest') {
        filteredArticles.sort((a, b) => new Date(b.date || 0) - new Date(a.date || 0));
      } else if (sort === 'oldest') {
        filteredArticles.sort((a, b) => new Date(a.date || 0) - new Date(b.date || 0));
      } else if (sort === 'title_asc') {
        filteredArticles.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
      } else if (sort === 'words_desc') {
        filteredArticles.sort((a, b) => (b.wordCount || 0) - (a.wordCount || 0));
      } else if (sort === 'words_asc') {
        filteredArticles.sort((a, b) => (a.wordCount || 0) - (b.wordCount || 0));
      } else if (sort === 'modified') {
        filteredArticles.sort((a, b) => new Date(b.modified || b.date || 0) - new Date(a.modified || a.date || 0));
      }

      currentArticlePage = 1;
      renderArticleTable();
    }

    function resetArticleFilters() {
      document.getElementById('article-search').value = '';
      document.getElementById('filter-desk').value = 'ALL';
      document.getElementById('filter-status').value = 'ALL';
      document.getElementById('filter-health').value = 'ALL';
      document.getElementById('filter-date').value = 'ALL';
      document.getElementById('filter-sort').value = 'newest';
      filteredArticles = [...articles];
      currentArticlePage = 1;
      renderArticleTable();
      showToast('Filters reset', 'warning');
    }

    function prevArticlePage() {
      if (currentArticlePage > 1) {
        currentArticlePage--;
        renderArticleTable();
      }
    }

    function nextArticlePage() {
      const totalPages = Math.ceil(filteredArticles.length / articlePageSize) || 1;
      if (currentArticlePage < totalPages) {
        currentArticlePage++;
        renderArticleTable();
      }
    }

    // -------------------------------------------------------------
    // Bulk Selection & Actions
    // -------------------------------------------------------------
    function handleMasterCheckbox(master) {
      const start = (currentArticlePage - 1) * articlePageSize;
      const slice = filteredArticles.slice(start, start + articlePageSize);
      slice.forEach(art => {
        if (master.checked) selectedArticleIds.add(art.relPath);
        else selectedArticleIds.delete(art.relPath);
      });
      renderArticleTable();
    }

    function toggleArticleSelection(relPath, checkbox) {
      if (checkbox.checked) selectedArticleIds.add(relPath);
      else selectedArticleIds.delete(relPath);
      updateBulkToolbar();
    }

    function clearBulkSelection() {
      selectedArticleIds.clear();
      const master = document.getElementById('master-checkbox');
      if (master) master.checked = false;
      renderArticleTable();
    }

    function updateBulkToolbar() {
      const bar = document.getElementById('bulk-toolbar');
      const countEl = document.getElementById('bulk-selected-count');
      if (!bar || !countEl) return;

      const count = selectedArticleIds.size;
      countEl.innerText = count;
      if (count > 0) {
        bar.classList.add('visible');
      } else {
        bar.classList.remove('visible');
      }
    }

    async function handleBulkArchive() {
      const count = selectedArticleIds.size;
      if (count === 0) return;

      openConfirmModal({
        title: 'Bulk Archive ' + count + ' Articles?',
        body: 'Archiving sets ' + count + ' articles to <code>noindex: true</code>. They will be removed from active search indexing while remaining available for restoration.',
        confirmLabel: 'Archive ' + count + ' Articles',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Archiving selected articles...', 'warning');
          for (const relPath of selectedArticleIds) {
            await fetch('/api/admin/articles/archive', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath })
            });
            const art = articles.find(a => a.relPath === relPath);
            if (art) {
              art.noindex = true;
              art.articleType = 'noindexed';
            }
          }
          clearBulkSelection();
          showToast('Successfully archived ' + count + ' articles', 'success');
        }
      });
    }

    async function handleBulkDelete() {
      const count = selectedArticleIds.size;
      if (count === 0) return;

      openConfirmModal({
        title: 'Destructive Action: Bulk Delete ' + count + ' Articles?',
        body: 'Permanent deletion will remove ' + count + ' source Markdown files from disk. This can break search rankings and produce 404 errors for external backlinks.<br><br>Type <strong>DELETE</strong> below to confirm:',
        inputRequired: 'DELETE',
        confirmLabel: 'Permanently Delete ' + count + ' Articles',
        danger: true,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Deleting selected articles...', 'warning');
          for (const relPath of selectedArticleIds) {
            await fetch('/api/admin/articles/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, confirmTitle: 'DELETE' })
            });
            const idx = articles.findIndex(a => a.relPath === relPath);
            if (idx !== -1) articles.splice(idx, 1);
          }
          clearBulkSelection();
          applyFiltersAndSorting();
          showToast('Successfully deleted ' + count + ' articles', 'success');
        }
      });
    }

