        </div>
        <div class="header-meta">
          <div class="meta-chip">
            <span>Branch:</span>
            <strong>{{ editorial.project.gitBranch or 'main' }}</strong>
          </div>
          <div class="meta-chip">
            <span>Commit:</span>
            <strong>{{ editorial.project.gitHead or 'b9cca8c' }}</strong>
          </div>
          <div class="meta-chip">
            <span>Total Corpus:</span>
            <strong style="color: var(--color-brand);">1,303 Files</strong>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation Tabs: Primary & Secondary -->
    <div class="nav-tabs-wrapper" id="main-nav-wrapper">
      <div class="nav-tabs-group">
        <button class="nav-tab-btn active" onclick="switchTab('overview', this)">
          <span>Overview</span>
