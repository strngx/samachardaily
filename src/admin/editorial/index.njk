    function cancelYouTubeEditMode() {
      initYouTubeWidgetState(AppState.currentlyEditingArticle);
    }

    function handleYouTubeUrlInput(val) {
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');

      if (!val || !val.trim()) {
        validationFeedback.style.display = 'none';
        validationFeedback.innerText = '';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
        return;
      }

      const id = parseYouTubeVideoId(val);
      if (id) {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-green)';
        validationFeedback.innerText = 'Valid YouTube ID: ' + id;
      } else {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-red)';
        validationFeedback.innerText = 'Enter a valid YouTube URL or 11-character video ID.';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
      }
    }

    function previewEnteredYouTubeVideo() {
      const urlInput = document.getElementById('yt-url-input');
      const validationFeedback = document.getElementById('yt-validation-feedback');
      const previewWrap = document.getElementById('yt-inline-preview-wrap');
      const previewIframe = document.getElementById('yt-inline-preview-iframe');

      const val = urlInput.value || '';
      const id = parseYouTubeVideoId(val);
      if (!id) {
        validationFeedback.style.display = 'block';
        validationFeedback.style.color = 'var(--color-red)';
        validationFeedback.innerText = 'Enter a valid YouTube URL or 11-character video ID.';
        if (previewWrap) previewWrap.style.display = 'none';
        if (previewIframe) previewIframe.src = '';
        return;
      }

      validationFeedback.style.display = 'block';
      validationFeedback.style.color = 'var(--color-green)';
      validationFeedback.innerText = 'Valid YouTube ID: ' + id;

      const safeVid = encodeURIComponent(id);
      previewIframe.src = 'https://www.youtube.com/embed/' + safeVid;
