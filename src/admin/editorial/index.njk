    }

    // ========================================================================
    // PHASE 14A-2: TARGETED DETERMINISTIC LIVE RECALCULATION ENGINE
    // ========================================================================
    const STOPWORDS = new Set([
      'a', 'about', 'above', 'after', 'again', 'against', 'all', 'also', 'am', 'amid',
      'an', 'and', 'any', 'are', 'aren\'t', 'as', 'at', 'be', 'because', 'been',
      'before', 'being', 'below', 'between', 'both', 'but', 'by', 'can', 'can\'t',
      'cannot', 'could', 'couldn\'t', 'did', 'didn\'t', 'do', 'does', 'doesn\'t',
      'doing', 'don\'t', 'down', 'during', 'each', 'few', 'for', 'from', 'further',
      'had', 'hadn\'t', 'has', 'hasn\'t', 'have', 'haven\'t', 'having', 'he', 'he\'d',
      'he\'ll', 'he\'s', 'her', 'here', 'here\'s', 'hers', 'herself', 'him', 'himself',
      'his', 'how', 'how\'s', 'i', 'i\'d', 'i\'ll', 'i\'m', 'i\'ve', 'if', 'in',
      'into', 'is', 'isn\'t', 'it', 'it\'s', 'its', 'itself', 'let\'s', 'me', 'more',
      'most', 'mustn\'t', 'my', 'myself', 'no', 'nor', 'not', 'of', 'off', 'on',
      'once', 'only', 'or', 'other', 'ought', 'our', 'ours', 'ourselves', 'out',
      'over', 'own', 'same', 'shan\'t', 'she', 'she\'d', 'she\'ll', 'she\'s', 'should',
      'shouldn\'t', 'so', 'some', 'such', 'than', 'that', 'that\'s', 'the', 'their',
      'theirs', 'them', 'themselves', 'then', 'there', 'there\'s', 'these', 'they',
      'they\'d', 'they\'ll', 'they\'re', 'they\'ve', 'this', 'those', 'through', 'to',
      'too', 'under', 'until', 'up', 'very', 'was', 'wasn\'t', 'we', 'we\'d', 'we\'ll',
      'we\'re', 'we\'ve', 'were', 'weren\'t', 'what', 'what\'s', 'when', 'when\'s',
      'where', 'where\'s', 'which', 'while', 'who', 'who\'s', 'whom', 'why', 'why\'s',
      'with', 'won\'t', 'would', 'wouldn\'t', 'you', 'you\'d', 'you\'ll', 'you\'re',
      'you\'ve', 'your', 'yours', 'yourself', 'yourselves', 'today', 'news', 'india'
    ]);

    const CONTEXT_PATTERNS = /\b(?:earlier|previously|background|history|in recent months|context|following the|development comes as|preceded by|meanwhile|historically|prior to|over the past)\b/i;
    const ATTRIBUTION_PATTERNS = /\b(?:according to|reported by|spokesperson|news agency|press release|pti|ani|reuters|afp|associated press|official statement|confirmed by|disclosed by|briefed reporters)\b/i;
    const FACTS_PATTERNS = /\b(?:\d{1,4}(?:,\d{3})*(?:\.\d+)?%?|\$\d+|₹\d+|rs\.?\s*\d+|\b(?:january|february|march|april|may|june|july|august|september|october|november|december)\b)\b/i;
    const EXPLANATORY_PATTERNS = /\b(?:because|due to|in order to|as a result|explaining why|intended to|significance|implications|aims to|seeks to|primary objective)\b/i;

    const SENSITIVE_PATTERNS = {
      crime_legal: /\b(?:murder|homicide|manslaughter|kidnapping|arrested|fir registered|criminal charges|court verdict|sentenced to|cbi|ed|ncb|bail denied)\b/i,
      fatalities_disasters: /\b(?:death toll|fatalities|fatal crash|fatal accident|killed|perished|succumbed to injuries|drown(?:ed|ing)|landslide)\b/i,
      politics_elections: /\b(?:election commission|polling dates|all-party consultation|assembly election|voter turnout|campaign rally|bjp|congress|aap|parliament)\b/i,
      health_medical: /\b(?:medical trial|clinical study|pharmaceutical|cancer treatment|vaccine efficacy|ministry of health|hospital negligence)\b/i,
      defense_military: /\b(?:drdo|missile test|army chief|air force|navy|defense ministry|border clash|line of actual control)\b/i,
      financial_markets: /\b(?:stock exchange|sensex|nifty|market rally|benchmark repo rate|sebi|interest rate hike)\b/i
    };

    function classifySensitive(title, dek, body) {
      const text = ((title || '') + ' ' + (dek || '') + ' ' + (body || '')).toLowerCase();
      const matched = [];
      for (const [cat, regex] of Object.entries(SENSITIVE_PATTERNS)) {
        if (regex.test(text)) matched.push(cat);
      }
      return matched.length > 0 ? matched : null;
    }

    function countArticleWords(str) {
      if (!str || typeof str !== 'string') return 0;
      return (str.match(/\S+/g) || []).length;
    }

    function formatDateIso(dateVal) {
      if (!dateVal) return null;
      try {
        const d = new Date(dateVal);
        if (isNaN(d.getTime())) return String(dateVal).slice(0, 10);
        return d.toISOString().slice(0, 10);
      } catch (_) {
        return String(dateVal).slice(0, 10);
      }
    }

    function tokenizeText(text) {
      if (!text || typeof text !== 'string') return [];
      return text
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, ' ')
        .split(/\s+/)
        .filter(w => w.length > 2 && !STOPWORDS.has(w));
    }

    function computeJaccardSimilarity(setA, setB) {
      if (!setA || !setB || setA.size === 0 || setB.size === 0) return 0;
      let intersect = 0;
      for (const token of setA) {
        if (setB.has(token)) intersect++;
      }
      const union = setA.size + setB.size - intersect;
      return union > 0 ? intersect / union : 0;
    }

    function evaluateArticleSignals(article) {
      const body = (article.body || '').trim();
      const title = (article.title || '').trim();
      const wordCount = article.wordCount || countArticleWords(body);
      const charCount = body.length;
      const titleCharCount = title.length;

      const paragraphs = body
        .split(/\n\s*\n/)
        .map(p => p.trim())
        .filter(p => p.length > 0);
      const paraCount = Math.max(paragraphs.length, body ? 1 : 0);
      const meaningfulParas = paragraphs.filter(p => countArticleWords(p) >= 20).length;
      const avgWordsPerPara = paraCount > 0 ? Math.round(wordCount / paraCount) : 0;

      const hasAttribution = Boolean(
        (article.sourceName && String(article.sourceName).trim() !== '') ||
        (article.sourceUrl && String(article.sourceUrl).trim() !== '') ||
        ATTRIBUTION_PATTERNS.test(body)
      );

      const hasQuotes = /["""]|(?:\n|^)>/.test(body);
      const hasContext = CONTEXT_PATTERNS.test(body);
      const hasFacts = FACTS_PATTERNS.test(body);
      const hasExplanatory = EXPLANATORY_PATTERNS.test(body);

      const substantiveTokens = tokenizeText(body);
      const bodySubstanceRatio = wordCount > 0 ? Math.min(1, substantiveTokens.length / wordCount) : 0;

      return {
        wordCount,
        charCount,
        titleCharCount,
        paraCount,
        meaningfulParas,
        avgWordsPerPara,
        hasAttribution,
        hasQuotes,
        hasContext,
        hasFacts,
        hasExplanatory,
        bodySubstanceRatio,
        titleTokens: new Set(tokenizeText(title))
      };
    }

    function findSingleArticleOverlap(art, articles) {
      if (!art || !art.signals || !art.signals.titleTokens || art.signals.titleTokens.size === 0) return null;
      let bestOverlap = null;
      const targetCategory = (art.category || '').toLowerCase();
      for (const b of articles) {
        if (b.relPath === art.relPath) continue;
        if ((b.category || '').toLowerCase() !== targetCategory) continue;
        if (b.noindex || b.articleType === 'redirect') continue;

        const bTokens = b.signals && b.signals.titleTokens
          ? b.signals.titleTokens
          : new Set(tokenizeText(b.title || ''));
        const sim = computeJaccardSimilarity(art.signals.titleTokens, bTokens);
        if (sim >= 0.40) {
          if (!bestOverlap || sim > bestOverlap.sim) {
            bestOverlap = { related: b, sim };
          }
        }
      }
      return bestOverlap;
    }

    function classifyArticle(article, overlap) {
      const sig = article.signals;
      const isoDate = formatDateIso(article.date);
      const detectedSignals = [];
      const notDetectedSignals = [];

      if (sig.wordCount < 100) detectedSignals.push('Severe brevity: ' + sig.wordCount + ' words');
      else if (sig.wordCount < 180) detectedSignals.push('Sub-standard length: ' + sig.wordCount + ' words');
      else if (sig.wordCount < 250) detectedSignals.push('Moderate length: ' + sig.wordCount + ' words');

      if (sig.paraCount <= 1) detectedSignals.push('Single paragraph layout');
      if (sig.meaningfulParas < 2) detectedSignals.push('Fewer than 2 substantive paragraphs (>=20 words)');
      if (!sig.hasAttribution) notDetectedSignals.push('Wire attribution or primary source cited');
      else detectedSignals.push('Active primary source or wire attribution verified');

      if (!sig.hasQuotes) notDetectedSignals.push('Direct quotation marks or official statement');
      else detectedSignals.push('Direct quotes present');

      if (!sig.hasContext) notDetectedSignals.push('Background or historical context framing');
      else detectedSignals.push('Background context detected');

      if (!sig.hasFacts) notDetectedSignals.push('Specific verifiable numerical or temporal facts');
      else detectedSignals.push('Specific figures, dates, or verifiable metrics present');

      if (!sig.hasExplanatory) notDetectedSignals.push('Explanatory reasoning phrases (why/how)');

      let classification = null;
      let finding = null;
      let confidence = 'Medium';
      let reason = '';
      let relatedArticle = null;
      let evidence = [];

      if (overlap) {
        classification = 'Consolidate';
        finding = 'Potential overlap';
        confidence = overlap.sim >= 0.50 ? 'High' : 'Medium';
        reason = 'Title and body strongly overlap with another article covering the same event.';
        relatedArticle = {
          id: overlap.related.id || (overlap.related.category + '/' + overlap.related.slug),
          title: overlap.related.title,
          slug: overlap.related.slug,
          url: overlap.related.url,
          category: overlap.related.category,
          date: formatDateIso(overlap.related.date),
          similarityPercent: Math.round(overlap.sim * 100)
        };
        evidence.push('Shares ' + Math.round(overlap.sim * 100) + '% significant title vocabulary with "' + overlap.related.title + '"');
        evidence.push('Both articles published in ' + String(article.category).toUpperCase() + ' desk.');
      } else if (sig.wordCount < 85 && !sig.hasQuotes && !sig.hasContext && isoDate && isoDate < '2026-09-18') {
        classification = 'Prune';
        finding = 'Potentially obsolete/low-value';
        confidence = 'Medium';
        reason = 'Article appears to be an ephemeral update with limited historical or archival value.';
        evidence.push('Article body contains only ' + sig.wordCount + ' words.');
        evidence.push('Lacks direct quotations and contextual analysis.');
        evidence.push('Published on ' + isoDate + '; candidate for editorial pruning or consolidation.');
      } else if (sig.wordCount < 100 && !sig.hasQuotes && !sig.hasContext) {
        classification = 'Noindex';
        finding = 'Limited standalone depth';
        confidence = 'Medium';
        reason = 'Article provides minimal unique reporting and limited standalone search value; consider noindex if not enriched.';
        evidence.push('Substantially thin content: ' + sig.wordCount + ' words.');
        evidence.push('Missing quotes and contextual background.');
        evidence.push('Low standalone search utility.');
      } else if (sig.wordCount >= 100 && sig.wordCount <= 260 && sig.hasAttribution && sig.hasFacts && (sig.meaningfulParas >= 2 || sig.hasQuotes)) {
        classification = 'Keep Short';
        finding = 'Concise breaking news';
        confidence = 'High';
        reason = 'Article is short but contains sufficient verifiable information and attribution for a breaking-news update.';
        evidence.push('Article is ' + sig.wordCount + ' words with ' + sig.paraCount + ' paragraphs.');
        evidence.push('Contains active source attribution and concrete factual figures.');
        evidence.push('Properly structured as a rapid breaking news dispatch.');
      } else if (sig.wordCount < 200 && (!sig.hasContext || !sig.hasExplanatory)) {
        classification = 'Enrich';
        finding = 'Potentially thin';
        confidence = sig.wordCount < 140 ? 'High' : 'Medium';
        reason = 'Article is substantially shorter than comparable articles and contains limited supporting context.';
        evidence.push('Article body length is ' + sig.wordCount + ' words (editorial target: 250+ words).');
        if (!sig.hasContext) evidence.push('Missing supporting historical or previous event context.');
        if (!sig.hasExplanatory) evidence.push('Lacks explanatory why-it-matters background.');
      } else if (sig.wordCount < 220 || (!sig.hasQuotes && sig.wordCount < 260)) {
        classification = 'Review';
        finding = 'Needs editorial review';
        confidence = 'Low';
        reason = 'Multiple thin-content signals detected; editorial review recommended.';
        evidence.push('Article length is ' + sig.wordCount + ' words.');
        if (!sig.hasQuotes) evidence.push('Contains no direct quotes or official statements.');
        if (sig.paraCount <= 1) evidence.push('Formatted as a single continuous block paragraph.');
      } else {
        return null;
      }

      return {
        id: article.id || (article.category + '/' + article.slug),
        title: article.title,
        slug: article.slug,
        category: article.category,
        url: article.url,
        relPath: article.relPath,
        date: isoDate,
        wordCount: sig.wordCount,
        charCount: sig.charCount,
        paraCount: sig.paraCount,
        finding,
        classification,
        confidence,
        reason,
        relatedArticle,
        detectedSignals,
        notDetectedSignals,
        evidence
      };
    }

    function evaluateArticleAttention(a) {
      if (!a) return null;
      if (a.articleType === 'redirect') {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Consolidated Redirect Stub',
          severity: 'INFO',
          reason: 'Article was consolidated into a master story; forwards via 301/meta-refresh to ' + (a.redirectTo || a.redirect_to || 'target story'),
          recommendedAction: 'Verify redirect destination remains active and relevant.'
        };
      } else if (a.noindex) {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Soft-Pruned (noindex: true)',
          severity: 'MEDIUM',
          reason: 'Article frontmatter explicitly contains noindex: true. It is live on disk but omitted from sitemap.xml and search engines.',
          recommendedAction: 'Review whether content can be expanded or rehabilitated to regain indexation eligibility.'
        };
      } else if ((a.wordCount || 0) < 100) {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Severe Thin Content (<100 words)',
          severity: 'HIGH',
          reason: 'Article body has only ' + (a.wordCount || 0) + ' words. High risk of search engine low-value content penalty.',
          recommendedAction: 'Enrich with background context, why-it-matters analysis, or consolidate.'
        };
      } else if ((a.wordCount || 0) < 150) {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Marginal Thin Content (100–149 words)',
          severity: 'MEDIUM',
          reason: 'Article body has ' + (a.wordCount || 0) + ' words. Below the 250-word editorial standard for substantive news.',
          recommendedAction: 'Enrich with source corroboration or key takeaways.'
        };
      } else if (!a.hasImage && (!a.image || !String(a.image).trim())) {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Missing Hero Photograph',
          severity: 'LOW',
          reason: 'Article lacks a valid hero image in frontmatter.',
          recommendedAction: 'Attach a high-resolution photograph with proper credit attribution.'
        };
      } else if (!a.hasSourceName && (!a.sourceName || !String(a.sourceName).trim())) {
        return {
          id: a.id || (a.category + '/' + a.slug),
          title: a.title,
          slug: a.slug,
          category: a.category,
          url: a.url,
          relPath: a.relPath,
          problem: 'Missing Primary Source Attribution',
          severity: 'LOW',
          reason: 'No sourceName specified in frontmatter.',
          recommendedAction: 'Attach wire attribution or reporting agency source.'
        };
      }
      return null;
    }

    function recalculateThinQueueStats() {
      const classificationCounts = { Enrich: 0, 'Keep Short': 0, Consolidate: 0, Noindex: 0, Prune: 0, Review: 0 };
      const findingCounts = { potentiallyThin: 0, potentialOverlap: 0, conciseBreaking: 0, limitedDepth: 0, needsReview: 0, obsolete: 0 };
      ThinQueueState.items.forEach(item => {
        if (classificationCounts[item.classification] !== undefined) {
          classificationCounts[item.classification]++;
        }
        if (item.finding === 'Potentially thin') findingCounts.potentiallyThin++;
        else if (item.finding === 'Potential overlap') findingCounts.potentialOverlap++;
        else if (item.finding === 'Concise breaking news') findingCounts.conciseBreaking++;
        else if (item.finding === 'Limited standalone depth') findingCounts.limitedDepth++;
        else if (item.finding === 'Needs editorial review') findingCounts.needsReview++;
        else if (item.finding === 'Potentially obsolete/low-value') findingCounts.obsolete++;
      });
      ThinQueueState.stats.flaggedCount = ThinQueueState.items.length;
      ThinQueueState.stats.classificationCounts = classificationCounts;
      ThinQueueState.stats.findingCounts = findingCounts;
      window.__THIN_STATS__ = ThinQueueState.stats;
    }

    function recalculateArticleDeterministicState(art) {
      if (!art || !art.relPath) return;

      // 1. Attention Recalculation
      const attnIssue = evaluateArticleAttention(art);
      if (attnIssue) {
        attentionMap.set(art.relPath, attnIssue);
        if (!Array.isArray(window.__NEEDS_ATTENTION__)) window.__NEEDS_ATTENTION__ = [];
        const existingIdx = window.__NEEDS_ATTENTION__.findIndex(item => item.relPath === art.relPath);
        if (existingIdx !== -1) {
          window.__NEEDS_ATTENTION__[existingIdx] = attnIssue;
        } else {
          window.__NEEDS_ATTENTION__.push(attnIssue);
        }
      } else {
        attentionMap.delete(art.relPath);
        if (Array.isArray(window.__NEEDS_ATTENTION__)) {
          window.__NEEDS_ATTENTION__ = window.__NEEDS_ATTENTION__.filter(item => item.relPath !== art.relPath);
        }
      }

      // 2. Sensitive Topic Recalculation
      const sens = classifySensitive(art.title, art.dek, art.body);
      art.sensitiveTopic = sens;
      if (!Array.isArray(window.__SENSITIVE__)) window.__SENSITIVE__ = [];
      window.__SENSITIVE__ = window.__SENSITIVE__.filter(item => item.relPath !== art.relPath);
      if (sens && sens.length > 0) {
        window.__SENSITIVE__.push({
          id: art.id || (art.category + '/' + art.slug),
          title: art.title,
          slug: art.slug,
          category: art.category,
          url: art.url,
          relPath: art.relPath,
          date: art.date,
          wordCount: art.wordCount,
          flags: sens,
          source: art.sourceName || 'Unknown'
        });
      }

      // 3. Thin Content Recalculation
      const isRedirect = Boolean(art.articleType === 'redirect' || art.redirect_to);
      const isArchived = Boolean(art.noindex === true);

      if (isRedirect || isArchived) {
        // Excluded from active thin queue
        ThinQueueState.items = ThinQueueState.items.filter(item => item.relPath !== art.relPath && item.slug !== art.slug);
      } else {
        art.signals = evaluateArticleSignals(art);
        const overlap = findSingleArticleOverlap(art, AppState.articles);
        const classified = classifyArticle(art, overlap);

        if (classified) {
          const idx = ThinQueueState.items.findIndex(item => item.relPath === art.relPath || item.slug === art.slug);
          if (idx !== -1) {
            ThinQueueState.items[idx] = classified;
          } else {
            ThinQueueState.items.push(classified);
          }
        } else {
          ThinQueueState.items = ThinQueueState.items.filter(item => item.relPath !== art.relPath && item.slug !== art.slug);
        }
      }

      window.__THIN_QUEUE__ = ThinQueueState.items;
      recalculateThinQueueStats();
      updateThinQueueCounts();
      populateOverviewStats();

      // View-specific re-renders
      if (AppState.currentView === 'articles') {
        applyFiltersAndSorting();
      } else if (AppState.currentView === 'thin-queue') {
        applyThinQueueFilters();
      } else if (AppState.currentView === 'attention') {
        renderNeedsAttentionTab();
      } else if (AppState.currentView === 'safety') {
        renderSafetyTab();
      }
    }

    function renderThinQueueTable() {
      const tbody = document.getElementById('tq-table-body');
      if (!tbody) return;

      const items = ThinQueueState.filteredItems;
      const total = items.length;

      if (total === 0) {
        tbody.innerHTML = '<tr><td colspan="10" style="text-align: center; padding: 48px; color: var(--color-subtle);"><div style="font-size: 16px; font-weight: 600; margin-bottom: 6px;">No articles match the current filter criteria</div><div style="font-size: 12px;">Try changing classification, desk, or clearing the search query.</div></td></tr>';
        updateThinQueuePagination(0, 0, 0);
        return;
      }

      const p = ThinQueueState.pagination;
      const totalPages = Math.ceil(total / p.pageSize) || 1;
      if (p.page > totalPages) p.page = totalPages;
      if (p.page < 1) p.page = 1;

      const startIndex = (p.page - 1) * p.pageSize;
      const endIndex = Math.min(startIndex + p.pageSize, total);
      const pageItems = items.slice(startIndex, endIndex);

      let html = '';
      pageItems.forEach((item, index) => {
        const rev = ThinQueueState.reviewStates[item.slug];
        const isReviewed = rev && rev.status === 'reviewed';
        const isDismissed = rev && rev.status === 'dismissed';

        let classBadge = '<span class="badge badge-gray">' + escapeHtml(item.classification) + '</span>';
        if (item.classification === 'Enrich') classBadge = '<span class="badge badge-amber">Enrich</span>';
        else if (item.classification === 'Keep Short') classBadge = '<span class="badge badge-green">Keep Short</span>';
        else if (item.classification === 'Consolidate') classBadge = '<span class="badge badge-purple">Consolidate</span>';
        else if (item.classification === 'Noindex') classBadge = '<span class="badge badge-gray">Noindex</span>';
        else if (item.classification === 'Prune') classBadge = '<span class="badge badge-red">Prune</span>';
        else if (item.classification === 'Review') classBadge = '<span class="badge badge-blue">Review</span>';

        let confBadge = '<span class="badge badge-gray" style="font-size: 10px;">' + escapeHtml(item.confidence) + '</span>';
        if (item.confidence === 'High') confBadge = '<span class="badge badge-amber" style="font-size: 10px;">HIGH</span>';
        else if (item.confidence === 'Medium') confBadge = '<span class="badge badge-blue" style="font-size: 10px;">MED</span>';
        else if (item.confidence === 'Low') confBadge = '<span class="badge badge-gray" style="font-size: 10px;">LOW</span>';

        let reviewIndicator = '';
        if (isReviewed) {
          reviewIndicator = ' <span class="badge badge-green" style="font-size: 9px; padding: 1px 4px;">REVIEWED</span>';
        } else if (isDismissed) {
          reviewIndicator = ' <span class="badge badge-gray" style="font-size: 9px; padding: 1px 4px;">DISMISSED</span>';
        }

        let relatedCell = '<span style="color: var(--color-subtle); font-size: 11px;">None</span>';
        if (item.relatedArticle) {
          relatedCell = '<div style="font-size: 11px; line-height: 1.3;">' +
            '<span class="badge badge-purple" style="font-size: 9px; margin-bottom: 2px;">' + item.relatedArticle.similarityPercent + '% Match</span><br>' +
            '<span style="font-weight: 500; cursor: pointer; color: var(--color-brand);" onclick="openThinDetailModal(\'' + escapeJs(item.slug) + '\')">' + escapeHtml(item.relatedArticle.title.slice(0, 42)) + '...</span>' +
            '</div>';
        }

        html += '<tr style="' + (isDismissed ? 'opacity: 0.6;' : '') + '">' +
          '<td>' +
            '<div class="row-article-headline" onclick="openThinDetailModal(\'' + escapeJs(item.slug) + '\')" title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + reviewIndicator + '</div>' +
            '<div class="row-article-sub" title="' + escapeHtml(item.url || item.relPath) + '">' + escapeHtml(item.url || item.relPath) + '</div>' +
          '</td>' +
          '<td><span class="badge badge-gray" style="text-transform: capitalize;">' + escapeHtml(item.category) + '</span></td>' +
          '<td style="font-size: 12px; color: var(--color-subtle); white-space: nowrap;">' + escapeHtml(item.date || '—') + '</td>' +
          '<td><strong style="color: ' + (item.wordCount < 100 ? 'var(--color-red)' : (item.wordCount < 200 ? 'var(--color-amber)' : 'var(--color-ink)')) + ';">' + item.wordCount + 'w</strong></td>' +
          '<td style="font-size: 12px; font-weight: 500; color: var(--color-ink-light);">' + escapeHtml(item.finding) + '</td>' +
          '<td>' + classBadge + '</td>' +
          '<td>' + confBadge + '</td>' +
          '<td><div class="row-reason-text" title="' + escapeHtml(item.reason) + '">' + escapeHtml(item.reason) + '</div></td>' +
          '<td>' + relatedCell + '</td>' +
          '<td style="text-align: right; white-space: nowrap;">' +
            '<div class="row-actions-group">' +
              '<button class="btn-table-action" onclick="openThinDetailModal(\'' + escapeJs(item.slug) + '\')" title="Inspect signals & evidence">Inspect</button>' +
              '<button class="btn-table-action" onclick="openArticleEditor(\'' + escapeJs(item.relPath) + '\')" title="Open in Article Editor">Edit</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      });

      tbody.innerHTML = html;
      updateThinQueuePagination(startIndex + 1, endIndex, total);
    }

    function updateThinQueuePagination(start, end, total) {
      const infoEl = document.getElementById('tq-pagination-info');
      const dispEl = document.getElementById('tq-page-display');
      const btnPrev = document.getElementById('tq-btn-prev');
      const btnNext = document.getElementById('tq-btn-next');

      const p = ThinQueueState.pagination;
      const totalPages = Math.ceil(total / p.pageSize) || 1;

      if (infoEl) infoEl.innerText = total > 0 ? `Showing ${start} to ${end} of ${total.toLocaleString()} flagged articles` : 'No flagged articles found';
      if (dispEl) dispEl.innerText = `Page ${p.page} of ${totalPages}`;

      if (btnPrev) btnPrev.disabled = p.page <= 1;
      if (btnNext) btnNext.disabled = p.page >= totalPages;
    }

    function prevThinQueuePage() {
      if (ThinQueueState.pagination.page > 1) {
        ThinQueueState.pagination.page--;
        renderThinQueueTable();
      }
    }

    function nextThinQueuePage() {
      const totalPages = Math.ceil(ThinQueueState.filteredItems.length / ThinQueueState.pagination.pageSize) || 1;
      if (ThinQueueState.pagination.page < totalPages) {
        ThinQueueState.pagination.page++;
        renderThinQueueTable();
      }
    }

    function handleThinQueuePageSizeChange(val) {
      const size = parseInt(val, 10);
      if (!isNaN(size) && size > 0) {
        ThinQueueState.pagination.pageSize = size;
        ThinQueueState.pagination.page = 1;
        renderThinQueueTable();
      }
    }

    function filterThinQueueByClassification(cls) {
      ThinQueueState.filters.classification = cls;

      // Update pill buttons active state
      const pillMap = {
        'ALL': 'tq-pill-all',
        'Enrich': 'tq-pill-enrich',
        'Keep Short': 'tq-pill-keep-short',
        'Consolidate': 'tq-pill-consolidate',
        'Noindex': 'tq-pill-noindex',
        'Prune': 'tq-pill-prune',
        'Review': 'tq-pill-review'
      };

      Object.entries(pillMap).forEach(([k, btnId]) => {
        const btn = document.getElementById(btnId);
        if (btn) {
          if (k === cls) btn.classList.add('active');
          else btn.classList.remove('active');
        }
      });

      applyThinQueueFilters();
    }

    function handleThinQueueDeskChange(val) {
      ThinQueueState.filters.desk = val;
      applyThinQueueFilters();
    }

    function handleThinQueueWordsChange(val) {
      ThinQueueState.filters.words = val;
      applyThinQueueFilters();
    }

    function handleThinQueueReviewStatusChange(val) {
      ThinQueueState.filters.reviewStatus = val;
      applyThinQueueFilters();
    }

    function handleThinQueueSortChange(val) {
      ThinQueueState.filters.sort = val;
      applyThinQueueFilters();
    }

    const debouncedThinQueueSearch = debounce((val) => {
      ThinQueueState.filters.search = (val || '').trim();
      applyThinQueueFilters();
    }, 180);

    function handleThinQueueSearch(val) {
      ThinQueueState.filters.search = (val || '').trim();
      debouncedThinQueueSearch(val);
    }

    // Modal Inspection Drawer
    function openThinDetailModal(slug) {
      const item = ThinQueueState.items.find(i => i.slug === slug);
      if (!item) return;

      ThinQueueState.selectedItem = item;

      const modal = document.getElementById('thin-item-modal');
      const titleEl = document.getElementById('tq-modal-title');
      const classBadge = document.getElementById('tq-modal-class-badge');
      const deskEl = document.getElementById('tq-modal-desk');
      const dateEl = document.getElementById('tq-modal-date');
      const wordsEl = document.getElementById('tq-modal-words');
      const charsEl = document.getElementById('tq-modal-chars');
      const parasEl = document.getElementById('tq-modal-paras');
      const statusEl = document.getElementById('tq-modal-review-status');
      const bodyEl = document.getElementById('tq-modal-body');
      const liveBtn = document.getElementById('tq-modal-btn-live');

      if (titleEl) titleEl.innerText = item.title;
      if (classBadge) {
        classBadge.innerText = item.classification;
        classBadge.className = 'badge ' + (
          item.classification === 'Enrich' ? 'badge-amber' :
          item.classification === 'Keep Short' ? 'badge-green' :
          item.classification === 'Consolidate' ? 'badge-purple' :
          item.classification === 'Noindex' ? 'badge-gray' :
          item.classification === 'Prune' ? 'badge-red' : 'badge-blue'
        );
      }

      if (deskEl) deskEl.innerText = (item.category || '').toUpperCase();
      if (dateEl) dateEl.innerText = item.date || '—';
      if (wordsEl) wordsEl.innerText = item.wordCount + ' words';
      if (charsEl) charsEl.innerText = item.charCount ? item.charCount.toLocaleString() : '—';
      if (parasEl) parasEl.innerText = item.paraCount || '1';

      const rev = ThinQueueState.reviewStates[item.slug];
      if (statusEl) {
        if (rev && rev.status === 'reviewed') {
          statusEl.innerText = 'Reviewed by ' + (rev.reviewer || 'editor');
          statusEl.className = 'badge badge-green';
        } else if (rev && rev.status === 'dismissed') {
          statusEl.innerText = 'Dismissed';
          statusEl.className = 'badge badge-gray';
        } else {
          statusEl.innerText = 'Unreviewed';
          statusEl.className = 'badge badge-gray';
        }
      }

      if (liveBtn) {
        liveBtn.href = item.url || '#';
      }

      // Render Modal Body Content
      if (bodyEl) {
        let detectedHtml = '';
        (item.detectedSignals || []).forEach(sig => {
          detectedHtml += '<div style="display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 4px; color: var(--color-ink);">' +
            '<span style="color: var(--color-green); font-weight: bold;">&#10003;</span> ' + escapeHtml(sig) +
            '</div>';
        });
        if (!detectedHtml) detectedHtml = '<div style="font-size: 12px; color: var(--color-subtle);">None flagged</div>';

        let notDetectedHtml = '';
        (item.notDetectedSignals || []).forEach(sig => {
          notDetectedHtml += '<div style="display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 4px; color: var(--color-muted);">' +
            '<span style="color: var(--color-subtle); font-weight: bold;">&bull;</span> Not detected: ' + escapeHtml(sig) +
            '</div>';
        });
        if (!notDetectedHtml) notDetectedHtml = '<div style="font-size: 12px; color: var(--color-subtle);">Standard signals present</div>';

        let evidenceHtml = '';
        (item.evidence || []).forEach(ev => {
          evidenceHtml += '<li style="margin-bottom: 4px;">' + escapeHtml(ev) + '</li>';
        });

        let overlapHtml = '';
        if (item.relatedArticle) {
          overlapHtml = '<div style="background: var(--color-purple-bg); border: 1px solid var(--color-purple-border); border-radius: var(--radius-md); padding: 14px; margin-top: 14px;">' +
            '<div style="font-size: 12px; font-weight: 700; color: var(--color-purple); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">Potential Redundancy / Overlap Detected</div>' +
            '<div style="font-size: 13px; font-weight: 600; color: var(--color-ink); margin-bottom: 4px;">' + escapeHtml(item.relatedArticle.title) + '</div>' +
            '<div style="font-size: 11px; color: var(--color-muted); margin-bottom: 8px;">Similarity Score: <strong>' + item.relatedArticle.similarityPercent + '% shared vocabulary</strong> &middot; Published: ' + (item.relatedArticle.date || '—') + '</div>' +
            '<div style="display: flex; gap: 8px;">' +
              '<a class="btn-table-action" href="' + escapeHtml(item.relatedArticle.url || '#') + '" target="_blank" rel="noopener">Open Related Story &rarr;</a>' +
            '</div>' +
          '</div>';
        }

        bodyEl.innerHTML = `
          <div style="background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 14px; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--color-subtle); letter-spacing: 0.5px;">Advisory Recommendation</span>
              <span class="badge ${item.confidence === 'High' ? 'badge-amber' : 'badge-blue'}">${item.confidence} Confidence</span>
            </div>
            <div style="font-size: 15px; font-weight: 700; color: var(--color-ink); margin-bottom: 4px;">Recommended Action: ${escapeHtml(item.classification)}</div>
            <div style="font-size: 13px; color: var(--color-muted); line-height: 1.45;">${escapeHtml(item.reason)}</div>
            <div style="font-size: 11px; color: var(--color-subtle); margin-top: 8px; font-style: italic;">
              Advisory notice: This analysis is an internal editorial suggestion. The system does NOT automatically alter, prune, or noindex any article.
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-bottom: 16px;">
            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--color-subtle); margin-bottom: 8px;">Detected Signals</div>
              ${detectedHtml}
            </div>

            <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--color-subtle); margin-bottom: 8px;">Absence / Gaps Checked</div>
              ${notDetectedHtml}
            </div>
          </div>

          <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 12px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--color-subtle); margin-bottom: 6px;">Evidence Breakdown</div>
            <ul style="font-size: 12px; color: var(--color-ink-light); padding-left: 18px; line-height: 1.5;">
              ${evidenceHtml}
            </ul>
          </div>

          ${overlapHtml}
        `;
      }

      if (modal) modal.classList.add('show');
    }

    function closeThinDetailModal(event) {
      if (event && event.target && !event.target.classList.contains('modal-backdrop')) return;
      const modal = document.getElementById('thin-item-modal');
      if (modal) modal.classList.remove('show');
    }

    async function markThinItemReviewed() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;

      const slug = item.slug;
      try {
        const resp = await fetch('/api/admin/thin-queue/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, relPath: item.relPath, action: 'reviewed' })
        });
        if (resp.ok) {
          const resData = await resp.json().catch(() => ({}));
          if (resData.persisted === false) {
            showToast('Warning: Cloudflare KV is unavailable. State preserved in local session only, not permanently stored on server.', 'warning');
          } else {
            showToast('Article marked as reviewed. Audit event logged.', 'success');
          }
        } else {
          showToast('Warning: Server review failed. Review state updated in local session only.', 'warning');
        }
      } catch (_) {
        showToast('Warning: Connection failed. Review state updated in local session only.', 'warning');
      }

      ThinQueueState.reviewStates[slug] = {
        status: 'reviewed',
        reviewer: 'editor',
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
      } catch (_) {}

      renderThinQueueTable();
      openThinDetailModal(slug);
    }

    async function dismissThinItemFlag() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;

      const slug = item.slug;
      try {
        const resp = await fetch('/api/admin/thin-queue/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, relPath: item.relPath, action: 'dismissed' })
        });
        if (resp.ok) {
          const resData = await resp.json().catch(() => ({}));
          if (resData.persisted === false) {
            showToast('Warning: Cloudflare KV is unavailable. Flag dismissed in local session only, not permanently stored on server.', 'warning');
          } else {
            showToast('Flag dismissed for this article. Audit event logged.', 'info');
          }
        } else {
          showToast('Warning: Server update failed. Flag dismissed in local session only.', 'warning');
        }
      } catch (_) {
        showToast('Warning: Connection failed. Flag dismissed in local session only.', 'warning');
      }

      ThinQueueState.reviewStates[slug] = {
        status: 'dismissed',
        reviewer: 'editor',
        timestamp: new Date().toISOString()
      };
      try {
        localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
      } catch (_) {}

      renderThinQueueTable();
      openThinDetailModal(slug);
    }

    function openEditorFromThinQueue() {
      const item = ThinQueueState.selectedItem;
      if (!item) return;
      closeThinDetailModal();
      openArticleEditor(item.relPath);
    }

    // ========================================================================
    // PHASE 9: AI EDITORIAL SAFETY & INTEGRITY ASSISTANT
    // ========================================================================
    const SafetyState = {
      currentResult: null,
      currentSignoff: null,
      activeTab: 'all',
      isChecking: false
    };

    function resetSafetyEditorState() {
      SafetyState.currentResult = null;
      SafetyState.currentSignoff = null;
      SafetyState.activeTab = 'all';
      SafetyState.isChecking = false;
      updateSafetyPillAndBadge('UNCHECKED', 'Safety: Unchecked');
    }

    function updateSafetyPillAndBadge(gate, customLabel) {
      const pill = document.getElementById('editor-safety-pill');
      const badge = document.getElementById('safety-card-gate-badge');
      const summary = document.getElementById('safety-card-summary');
      const g = (gate || 'UNCHECKED').toUpperCase();

      let badgeClass = 'badge-gray';
      let label = customLabel || ('Safety: ' + g);

      if (g === 'PASS') {
        badgeClass = 'badge-green';
        label = customLabel || 'Safety: PASS';
      } else if (g === 'NEEDS_REVIEW') {
        badgeClass = 'badge-amber';
        label = customLabel || 'Safety: NEEDS REVIEW';
      } else if (g === 'BLOCKED') {
        badgeClass = 'badge-red';
        label = customLabel || 'Safety: BLOCKED';
      } else if (g === 'SIGNED_OFF') {
        badgeClass = 'badge-teal';
        label = customLabel || 'Safety: SIGNED OFF';
      } else if (g === 'CHECKING') {
        badgeClass = 'badge-blue';
        label = 'Safety: Analyzing...';
      }

      if (pill) {
        pill.className = 'badge ' + badgeClass;
        pill.innerText = label;
      }
      if (badge) {
        badge.className = 'badge ' + badgeClass;
        badge.innerText = g === 'CHECKING' ? 'Checking...' : g;
      }

      if (summary) {
        if (SafetyState.currentResult) {
          summary.style.display = 'block';
          const r = SafetyState.currentResult;
          const piiCount = (r.checks && r.checks.pii && r.checks.pii.findings) ? r.checks.pii.findings.length : 0;
          const claimsCount = (r.checks && r.checks.claims && r.checks.claims.claims) ? r.checks.claims.claims.length : 0;
          const topics = (r.checks && r.checks.sensitivity && r.checks.sensitivity.topics) ? r.checks.sensitivity.topics : [];
          summary.innerHTML = '<div style="display:flex; flex-direction:column; gap:4px;">' +
            '<div>&bull; Gate: <strong>' + escapeHtml(r.gate) + '</strong></div>' +
            '<div>&bull; PII Findings: <strong>' + piiCount + '</strong></div>' +
            '<div>&bull; Factual Claims: <strong>' + claimsCount + '</strong></div>' +
            '<div>&bull; Sensitivity: <strong>' + (topics.length ? escapeHtml(topics.join(', ')) : 'Standard') + '</strong></div>' +
            (SafetyState.currentSignoff ? '<div style="color:var(--color-teal); font-weight:600;">&bull; Signed off by ' + escapeHtml(SafetyState.currentSignoff.user || 'Admin') + '</div>' : '') +
          '</div>';
        } else {
          summary.style.display = 'none';
        }
      }
    }

    async function fetchEditorialSafetyStatus(art) {
      if (!art || !art.slug) return;
      try {
        const query = '?slug=' + encodeURIComponent(art.slug) + (art.sha ? '&sha=' + encodeURIComponent(art.sha) : '');
        const res = await fetch('/api/admin/safety/status' + query);
        if (res.ok) {
          const data = await res.json();
          if (data.success && data.found) {
            SafetyState.currentResult = data.result || null;
            SafetyState.currentSignoff = data.signoff || null;
            if (SafetyState.currentSignoff && SafetyState.currentResult) {
              updateSafetyPillAndBadge('SIGNED_OFF', 'Safety: Signed Off (' + (data.signoff.user || 'Admin') + ')');
            } else if (SafetyState.currentResult) {
              updateSafetyPillAndBadge(SafetyState.currentResult.gate);
            }
          }
        }
      } catch (_) {}
    }

    async function runSafetyCheckFromEditor(openModalAfter = false) {
      if (!AppState.currentlyEditingArticle) {
        showToast('No active article selected in editor', 'error');
        return;
      }
      if (SafetyState.isChecking) return;

      const art = AppState.currentlyEditingArticle;
      SafetyState.isChecking = true;
      updateSafetyPillAndBadge('CHECKING');
      showToast('Running multi-tier editorial safety analysis...', 'info');

      const payload = {
        relPath: art.relPath,
        slug: art.slug,
        sha: art.sha || null,
        title: document.getElementById('edit-headline').value,
        dek: document.getElementById('edit-dek').value,
        body: document.getElementById('edit-body').value,
        sourceName: document.getElementById('edit-source-name').value,
        sourceUrl: document.getElementById('edit-source-url').value,
        image: document.getElementById('edit-image').value,
        imageCredit: document.getElementById('edit-image-credit').value
      };

      try {
        const res = await fetch('/api/admin/safety/check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        SafetyState.isChecking = false;

        if (res.ok && data.success && data.result) {
          SafetyState.currentResult = data.result;
          SafetyState.currentSignoff = null; // New check resets previous signoff for this pass

          updateSafetyPillAndBadge(data.result.gate);

          if (!data.result.persisted) {
            showToast('Safety check passed with ephemeral state (KV storage unavailable)', 'warning');
          } else {
            showToast('Editorial safety analysis complete (' + data.result.gate + ')', data.result.gate === 'BLOCKED' ? 'error' : (data.result.gate === 'NEEDS_REVIEW' ? 'warning' : 'success'));
          }

          if (openModalAfter) {
            openSafetyInspectionModal();
          } else {
            // Also refresh modal if it happens to be open
            const modal = document.getElementById('safety-inspection-modal');
            if (modal && modal.style.display === 'flex') {
              renderSafetyModalContent();
            }
          }
        } else {
          updateSafetyPillAndBadge('UNCHECKED', 'Safety: Analysis Failed');
          showToast(data.error || 'Safety check encountered an error', 'error');
        }
      } catch (err) {
        SafetyState.isChecking = false;
        updateSafetyPillAndBadge('UNCHECKED', 'Safety: Network Error');
        showToast('Failed to reach safety API: ' + err.message, 'error');
      }
    }

    function openSafetyInspectionModal() {
      if (!AppState.currentlyEditingArticle) {
        showToast('Open an article in the editor first', 'warning');
        return;
      }

      if (!SafetyState.currentResult && !SafetyState.isChecking) {
        runSafetyCheckFromEditor(true);
        return;
      }

      renderSafetyModalContent();
      const modal = document.getElementById('safety-inspection-modal');
      if (modal) modal.style.display = 'flex';
    }

    function closeSafetyModal(e) {
      if (e && e.target && e.target.id !== 'safety-inspection-modal' && !e.target.classList.contains('btn-close-modal') && e.target.tagName !== 'BUTTON') {
        return;
      }
      const modal = document.getElementById('safety-inspection-modal');
      if (modal) modal.style.display = 'none';
    }

    function switchSafetyModalTab(tabId) {
      SafetyState.activeTab = tabId;
      document.querySelectorAll('#safety-inspection-modal [id^="safety-tab-"]').forEach(btn => {
        btn.classList.toggle('active', btn.id === 'safety-tab-' + tabId);
      });
      renderSafetyModalContent();
    }

    function renderSafetyModalContent() {
      const r = SafetyState.currentResult;
      const art = AppState.currentlyEditingArticle;
      if (!art) return;

      const gateBadge = document.getElementById('safety-modal-gate-badge');
      const shaEl = document.getElementById('safety-modal-sha');
      const checkedEl = document.getElementById('safety-modal-checked-at');
      const kvEl = document.getElementById('safety-modal-kv-status');
      const signoffStatusEl = document.getElementById('safety-modal-signoff-status');
      const bodyEl = document.getElementById('safety-modal-body');
      const signoffContainer = document.getElementById('safety-signoff-container');

      const gate = r ? r.gate : 'UNCHECKED';
      if (gateBadge) {
        let cls = 'badge-gray';
        if (gate === 'PASS') cls = 'badge-green';
        else if (gate === 'NEEDS_REVIEW') cls = 'badge-amber';
        else if (gate === 'BLOCKED') cls = 'badge-red';
        gateBadge.className = 'badge ' + cls;
        gateBadge.innerText = gate;
      }

      if (shaEl) shaEl.innerText = (art.sha ? art.sha.slice(0, 10) : (r && r.sha ? r.sha.slice(0, 10) : 'Working Draft (Unsaved)'));
      if (checkedEl) checkedEl.innerText = (r && r.checkedAt) ? new Date(r.checkedAt).toLocaleTimeString() : 'Not checked';
      if (kvEl) {
        kvEl.className = 'badge ' + (r && r.persisted ? 'badge-green' : 'badge-gray');
        kvEl.innerText = (r && r.persisted) ? 'KV Persisted' : 'Ephemeral';
      }

      if (signoffStatusEl) {
        if (SafetyState.currentSignoff) {
          signoffStatusEl.innerHTML = '<span style="color:var(--color-teal);">&check; Editorial Sign-Off by <strong>' + escapeHtml(SafetyState.currentSignoff.user || 'Admin') + '</strong> at ' + new Date(SafetyState.currentSignoff.timestamp).toLocaleTimeString() + '</span>';
        } else if (gate === 'NEEDS_REVIEW') {
          signoffStatusEl.innerHTML = '<span style="color:var(--color-amber);">&#9888; Requires Editorial Sign-Off or Remediation</span>';
        } else if (gate === 'BLOCKED') {
          signoffStatusEl.innerHTML = '<span style="color:var(--color-red); font-weight:700;">&#10008; BLOCKED: Must remediate before publishing</span>';
        } else {
          signoffStatusEl.innerHTML = '<span style="color:var(--color-green);">&check; Clear pre-publication safety gate</span>';
        }
      }

      if (signoffContainer) {
        signoffContainer.style.display = (gate === 'NEEDS_REVIEW' || gate === 'BLOCKED') ? 'flex' : 'none';
      }

      if (!r || !r.checks) {
        bodyEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--color-subtle);">' +
          '<div style="font-weight:600; margin-bottom:8px;">No safety analysis data available for current text.</div>' +
          '<button class="btn-table-action btn-table-primary" onclick="runSafetyCheckFromEditor(false)">Run Editorial Safety Check</button>' +
        '</div>';
        return;
      }

      const tab = SafetyState.activeTab;
      let html = '';

      if (tab === 'all') {
        html += '<div style="display:flex; flex-direction:column; gap:16px;">';
        
        // Gate Banner
        let bannerBg = 'var(--color-blue-bg)';
        let bannerBorder = 'var(--color-blue-border)';
        let bannerText = 'Deterministic &amp; AI Editorial Safety Checks Complete.';
        if (gate === 'BLOCKED') {
          bannerBg = 'var(--color-red-bg)';
          bannerBorder = 'var(--color-red-border)';
          bannerText = '<strong>BLOCKED:</strong> High-confidence deterministic rule violations detected. You must remediate these items.';
        } else if (gate === 'NEEDS_REVIEW') {
          bannerBg = 'var(--color-amber-bg)';
          bannerBorder = 'var(--color-amber-border)';
          bannerText = '<strong>NEEDS EDITORIAL REVIEW:</strong> Content contains items requiring explicit editorial sign-off or attribution review.';
        } else if (gate === 'PASS') {
          bannerBg = 'var(--color-green-bg)';
          bannerBorder = 'var(--color-green-border)';
          bannerText = '<strong>GATE PASSED:</strong> Deterministic checks clean and attribution documented.';
        }

        html += '<div style="padding:12px 16px; border-radius:var(--radius-sm); background:' + bannerBg + '; border:1px solid ' + bannerBorder + '; font-size:13px;">' + bannerText + '</div>';

        // 5 Summary Pillars
        html += '<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px;">';
        
        // 1. PII
        const piiFindings = (r.checks.pii && r.checks.pii.findings) || [];
        html += '<div style="border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:12px; background:var(--color-surface); cursor:pointer;" onclick="switchSafetyModalTab(\'pii\')">' +
          '<div style="display:flex; justify-content:space-between; margin-bottom:6px;"><strong>Privacy &amp; PII</strong>' +
          (piiFindings.length ? '<span class="badge badge-red">' + piiFindings.length + ' Found</span>' : '<span class="badge badge-green">Clean</span>') +
          '</div><div style="font-size:12px; color:var(--color-subtle);">' + (piiFindings.length ? 'Sensitive private identifiers detected' : 'No personal private numbers/IDs found') + '</div></div>';

        // 2. Claims
        const claims = (r.checks.claims && (r.checks.claims.items || r.checks.claims.claims)) || [];
        html += '<div style="border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:12px; background:var(--color-surface); cursor:pointer;" onclick="switchSafetyModalTab(\'claims\')">' +
          '<div style="display:flex; justify-content:space-between; margin-bottom:6px;"><strong>Claims Detected</strong>' +
          '<span class="badge badge-gray">' + claims.length + ' Extracted</span>' +
          '</div><div style="font-size:12px; color:var(--color-subtle);">Deterministic extraction (AI verification disabled)</div></div>';

        // 3. Source
        const srcCheck = r.checks.source || {};
        html += '<div style="border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:12px; background:var(--color-surface); cursor:pointer;" onclick="switchSafetyModalTab(\'source\')">' +
          '<div style="display:flex; justify-content:space-between; margin-bottom:6px;"><strong>Source &amp; Wire</strong>' +
          '<span class="badge ' + (srcCheck.status === 'VERIFIED' ? 'badge-green' : 'badge-amber') + '">' + escapeHtml(srcCheck.status || 'UNCHECKED') + '</span>' +
          '</div><div style="font-size:12px; color:var(--color-subtle);">' + escapeHtml(srcCheck.details || 'Attribution evaluation') + '</div></div>';

        // 4. Sensitive
        const sensCheck = r.checks.sensitivity || {};
        const topics = sensCheck.topics || [];
        html += '<div style="border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:12px; background:var(--color-surface); cursor:pointer;" onclick="switchSafetyModalTab(\'sensitivity\')">' +
          '<div style="display:flex; justify-content:space-between; margin-bottom:6px;"><strong>Sensitive Story</strong>' +
          (topics.length ? '<span class="badge badge-blue">' + topics.length + ' Topics</span>' : '<span class="badge badge-gray">General</span>') +
          '</div><div style="font-size:12px; color:var(--color-subtle);">' + (topics.length ? escapeHtml(topics.join(', ')) : 'Standard editorial jurisdiction') + '</div></div>';

        // 5. Media
        const mediaCheck = r.checks.media || {};
        html += '<div style="border:1px solid var(--color-border); border-radius:var(--radius-sm); padding:12px; background:var(--color-surface); cursor:pointer;" onclick="switchSafetyModalTab(\'media\')">' +
          '<div style="display:flex; justify-content:space-between; margin-bottom:6px;"><strong>Media Rights</strong>' +
          '<span class="badge ' + (mediaCheck.status === 'VERIFIED / DOCUMENTED' ? 'badge-green' : (mediaCheck.status === 'NEEDS CREDIT' ? 'badge-amber' : 'badge-gray')) + '">' + escapeHtml(mediaCheck.status || 'UNKNOWN') + '</span>' +
          '</div><div style="font-size:12px; color:var(--color-subtle);">' + escapeHtml(mediaCheck.details || 'Photo credit validation') + '</div></div>';

        html += '</div></div>';
      } else if (tab === 'pii') {
        const findings = (r.checks.pii && r.checks.pii.findings) || [];
        html += '<div style="display:flex; flex-direction:column; gap:12px;">';
        html += '<div style="font-size:12px; color:var(--color-subtle); line-height:1.4;">Deterministic scanner identifies private personal identifiers (Aadhaar, PAN, personal phone numbers, bank accounts, UPI IDs, private residences). Public institutional contact details are allowed.</div>';
        if (findings.length === 0) {
          html += '<div style="padding:24px; text-align:center; color:var(--color-green); background:var(--color-green-bg); border:1px solid var(--color-green-border); border-radius:var(--radius-sm);">' +
            '<strong>&check; No private personal identifiers found.</strong> Clean deterministic privacy scan.' +
          '</div>';
        } else {
          findings.forEach((f) => {
            html += '<div style="border:1px solid var(--color-red-border); background:var(--color-red-bg); padding:12px; border-radius:var(--radius-sm);">' +
              '<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">' +
                '<strong style="color:var(--color-red); font-size:13px;">[' + escapeHtml(f.type) + '] ' + escapeHtml(f.detected) + '</strong>' +
                '<span class="badge badge-red">' + escapeHtml(f.confidence) + ' Confidence</span>' +
              '</div>' +
              '<div style="font-size:12px; color:var(--color-ink); margin-bottom:6px;">' + escapeHtml(f.reason) + '</div>' +
              '<div style="display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--color-muted);">' +
                '<span><strong>Action:</strong> ' + escapeHtml(f.suggestedAction) + '</span>' +
                '<button class="btn-table-action" type="button" onclick="previewRedactionInEditor(\'' + escapeJs(f.detected) + '\', \'' + escapeJs(f.type) + '\')">Preview Redaction in Editor</button>' +
              '</div>' +
            '</div>';
          });
        }
        html += '</div>';
      } else if (tab === 'claims') {
        const claims = (r.checks.claims && (r.checks.claims.items || r.checks.claims.claims)) || [];
        html += '<div style="display:flex; flex-direction:column; gap:12px;">';
        html += '<div style="padding:10px 14px; background:var(--color-surface-alt); border:1px solid var(--color-border); border-radius:var(--radius-sm); font-size:12px; color:var(--color-ink); line-height:1.5;">' +
          '<strong>Claims detected:</strong> Automated factual claim extraction identifies numbers, dates, quotations, and high-impact assertions. ' +
          '<em>Automatic AI verification is not enabled</em> to preserve production publishing quotas. ' +
          'For difficult claims, manually verify against the cited source.' +
        '</div>';
        if (claims.length === 0) {
          html += '<div style="padding:24px; text-align:center; color:var(--color-muted); background:var(--color-surface-alt); border-radius:var(--radius-sm);">No high-priority statistical or named factual claims extracted.</div>';
        } else {
          claims.forEach((c) => {
            let stCls = 'badge-gray';
            let stLabel = 'Manual Check';
            if (c.verificationStatus === 'SUPPORTED_BY_SOURCE') {
              stCls = 'badge-green';
              stLabel = 'Wire Attributed';
            } else if (c.verificationStatus === 'UNATTRIBUTED_ASSERTION') {
              stCls = 'badge-amber';
              stLabel = 'Unattributed';
            } else if (c.verificationStatus === 'CONFLICTING_EVIDENCE') {
              stCls = 'badge-red';
              stLabel = 'Conflicting';
            } else if (c.verificationStatus === 'REQUIRES_MANUAL_VERIFICATION' || c.verificationStatus === 'UNABLE_TO_VERIFY') {
              stCls = 'badge-blue';
              stLabel = 'Manual Review';
            }

            html += '<div style="border:1px solid var(--color-border); background:var(--color-surface); padding:12px; border-radius:var(--radius-sm);">' +
