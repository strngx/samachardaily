    function updateGSCStatusUI() {
      const statusBadge = document.getElementById('gsc-status-badge');
      const btnConnect = document.getElementById('gsc-btn-connect-header');
      const btnRefresh = document.getElementById('gsc-btn-refresh-header');
      const btnDisconnect = document.getElementById('gsc-btn-disconnect-header');
