  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="toast-container"></div>

  <!-- ======================================================================
       CLIENT APPLICATION JAVASCRIPT STATE ENGINE
       ====================================================================== -->
  
<script>
    // Master Injected Data from Eleventy Build
    window.__CORPUS__ = {{ editorial.masterArticlesJson | safe }};
    window.__NEEDS_ATTENTION__ = {{ editorial.needsAttentionJson | safe }};
    window.__SENSITIVE__ = {{ editorial.sensitiveArticlesJson | safe }};
    window.__THIN_QUEUE__ = {{ editorial.thinContentQueueJson | safe }};
    window.__THIN_STATS__ = {{ editorial.thinContentStatsJson | safe }};

    // Central Application State
    const AppState = {
      currentView: 'overview',
      articleSubView: 'list', // 'list' | 'editor'
      currentlyEditingArticle: null,
      editorOrigin: null,
      articles: Array.isArray(window.__CORPUS__) ? window.__CORPUS__ : [],
      filteredArticles: [],
      selectedIds: new Set(),
      members: [],
      invitations: [],
      invitationFilter: 'all',
      indexingFilter: 'all',
      inspectionsCache: new Map(),
      currentUser: null,
      membersLoading: false,
      membersError: null,
      pagination: {
        page: 1,
        pageSize: 25
      },
      filters: {
        search: '',
        desk: 'ALL',
        status: 'ALL',
        health: 'ALL',
        date: 'ALL',
        sort: 'newest'
      }
    };

    AppState.filteredArticles = [...AppState.articles];

    // Fast lookup map for attention items
    const attentionMap = new Map();
    (Array.isArray(window.__NEEDS_ATTENTION__) ? window.__NEEDS_ATTENTION__ : []).forEach(item => {
      if (item.relPath) attentionMap.set(item.relPath, item);
    });

    // ========================================================================
    // SINGLE-SOURCE NAVIGATION ROUTER
    // ========================================================================
    function navigate(viewId, options = {}) {
      const validViews = ['overview', 'articles', 'thin-queue', 'attention', 'safety', 'search', 'website', 'broken-links', 'google-news', 'settings', 'members', 'indexing', 'sitemaps', 'video-seo', 'gsc-overview', 'url-inspection'];
      if (!validViews.includes(viewId)) viewId = 'overview';

      const prevView = AppState.currentView;
      AppState.currentView = viewId;

      // Handle subviews for articles
      if (viewId === 'articles') {
        if (options.subview === 'editor') {
          AppState.articleSubView = 'editor';
        } else {
          AppState.articleSubView = 'list';
          if (!options.fromEditor && !options.fromGlobalSearch) {
            // Fresh entry into articles list view: always reset search & filters to avoid sticky state
            resetArticleFilters(Boolean(options.status));
            if (options.status) {
              AppState.filters.status = options.status;
              const filterEl = document.getElementById('filter-status');
              if (filterEl) filterEl.value = options.status;
              applyFiltersAndSorting();
            }
          } else {
            // Returning from editor or global search: ensure table reflects all recent mutations immediately
            applyFiltersAndSorting();
          }
        }
      } else {
        AppState.articleSubView = 'list';
        // Clear global search and selection when leaving articles view
        if (prevView === 'articles') {
          const globalSearch = document.getElementById('global-search-input');
          if (globalSearch) globalSearch.value = '';
          AppState.selectedIds.clear();
          updateBulkToolbar();
        }
      }

      // Map alias views to their respective DOM panes
      let targetPaneId = viewId;
      if (viewId === 'gsc-overview') {
        targetPaneId = 'search';
      } else if (viewId === 'url-inspection') {
        targetPaneId = 'indexing';
        options.focusInspector = true;
      }

      // Synchronize View Panes
      document.querySelectorAll('.view-pane').forEach(el => el.classList.remove('active'));
      const activePane = document.getElementById('view-' + targetPaneId);
      if (activePane) {
        activePane.classList.add('active');
      } else {
        // Fallback: never leave page blank
        const fallback = document.getElementById('view-overview');
        if (fallback) fallback.classList.add('active');
      }

      // Synchronize View Content Deterministically
      if (viewId === 'overview') {
        populateOverviewStats();
      } else if (viewId === 'thin-queue') {
        applyThinQueueFilters();
      } else if (viewId === 'attention') {
        renderNeedsAttentionTab();
      } else if (viewId === 'safety') {
        renderSafetyTab();
      } else if (viewId === 'members') {
        loadMembersData();
      } else if (viewId === 'search' || viewId === 'gsc-overview') {
        loadSearchPerformanceData();
      } else if (viewId === 'indexing' || viewId === 'url-inspection') {
        renderIndexingTab();
        if (options.focusInspector || viewId === 'url-inspection') {
          setTimeout(() => {
            const input = document.getElementById('inspector-url-input');
            if (input) {
              input.focus();
              input.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }, 100);
        }
      } else if (viewId === 'sitemaps') {
        renderSitemapsTab();
      } else if (viewId === 'video-seo') {
        renderVideoSeoTab();
      }

      // Synchronize Articles Subviews
      const listContainer = document.getElementById('articles-list-container');
      const editorContainer = document.getElementById('articles-editor-container');
      if (listContainer && editorContainer) {
        if (viewId === 'articles' && AppState.articleSubView === 'editor') {
          listContainer.style.display = 'none';
          editorContainer.classList.add('show');
        } else {
          listContainer.style.display = 'block';
          editorContainer.classList.remove('show');
        }
      }

      // Synchronize Sidebar Active State
      document.querySelectorAll('.saas-sidebar .nav-item').forEach(btn => {
        if (btn.getAttribute('data-view') === viewId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Synchronize Topbar Breadcrumb
      const breadcrumbEl = document.getElementById('top-breadcrumb');
      if (breadcrumbEl) {
        let artTitle = 'Articles';
        if (AppState.articleSubView === 'editor') {
          const originLabel = AppState.editorOrigin && AppState.editorOrigin !== 'articles' ? (' (from ' + AppState.editorOrigin + ')') : '';
          artTitle = 'Articles / Writing Studio' + originLabel;
        }
        const labels = {
          'overview': 'Overview',
          'articles': artTitle,
          'thin-queue': 'Thin Content Queue',
          'attention': 'Needs Attention',
          'safety': 'Safety Governance',
          'gsc-overview': 'GSC Overview',
          'search': 'Search Performance',
          'indexing': 'GSC Indexing Control Center',
          'url-inspection': 'GSC URL Inspection',
          'sitemaps': 'XML Sitemaps Comparison',
          'video-seo': 'Video SEO & Media Diagnostics',
          'website': 'Website Health',
          'broken-links': 'Broken Links',
          'google-news': 'Google News',
          'settings': 'Settings',
          'members': 'Team Members'
        };
        breadcrumbEl.innerText = labels[viewId] || 'Overview';
      }

      // Update URL search parameters smoothly without flooding browser history
      if (!options.fromPopState) {
        const url = new URL(window.location);
        const currentParamView = url.searchParams.get('view') || 'overview';
        url.searchParams.set('view', viewId);
        if (viewId === 'articles' && AppState.articleSubView === 'editor' && AppState.currentlyEditingArticle) {
          url.searchParams.set('article', AppState.currentlyEditingArticle.slug || 'edit');
          url.searchParams.set('mode', 'edit');
        } else {
          url.searchParams.delete('article');
          url.searchParams.delete('mode');
        }
        if (currentParamView === viewId && (!options.subview || options.subview === 'list')) {
          window.history.replaceState({ view: viewId, subview: AppState.articleSubView }, '', url.toString());
        } else {
          window.history.pushState({ view: viewId, subview: AppState.articleSubView }, '', url.toString());
        }
      }

      // Close mobile drawer if open
      toggleMobileSidebar(false);

      // Scroll workspace to top
      const scrollWrap = document.getElementById('main-workspace-scroll');
      if (scrollWrap) scrollWrap.scrollTo({ top: 0, behavior: 'instant' });
    }

    // Handle Browser Back / Forward Buttons
    window.addEventListener('popstate', (e) => {
      const params = new URLSearchParams(window.location.search);
      const view = params.get('view') || 'overview';
      const artSlug = params.get('article');
      const mode = params.get('mode');

      if (view === 'articles' && mode === 'edit' && artSlug) {
        const art = AppState.articles.find(a => a.slug === artSlug || a.relPath.includes(artSlug));
        if (art) {
          openArticleEditor(art.relPath, { fromPopState: true });
          return;
        }
      }

      navigate(view, { fromPopState: true });
    });

    // Mobile Sidebar Drawer
    function toggleMobileSidebar(force) {
      const sidebar = document.getElementById('saas-sidebar');
      const overlay = document.getElementById('sidebar-overlay');
      if (!sidebar || !overlay) return;

      if (typeof force === 'boolean') {
        if (force) {
          sidebar.classList.add('mobile-open');
          overlay.classList.add('mobile-open');
        } else {
          sidebar.classList.remove('mobile-open');
          overlay.classList.remove('mobile-open');
        }
      } else {
        sidebar.classList.toggle('mobile-open');
        overlay.classList.toggle('mobile-open');
      }
    }

    // Global Quick Search (Keyboard '/')
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        e.preventDefault();
        const searchInput = document.getElementById('global-search-input');
        if (searchInput) searchInput.focus();
      }
    });

    // Debounce helper for silky performance
    function debounce(fn, delay = 180) {
      let timer = null;
      return function (...args) {
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          fn.apply(this, args);
        }, delay);
      };
    }

    const debouncedGlobalSearch = debounce((query) => {
      if (AppState.currentView !== 'articles' || AppState.articleSubView !== 'list') {
        navigate('articles', { fromGlobalSearch: true });
      }
      const tableInput = document.getElementById('table-search-input');
      if (tableInput) {
        tableInput.value = query;
      }
      AppState.filters.search = (query || '').toLowerCase().trim();
      AppState.pagination.page = 1;
      applyFiltersAndSorting();
    }, 200);

    function handleGlobalSearch(query) {
      debouncedGlobalSearch(query);
    }

    // Session Management & Logout
    async function verifyAuthSession() {
      try {
        const res = await fetch('/api/admin/session');
        if (res.ok) {
          const data = await res.json();
          if (!data || !data.authenticated) {
            window.location.replace('/admin/');
            return;
          }
          AppState.currentUser = data;
          updateSidebarProfile(data);
          updateRoleRestrictedUI(data);
        }
      } catch (e) {}
    }
    verifyAuthSession();

    function updateSidebarProfile(user) {
      if (!user) return;
      const nameEl = document.getElementById('sidebar-user-name');
      const emailEl = document.getElementById('sidebar-user-email');
      const avatarEl = document.getElementById('sidebar-user-avatar');
      const roleEl = document.getElementById('sidebar-user-role');

      const topNameEl = document.getElementById('topbar-user-name');
      const topAvatarEl = document.getElementById('topbar-user-avatar');
      const topRoleEl = document.getElementById('topbar-user-role');

      const displayName = user.displayName || user.name || user.user || 'Newsroom Admin';
      if (nameEl) nameEl.innerText = displayName;
      if (topNameEl) topNameEl.innerText = displayName;

      const email = user.email || 'admin@thesamachardaily.in';
      if (emailEl) emailEl.innerText = email;

      const parts = displayName.trim().split(/\s+/);
      const initials = parts.length >= 2
        ? (parts[0][0] + parts[1][0]).toUpperCase()
        : displayName.slice(0, 2).toUpperCase();

      // Phase 2.1 Avatar Priority:
      // 1. Existing admin user.picture
      // 2. Existing admin user.photo
      // 3. Existing admin user.avatar
      // 4. Google OAuth profile picture (user.googlePicture or window.GSCState.accountPicture)
      // 5. Existing initials fallback
      const gscPic = user.googlePicture || (typeof window !== 'undefined' && window.GSCState ? window.GSCState.accountPicture : null);
      const photoUrl = user.picture || user.photo || user.avatar || gscPic || null;

      function renderAvatarInto(el) {
        if (!el) return;
        if (photoUrl && typeof photoUrl === 'string' && photoUrl.trim()) {
          el.innerHTML = '';
          const img = document.createElement('img');
          img.src = photoUrl.trim();
          img.alt = displayName;
          img.style.width = '100%';
          img.style.height = '100%';
          img.style.objectFit = 'cover';
          img.style.borderRadius = '50%';
          img.style.display = 'block';
          img.referrerPolicy = 'no-referrer';
          img.onerror = function() {
            el.innerHTML = '';
            el.innerText = initials || 'AD';
          };
          el.appendChild(img);
        } else {
          el.innerHTML = '';
          el.innerText = initials || 'AD';
        }
      }

      renderAvatarInto(avatarEl);
      renderAvatarInto(topAvatarEl);

      const roleLabel = user.role === 'owner'
        ? 'Root Owner'
        : (user.role === 'admin' ? 'Admin' : 'Editor');
      if (roleEl) roleEl.innerText = roleLabel;
      if (topRoleEl) topRoleEl.innerText = roleLabel;
    }

    function updateRoleRestrictedUI(user) {
      if (!user) return;
      const inviteBtn = document.getElementById('btn-open-invite-modal');
      if (inviteBtn && user.role === 'editor') {
        inviteBtn.style.display = 'none';
      }
    }

    async function handleLogout() {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch (e) {}
      window.location.replace('/admin/');
    }

    // ========================================================================
    // TEAM MEMBERS & ROLE-BASED ACCESS (PHASE 14B-2)
    // ========================================================================
    async function loadMembersData(force = false) {
      if (AppState.membersLoading) return;
      AppState.membersLoading = true;
      renderMembersLoadingState();

      try {
        const [membersRes, invRes] = await Promise.all([
          fetch('/api/admin/members'),
          fetch('/api/admin/members/invitations')
        ]);

        if (membersRes.ok) {
          const mData = await membersRes.json();
          if (mData.success && Array.isArray(mData.members)) {
            AppState.members = mData.members;
            if (AppState.currentUser && !AppState.currentUser.picture) {
              const currentEmail = (AppState.currentUser.email || '').toLowerCase();
              const matchedMember = mData.members.find(m => (m.email || '').toLowerCase() === currentEmail);
              if (matchedMember && (matchedMember.picture || matchedMember.avatar || matchedMember.photo)) {
                AppState.currentUser.picture = matchedMember.picture || matchedMember.avatar || matchedMember.photo;
                updateSidebarProfile(AppState.currentUser);
              }
            }
          }
        } else if (membersRes.status === 403) {
          AppState.membersError = 'Access restricted. Member management requires Administrator privileges.';
        } else {
          AppState.membersError = 'Failed to load team members from server.';
        }

        if (invRes.ok) {
          const iData = await invRes.json();
          if (iData.success && Array.isArray(iData.invitations)) {
            AppState.invitations = iData.invitations;
          }
        }

        AppState.membersError = null;
      } catch (err) {
        AppState.membersError = err.message || 'Network error loading team data.';
      } finally {
        AppState.membersLoading = false;
        renderMembersTab();
      }
    }

    function renderMembersLoadingState() {
      const tbody = document.getElementById('members-table-body');
      if (tbody && (!AppState.members || AppState.members.length === 0)) {
        tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 32px; color: var(--color-muted);">' +
          '<span class="status-pulse-dot" style="margin-right: 8px;"></span> Loading team members from server-side registry...</td></tr>';
      }
    }

    function renderMembersTab() {
      const totalCount = AppState.members.length;
      let activeCount = 0;
      AppState.members.forEach(m => {
        if (m.status === 'active') activeCount++;
      });
      const pendingCount = AppState.invitations.filter(i => (i.status === 'pending') && !i.revoked && i.status !== 'cancelled' && i.status !== 'revoked').length;

      // Update KPI cards
      const statTotal = document.getElementById('stat-total-members');
      const statActive = document.getElementById('stat-active-members');
      const statPending = document.getElementById('stat-pending-invitations');
      const sideCount = document.getElementById('side-members-count');

      if (statTotal) statTotal.innerText = totalCount;
      if (statActive) statActive.innerText = activeCount;
      if (statPending) statPending.innerText = pendingCount;
      if (sideCount) sideCount.innerText = totalCount;

      // Update Root Owner Config Warning Banner if applicable
      const rootOwner = AppState.members.find(m => m.id === 'owner-admin' || m.role === 'owner');
      const banner = document.getElementById('members-config-banner');
      if (banner) {
        if (rootOwner && rootOwner.configurationWarning) {
          banner.style.display = 'block';
          banner.style.background = 'var(--color-amber-bg)';
          banner.style.border = '1px solid var(--color-amber-border)';
          banner.style.color = 'var(--color-amber)';
          banner.innerHTML = '<strong>Configuration Notice:</strong> ' + escapeHtml(rootOwner.configurationWarning) +
            ' Root Owner identity is active via technical-admin binding. Set <code>ROOT_OWNER_EMAIL=arjunkhatri925@gmail.com</code> in Cloudflare Worker secrets.';
        } else {
          banner.style.display = 'none';
        }
      }

      // Render Active Members Table
      const tbody = document.getElementById('members-table-body');
      if (tbody) {
        if (AppState.members.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 32px; color: var(--color-muted); font-size: 13px;">' +
            'No team members registered.</td></tr>';
        } else {
          let html = '';
          AppState.members.forEach(m => {
            const isOwner = (m.id === 'owner-admin' || m.role === 'owner');
            const displayName = m.displayName || (isOwner ? 'Arjun' : 'Team Member');
            const email = m.email || (isOwner ? 'arjunkhatri925@gmail.com (Unconfigured in Secrets)' : 'No email');
            const parts = displayName.trim().split(/\s+/);
            const initials = parts.length >= 2 ? (parts[0][0] + parts[1][0]).toUpperCase() : displayName.slice(0, 2).toUpperCase();

