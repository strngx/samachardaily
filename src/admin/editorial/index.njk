    // ========================================================================
    // REVISION & AUDIT HISTORY MODAL (PHASE 6)
    // ========================================================================
    async function openRevisionHistoryModal(relPath) {
      const targetRelPath = relPath || (AppState.currentlyEditingArticle ? AppState.currentlyEditingArticle.relPath : null);
      if (!targetRelPath) {
        showToast('Please select an article to view audit history', 'error');
        return;
      }

      const art = AppState.articles.find(a => a.relPath === targetRelPath) || AppState.currentlyEditingArticle;
      const modal = document.getElementById('revision-modal');
      const bodyEl = document.getElementById('revision-modal-body');
      const titleEl = document.getElementById('revision-modal-article-path');
      const countEl = document.getElementById('revision-modal-event-count');

      if (titleEl) {
        titleEl.innerHTML = '<strong>' + escapeHtml(art ? art.title : targetRelPath) + '</strong> <span style="opacity: 0.7;">(' + escapeHtml(targetRelPath) + ')</span>';
      }
      if (countEl) countEl.innerText = 'Fetching...';

      bodyEl.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--color-subtle);">' +
        '<div style="font-size: 24px; margin-bottom: 8px;">&#8987;</div>' +
        '<div>Loading audit history records from Cloudflare KV...</div>' +
      '</div>';

      modal.style.display = 'flex';

      try {
        const res = await fetch('/api/admin/audit?relPath=' + encodeURIComponent(targetRelPath));
        if (!res.ok) {
          bodyEl.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--color-red);">' +
            '<div style="font-size: 24px; margin-bottom: 8px;">&#9888;</div>' +
            '<div>Failed to load audit history (' + res.status + '). Ensure server session is active.</div>' +
          '</div>';
          if (countEl) countEl.innerText = 'Error';
          return;
        }

        const data = await res.json();
        const records = (data && Array.isArray(data.history)) ? data.history : [];

        if (countEl) countEl.innerText = records.length + (records.length === 1 ? ' record' : ' records');

        if (records.length === 0) {
          bodyEl.innerHTML = '<div style="text-align: center; padding: 40px 20px; color: var(--color-muted);">' +
            '<div style="font-size: 32px; margin-bottom: 8px;">&#128220;</div>' +
            '<div style="font-weight: 600; color: var(--color-ink); margin-bottom: 6px;">No Revision History Recorded Yet</div>' +
            '<p style="font-size: 12px; max-width: 480px; margin: 0 auto; color: var(--color-subtle);">' +
              'This article has not been modified since Phase 6 audit logging was activated. Future edits, saves, archives, restores, and validation checks will be logged here with complete before/after field changes.' +
            '</p>' +
          '</div>';
          return;
        }

        let html = '<div style="display: flex; flex-direction: column; gap: 14px;">';

        records.forEach((rec, idx) => {
          let actionBadge = '<span class="badge badge-gray">' + escapeHtml(rec.action || 'Unknown') + '</span>';
          if (rec.action === 'save') actionBadge = '<span class="badge badge-blue">Save / Edit</span>';
          else if (rec.action === 'archive') actionBadge = '<span class="badge badge-amber">Archive (Noindex)</span>';
          else if (rec.action === 'restore') actionBadge = '<span class="badge badge-green">Restore (Active)</span>';
          else if (rec.action === 'delete') actionBadge = '<span class="badge badge-red">Permanent Delete</span>';

          let statusBadge = '<span class="badge badge-green">&#10003; Committed</span>';
          if (rec.status === 'failed') statusBadge = '<span class="badge badge-red">&#9888; Validation Rejected</span>';
          else if (rec.status === 'conflict') statusBadge = '<span class="badge badge-amber">&#9888; Git SHA Conflict</span>';

          const timeStr = rec.timestamp ? new Date(rec.timestamp).toLocaleString('en-GB', {
            day: '2-digit', month: 'short', year: 'numeric',
            hour: '2-digit', minute: '2-digit', second: '2-digit'
          }) : 'N/A';

          const actorStr = escapeHtml(rec.actor || 'admin');
          const shaStr = rec.sha ? ('<code style="font-size: 11px; background: #e2e8f0; padding: 2px 6px; border-radius: 4px;">SHA: ' + escapeHtml(rec.sha.slice(0, 7)) + '</code>') : '';

          html += '<div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: 14px 16px; box-shadow: var(--shadow-sm);">' +
            '<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px;">' +
              '<div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">' +
                actionBadge +
                statusBadge +
                (shaStr ? ('<span>' + shaStr + '</span>') : '') +
              '</div>' +
              '<div style="font-size: 11px; color: var(--color-subtle); white-space: nowrap;">' + timeStr + '</div>' +
            '</div>' +
            '<div style="font-weight: 600; font-size: 13px; color: var(--color-ink); margin-bottom: 4px;">' +
              escapeHtml(rec.summary || 'Editorial action performed') +
            '</div>' +
            '<div style="font-size: 11px; color: var(--color-muted); margin-bottom: 8px;">' +
              'Authenticated Admin: <strong>' + actorStr + '</strong>' +
            '</div>';

          // Changed fields badges
          const changedFields = (rec.diff && Array.isArray(rec.diff.changedFields)) ? rec.diff.changedFields : [];
          if (changedFields.length > 0) {
            html += '<div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px;">' +
              changedFields.map(f => '<span class="badge badge-gray" style="font-size: 10px; padding: 1px 6px;">' + escapeHtml(f) + '</span>').join('') +
            '</div>';
          }

          // Before / After Diff Details
          const fieldChanges = (rec.diff && rec.diff.fieldChanges) ? rec.diff.fieldChanges : {};
          const changeKeys = Object.keys(fieldChanges);
          if (changeKeys.length > 0) {
            html += '<details style="margin-top: 8px; font-size: 12px; background: var(--color-surface-alt); border-radius: var(--radius-sm); border: 1px solid var(--color-border); padding: 8px 12px;">' +
              '<summary style="cursor: pointer; font-weight: 600; color: var(--color-ink-light); user-select: none;">View Before / After Differences (' + changeKeys.length + ' fields)</summary>' +
              '<div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">';

            changeKeys.forEach(k => {
              const item = fieldChanges[k];
              if (k === 'body') {
                html += '<div style="background: #ffffff; padding: 8px 10px; border-radius: 4px; border: 1px solid var(--color-border);">' +
                  '<div style="font-weight: 600; color: var(--color-ink); margin-bottom: 2px;">Article Body:</div>' +
                  '<div style="font-size: 11px; color: var(--color-muted);">' +
                    'Words: <strong>' + item.oldWords + '</strong> &rarr; <strong>' + item.newWords + '</strong> ' +
                    '(' + (item.wordDiff >= 0 ? '+' : '') + item.wordDiff + ' words)' +
                  '</div>' +
                  (item.previewSnippet ? '<div style="font-family: var(--font-mono); font-size: 11px; color: var(--color-subtle); margin-top: 4px; background: var(--color-surface-alt); padding: 4px 6px; border-radius: 3px;">' + escapeHtml(item.previewSnippet) + '</div>' : '') +
                '</div>';
              } else {
                html += '<div style="background: #ffffff; padding: 8px 10px; border-radius: 4px; border: 1px solid var(--color-border);">' +
                  '<div style="font-weight: 600; color: var(--color-ink); margin-bottom: 4px;">Field: <code>' + escapeHtml(k) + '</code></div>' +
                  '<div style="display: flex; flex-direction: column; gap: 2px; font-size: 11px;">' +
                    '<div style="color: var(--color-red); background: var(--color-red-bg); padding: 3px 6px; border-radius: 3px;">&minus; Before: ' + escapeHtml(String(item.old !== undefined ? item.old : '(empty)')) + '</div>' +
                    '<div style="color: var(--color-green); background: var(--color-green-bg); padding: 3px 6px; border-radius: 3px;">+ After: ' + escapeHtml(String(item.new !== undefined ? item.new : '(empty)')) + '</div>' +
                  '</div>' +
                '</div>';
              }
            });

            html += '</div></details>';
          }

          // Validation errors display if failed
          if (rec.validation && Array.isArray(rec.validation.errors) && rec.validation.errors.length > 0) {
            html += '<div style="margin-top: 8px; background: var(--color-red-bg); border: 1px solid var(--color-red-border); color: var(--color-red); padding: 8px 12px; border-radius: var(--radius-sm); font-size: 11px;">' +
              '<strong>Validation Errors:</strong>' +
              '<ul style="margin: 4px 0 0 16px;">' +
                rec.validation.errors.map(err => '<li>' + escapeHtml(err) + '</li>').join('') +
              '</ul>' +
            '</div>';
          }

          html += '</div>';
        });

        html += '</div>';
        bodyEl.innerHTML = html;

      } catch (err) {
        bodyEl.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--color-red);">' +
          '<div style="font-size: 24px; margin-bottom: 8px;">&#9888;</div>' +
          '<div>Network error loading audit history.</div>' +
        '</div>';
        if (countEl) countEl.innerText = 'Error';
      }
    }

    function closeRevisionModal(e) {
      if (e && e.target && e.target.id !== 'revision-modal' && !e.target.classList.contains('btn-close-modal') && !e.target.classList.contains('btn-table-action')) return;
      const modal = document.getElementById('revision-modal');
      if (modal) modal.style.display = 'none';
    }

    // ========================================================================
    // MUTATION HANDLERS: ARCHIVE, RESTORE, DELETE
    // ========================================================================
    function promptArchiveArticle(relPath) {
      const art = AppState.articles.find(a => a.relPath === relPath);
      if (!art) return;

      if (art.articleType === 'redirect') {
        alert('Cannot archive redirect stub. Redirect stubs protect canonical backlinks.');
        return;
      }

      openConfirmModal({
        title: 'Archive Article?',
        body: 'Archiving <strong>' + escapeHtml(art.title) + '</strong> marks it as <code>noindex: true</code>.<br><br>It will be excluded from search sitemaps while preserving the content for restoration at any time.',
        confirmLabel: 'Archive Article',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Archiving article...', 'info');
          try {
            const res = await fetch('/api/admin/articles/archive', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, sha: art.sha || null })
            });
            let data = {};
            try { data = await res.json(); } catch (_) {}
            if (res.ok && data.success) {
              art.noindex = true;
              art.articleType = 'noindexed';
              if (data.sha) art.sha = data.sha;
              AppState.selectedIds.delete(relPath);
              updateBulkToolbar();
              recalculateArticleDeterministicState(art);
              syncEditorStatusIfCurrent(art);
              showToast('Article archived (set to noindex)', 'warning');
            } else if (res.status === 409 || data.conflict) {
              showToast('Article changed in GitHub since loaded. Refresh before modifying.', 'error');
            } else {
              showToast(data.error || 'Failed to archive', 'error');
            }
          } catch (e) {
            showToast('Network error during archive', 'error');
          }
        }
      });
    }

    function promptRestoreArticle(relPath) {
      const art = AppState.articles.find(a => a.relPath === relPath);
      if (!art) return;

      openConfirmModal({
        title: 'Restore Article to Active?',
        body: 'Restore <strong>' + escapeHtml(art.title) + '</strong> to active search indexation? This removes the <code>noindex</code> flag and restores it to sitemaps.',
        confirmLabel: 'Restore to Active',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Restoring article...', 'info');
          try {
            const res = await fetch('/api/admin/articles/restore', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, sha: art.sha || null })
            });
            let data = {};
            try { data = await res.json(); } catch (_) {}
            if (res.ok && data.success) {
              delete art.noindex;
              art.articleType = 'active';
              if (data.sha) art.sha = data.sha;
              AppState.selectedIds.delete(relPath);
              updateBulkToolbar();
              recalculateArticleDeterministicState(art);
              syncEditorStatusIfCurrent(art);
              showToast('Article restored to active status', 'success');
            } else if (res.status === 409 || data.conflict) {
              showToast('Article changed in GitHub since loaded. Refresh before modifying.', 'error');
            } else {
              showToast(data.error || 'Failed to restore', 'error');
            }
          } catch (e) {
            showToast('Network error during restore', 'error');
          }
        }
      });
    }

    function promptDeleteArticle(relPath) {
      const art = AppState.articles.find(a => a.relPath === relPath);
      if (!art) return;

      if (art.articleType === 'redirect') {
        alert('Cannot delete redirect stub. Redirect stubs protect canonical backlinks and prevent crawl penalties.');
        return;
      }

      openConfirmModal({
        title: 'Guarded Action: Delete Article?',
        body: '<strong>Warning:</strong> This article has an active public URL (<a href="' + art.url + '" target="_blank">' + art.url + '</a>).<br><br>' +
              'Permanent deletion removes the Markdown source file from disk. It may cause search crawl penalties.<br><br>' +
              'To confirm deletion, please type <strong>DELETE</strong> below:',
        inputRequired: 'DELETE',
        confirmLabel: 'Permanently Delete',
        danger: true,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Deleting article from repository...', 'info');
          try {
            const res = await fetch('/api/admin/articles/delete', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ relPath, confirmTitle: 'DELETE', sha: art.sha || null })
            });
            let data = {};
            try { data = await res.json(); } catch (_) {}
            if (res.ok && data.success) {
              const idx = AppState.articles.findIndex(a => a.relPath === relPath);
              if (idx !== -1) AppState.articles.splice(idx, 1);
              AppState.selectedIds.delete(relPath);

              // Purge from attention and queue caches
              attentionMap.delete(relPath);
              if (Array.isArray(window.__NEEDS_ATTENTION__)) {
                window.__NEEDS_ATTENTION__ = window.__NEEDS_ATTENTION__.filter(item => item.relPath !== relPath);
              }
              if (Array.isArray(window.__SENSITIVE__)) {
                window.__SENSITIVE__ = window.__SENSITIVE__.filter(item => item.relPath !== relPath);
              }
              if (Array.isArray(window.__THIN_QUEUE__)) {
                window.__THIN_QUEUE__ = window.__THIN_QUEUE__.filter(item => item.relPath !== relPath);
              }
              ThinQueueState.items = ThinQueueState.items.filter(item => item.relPath !== relPath);
              recalculateThinQueueStats();
              updateThinQueueCounts();

              // If deleted article was currently open in editor, close cleanly
              const wasEditing = AppState.currentlyEditingArticle && AppState.currentlyEditingArticle.relPath === relPath;
              if (wasEditing) {
                AppState.currentlyEditingArticle = null;
                updateEditorActionButtons(null);
              }

              updateBulkToolbar();
              applyFiltersAndSorting();
              populateOverviewStats();

              if (AppState.currentView === 'thin-queue') {
                applyThinQueueFilters();
              } else if (AppState.currentView === 'attention') {
                renderNeedsAttentionTab();
              } else if (AppState.currentView === 'safety') {
                renderSafetyTab();
              }

              if (wasEditing || AppState.articleSubView === 'editor') {
                navigate('articles', { subview: 'list' });
              }
              showToast('Article deleted permanently from corpus', 'error');
            } else if (res.status === 409 || data.conflict) {
              showToast('Article changed in GitHub since loaded. Refresh before modifying.', 'error');
            } else {
              showToast(data.error || 'Failed to delete article', 'error');
            }
          } catch (e) {
            showToast('Network error during deletion', 'error');
          }
        }
      });
    }

    async function handleBulkArchive() {
      const count = AppState.selectedIds.size;
      if (count === 0) return;

      const targets = Array.from(AppState.selectedIds);
      const actionableTargets = targets.filter(relPath => {
        const art = AppState.articles.find(a => a.relPath === relPath);
        return art && art.articleType !== 'redirect';
      });

      if (actionableTargets.length === 0) {
        showToast('Selected articles are redirect stubs and cannot be archived.', 'warning');
        return;
      }

      openConfirmModal({
        title: 'Bulk Archive ' + actionableTargets.length + ' Articles?',
        body: 'Archiving ' + actionableTargets.length + ' selected articles sets them to <code>noindex: true</code>. They will be removed from sitemaps while remaining available for restoration.',
        confirmLabel: 'Archive ' + actionableTargets.length + ' Articles',
        danger: false,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Archiving selected articles...', 'warning');

          let successCount = 0;
          let failCount = 0;
          const errors = [];

          for (const relPath of actionableTargets) {
            const art = AppState.articles.find(a => a.relPath === relPath);
            try {
              const res = await fetch('/api/admin/articles/archive', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ relPath, sha: (art && art.sha) || null })
              });
              let data = {};
              try { data = await res.json(); } catch (_) {}

              if (res.ok && data.success) {
                if (art) {
                  art.noindex = true;
                  art.articleType = 'noindexed';
                  if (data.sha) art.sha = data.sha;
                  recalculateArticleDeterministicState(art);
                  syncEditorStatusIfCurrent(art);
                }
                AppState.selectedIds.delete(relPath);
                successCount++;
              } else {
                failCount++;
                errors.push(data.error || ('Failed to archive: ' + (art ? art.title : relPath)));
              }
            } catch (err) {
              failCount++;
              errors.push('Network error: ' + (art ? art.title : relPath));
            }
          }

          updateBulkToolbar();
          applyFiltersAndSorting();
          populateOverviewStats();

          if (successCount > 0 && failCount === 0) {
            showToast('Successfully archived ' + successCount + ' articles', 'success');
          } else if (successCount > 0 && failCount > 0) {
            showToast('Archived ' + successCount + ' articles (' + failCount + ' failed: ' + errors[0] + ')', 'warning');
          } else {
            showToast('Archive failed: ' + (errors[0] || 'Unknown error'), 'error');
          }
        }
      });
    }

    async function handleBulkDelete() {
      const count = AppState.selectedIds.size;
      if (count === 0) return;

      const targets = Array.from(AppState.selectedIds);
      const actionableTargets = targets.filter(relPath => {
        const art = AppState.articles.find(a => a.relPath === relPath);
        return art && art.articleType !== 'redirect';
      });

      if (actionableTargets.length === 0) {
        showToast('Selected articles are redirect stubs and cannot be deleted.', 'error');
        return;
      }

      const redirectSkippedCount = targets.length - actionableTargets.length;
      let promptBody = 'Permanent deletion will remove ' + actionableTargets.length + ' source Markdown files from disk.';
      if (redirectSkippedCount > 0) {
        promptBody += '<br><br><em>Note: ' + redirectSkippedCount + ' selected redirect stub(s) will be protected and preserved.</em>';
      }
      promptBody += '<br><br>Type <strong>DELETE</strong> below to confirm:';

      openConfirmModal({
        title: 'Bulk Delete ' + actionableTargets.length + ' Articles?',
        body: promptBody,
        inputRequired: 'DELETE',
        confirmLabel: 'Permanently Delete ' + actionableTargets.length + ' Articles',
        danger: true,
        onConfirm: async () => {
          closeConfirmModal();
          showToast('Deleting selected articles...', 'warning');

          let successCount = 0;
          let failCount = 0;
          const errors = [];

          for (const relPath of actionableTargets) {
            const art = AppState.articles.find(a => a.relPath === relPath);
            try {
              const res = await fetch('/api/admin/articles/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ relPath, confirmTitle: 'DELETE', sha: (art && art.sha) || null })
              });
              let data = {};
              try { data = await res.json(); } catch (_) {}

              if (res.ok && data.success) {
                const idx = AppState.articles.findIndex(a => a.relPath === relPath);
                if (idx !== -1) AppState.articles.splice(idx, 1);
                AppState.selectedIds.delete(relPath);
                attentionMap.delete(relPath);
                if (Array.isArray(window.__NEEDS_ATTENTION__)) {
                  window.__NEEDS_ATTENTION__ = window.__NEEDS_ATTENTION__.filter(item => item.relPath !== relPath);
                }
                if (Array.isArray(window.__SENSITIVE__)) {
                  window.__SENSITIVE__ = window.__SENSITIVE__.filter(item => item.relPath !== relPath);
                }
                if (Array.isArray(window.__THIN_QUEUE__)) {
                  window.__THIN_QUEUE__ = window.__THIN_QUEUE__.filter(item => item.relPath !== relPath);
                }
                ThinQueueState.items = ThinQueueState.items.filter(item => item.relPath !== relPath);
                if (AppState.currentlyEditingArticle && AppState.currentlyEditingArticle.relPath === relPath) {
                  AppState.currentlyEditingArticle = null;
                  updateEditorActionButtons(null);
                }
                successCount++;
              } else {
                failCount++;
                errors.push(data.error || ('Failed to delete: ' + (art ? art.title : relPath)));
              }
            } catch (err) {
              failCount++;
              errors.push('Network error: ' + (art ? art.title : relPath));
            }
          }

          recalculateThinQueueStats();
          updateThinQueueCounts();
          updateBulkToolbar();
          applyFiltersAndSorting();
          populateOverviewStats();
          if (AppState.currentView === 'thin-queue') {
            applyThinQueueFilters();
          } else if (AppState.currentView === 'attention') {
            renderNeedsAttentionTab();
          } else if (AppState.currentView === 'safety') {
            renderSafetyTab();
          }

          if (successCount > 0 && failCount === 0) {
            showToast('Successfully deleted ' + successCount + ' articles', 'success');
          } else if (successCount > 0 && failCount > 0) {
            showToast('Deleted ' + successCount + ' articles (' + failCount + ' failed: ' + errors[0] + ')', 'warning');
          } else {
            showToast('Deletion failed: ' + (errors[0] || 'Unknown error'), 'error');
          }
        }
      });
    }

    // Confirmation Modal Helper
    let currentConfirmCallback = null;

    function openConfirmModal(config) {
      const modal = document.getElementById('confirm-modal');
      if (!modal) return;
      document.getElementById('confirm-modal-title').innerText = config.title;

      let bodyHtml = '<div style="font-size: 13px; line-height: 1.6; color: var(--color-ink);">' + config.body + '</div>';
      if (config.inputRequired) {
        bodyHtml += '<div style="margin-top: 14px;">' +
          '<input type="text" id="confirm-input-phrase" class="form-input-sm" style="font-weight: 700; letter-spacing: 1px; width: 100%; box-sizing: border-box;" placeholder="Type ' + config.inputRequired + ' to confirm">' +
        '</div>';
      }
      document.getElementById('confirm-modal-body').innerHTML = bodyHtml;

      const btnClass = config.danger ? 'btn-table-action btn-table-danger' : 'btn-table-action btn-table-primary';

      let footerHtml = '<button class="btn-table-action" type="button" onclick="closeConfirmModal()">Cancel</button>' +
        '<button class="' + btnClass + '" type="button" id="btn-modal-confirm">' + config.confirmLabel + '</button>';
      document.getElementById('confirm-modal-footer').innerHTML = footerHtml;

      currentConfirmCallback = () => {
        if (config.inputRequired) {
          const input = document.getElementById('confirm-input-phrase');
          if (!input || input.value.trim().toUpperCase() !== config.inputRequired) {
            alert('Confirmation phrase does not match. Action aborted.');
            return;
          }
        }
        if (config.onConfirm) config.onConfirm();
      };

      const confirmBtn = document.getElementById('btn-modal-confirm');
      if (confirmBtn) confirmBtn.onclick = currentConfirmCallback;
      modal.style.display = 'flex';

      if (config.inputRequired) {
        setTimeout(() => {
          const inp = document.getElementById('confirm-input-phrase');
          if (inp) {
            inp.focus();
            inp.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') {
                e.preventDefault();
                if (currentConfirmCallback) currentConfirmCallback();
              }
            });
          }
        }, 60);
      }
    }

    function closeConfirmModal(e) {
      if (e && e.target) {
        const isBackdrop = e.target.id === 'confirm-modal';
        const isClose = e.target.closest && (e.target.closest('.btn-close-modal') || e.target.closest('.btn-table-action'));
        if (!isBackdrop && !isClose) return;
      }
      const modal = document.getElementById('confirm-modal');
      if (modal) modal.style.display = 'none';
      currentConfirmCallback = null;
    }

    // ========================================================================
    // NEEDS ATTENTION & SAFETY TABLE RENDERING
    // ========================================================================
    function renderNeedsAttentionTab() {
      const tbody = document.getElementById('attn-table-body');
      if (!tbody) return;

      const list = Array.isArray(window.__NEEDS_ATTENTION__) ? window.__NEEDS_ATTENTION__ : [];
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 32px; color: var(--color-subtle);">No dispatches currently require attention.</td></tr>';
        return;
      }

      let html = '';
      list.forEach((item, idx) => {
        let sevBadge = '<span class="badge badge-gray">' + item.severity + '</span>';
        if (item.severity === 'HIGH') sevBadge = '<span class="badge badge-red">HIGH</span>';
        else if (item.severity === 'MEDIUM') sevBadge = '<span class="badge badge-amber">MEDIUM</span>';
        else if (item.severity === 'INFO') sevBadge = '<span class="badge badge-teal">INFO</span>';

        html += '<tr>' +
          '<td style="color: var(--color-subtle);">' + (idx + 1) + '</td>' +
          '<td>' +
            '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(item.relPath) + '\')">' + escapeHtml(item.title) + '</div>' +
            '<div class="row-article-sub">' + escapeHtml(item.url || item.relPath) + '</div>' +
          '</td>' +
          '<td>' + sevBadge + '</td>' +
          '<td style="color: var(--color-ink); font-weight: 500;">' + escapeHtml(item.problem) + '</td>' +
          '<td style="color: var(--color-muted); font-size: 12px;">' + escapeHtml(item.recommendedAction) + '</td>' +
          '<td style="text-align: right;">' +
            '<button class="btn-table-action btn-table-primary" onclick="openArticleEditor(\'' + escapeJs(item.relPath) + '\')">Edit Story</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    function renderSafetyTab() {
      const tbody = document.getElementById('safety-table-body');
      if (!tbody) return;

      const list = Array.isArray(window.__SENSITIVE__) ? window.__SENSITIVE__.length ? window.__SENSITIVE__ : AppState.articles.filter(a => a.sensitiveTopic) : [];
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 32px; color: var(--color-subtle);">No sensitive dispatches flagged.</td></tr>';
        return;
      }

      let html = '';
      list.forEach((art, idx) => {
        const topics = Array.isArray(art.sensitiveTopic) ? art.sensitiveTopic.join(', ') : (art.sensitiveTopic || 'General Sensitive');
        html += '<tr>' +
          '<td style="color: var(--color-subtle);">' + (idx + 1) + '</td>' +
          '<td>' +
            '<div class="row-article-headline" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">' + escapeHtml(art.title) + '</div>' +
            '<div class="row-article-sub">' + escapeHtml(art.url) + '</div>' +
          '</td>' +
          '<td>' + getDeskBadge(art.category) + '</td>' +
          '<td><span class="badge badge-blue">' + escapeHtml(topics) + '</span></td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' +
            (art.hasSourceName ? '<span style="color: var(--color-green);">&check; Grounded in wire report (' + escapeHtml(art.sourceName) + ')</span>' : '<span style="color: var(--color-amber);">&bull; Review wire citation</span>') +
          '</td>' +
          '<td style="text-align: right;">' +
            '<button class="btn-table-action btn-table-primary" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">Review</button>' +
          '</td>' +
        '</tr>';
      });
      tbody.innerHTML = html;
    }

    // ========================================================================
    // HELPERS & UTILITIES
    // ========================================================================
    function getDeskBadge(cat) {
      const c = (cat || '').toLowerCase();
      let badgeClass = 'badge-gray';
      if (c === 'india') badgeClass = 'badge-red';
      else if (c === 'world') badgeClass = 'badge-blue';
      else if (c === 'business') badgeClass = 'badge-green';
      else if (c === 'tech') badgeClass = 'badge-purple';
      else if (c === 'sports') badgeClass = 'badge-amber';
      return '<span class="badge ' + badgeClass + '">' + escapeHtml(cat || 'General') + '</span>';
    }

    function getStatusBadge(art) {
      if (art.articleType === 'redirect') {
        return '<span class="badge badge-teal">Redirect</span>';
      } else if (art.noindex) {
        return '<span class="badge badge-amber">Archived</span>';
      }
      return '<span class="badge badge-green">Active</span>';
    }

    function formatDate(d) {
      if (!d) return 'N/A';
      try {
        return new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
      } catch (e) {
        return String(d);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeJs(str) {
      if (!str) return '';
      return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'toast-pill ' + type;
      toast.innerHTML = '<span>' + (type === 'success' ? '&#10003;' : (type === 'error' ? '&#9888;' : '&#8505;')) + '</span> <span>' + escapeHtml(message) + '</span>';
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    // Close modals on ESC key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closePreviewModal();
        closeConfirmModal();
        closeRevisionModal();
        closeThinDetailModal();
        closeSafetyModal();
      }
    });

    // Initialize application on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      populateOverviewStats();
      applyFiltersAndSorting();
      renderNeedsAttentionTab();
      renderSafetyTab();
      initThinQueueView();

      // Check initial URL parameters for deep links
      const params = new URLSearchParams(window.location.search);
      const initialView = params.get('view') || 'overview';
      const initialArticle = params.get('article');
      const initialMode = params.get('mode');

      if (initialView === 'articles' && initialMode === 'edit' && initialArticle) {
        const art = AppState.articles.find(a => a.slug === initialArticle || a.relPath.includes(initialArticle));
        if (art) {
          openArticleEditor(art.relPath, { fromPopState: true });
          return;
        }
      }

      navigate(initialView, { fromPopState: true });
    });

    // ========================================================================
    // PHASE 8: THIN CONTENT QUEUE CLIENT ENGINE
    // ========================================================================
    const ThinQueueState = {
      items: Array.isArray(window.__THIN_QUEUE__) ? window.__THIN_QUEUE__ : [],
      stats: window.__THIN_STATS__ || {},
      filteredItems: [],
      selectedItem: null,
      reviewStates: {}, // slug -> { status: 'reviewed' | 'dismissed', reviewer, timestamp, notes }
      filters: {
        classification: 'ALL',
        desk: 'ALL',
        words: 'ALL',
        reviewStatus: 'ALL',
        search: '',
        sort: 'confidence'
      },
      pagination: {
        page: 1,
        pageSize: 25
      }
    };

    // Load persisted review states from localStorage as local fallback
    try {
      const cachedReviews = localStorage.getItem('samachar_thin_queue_reviews');
      if (cachedReviews) {
        ThinQueueState.reviewStates = JSON.parse(cachedReviews) || {};
      }
    } catch (_) {}

    function initThinQueueView(forceRefresh = false) {
      if (forceRefresh) {
        showToast('Refreshing Thin Content Queue data...', 'info');
      }

      // Sync items from global
      ThinQueueState.items = Array.isArray(window.__THIN_QUEUE__) ? window.__THIN_QUEUE__ : [];
      ThinQueueState.stats = window.__THIN_STATS__ || {};

      // Batch fetch latest review states from Worker API if authenticated
      fetchThinQueueReviewStates();

      // Apply filters and render
      applyThinQueueFilters();
    }

    async function fetchThinQueueReviewStates() {
      if (!ThinQueueState.items || ThinQueueState.items.length === 0) return;
      // Get first 100 slugs for active inspection
      const slugs = ThinQueueState.items.slice(0, 100).map(i => i.slug).filter(Boolean);
      if (slugs.length === 0) return;

      try {
        const resp = await fetch('/api/admin/thin-queue/reviews?slugs=' + encodeURIComponent(slugs.join(',')), {
          headers: { 'Accept': 'application/json' }
        });
        if (resp.ok) {
          const data = await resp.json();
          if (data && data.reviews) {
            ThinQueueState.reviewStates = { ...ThinQueueState.reviewStates, ...data.reviews };
            try {
              localStorage.setItem('samachar_thin_queue_reviews', JSON.stringify(ThinQueueState.reviewStates));
            } catch (_) {}
            renderThinQueueTable();
          }
        }
      } catch (_) {
        // Fallback gracefully to local state
      }
    }

    function applyThinQueueFilters() {
      let filtered = [...ThinQueueState.items];
      const f = ThinQueueState.filters;

      // 1. Classification Filter
      if (f.classification !== 'ALL') {
        if (f.classification === 'LOW_VALUE') {
          filtered = filtered.filter(item => item.classification === 'Noindex' || item.classification === 'Prune');
        } else {
          filtered = filtered.filter(item => item.classification === f.classification);
        }
      }

      // 2. Desk Filter
      if (f.desk !== 'ALL') {
        filtered = filtered.filter(item => (item.category || '').toLowerCase() === f.desk.toLowerCase());
      }

      // 3. Word Count Filter
      if (f.words !== 'ALL') {
        if (f.words === 'under100') filtered = filtered.filter(item => item.wordCount < 100);
        else if (f.words === '100-199') filtered = filtered.filter(item => item.wordCount >= 100 && item.wordCount < 200);
        else if (f.words === '200-299') filtered = filtered.filter(item => item.wordCount >= 200 && item.wordCount < 300);
        else if (f.words === '300plus') filtered = filtered.filter(item => item.wordCount >= 300);
      }

      // 4. Review Status Filter
      if (f.reviewStatus !== 'ALL') {
        filtered = filtered.filter(item => {
          const rev = ThinQueueState.reviewStates[item.slug];
          const status = rev ? rev.status : 'unreviewed';
          return status === f.reviewStatus;
        });
      }

      // 5. Search Filter
      if (f.search) {
        const q = f.search.toLowerCase();
        filtered = filtered.filter(item => {
          return (item.title && item.title.toLowerCase().includes(q)) ||
                 (item.slug && item.slug.toLowerCase().includes(q)) ||
                 (item.reason && item.reason.toLowerCase().includes(q));
        });
      }

      // 6. Sorting
      const confOrder = { 'High': 3, 'Medium': 2, 'Low': 1 };
      filtered.sort((a, b) => {
        if (f.sort === 'confidence') {
          const cA = confOrder[a.confidence] || 0;
          const cB = confOrder[b.confidence] || 0;
          if (cA !== cB) return cB - cA;
          return a.wordCount - b.wordCount;
        } else if (f.sort === 'newest') {
          return (b.date || '').localeCompare(a.date || '');
        } else if (f.sort === 'oldest') {
          return (a.date || '').localeCompare(b.date || '');
        } else if (f.sort === 'shortest') {
          return a.wordCount - b.wordCount;
        } else if (f.sort === 'longest') {
          return b.wordCount - a.wordCount;
        }
        return 0;
      });

      ThinQueueState.filteredItems = filtered;
      ThinQueueState.pagination.page = 1;
      renderThinQueueTable();
      updateThinQueueCounts();
    }

    function updateThinQueueCounts() {
      const counts = ThinQueueState.stats.classificationCounts || {};
      const total = ThinQueueState.stats.flaggedCount || ThinQueueState.items.length;

      const pAll = document.getElementById('tq-count-pill-all');
      const pEnrich = document.getElementById('tq-count-pill-enrich');
      const pKeep = document.getElementById('tq-count-pill-keep-short');
      const pCons = document.getElementById('tq-count-pill-consolidate');
      const pNoindex = document.getElementById('tq-count-pill-noindex');
      const pPrune = document.getElementById('tq-count-pill-prune');
      const pRev = document.getElementById('tq-count-pill-review');

      if (pAll) pAll.innerText = total.toLocaleString();
      if (pEnrich) pEnrich.innerText = (counts['Enrich'] || 0).toLocaleString();
      if (pKeep) pKeep.innerText = (counts['Keep Short'] || 0).toLocaleString();
      if (pCons) pCons.innerText = (counts['Consolidate'] || 0).toLocaleString();
      if (pNoindex) pNoindex.innerText = (counts['Noindex'] || 0).toLocaleString();
      if (pPrune) pPrune.innerText = (counts['Prune'] || 0).toLocaleString();
      if (pRev) pRev.innerText = (counts['Review'] || 0).toLocaleString();

      // Top Summary KPI Cards
      const kEnrich = document.getElementById('tq-kpi-enrich');
      const kCons = document.getElementById('tq-kpi-consolidate');
      const kRev = document.getElementById('tq-kpi-review');
      const kKeep = document.getElementById('tq-kpi-keep-short');
      const kLowVal = document.getElementById('tq-kpi-low-value');
      if (kEnrich) kEnrich.innerText = (counts['Enrich'] || 0).toLocaleString();
      if (kCons) kCons.innerText = (counts['Consolidate'] || 0).toLocaleString();
      if (kRev) kRev.innerText = (counts['Review'] || 0).toLocaleString();
      if (kKeep) kKeep.innerText = (counts['Keep Short'] || 0).toLocaleString();
      if (kLowVal) kLowVal.innerText = ((counts['Noindex'] || 0) + (counts['Prune'] || 0)).toLocaleString();

      const kScanned = document.getElementById('tq-kpi-scanned');
      const kScannedSub = document.getElementById('tq-kpi-scanned-sub');
      const totalArticles = AppState.articles.length;
