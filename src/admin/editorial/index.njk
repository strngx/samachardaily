        // Desktop Row
        desktopHtml += '<tr class="' + (isSelected ? 'selected' : '') + '">' +
          '<td style="text-align: center;">' +
            '<input type="checkbox" ' + (isSelected ? 'checked' : '') + ' onchange="toggleArticleSelection(\'' + escapeJs(art.relPath) + '\', this)">' +
          '</td>' +
          '<td>' +
            '<div class="td-article-title" onclick="openArticleDrawer(\'' + escapeJs(art.relPath) + '\')">' + escapeHtml(art.title) + '</div>' +
            '<div class="td-article-url">' + escapeHtml(art.url) + '</div>' +
          '</td>' +
          '<td>' + deskBadge + '</td>' +
          '<td>' + statusBadge + '</td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + displayDate + '</td>' +
          '<td>' + healthBadge + '</td>' +
          '<td style="text-align: right;">' +
            '<div style="display: flex; gap: 6px; justify-content: flex-end; align-items: center;">' +
              '<button class="btn-action-primary" onclick="openArticleEditor(\'' + escapeJs(art.relPath) + '\')">Edit</button>' +
              '<button class="btn-action-secondary" onclick="openPreviewModal(\'' + escapeJs(art.relPath) + '\')">Preview</button>' +
              '<div class="dropdown">' +
                '<button class="btn-action-more" onclick="toggleDropdown(this)">...</button>' +
                '<div class="dropdown-content">' +
                  '<a href="' + art.url + '" target="_blank" class="dropdown-item">Open Live Article</a>' +
                  (art.noindex
                    ? '<button class="dropdown-item" onclick="promptRestoreArticle(\'' + escapeJs(art.relPath) + '\')">Restore (Active)</button>'
                    : '<button class="dropdown-item" onclick="promptArchiveArticle(\'' + escapeJs(art.relPath) + '\')">Archive Story</button>'
                  ) +
                  '<button class="dropdown-item danger" onclick="promptDeleteArticle(\'' + escapeJs(art.relPath) + '\')">Delete Story</button>' +
                '</div>' +
