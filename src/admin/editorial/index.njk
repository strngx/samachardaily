        <button class="btn-table-action" id="safety-tab-sensitivity" onclick="switchSafetyModalTab('sensitivity')" style="font-size: 12px; padding: 4px 10px;">Sensitive Topics</button>
        <button class="btn-table-action" id="safety-tab-media" onclick="switchSafetyModalTab('media')" style="font-size: 12px; padding: 4px 10px;">Media Rights</button>
      </div>

      <div class="modal-body" id="safety-modal-body" style="max-height: 55vh; overflow-y: auto; padding: 20px;">
        <!-- Injected via JavaScript -->
      </div>

      <div class="modal-footer" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid var(--color-border); padding: 12px 20px;">
        <div id="safety-signoff-container" style="display: flex; align-items: center; gap: 8px;">
          <input type="text" id="safety-signoff-notes" class="form-input-sm" placeholder="Editorial rationale (optional)..." style="width: 220px; font-size: 12px; padding: 4px 8px;">
          <button class="btn-table-action" type="button" id="btn-safety-signoff" onclick="handleSafetySignoff()" style="font-size: 12px;">Editorial Sign-Off</button>
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="btn-table-action" type="button" id="btn-re-safety-check" onclick="runSafetyCheckFromEditor(false)" style="font-size: 12px;">Re-run Check</button>
          <button class="btn-table-action" type="button" onclick="closeSafetyModal()" style="font-size: 12px;">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Confirmation Modal -->
  <div id="confirm-modal" class="modal-backdrop" onclick="closeConfirmModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div class="modal-title" id="confirm-modal-title">Confirm Action</div>
        <button class="btn-close-modal" onclick="closeConfirmModal()">&times;</button>
      </div>
      <div class="modal-body" id="confirm-modal-body">
        <!-- Injected via JavaScript -->
      </div>
      <div class="modal-footer" id="confirm-modal-footer">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- Invite Member Modal -->
  <div id="invite-member-modal" class="modal-backdrop" onclick="closeInviteModal(event)">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width: 520px;">
      <div class="modal-header">
        <div class="modal-title">Invite Team Member</div>
        <button class="btn-close-modal" type="button" onclick="closeInviteModal()">&times;</button>
      </div>
      <form id="invite-member-form" onsubmit="handleSendInvitation(event)">
        <div class="modal-body" style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
          <div class="form-group">
            <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--color-ink);">
              Gmail Address <span style="color: var(--color-brand);">*</span>
            </label>
            <input type="email" id="invite-input-email" class="form-input" placeholder="journalist@gmail.com" required style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px;">
            <div style="font-size: 11px; color: var(--color-subtle); margin-top: 4px;">
              Must be an active @gmail.com or @googlemail.com account. Invitee authenticates via Google.
            </div>
          </div>

          <div class="form-group">
            <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--color-ink);">
              Display Name <span style="color: var(--color-brand);">*</span>
            </label>
            <input type="text" id="invite-input-name" class="form-input" placeholder="e.g. Priya Sharma" required style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px;">
          </div>

          <div class="form-group">
            <label style="display: block; font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--color-ink);">
              Initial Role <span style="color: var(--color-brand);">*</span>
            </label>
            <select id="invite-input-role" class="form-select" style="width: 100%; box-sizing: border-box; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px;" required>
              <option value="editor">Editor — Article work only</option>
              <option value="admin">Admin — Full administrative access</option>
            </select>
            <div style="font-size: 11px; color: var(--color-subtle); margin-top: 4px;">
              Owner role is immutable and reserved exclusively for the Root Owner.
