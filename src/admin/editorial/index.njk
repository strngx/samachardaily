          <div id="invite-error-box" style="display: none; padding: 10px 14px; background: var(--color-brand-light); border: 1px solid var(--color-brand-border); color: var(--color-brand); border-radius: var(--radius-sm); font-size: 12px;"></div>

          <div id="invite-result-box" style="display: none; padding: 14px; background: var(--color-surface-alt); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 12px;">
            <div id="invite-result-msg" style="font-weight: 600; margin-bottom: 8px; color: var(--color-ink);"></div>
            <div id="invite-result-url-wrap" style="display: none;">
              <div style="font-size: 11px; color: var(--color-subtle); margin-bottom: 6px;">
                Direct Invitation Link (share this URL with the invitee):
              </div>
              <div style="display: flex; gap: 8px;">
                <input type="text" id="invite-result-url" readonly style="flex: 1; font-family: var(--font-mono); font-size: 11px; padding: 6px 10px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
                <button type="button" class="btn-table-action btn-table-primary" id="btn-copy-invite-url" onclick="copyInviteResultUrl()">Copy Link</button>
