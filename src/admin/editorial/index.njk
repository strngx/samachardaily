        <div class="modal-footer" style="padding: 14px 20px; border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end; gap: 10px;">
          <button type="button" class="btn-table-action" onclick="closeInviteModal()">Close</button>
          <button type="submit" id="btn-submit-invite" class="btn-table-action btn-table-primary">Send Invitation</button>
        </div>
