        </div>

        <div class="card" style="margin-bottom: 0;">
          <div class="card-title">Newsroom Governance</div>
          <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px; font-size: 13px;">
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--color-muted);">Technical Google News:</span>
              <strong style="color: var(--color-green);">PASS (Verified)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
              <span style="color: var(--color-muted);">Admin Production Isolation:</span>
