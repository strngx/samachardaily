            <div>Generated HTML Files: <strong>1,303 (in _site/articles/)</strong></div>
            <div>Static Assets Copied: <strong>17 assets</strong></div>
          </div>
        </div>

        <div class="card">
          <div class="card-title">Security Containment</div>
          <div style="font-size: 13px; line-height: 1.8; margin-top: 8px;">
            <div>Admin Isolation: <strong style="color: var(--color-green);">Enforced</strong></div>
            <div>Session Mechanism: <strong>HttpOnly / Scrypt</strong></div>
            <div>Public Exposure: <strong style="color: var(--color-green);">Zero</strong></div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Inspection Modal -->
  <div id="inspect-modal" class="modal-backdrop" onclick="closeInspectModal(event)">
    <div class="modal-card" onclick="event.stopPropagation()">
      <div class="modal-header">
        <h3 id="inspect-modal-title">Article Inspection</h3>
        <button class="modal-close" onclick="closeInspectModal()">&times;</button>
      </div>
      <div id="inspect-modal-body" class="modal-body">
        <!-- Content injected dynamically -->
      </div>
      <div class="modal-footer">
        <button class="btn-reset" onclick="closeInspectModal()">Close</button>
      </div>
    </div>
  </div>

  <!-- Guarded Action Modal (for Edit / Delete / Archive) -->
  <div id="guarded-modal" class="modal-backdrop" onclick="closeGuardedModal(event)">
    <div class="modal-card" style="max-width: 500px;" onclick="event.stopPropagation()">
      <div class="modal-header">
        <h3 id="guarded-modal-title">Controlled Action Notice</h3>
        <button class="modal-close" onclick="closeGuardedModal()">&times;</button>
      </div>
      <div id="guarded-modal-body" class="modal-body">
        <!-- Content injected dynamically -->
      </div>
      <div class="modal-footer">
        <button class="btn-reset" onclick="closeGuardedModal()">Understood</button>
      </div>
    </div>
  </div>

  <!-- Embed Master Corpus Data for Client-Side Search/Filter -->
  <script>
    window.__CORPUS__ = {{ editorial.masterArticlesJson | safe }};
    window.__NEEDS_ATTENTION__ = {{ editorial.needsAttentionJson | safe }};
    window.__SENSITIVE__ = {{ editorial.sensitiveArticlesJson | safe }};

    // Client-side authentication ping
    async function verifyAuthSession() {
      try {
        const res = await fetch('/api/admin/session');
        if (res.ok) {
          const data = await res.json();
          if (!data || !data.authenticated) {
            window.location.replace('/admin/');
          }
        }
      } catch (e) {
        // Offline or non-auth environment
      }
    }
    verifyAuthSession();

    async function handleLogout() {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
      } catch (e) {}
      window.location.replace('/admin/');
    }

    // -------------------------------------------------------------
    // Tab Switching
    // -------------------------------------------------------------
    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-tab-btn').forEach(el => el.classList.remove('active'));

      const target = document.getElementById('tab-' + tabId);
      if (target) target.classList.add('active');
      if (btn) btn.classList.add('active');
    }

    // -------------------------------------------------------------
    // Master Article Table Engine
    // -------------------------------------------------------------
    let allArticles = Array.isArray(window.__CORPUS__) ? window.__CORPUS__ : [];
    let filteredArticles = [...allArticles];
    let currentArticlePage = 1;
    const articlePageSize = 25;

    function renderArticleTable() {
      const tbody = document.getElementById('article-table-body');
      if (!tbody) return;

      const total = filteredArticles.length;
      const totalPages = Math.ceil(total / articlePageSize) || 1;
      if (currentArticlePage > totalPages) currentArticlePage = totalPages;
      if (currentArticlePage < 1) currentArticlePage = 1;

      document.getElementById('art-shown-count').innerText = total;
      document.getElementById('art-total-count').innerText = allArticles.length;
      document.getElementById('art-page-num').innerText = currentArticlePage;
      document.getElementById('art-page-total').innerText = totalPages;

      document.getElementById('art-prev-btn').disabled = (currentArticlePage === 1);
      document.getElementById('art-next-btn').disabled = (currentArticlePage === totalPages);

      const start = (currentArticlePage - 1) * articlePageSize;
      const slice = filteredArticles.slice(start, start + articlePageSize);

      if (slice.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; padding: 32px; color: var(--color-muted);">No articles match the selected search or filter criteria.</td></tr>';
        return;
      }

      let html = '';
      slice.forEach((art, idx) => {
        const itemNum = start + idx + 1;
        
        let statusBadge = '<span class="badge badge-green">Active</span>';
        if (art.articleType === 'redirect') {
          statusBadge = '<span class="badge badge-teal">Redirect Stub</span>';
        } else if (art.noindex) {
          statusBadge = '<span class="badge badge-amber">Noindexed</span>';
        }

        let deskBadgeClass = 'badge-gray';
        const d = (art.category || '').toLowerCase();
        if (d === 'india') deskBadgeClass = 'badge-red';
        else if (d === 'world') deskBadgeClass = 'badge-blue';
        else if (d === 'business') deskBadgeClass = 'badge-green';
        else if (d === 'tech') deskBadgeClass = 'badge-purple';
        else if (d === 'sports') deskBadgeClass = 'badge-amber';

        let wordTierClass = 'color: var(--color-green);';
        if (art.wordCount < 100) wordTierClass = 'color: #b91c1c; font-weight: 700;';
        else if (art.wordCount < 150) wordTierClass = 'color: #b45309; font-weight: 700;';
        else if (art.wordCount < 180) wordTierClass = 'color: #1d4ed8;';

        const displayDate = art.date ? new Date(art.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'N/A';

        html += '<tr>' +
          '<td class="td-mono">' + itemNum + '</td>' +
          '<td>' +
            '<div class="td-title"><a href="' + art.url + '" target="_blank">' + escapeHtml(art.title) + '</a></div>' +
            '<div class="td-sub">Src: ' + escapeHtml(art.sourceName || 'Unspecified') + ' &bull; <code>' + escapeHtml(art.slug) + '</code></div>' +
          '</td>' +
          '<td><span class="badge ' + deskBadgeClass + '">' + escapeHtml(art.category) + '</span></td>' +
          '<td class="td-mono" style="' + wordTierClass + '">' + (art.wordCount || 0) + 'w</td>' +
          '<td>' + statusBadge + '</td>' +
          '<td class="td-mono">' + displayDate + '</td>' +
          '<td>' +
            '<div style="display: flex; gap: 6px; flex-wrap: wrap;">' +
              '<a href="' + art.url + '" target="_blank" class="btn-action-view">View</a>' +
              '<button class="btn-action-inspect" onclick="inspectArticle(' + (start + idx) + ')">Inspect</button>' +
            '</div>' +
          '</td>' +
        '</tr>';
      });

      tbody.innerHTML = html;
    }

    function handleArticleSearch() {
      applyAllArticleFilters();
    }

    function handleArticleFilter() {
      applyAllArticleFilters();
    }

    function applyAllArticleFilters() {
      const q = (document.getElementById('article-search').value || '').toLowerCase().trim();
      const desk = document.getElementById('filter-desk').value;
      const status = document.getElementById('filter-status').value;
      const words = document.getElementById('filter-words').value;

      filteredArticles = allArticles.filter(art => {
        if (q) {
          const matchTitle = (art.title || '').toLowerCase().includes(q);
          const matchSlug = (art.slug || '').toLowerCase().includes(q);
          const matchSrc = (art.sourceName || '').toLowerCase().includes(q);
          const matchAuthor = (art.author || '').toLowerCase().includes(q);
          const matchPath = (art.relPath || '').toLowerCase().includes(q);
          if (!matchTitle && !matchSlug && !matchSrc && !matchAuthor && !matchPath) return false;
        }

        if (desk !== 'ALL' && (art.category || '').toLowerCase() !== desk) return false;

        if (status === 'active' && (art.noindex || art.articleType === 'redirect')) return false;
        if (status === 'noindexed' && (!art.noindex || art.articleType === 'redirect')) return false;
        if (status === 'redirect' && art.articleType !== 'redirect') return false;

        const wc = art.wordCount || 0;
        if (words === 'under100' && (wc >= 100 || art.articleType === 'redirect')) return false;
        if (words === 'w100_149' && (wc < 100 || wc >= 150)) return false;
        if (words === 'w150_179' && (wc < 150 || wc >= 180)) return false;
        if (words === 'w180_249' && (wc < 180 || wc >= 250)) return false;
        if (words === 'w250plus' && wc < 250) return false;

        return true;
      });

      currentArticlePage = 1;
      renderArticleTable();
    }

    function resetArticleFilters() {
      document.getElementById('article-search').value = '';
      document.getElementById('filter-desk').value = 'ALL';
      document.getElementById('filter-status').value = 'ALL';
      document.getElementById('filter-words').value = 'ALL';
      filteredArticles = [...allArticles];
      currentArticlePage = 1;
      renderArticleTable();
    }

    function prevArticlePage() {
      if (currentArticlePage > 1) {
        currentArticlePage--;
        renderArticleTable();
      }
    }

    function nextArticlePage() {
      const totalPages = Math.ceil(filteredArticles.length / articlePageSize) || 1;
      if (currentArticlePage < totalPages) {
        currentArticlePage++;
        renderArticleTable();
      }
    }

    // -------------------------------------------------------------
    // Needs Attention Table Engine
    // -------------------------------------------------------------
    let allAttn = Array.isArray(window.__NEEDS_ATTENTION__) ? window.__NEEDS_ATTENTION__ : [];
    let filteredAttn = [...allAttn];
    let currentAttnPage = 1;
    const attnPageSize = 20;

    function renderAttnTable() {
      const tbody = document.getElementById('attn-table-body');
      if (!tbody) return;

      const total = filteredAttn.length;
      const totalPages = Math.ceil(total / attnPageSize) || 1;
      if (currentAttnPage > totalPages) currentAttnPage = totalPages;
      if (currentAttnPage < 1) currentAttnPage = 1;

      document.getElementById('attn-shown-count').innerText = total;
      document.getElementById('attn-page-num').innerText = currentAttnPage;
      document.getElementById('attn-page-total').innerText = totalPages;

      document.getElementById('attn-prev-btn').disabled = (currentAttnPage === 1);
      document.getElementById('attn-next-btn').disabled = (currentAttnPage === totalPages);

      const start = (currentAttnPage - 1) * attnPageSize;
      const slice = filteredAttn.slice(start, start + attnPageSize);

      if (slice.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 24px; color: var(--color-muted);">No issues matching the selected filters.</td></tr>';
        return;
      }

      let html = '';
      slice.forEach((item, idx) => {
        let sevBadge = '<span class="badge badge-gray">' + item.severity + '</span>';
        if (item.severity === 'HIGH') sevBadge = '<span class="badge badge-red">HIGH</span>';
        else if (item.severity === 'MEDIUM') sevBadge = '<span class="badge badge-amber">MEDIUM</span>';
        else if (item.severity === 'INFO') sevBadge = '<span class="badge badge-teal">INFO</span>';

        html += '<tr>' +
          '<td class="td-mono">' + (start + idx + 1) + '</td>' +
          '<td>' +
            '<div class="td-title"><a href="' + item.url + '" target="_blank">' + escapeHtml(item.title) + '</a></div>' +
            '<div class="td-sub"><code>' + escapeHtml(item.relPath) + '</code></div>' +
          '</td>' +
          '<td>' + sevBadge + '</td>' +
          '<td><strong>' + escapeHtml(item.problem) + '</strong><div class="td-sub">' + escapeHtml(item.reason) + '</div></td>' +
          '<td style="font-size: 12px; color: var(--color-muted);">' + escapeHtml(item.recommendedAction) + '</td>' +
          '<td><button class="btn-action-inspect" onclick="inspectAttnItem(' + (start + idx) + ')">Inspect</button></td>' +
        '</tr>';
      });

      tbody.innerHTML = html;
    }

    function filterAttnTable() {
      const q = (document.getElementById('attn-search').value || '').toLowerCase().trim();
      const sev = document.getElementById('filter-attn-severity').value;

      filteredAttn = allAttn.filter(item => {
        if (q) {
          const matchTitle = (item.title || '').toLowerCase().includes(q);
          const matchReason = (item.reason || '').toLowerCase().includes(q);
          const matchProb = (item.problem || '').toLowerCase().includes(q);
          if (!matchTitle && !matchReason && !matchProb) return false;
        }
        if (sev !== 'ALL' && item.severity !== sev) return false;
        return true;
      });

      currentAttnPage = 1;
      renderAttnTable();
    }

    function resetAttnFilters() {
      document.getElementById('attn-search').value = '';
      document.getElementById('filter-attn-severity').value = 'ALL';
      filteredAttn = [...allAttn];
      currentAttnPage = 1;
      renderAttnTable();
    }

    function prevAttnPage() {
      if (currentAttnPage > 1) {
        currentAttnPage--;
        renderAttnTable();
      }
    }

    function nextAttnPage() {
      const totalPages = Math.ceil(filteredAttn.length / attnPageSize) || 1;
      if (currentAttnPage < totalPages) {
        currentAttnPage++;
        renderAttnTable();
      }
    }

    // -------------------------------------------------------------
    // Safety Table Engine
    // -------------------------------------------------------------
    function renderSafetyTable() {
      const tbody = document.getElementById('safety-table-body');
      if (!tbody) return;

      const list = Array.isArray(window.__SENSITIVE__) ? window.__SENSITIVE__ : [];
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 24px;">No flagged sensitive articles.</td></tr>';
        return;
      }

      let html = '';
      list.slice(0, 50).forEach((item, idx) => {
        const flagBadges = (item.flags || []).map(f => '<span class="badge badge-amber">' + f + '</span>').join(' ');
        html += '<tr>' +
          '<td class="td-mono">' + (idx + 1) + '</td>' +
          '<td>' +
            '<div class="td-title"><a href="' + item.url + '" target="_blank">' + escapeHtml(item.title) + '</a></div>' +
            '<div class="td-sub">Src: ' + escapeHtml(item.source) + ' &bull; <code>' + escapeHtml(item.relPath) + '</code></div>' +
          '</td>' +
          '<td><span class="badge badge-gray">' + escapeHtml(item.category) + '</span></td>' +
          '<td>' + flagBadges + '</td>' +
          '<td class="td-mono">' + (item.date ? new Date(item.date).toLocaleDateString('en-GB') : 'N/A') + '</td>' +
          '<td><button class="btn-action-inspect" onclick="inspectSafetyItem(' + idx + ')">Inspect</button></td>' +
        '</tr>';
      });

      tbody.innerHTML = html;
    }

    // -------------------------------------------------------------
    // Modals & Action Handlers
    // -------------------------------------------------------------
    function inspectArticle(idx) {
      const art = filteredArticles[idx];
      if (!art) return;

      document.getElementById('inspect-modal-title').innerText = art.title;

      let bodyHtml = '<div style="margin-bottom: 16px;">' +
        '<div><strong>Relative Filepath:</strong> <code>' + escapeHtml(art.relPath) + '</code></div>' +
        '<div style="margin-top: 6px;"><strong>URL:</strong> <a href="' + art.url + '" target="_blank">' + escapeHtml(art.url) + '</a></div>' +
        '<div style="margin-top: 6px;"><strong>Desk:</strong> ' + escapeHtml(art.category) + ' &bull; <strong>Word Count:</strong> ' + (art.wordCount || 0) + ' words</div>' +
        '<div style="margin-top: 6px;"><strong>Attribution:</strong> ' + escapeHtml(art.sourceName || 'None') + ' &bull; Source Link: ' + (art.sourceUrl ? '<a href="' + art.sourceUrl + '" target="_blank">Open Source</a>' : 'None') + '</div>' +
        '<div style="margin-top: 6px;"><strong>Indexability:</strong> ' + (art.noindex ? '<span class="badge badge-amber">noindex: true</span>' : '<span class="badge badge-green">Search Indexable</span>') + '</div>' +
      '</div>';

      if (art.dek) {
        bodyHtml += '<div style="background: var(--color-surface-alt); padding: 12px; border-radius: 4px; margin-bottom: 16px; border: 1px solid var(--color-border);">' +
          '<strong>Editorial Deck (dek):</strong>' +
          '<div style="margin-top: 4px; color: var(--color-muted);">' + escapeHtml(art.dek) + '</div>' +
        '</div>';
      }

      bodyHtml += '<div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--color-border);">' +
        '<button class="btn-reset" onclick="triggerControlledAction(\'Edit\', \'' + escapeHtml(art.slug) + '\')">Edit Story</button>' +
        '<button class="btn-reset" onclick="triggerControlledAction(\'Archive\', \'' + escapeHtml(art.slug) + '\')">Archive / Soft-Prune</button>' +
        '<button class="btn-reset" style="color: var(--color-brand);" onclick="triggerControlledAction(\'Delete\', \'' + escapeHtml(art.slug) + '\')">Delete Story</button>' +
      '</div>';

      document.getElementById('inspect-modal-body').innerHTML = bodyHtml;
      document.getElementById('inspect-modal').style.display = 'flex';
    }

    function inspectAttnItem(idx) {
      const item = filteredAttn[idx];
      if (!item) return;

      document.getElementById('inspect-modal-title').innerText = item.problem;
      const bodyHtml = '<div style="margin-bottom: 16px;">' +
        '<div><strong>Article:</strong> ' + escapeHtml(item.title) + '</div>' +
        '<div style="margin-top: 6px;"><strong>Filepath:</strong> <code>' + escapeHtml(item.relPath) + '</code></div>' +
        '<div style="margin-top: 6px;"><strong>Severity:</strong> <span class="badge badge-amber">' + item.severity + '</span></div>' +
      '</div>' +
      '<div style="background: var(--color-surface-alt); padding: 14px; border-radius: 4px; border: 1px solid var(--color-border); margin-bottom: 16px;">' +
        '<strong>Diagnostic Reason:</strong>' +
        '<div style="margin-top: 4px; color: var(--color-muted);">' + escapeHtml(item.reason) + '</div>' +
      '</div>' +
      '<div style="background: var(--color-teal-bg); padding: 14px; border-radius: 4px; border: 1px solid var(--color-teal-border);">' +
        '<strong style="color: var(--color-teal);">Recommended Action:</strong>' +
        '<div style="margin-top: 4px; color: var(--color-teal);">' + escapeHtml(item.recommendedAction) + '</div>' +
      '</div>';

      document.getElementById('inspect-modal-body').innerHTML = bodyHtml;
      document.getElementById('inspect-modal').style.display = 'flex';
    }

    function inspectSafetyItem(idx) {
      const list = Array.isArray(window.__SENSITIVE__) ? window.__SENSITIVE__ : [];
      const item = list[idx];
      if (!item) return;

      document.getElementById('inspect-modal-title').innerText = 'Safety Inspection: ' + item.title;
      const flagsHtml = (item.flags || []).map(f => '<span class="badge badge-amber">' + f + '</span>').join(' ');
      const bodyHtml = '<div style="margin-bottom: 16px;">' +
        '<div><strong>Filepath:</strong> <code>' + escapeHtml(item.relPath) + '</code></div>' +
        '<div style="margin-top: 6px;"><strong>Desk:</strong> ' + escapeHtml(item.category) + ' &bull; <strong>Word Count:</strong> ' + item.wordCount + ' words</div>' +
        '<div style="margin-top: 6px;"><strong>Sensitive Categories:</strong> ' + flagsHtml + '</div>' +
      '</div>' +
      '<div style="background: var(--color-surface-alt); padding: 12px; border-radius: 4px; border: 1px solid var(--color-border);">' +
        '<strong>Editorial Note:</strong>' +
        '<div style="margin-top: 4px; color: var(--color-muted);">This story contains terminology associated with sensitive topics. Verify that facts are corroborated by primary wire agencies before promoting or citing in investigative roundups.</div>' +
      '</div>';

      document.getElementById('inspect-modal-body').innerHTML = bodyHtml;
      document.getElementById('inspect-modal').style.display = 'flex';
    }

    function triggerControlledAction(actionType, slug) {
      closeInspectModal();
      document.getElementById('guarded-modal-title').innerText = 'Controlled Action: ' + actionType;
      let msg = '';
      if (actionType === 'Edit') {
        msg = 'Direct editing of the Markdown source (' + slug + '.md) is scheduled for the upcoming controlled CMS phase. In Phase 3, the article explorer operates in strict read-only mode to prevent accidental corpus corruption.';
      } else if (actionType === 'Delete') {
        msg = 'Silent hard deletion is strictly prohibited by SamacharDaily\'s SEO safety policy. In future phases, retiring this article will mandate establishing a 301 redirect stub to preserve backlinks and avoid 404 crawl penalties.';
      } else {
        msg = 'Archiving will inject `noindex: true` into the article frontmatter in the next controlled workflow phase, allowing the story to remain accessible to direct readers while cleanly de-indexing from search engines.';
      }

      document.getElementById('guarded-modal-body').innerHTML = '<div style="line-height: 1.5; color: var(--color-ink);">' + msg + '</div>';
      document.getElementById('guarded-modal').style.display = 'flex';
    }

    function closeInspectModal(e) {
      if (e && e.target && e.target.id !== 'inspect-modal' && !e.target.classList.contains('modal-close')) return;
      document.getElementById('inspect-modal').style.display = 'none';
    }

    function closeGuardedModal(e) {
      if (e && e.target && e.target.id !== 'guarded-modal' && !e.target.classList.contains('modal-close')) return;
      document.getElementById('guarded-modal').style.display = 'none';
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Initialize on page ready
    document.addEventListener('DOMContentLoaded', () => {
      renderArticleTable();
      renderAttnTable();
      renderSafetyTable();
    });
  </script>
</body>
</html>
