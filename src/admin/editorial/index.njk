          ovGscDesc.innerText = 'Real-time Google search queries, impressions, and discovery signals.';
        }
      }
    }

    async function loadSearchPerformanceData(forceRefresh = false) {
      if (GSCState.loading) return;
      GSCState.loading = true;

      const errorBanner = document.getElementById('gsc-error-banner');
      if (errorBanner) errorBanner.style.display = 'none';

      try {
        const statusRes = await fetch('/api/admin/gsc/status');
        if (statusRes.ok) {
          const statusData = await statusRes.json();
          GSCState.connected = Boolean(statusData.connected);
          GSCState.property = statusData.property || GSCState.property;
          GSCState.accountEmail = statusData.accountEmail || null;
          GSCState.accountName = statusData.accountName || null;
          GSCState.accountPicture = statusData.accountPicture || null;
          GSCState.lastSynced = statusData.lastSynced || null;
          if (AppState.currentUser) {
            if (statusData.accountPicture) AppState.currentUser.googlePicture = statusData.accountPicture;
            updateSidebarProfile(AppState.currentUser);
          }
        }
      } catch (e) {}

      updateGSCStatusUI();

      if (!GSCState.connected) {
        GSCState.loading = false;
        renderGSCNotConnectedState();
        return;
      }

      setGKPIsLoading();

      try {
        let url = '/api/admin/gsc/performance?range=' + encodeURIComponent(GSCState.dateRange) + '&searchType=' + encodeURIComponent(GSCState.searchType);
        if (GSCState.dateRange === 'custom' && GSCState.customStart && GSCState.customEnd) {
          url += '&startDate=' + encodeURIComponent(GSCState.customStart) + '&endDate=' + encodeURIComponent(GSCState.customEnd);
        }
        if (forceRefresh) {
          url += '&refresh=true';
        }

        const res = await fetch(url);
        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to retrieve Search Console data');
        }

        GSCState.summary = data.summary || { clicks: 0, impressions: 0, ctr: 0, position: 0 };
        GSCState.queries = Array.isArray(data.queries) ? data.queries : [];
        GSCState.pages = Array.isArray(data.pages) ? data.pages : [];
        GSCState.dateSeries = Array.isArray(data.dateSeries) ? data.dateSeries : [];
        GSCState.sitemaps = data.sitemaps || null;
        GSCState.lastSynced = data.lastSynced || new Date().toISOString();

        updateGSCStatusUI();
        renderGSCConnectedState();
      } catch (err) {
        GSCState.error = err.message || 'Google Search Console connection failed.';
        renderGSCErrorState(GSCState.error);
      } finally {
        GSCState.loading = false;
      }
    }

