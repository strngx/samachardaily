    function renderIndexingTab() {
      // 1. Overview KPIs
      const elPub = document.getElementById('idx-kpi-published');
      const elSite = document.getElementById('idx-kpi-sitemaps');
      const elInsp = document.getElementById('idx-kpi-inspected');
      if (elPub) elPub.innerText = (AppState.articles ? AppState.articles.length : 1468).toLocaleString();
      if (elSite) elSite.innerText = '1,481';
