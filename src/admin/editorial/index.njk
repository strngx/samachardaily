          <div class="brand-title">SamacharDaily</div>
          <div class="brand-subtitle">EDITORIAL CONTROL</div>
        </div>
      </div>

      <!-- Navigation Hierarchy -->
      <nav class="sidebar-nav">
        
        <div class="nav-category">WORKSPACE</div>
        <button class="nav-item active" data-view="overview" onclick="navigate('overview')">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span class="nav-item-label">Overview</span>
        </button>
        <button class="nav-item" data-view="articles" onclick="navigate('articles')">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span class="nav-item-label">Articles</span>
          <span class="nav-item-badge" id="side-art-count">...</span>
        </button>
        <button class="nav-item" data-view="thin-queue" onclick="navigate('thin-queue')">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><line x1="8" y1="13" x2="16" y2="13"></line><line x1="8" y1="17" x2="12" y2="17"></line><line x1="14" y1="2" x2="14" y2="8"></line><line x1="14" y1="8" x2="20" y2="8"></line><circle cx="17" cy="17" r="3"></circle><line x1="19.5" y1="19.5" x2="22" y2="22"></line></svg>
          <span class="nav-item-label">Thin Content Work Queue</span>
          <span class="nav-item-badge amber" id="side-thin-count">{{ editorial.thinContentStats.flaggedCount }}</span>
        </button>
        <button class="nav-item" data-view="attention" onclick="navigate('attention')">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span class="nav-item-label">Needs Attention</span>
          <span class="nav-item-badge amber" id="side-attn-count">...</span>
        </button>
        <button class="nav-item" data-view="safety" onclick="navigate('safety')">
          <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span class="nav-item-label">Safety</span>
          <span class="nav-item-badge blue" id="side-safe-count">...</span>
        </button>

        <div class="nav-group" id="nav-group-gsc">
          <button type="button" class="nav-group-header" onclick="toggleNavGroup('nav-group-gsc')" aria-expanded="true">
            <span>GSC / SEARCH CONSOLE</span>
            <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="nav-group-children">
            <button class="nav-item" data-view="gsc-overview" onclick="navigate('gsc-overview')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span class="nav-item-label">Overview</span>
            </button>
            <button class="nav-item" data-view="search" onclick="navigate('search')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
              <span class="nav-item-label">Search Performance &amp; Discovery</span>
              <span class="nav-item-badge blue">GSC API</span>
            </button>
            <button class="nav-item" data-view="indexing" onclick="navigate('indexing')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span class="nav-item-label">Indexing</span>
              <span class="nav-item-badge green">Index</span>
            </button>
            <button class="nav-item" data-view="url-inspection" onclick="navigate('url-inspection')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <span class="nav-item-label">URL Inspection</span>
              <span class="nav-item-badge blue">Inspector</span>
            </button>
            <button class="nav-item" data-view="sitemaps" onclick="navigate('sitemaps')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
              <span class="nav-item-label">Sitemaps</span>
              <span class="nav-item-badge teal">XML</span>
            </button>
          </div>
        </div>

        <div class="nav-group" id="nav-group-site-health">
          <button type="button" class="nav-group-header" onclick="toggleNavGroup('nav-group-site-health')" aria-expanded="true">
            <span>SITE HEALTH</span>
            <svg class="nav-group-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="nav-group-children">
            <button class="nav-item" data-view="website" onclick="navigate('website')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
              <span class="nav-item-label">Website Health</span>
              <span class="nav-item-badge green">PASS</span>
            </button>
            <button class="nav-item" data-view="broken-links" onclick="navigate('broken-links')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              <span class="nav-item-label">Broken Links</span>
              <span class="nav-item-badge green">PASS</span>
            </button>
            <button class="nav-item" data-view="server-response" onclick="navigate('server-response')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
              <span class="nav-item-label">Server Response</span>
              <span class="nav-item-badge green">PASS</span>
            </button>
            <button class="nav-item" data-view="security" onclick="navigate('security')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span class="nav-item-label">Security</span>
              <span class="nav-item-badge green">TLS</span>
            </button>
            <button class="nav-item" data-view="google-news" onclick="navigate('google-news')">
              <svg class="nav-item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
