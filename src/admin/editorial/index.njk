    function openInviteModal() {
      if (AppState.currentUser && AppState.currentUser.role === 'editor') {
        alert('Forbidden. Only newsroom Administrators and the Root Owner can invite members.');
        return;
      }
      const modal = document.getElementById('invite-member-modal');
      const errBox = document.getElementById('invite-error-box');
      const resBox = document.getElementById('invite-result-box');
      const emailInp = document.getElementById('invite-input-email');
      const nameInp = document.getElementById('invite-input-name');
      const roleSel = document.getElementById('invite-input-role');

      if (errBox) errBox.style.display = 'none';
      if (resBox) resBox.style.display = 'none';
      if (emailInp) emailInp.value = '';
      if (nameInp) nameInp.value = '';
      if (roleSel) roleSel.value = 'editor';

      if (modal) modal.style.display = 'flex';
      if (emailInp) setTimeout(() => emailInp.focus(), 60);
    }

    function closeInviteModal(e) {
      if (e && e.target && e.target.id !== 'invite-member-modal' && !e.target.closest('.btn-close-modal') && !e.target.closest('.btn-table-action')) {
        return;
      }
      const modal = document.getElementById('invite-member-modal');
      if (modal) modal.style.display = 'none';
    }

    async function handleSendInvitation(e) {
      if (e) e.preventDefault();
      const emailInp = document.getElementById('invite-input-email');
      const nameInp = document.getElementById('invite-input-name');
      const roleSel = document.getElementById('invite-input-role');
      const errBox = document.getElementById('invite-error-box');
      const resBox = document.getElementById('invite-result-box');
      const resMsg = document.getElementById('invite-result-msg');
      const urlWrap = document.getElementById('invite-result-url-wrap');
      const urlInp = document.getElementById('invite-result-url');
      const submitBtn = document.getElementById('btn-submit-invite');

      if (errBox) errBox.style.display = 'none';
      if (resBox) resBox.style.display = 'none';

      const email = (emailInp?.value || '').trim().toLowerCase();
      const displayName = (nameInp?.value || '').trim();
      const role = roleSel?.value || 'editor';

      // Strict client-side validation
      if (!email.endsWith('@gmail.com') && !email.endsWith('@googlemail.com')) {
        if (errBox) {
          errBox.innerText = 'Only @gmail.com or @googlemail.com addresses are permitted for member invitations.';
          errBox.style.display = 'block';
        }
        return;
      }

      if (!displayName) {
        if (errBox) {
          errBox.innerText = 'Display name is required.';
          errBox.style.display = 'block';
        }
        return;
      }

      if (role !== 'admin' && role !== 'editor') {
        if (errBox) {
          errBox.innerText = 'Invalid role. Only Admin and Editor roles can be assigned.';
          errBox.style.display = 'block';
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';
      }

      try {
        const res = await fetch('/api/admin/members/invite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, displayName, role })
        });
        const data = await res.json();

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Invitation';
        }

        if (res.ok && data.success) {
          showToast('Invitation created for ' + email, 'success');
          if (resBox && resMsg) {
            resBox.style.display = 'block';
            let msgText = '';
            if (data.emailDelivery && data.emailDelivery.sent === true) {
              msgText = '✓ Invitation sent via email to ' + email + ' (Provider: ' + (data.emailDelivery.provider || 'Resend') + ').';
            } else if (data.emailDelivery && data.emailDelivery.sent === false) {
              msgText = 'Email delivery is not configured yet. Share the invitation URL directly:';
            } else {
              msgText = 'Invitation created. Share the invitation URL directly:';
            }
            resMsg.innerText = msgText;

            if (data.inviteUrl && urlWrap && urlInp) {
              urlWrap.style.display = 'block';
              urlInp.value = data.inviteUrl;
            }
          }
          // Refresh data in background
          loadMembersData(true);
        } else {
          if (errBox) {
            errBox.innerText = data.error || 'Failed to send invitation.';
            errBox.style.display = 'block';
          }
        }
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Send Invitation';
        }
        if (errBox) {
          errBox.innerText = 'Network error: ' + err.message;
          errBox.style.display = 'block';
        }
      }
    }

    function copyInviteResultUrl() {
      const inp = document.getElementById('invite-result-url');
      if (!inp || !inp.value) return;
      navigator.clipboard.writeText(inp.value).then(() => {
        showToast('Invitation URL copied to clipboard', 'info');
      }).catch(() => {
        inp.select();
        document.execCommand('copy');
        showToast('Invitation URL copied to clipboard', 'info');
      });
    }

    function confirmCancelInvitation(id, email) {
      openConfirmModal({
        title: 'Revoke Pending Invitation',
        body: 'Are you sure you want to revoke the pending invitation for <strong>' + escapeHtml(email) + '</strong>?<br><br>The single-use invitation link will be permanently revoked.',
        danger: true,
        confirmLabel: 'Revoke Invitation',
        onConfirm: async () => {
          closeConfirmModal();
          try {
            const res = await fetch('/api/admin/members/invite/cancel', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              showToast('Invitation for ' + email + ' revoked', 'success');
              // Optimistically update local invitation status immediately
              const target = AppState.invitations.find(i => i.id === id);
              if (target) {
                target.status = 'revoked';
                target.revoked = true;
                target.revokedAt = new Date().toISOString();
              }
              renderMembersTab();
              loadMembersData(true);
            } else {
              showToast(data.error || 'Failed to revoke invitation', 'error');
            }
          } catch (err) {
            showToast('Network error: ' + err.message, 'error');
          }
        }
      });
    }

