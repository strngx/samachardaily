    async function connectSearchConsole() {
      try {
        const res = await fetch('/api/admin/gsc/auth/start?format=json', {
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          const data = await res.json();
          if (data.success && data.authUrl) {
            window.location.href = data.authUrl;
            return;
          }
        } else if (res.status === 503) {
          const data = await res.json().catch(() => ({}));
          const msg = data.error || 'Google OAuth credentials (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are not configured.';
          renderGSCErrorState(msg);
          showToast(msg, 'warning');
          return;
        }
      } catch (e) {
        // Fallback to direct navigation
      }
      window.location.href = '/api/admin/gsc/auth/start';
    }

    async function disconnectSearchConsole() {
      if (!confirm('Disconnect Google Search Console? This will remove stored access credentials from the server.')) {
        return;
      }
      try {
        const res = await fetch('/api/admin/gsc/disconnect', { method: 'POST' });
        const data = await res.json();
        if (res.ok && data.success) {
          GSCState.connected = false;
          GSCState.accountEmail = null;
          GSCState.accountName = null;
          GSCState.accountPicture = null;
          GSCState.summary = null;
          GSCState.queries = [];
          GSCState.pages = [];
          GSCState.dateSeries = [];
          GSCState.sitemaps = null;
          if (AppState.currentUser) {
            delete AppState.currentUser.googlePicture;
            updateSidebarProfile(AppState.currentUser);
          }
          updateGSCStatusUI();
          renderGSCNotConnectedState();
          showToast('Google Search Console disconnected', 'info');
        } else {
          showToast(data.error || 'Failed to disconnect', 'error');
        }
      } catch (e) {
        showToast('Error disconnecting: ' + e.message, 'error');
      }
    }

    function initGSCOAuthRedirectFeedback() {
      try {
        let params = new URLSearchParams(window.location.search);
        // Fallback: check if params arrived after hash
        if (!params.get('gsc') && !params.get('gsc_error') && !params.get('gsc_disconnected')) {
          const hash = window.location.hash || '';
          const qIdx = hash.indexOf('?');
          if (qIdx !== -1) {
            params = new URLSearchParams(hash.slice(qIdx));
          }
        }

        if (params.get('gsc') === 'connected') {
          showToast('Google Search Console connected successfully!', 'success');
          params.delete('gsc');
          const cleanHash = (window.location.hash || '').split('?')[0];
          const newSearch = params.toString() ? '?' + params.toString() : '';
          window.history.replaceState({}, document.title, window.location.pathname + newSearch + cleanHash);
        } else if (params.get('gsc_error')) {
          const errCode = params.get('gsc_error');
          let msg = 'Google Search Console connection failed.';
          if (errCode === 'oauth_denied' || errCode === 'access_denied') msg = 'Google Search Console access was denied.';
          else if (errCode === 'missing_code') msg = 'OAuth authorization code missing.';
          else if (errCode === 'invalid_state') msg = 'OAuth security state verification failed. Please try again.';
          else if (errCode === 'token_exchange_failed') msg = 'Failed to exchange Google OAuth authorization token.';
          else if (errCode === 'missing_credentials') msg = 'Google OAuth credentials (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are not configured.';
          else if (errCode === 'missing_params') msg = 'OAuth callback parameters missing.';
          else if (errCode === 'oauth_not_configured') msg = 'Google OAuth credentials are not configured.';
          else msg = 'Google Search Console connection failed: ' + errCode;
          renderGSCErrorState(msg);
          showToast(msg, 'error');
          params.delete('gsc_error');
          const cleanHash = (window.location.hash || '').split('?')[0];
          const newSearch = params.toString() ? '?' + params.toString() : '';
          window.history.replaceState({}, document.title, window.location.pathname + newSearch + cleanHash);
        } else if (params.get('gsc_disconnected')) {
          showToast('Google Search Console disconnected', 'info');
          params.delete('gsc_disconnected');
          const cleanHash = (window.location.hash || '').split('?')[0];
          const newSearch = params.toString() ? '?' + params.toString() : '';
          window.history.replaceState({}, document.title, window.location.pathname + newSearch + cleanHash);
        }
      } catch (e) {}

      checkInitialGSCStatus();
    }

