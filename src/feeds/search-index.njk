---
permalink: /search-index.json
eleventyExcludeFromCollections: true
---
[{% set comma = false %}{% for article in collections.articles %}{% set d = article.data %}{% if not d.noindex and not d.redirect_to and not d.redirect and not d.draft and not d.archived and not d.eleventyExcludeFromCollections and article.date and article.date.getTime() > 0 and article.date.getTime() <= page.date.getTime() %}{% if comma %},{% endif %}{"t":{{ d.title | json | safe }},"d":{{ (d.dek or "") | json | safe }},"c":{{ (d.category | categorySlug) | json | safe }},"dt":{{ article.date | isoDate | json | safe }},"u":{{ article.url | url | json | safe }},"i":{{ ((d.image | url) if d.image else "") | json | safe }},"s":{{ (d.slug or article.fileSlug) | json | safe }}}{% set comma = true %}{% endif %}{% endfor %}]
