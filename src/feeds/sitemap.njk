---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  <!-- Homepage -->
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ "now" | isoDate }}</lastmod>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Category Pages -->
  {% for cat in site.categories %}
  <url>
    <loc>{{ site.url }}/{{ cat.slug }}/</loc>
    <lastmod>{{ "now" | isoDate }}</lastmod>
    <changefreq>hourly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}

  <!-- Policy Pages -->
  {% for link in site.footerNav %}
    {% if link.url != '/rss.xml' and link.url != '/sitemap.xml' %}
  <url>
    <loc>{{ site.url }}{{ link.url }}</loc>
    <lastmod>{{ "now" | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
    {% endif %}
  {% endfor %}

  <!-- Articles -->
  {% for article in collections.articles %}
  <url>
    <loc>{{ site.url }}{{ article.url }}</loc>
    <lastmod>{{ article.date | isoDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
    <news:news>
      <news:publication>
        <news:name>{{ site.name }}</news:name>
        <news:language>en</news:language>
      </news:publication>
      <news:publication_date>{{ article.date | isoDate }}</news:publication_date>
      <news:title>{{ article.data.title | escape }}</news:title>
    </news:news>
  </url>
  {% endfor %}
</urlset>
