---
layout: layouts/base.njk
title: "Search Articles"
description: "Search across all SamacharDaily news categories, archives, and topics."
permalink: "/search/index.html"
noindex: true
---

<div class="container">
  <div class="article-reading-container" style="max-width: 880px;">
    <!-- Breadcrumbs -->
    <nav class="article-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ '/' | url }}">Home</a>
      <span>/</span>
      <span style="color: var(--color-ink);">Search</span>
    </nav>

    <h1 class="article-headline-main">Search Articles</h1>
    <p style="color: var(--color-muted); font-size: 1.125rem; margin-bottom: var(--space-6);">
      Search verified reporting across India, World, Business, Tech, and Sports.
    </p>

    <!-- Search Form -->
    <div style="margin-bottom: var(--space-6);">
      <form class="search-form-page" id="main-search-form" action="{{ '/search/' | url }}" method="get" role="search">
        <input 
          type="search" 
          name="q"
          id="page-search-input" 
          class="search-page-input" 
          placeholder="Type a headline, topic, company, policy, or sport..."
          autocomplete="off"
          maxlength="200"
        >
        <button type="submit" class="search-page-btn">Search</button>
      </form>
    </div>

    <!-- Filter Toolbar -->
    <div class="search-filters-bar" aria-label="Search Filters">
      <!-- Desk Filter Pills -->
      <div class="desk-pills" role="group" aria-label="Filter by Desk">
        <button type="button" class="desk-pill is-active" data-desk="all" aria-pressed="true">All Desks</button>
        <button type="button" class="desk-pill" data-desk="india" aria-pressed="false">India</button>
        <button type="button" class="desk-pill" data-desk="world" aria-pressed="false">World</button>
        <button type="button" class="desk-pill" data-desk="business" aria-pressed="false">Business</button>
        <button type="button" class="desk-pill" data-desk="tech" aria-pressed="false">Tech</button>
        <button type="button" class="desk-pill" data-desk="sports" aria-pressed="false">Sports</button>
      </div>

      <!-- Secondary Filters: Date & Sort -->
      <div class="search-dropdowns">
        <div class="search-dropdown-group">
          <label for="search-date-filter" class="search-filter-label">Date:</label>
          <select id="search-date-filter" class="search-select">
            <option value="any">Any Time</option>
            <option value="24h">Past 24 Hours</option>
            <option value="7d">Past 7 Days</option>
            <option value="30d">Past 30 Days</option>
            <option value="year">This Year</option>
          </select>
        </div>

        <div class="search-dropdown-group">
          <label for="search-sort-filter" class="search-filter-label">Sort:</label>
          <select id="search-sort-filter" class="search-select">
            <option value="relevance">Most Relevant</option>
            <option value="newest">Newest First</option>
            <option value="oldest">Oldest First</option>
          </select>
        </div>

        <button type="button" id="search-reset-filters" class="search-btn-reset" title="Reset all filters">Clear</button>
      </div>
    </div>

    <!-- Match Count & Meta Header -->
    <div id="search-results-meta" class="search-results-meta" style="display: none;" aria-live="polite"></div>

    <!-- Search Results Container -->
    <div id="search-results" class="grid-comp-b search-results-grid" style="display: none;" aria-live="polite">
      <!-- Populated dynamically via src/assets/js/search.js -->
    </div>

    <!-- Pagination Bounded Controller -->
    <div id="search-pagination" class="search-pagination" style="display: none;">
      <button type="button" id="search-load-more" class="btn-load-more">Load More Stories</button>
    </div>

    <!-- Empty / Initial Guidance State -->
    <div id="search-empty-state" class="empty-newsroom-state" style="padding: 40px 0; text-align: center; color: var(--color-muted);">
      <p>Enter keywords above to find verified reporting across our categories.</p>
      <div class="search-category-hints">
        <span>Quick browse:</span>
        <a href="{{ '/india/' | url }}">India</a> &bull;
        <a href="{{ '/world/' | url }}">World</a> &bull;
        <a href="{{ '/business/' | url }}">Business</a> &bull;
        <a href="{{ '/tech/' | url }}">Tech</a> &bull;
        <a href="{{ '/sports/' | url }}">Sports</a>
      </div>
    </div>

  </div>
</div>

<script src="{{ '/assets/js/search.js' | url }}" defer></script>
